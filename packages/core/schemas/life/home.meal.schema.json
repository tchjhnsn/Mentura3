{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reflect:schema:life:home.meal",
  "title": "Meal",
  "description": "A meal you make: how many it serves and what goes in it, one ingredient a line.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Meal",
      "description": "Chili",
      "maxLength": 300
    },
    "serves": {
      "type": "number",
      "title": "Serves",
      "description": "4",
