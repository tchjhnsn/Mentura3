      "exclusiveMaximum": 10000000000
    },
    "ingredients": {
      "type": "string",
      "title": "Ingredients, one a line",
      "description": "2 cups rice",
      "maxLength": 20000
    },
    "method": {
      "type": "string",
      "title": "How to make it",
      "maxLength": 20000
    },
    "recipe": {
      "type": "string",
      "title": "Reflect's recipe",
      "maxLength": 4000
    }
  },
  "additionalProperties": true,
  "x-reflect": {
    "app": "home",
    "kind": "meal",
    "noun": "meal",
    "category": "substance",
    "good": "body",
    "community": "household"
  }
}
