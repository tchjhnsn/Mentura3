{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reflect:schema:life:home.step",
  "title": "Step",
  "description": "A change still to be reached, such as married or two children, with what it would cost. Nothing that is not yet is guaranteed.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "The step",
      "description": "Married",
      "maxLength": 300
    },
    "order": {
      "type": "number",
      "title": "Order",
      "description": "1 for the next step",
      "minimum": 0,
      "exclusiveMaximum": 10000000000
    },
    "year": {
      "type": "number",
      "title": "Year, if you have one",
      "minimum": 0,
      "exclusiveMaximum": 10000000000
    },
    "where": {
      "type": "string",
      "title": "Where you would live",
      "description": "County and state",
      "maxLength": 300
    },
    "adults": {
      "type": "number",
      "title": "Adults in the household",
      "minimum": 0,
      "exclusiveMaximum": 10000000000
    },
    "children": {
      "type": "number",
      "title": "Children",
      "minimum": 0,
      "exclusiveMaximum": 10000000000
    },
    "food": {
      "type": "string",
      "title": "How you would eat",
      "enum": [
        "thrifty",
        "low",
        "moderate",
        "liberal"
      ]
    },
    "shelter": {
      "type": "number",
      "title": "Housing a month",
      "minimum": 0,
      "exclusiveMaximum": 10000000000
    },
    "transport": {
      "type": "number",
      "title": "Transport a month",
      "minimum": 0,
      "exclusiveMaximum": 10000000000
    },
    "water": {
      "type": "number",
      "title": "Water a month",
      "minimum": 0,
      "exclusiveMaximum": 10000000000
    },
    "safety": {
      "type": "number",
      "title": "Safety a month",
      "minimum": 0,
      "exclusiveMaximum": 10000000000
    },
    "children-cost": {
      "type": "number",
      "title": "Children a month",
      "minimum": 0,
      "exclusiveMaximum": 10000000000
    },
    "health": {
      "type": "number",
      "title": "Health care a month",
      "minimum": 0,
      "exclusiveMaximum": 10000000000
    },
    "learning": {
      "type": "number",
      "title": "Learning a month",
      "minimum": 0,
      "exclusiveMaximum": 10000000000
    },
    "giving": {
      "type": "number",
      "title": "Giving a month",
      "minimum": 0,
      "exclusiveMaximum": 10000000000
    },
    "other": {
      "type": "number",
      "title": "Everything else a month",
      "minimum": 0,
      "exclusiveMaximum": 10000000000
    },
    "food-cost": {
      "type": "number",
      "title": "Food a month, if you know it",
      "minimum": 0,
      "exclusiveMaximum": 10000000000
    },
    "_sources": {
      "type": "object",
      "title": "Where each value came from",
      "description": "One source per field key. A field with no source here was typed by the person.",
      "propertyNames": {
        "enum": [
          "name",
          "order",
          "year",
          "where",
          "adults",
          "children",
          "food",
          "shelter",
          "transport",
          "water",
          "safety",
          "children-cost",
          "health",
          "learning",
          "giving",
          "other",
          "food-cost"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "source": {
      "title": "Where a value came from",
      "description": "The source a field's value was derived from (W3C PROV, wasDerivedFrom). Every kind but stated is proposed until the person confirms it.",
      "oneOf": [
        {
          "type": "object",
          "title": "The person typed it into the field",
          "properties": {
            "kind": {
              "const": "stated"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "A journal entry",
          "properties": {
            "kind": {
              "const": "journal"
            },
            "entry": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "description": "The entry's id."
            },
            "quote": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "description": "The words the value was taken from, quoted exactly."
            },
            "grant": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "description": "The read grant the quote was taken under."
            },
            "status": {
              "enum": [
                "proposed",
                "confirmed"
              ],
              "description": "Proposed until the person confirms it."
            }
          },
          "required": [
            "kind",
            "entry",
            "quote",
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "A conversation with an AI",
          "properties": {
            "kind": {
              "const": "conversation"
            },
            "conversation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "description": "The conversation's id."
            },
            "quote": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "description": "The words the value was taken from, quoted exactly."
            },
            "status": {
              "enum": [
                "proposed",
                "confirmed"
              ],
              "description": "Proposed until the person confirms it."
            }
          },
          "required": [
            "kind",
            "conversation",
            "quote",
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "A connector or an uploaded file",
          "properties": {
            "kind": {
              "const": "import"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "description": "The connector's or the file's name."
            },
            "item": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "description": "The item's id there."
            },
            "status": {
              "enum": [
                "proposed",
                "confirmed"
              ],
              "description": "Proposed until the person confirms it."
            }
          },
          "required": [
            "kind",
            "name",
            "item",
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "Reflect proposed it from the person's own records",
          "properties": {
            "kind": {
              "const": "noticed"
            },
            "records": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "description": "The ids of the records it was noticed in."
            },
            "status": {
              "enum": [
                "proposed",
                "confirmed"
              ],
              "description": "Proposed until the person confirms it."
            }
          },
          "required": [
            "kind",
            "records",
            "status"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "x-reflect": {
    "app": "home",
    "kind": "step",
    "noun": "life change",
    "category": "being affected",
    "good": "external",
    "community": "household"
  }
}
