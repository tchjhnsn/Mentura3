{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reflect:schema:life:legacy.adventure",
  "title": "Adventure",
  "description": "Something you want to do, such as camping, a league, travel or learning piano, with the tiles it touches.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "The adventure",
      "description": "Go camping",
      "maxLength": 300
    },
    "ref": {
      "type": "string",
      "title": "From the idea",
      "maxLength": 4000
    },
    "tiles": {
      "type": "string",
      "title": "Tiles it touches",
      "maxLength": 4000
    },
    "with": {
      "type": "string",
      "title": "With",
      "enum": [
        "alone",
        "partner",
        "family",
        "friends",
        "others"
      ]
    },
    "place": {
      "type": "string",
      "title": "Where",
      "maxLength": 4000
    },
    "lat": {
      "type": "number",
      "title": "Latitude",
      "minimum": -180,
      "maximum": 180
    },
    "lon": {
      "type": "number",
      "title": "Longitude",
      "minimum": -180,
      "maximum": 180
    },
    "start": {
      "type": "string",
      "title": "Starts",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "end": {
      "type": "string",
      "title": "Ends",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "plan": {
      "type": "string",
      "title": "Plan",
      "maxLength": 20000
    },
    "drafted": {
      "type": "boolean",
      "title": "Drafted by Reflect"
    },
    "checklist": {
      "type": "string",
      "title": "Checklist",
      "maxLength": 20000
    },
    "budget": {
      "type": "number",
      "title": "Budget",
      "minimum": 0,
      "exclusiveMaximum": 10000000000
    },
    "people": {
      "type": "string",
      "title": "Who is going",
      "maxLength": 4000
    },
    "events": {
      "type": "string",
      "title": "Calendar events",
      "maxLength": 4000
    },
    "_sources": {
      "type": "object",
      "title": "Where each value came from",
      "description": "One source per field key. A field with no source here was typed by the person.",
      "propertyNames": {
        "enum": [
          "name",
          "ref",
          "tiles",
          "with",
          "place",
          "lat",
          "lon",
          "start",
          "end",
          "plan",
          "drafted",
          "checklist",
          "budget",
          "people",
          "events"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "source": {
      "title": "Where a value came from",
      "description": "The source a field's value was derived from (W3C PROV, wasDerivedFrom). Every kind but stated is proposed until the person confirms it.",
      "oneOf": [
        {
          "type": "object",
          "title": "The person typed it into the field",
          "properties": {
            "kind": {
              "const": "stated"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "A journal entry",
          "properties": {
            "kind": {
              "const": "journal"
            },
            "entry": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "description": "The entry's id."
            },
            "quote": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "description": "The words the value was taken from, quoted exactly."
            },
            "grant": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "description": "The read grant the quote was taken under."
            },
            "status": {
              "enum": [
                "proposed",
                "confirmed"
              ],
              "description": "Proposed until the person confirms it."
            }
          },
          "required": [
            "kind",
            "entry",
            "quote",
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "A conversation with an AI",
          "properties": {
            "kind": {
              "const": "conversation"
            },
            "conversation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "description": "The conversation's id."
            },
            "quote": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "description": "The words the value was taken from, quoted exactly."
            },
            "status": {
              "enum": [
                "proposed",
                "confirmed"
              ],
              "description": "Proposed until the person confirms it."
            }
          },
          "required": [
            "kind",
            "conversation",
            "quote",
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "A connector or an uploaded file",
          "properties": {
            "kind": {
              "const": "import"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "description": "The connector's or the file's name."
            },
            "item": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "description": "The item's id there."
            },
            "status": {
              "enum": [
                "proposed",
                "confirmed"
              ],
              "description": "Proposed until the person confirms it."
            }
          },
          "required": [
            "kind",
            "name",
            "item",
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "Reflect proposed it from the person's own records",
          "properties": {
            "kind": {
              "const": "noticed"
            },
            "records": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "description": "The ids of the records it was noticed in."
            },
            "status": {
              "enum": [
                "proposed",
                "confirmed"
              ],
              "description": "Proposed until the person confirms it."
            }
          },
          "required": [
            "kind",
            "records",
            "status"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "x-reflect": {
    "app": "legacy",
    "kind": "adventure",
    "noun": "adventure",
    "category": "doing",
    "good": "external",
    "community": "person"
  }
}
