{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reflect:schema:life:home.receipt",
  "title": "Receipt",
  "description": "A receipt for food: the store, the day, the total and its lines.",
  "type": "object",
  "properties": {
    "store": {
      "type": "string",
      "title": "Store",
      "maxLength": 300
    },
    "day": {
      "type": "string",
      "title": "Day",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "total": {
      "type": "number",
      "title": "Total",
      "minimum": 0,
      "exclusiveMaximum": 10000000000
    },
    "spend": {
      "type": "string",
      "title": "Counts as",
      "enum": [
        "groceries",
        "eating-out"
      ]
    },
    "items": {
      "type": "string",
      "title": "Lines",
      "maxLength": 20000
    },
    "confirmed": {
      "type": "boolean",
      "title": "Confirmed"
    }
  },
  "additionalProperties": true,
  "x-reflect": {
    "app": "home",
    "kind": "receipt",
    "noun": "purchase",
    "category": "doing",
    "good": "external",
    "community": "household"
  }
}
