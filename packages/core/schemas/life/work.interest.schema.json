{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reflect:schema:life:work.interest",
  "title": "Interest",
  "description": "Something the person makes, does or follows, from Get to know you (`@reflect/core/interests` for the levels, `@reflect/core/interest-catalogue` for the things): which modes, and for each its commitment and its skill (Make, Do) or depth (Know).",
  "type": "object",
  "properties": {
    "ref": {
      "type": "string",
      "title": "Which thing",
      "maxLength": 4000
    },
    "title": {
      "type": "string",
      "title": "Name",
      "maxLength": 300
    },
    "area": {
      "type": "string",
      "title": "Area",
      "maxLength": 4000
    },
    "modes": {
      "type": "string",
      "title": "Make, Do, Know",
      "maxLength": 4000
    },
    "make_commitment": {
      "type": "string",
      "title": "Making: commitment",
      "maxLength": 4000
    },
    "make_skill": {
      "type": "string",
      "title": "Making: skill",
      "maxLength": 4000
    },
    "do_commitment": {
      "type": "string",
      "title": "Doing: commitment",
      "maxLength": 4000
    },
    "do_skill": {
      "type": "string",
      "title": "Doing: skill",
      "maxLength": 4000
    },
    "know_commitment": {
      "type": "string",
      "title": "Knowing: commitment",
      "maxLength": 4000
    },
    "know_depth": {
      "type": "string",
      "title": "Knowing: depth",
      "maxLength": 4000
    },
    "source": {
      "type": "string",
      "title": "How we learned it",
      "maxLength": 4000
    },
    "_sources": {
      "type": "object",
      "title": "Where each value came from",
      "description": "One source per field key. A field with no source here was typed by the person.",
      "propertyNames": {
        "enum": [
          "ref",
          "title",
          "area",
          "modes",
          "make_commitment",
          "make_skill",
          "do_commitment",
          "do_skill",
          "know_commitment",
          "know_depth",
          "source"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "source": {
      "title": "Where a value came from",
      "description": "The source a field's value was derived from (W3C PROV, wasDerivedFrom). Every kind but stated is proposed until the person confirms it.",
      "oneOf": [
        {
          "type": "object",
          "title": "The person typed it into the field",
          "properties": {
            "kind": {
              "const": "stated"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "A journal entry",
          "properties": {
            "kind": {
              "const": "journal"
            },
            "entry": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "description": "The entry's id."
            },
            "quote": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "description": "The words the value was taken from, quoted exactly."
            },
            "grant": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "description": "The read grant the quote was taken under."
            },
            "status": {
              "enum": [
                "proposed",
                "confirmed"
              ],
              "description": "Proposed until the person confirms it."
            }
          },
          "required": [
            "kind",
            "entry",
            "quote",
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "A conversation with an AI",
          "properties": {
            "kind": {
              "const": "conversation"
            },
            "conversation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "description": "The conversation's id."
            },
            "quote": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "description": "The words the value was taken from, quoted exactly."
            },
            "status": {
              "enum": [
                "proposed",
                "confirmed"
              ],
              "description": "Proposed until the person confirms it."
            }
          },
          "required": [
            "kind",
            "conversation",
            "quote",
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "A connector or an uploaded file",
          "properties": {
            "kind": {
              "const": "import"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "description": "The connector's or the file's name."
            },
            "item": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "description": "The item's id there."
            },
            "status": {
              "enum": [
                "proposed",
                "confirmed"
              ],
              "description": "Proposed until the person confirms it."
            }
          },
          "required": [
            "kind",
            "name",
            "item",
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "Reflect proposed it from the person's own records",
          "properties": {
            "kind": {
              "const": "noticed"
            },
            "records": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "description": "The ids of the records it was noticed in."
            },
            "status": {
              "enum": [
                "proposed",
                "confirmed"
              ],
              "description": "Proposed until the person confirms it."
            }
          },
          "required": [
            "kind",
            "records",
            "status"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "x-reflect": {
    "app": "work",
    "kind": "interest",
    "noun": "interest",
    "category": "quality",
    "good": "soul",
    "community": "person"
  }
}
