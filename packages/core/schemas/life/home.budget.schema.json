{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reflect:schema:life:home.budget",
  "title": "Budget",
  "description": "What you allot a month to each tile, held against what your plan says each costs and what comes in after taxes.",
  "type": "object",
  "properties": {
    "learn": {
      "type": "number",
      "title": "Scholē a month",
      "minimum": 0,
      "exclusiveMaximum": 10000000000
    },
    "work": {
      "type": "number",
      "title": "Ergon a month",
      "minimum": 0,
      "exclusiveMaximum": 10000000000
    },
    "health": {
      "type": "number",
      "title": "Health a month",
      "minimum": 0,
      "exclusiveMaximum": 10000000000
    },
    "fitness": {
      "type": "number",
      "title": "Fitness a month",
      "minimum": 0,
      "exclusiveMaximum": 10000000000
    },
    "income": {
      "type": "number",
      "title": "Income a month",
      "minimum": 0,
      "exclusiveMaximum": 10000000000
    },
    "shelter": {
      "type": "number",
      "title": "Shelter a month",
      "minimum": 0,
      "exclusiveMaximum": 10000000000
    },
    "food": {
      "type": "number",
      "title": "Food a month",
      "minimum": 0,
      "exclusiveMaximum": 10000000000
    },
    "water": {
      "type": "number",
      "title": "Water a month",
      "minimum": 0,
      "exclusiveMaximum": 10000000000
    },
    "transport": {
      "type": "number",
      "title": "Transport a month",
      "minimum": 0,
      "exclusiveMaximum": 10000000000
    },
    "safety": {
      "type": "number",
      "title": "Safety a month",
      "minimum": 0,
      "exclusiveMaximum": 10000000000
    },
    "mate": {
      "type": "number",
      "title": "Mate a month",
      "minimum": 0,
      "exclusiveMaximum": 10000000000
    },
    "kin": {
      "type": "number",
      "title": "Kin a month",
      "minimum": 0,
      "exclusiveMaximum": 10000000000
    },
    "friends": {
      "type": "number",
      "title": "Friends a month",
      "minimum": 0,
      "exclusiveMaximum": 10000000000
    },
    "standing": {
      "type": "number",
      "title": "Standing a month",
      "minimum": 0,
      "exclusiveMaximum": 10000000000
    },
    "polis": {
      "type": "number",
      "title": "Polis a month",
      "minimum": 0,
      "exclusiveMaximum": 10000000000
    },
    "ventures": {
      "type": "number",
      "title": "Ventures a month",
      "minimum": 0,
      "exclusiveMaximum": 10000000000
    },
    "_sources": {
      "type": "object",
      "title": "Where each value came from",
      "description": "One source per field key. A field with no source here was typed by the person.",
      "propertyNames": {
        "enum": [
          "learn",
          "work",
          "health",
          "fitness",
          "income",
          "shelter",
          "food",
          "water",
          "transport",
          "safety",
          "mate",
          "kin",
          "friends",
          "standing",
          "polis",
          "ventures"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "source": {
      "title": "Where a value came from",
      "description": "The source a field's value was derived from (W3C PROV, wasDerivedFrom). Every kind but stated is proposed until the person confirms it.",
      "oneOf": [
        {
          "type": "object",
          "title": "The person typed it into the field",
          "properties": {
            "kind": {
              "const": "stated"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "A journal entry",
          "properties": {
            "kind": {
              "const": "journal"
            },
            "entry": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "description": "The entry's id."
            },
            "quote": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "description": "The words the value was taken from, quoted exactly."
            },
            "grant": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "description": "The read grant the quote was taken under."
            },
            "status": {
              "enum": [
                "proposed",
                "confirmed"
              ],
              "description": "Proposed until the person confirms it."
            }
          },
          "required": [
            "kind",
            "entry",
            "quote",
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "A conversation with an AI",
          "properties": {
            "kind": {
              "const": "conversation"
            },
            "conversation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "description": "The conversation's id."
            },
            "quote": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "description": "The words the value was taken from, quoted exactly."
            },
            "status": {
              "enum": [
                "proposed",
                "confirmed"
              ],
              "description": "Proposed until the person confirms it."
            }
          },
          "required": [
            "kind",
            "conversation",
            "quote",
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "A connector or an uploaded file",
          "properties": {
            "kind": {
              "const": "import"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "description": "The connector's or the file's name."
            },
            "item": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "description": "The item's id there."
            },
            "status": {
              "enum": [
                "proposed",
                "confirmed"
              ],
              "description": "Proposed until the person confirms it."
            }
          },
          "required": [
            "kind",
            "name",
            "item",
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "Reflect proposed it from the person's own records",
          "properties": {
            "kind": {
              "const": "noticed"
            },
            "records": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "description": "The ids of the records it was noticed in."
            },
            "status": {
              "enum": [
                "proposed",
                "confirmed"
              ],
              "description": "Proposed until the person confirms it."
            }
          },
          "required": [
            "kind",
            "records",
            "status"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "x-reflect": {
    "app": "home",
    "kind": "budget",
    "noun": "budget",
    "category": "quantity",
    "good": "external",
    "community": "household"
  }
}
