{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:reflect:schema:life:home.food-likes",
  "title": "How you eat",
  "description": "How you like to eat, the food you grew up on, and what you will not eat.",
  "type": "object",
  "properties": {
    "eat": {
      "type": "string",
      "title": "How do you like to eat?",
      "enum": [
        "any",
        "lower-carb",
        "higher-carb",
        "vegetarian",
        "no-pork"
      ]
    },
    "region": {
      "type": "string",
      "title": "What food did you grow up on?",
      "enum": [
        "south",
        "creole",
        "tex-mex",
        "midwest",
        "everyday"
      ]
    },
    "nights": {
      "type": "string",
      "title": "How many nights a week do you cook?",
      "enum": [
        "3",
        "4",
        "5",
        "6",
        "7"
      ]
    },
    "hours": {
      "type": "string",
      "title": "How many hours a week do you want to spend cooking?",
      "enum": [
        "1",
        "2",
        "3",
        "5",
        "7",
        "10"
      ]
    },
    "avoid-shellfish": {
      "type": "boolean",
      "title": "Shellfish"
    },
    "avoid-fish": {
      "type": "boolean",
      "title": "Fish"
    },
    "avoid-dairy": {
      "type": "boolean",
      "title": "Dairy"
    },
    "avoid-nuts": {
      "type": "boolean",
      "title": "Nuts"
    },
    "avoid-gluten": {
      "type": "boolean",
      "title": "Gluten"
    },
    "avoid-pork": {
      "type": "boolean",
      "title": "Pork"
    },
    "_sources": {
      "type": "object",
      "title": "Where each value came from",
      "description": "One source per field key. A field with no source here was typed by the person.",
      "propertyNames": {
        "enum": [
          "eat",
          "region",
          "nights",
          "hours",
          "avoid-shellfish",
          "avoid-fish",
          "avoid-dairy",
          "avoid-nuts",
          "avoid-gluten",
          "avoid-pork"
        ]
      },
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "source": {
      "title": "Where a value came from",
      "description": "The source a field's value was derived from (W3C PROV, wasDerivedFrom). Every kind but stated is proposed until the person confirms it.",
      "oneOf": [
        {
          "type": "object",
          "title": "The person typed it into the field",
          "properties": {
            "kind": {
              "const": "stated"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "A journal entry",
          "properties": {
            "kind": {
              "const": "journal"
            },
            "entry": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "description": "The entry's id."
            },
            "quote": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "description": "The words the value was taken from, quoted exactly."
            },
            "grant": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "description": "The read grant the quote was taken under."
            },
            "status": {
              "enum": [
                "proposed",
                "confirmed"
              ],
              "description": "Proposed until the person confirms it."
            }
          },
          "required": [
            "kind",
            "entry",
            "quote",
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "A conversation with an AI",
          "properties": {
            "kind": {
              "const": "conversation"
            },
            "conversation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "description": "The conversation's id."
            },
            "quote": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000,
              "description": "The words the value was taken from, quoted exactly."
            },
            "status": {
              "enum": [
                "proposed",
                "confirmed"
              ],
              "description": "Proposed until the person confirms it."
            }
          },
          "required": [
            "kind",
            "conversation",
            "quote",
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "A connector or an uploaded file",
          "properties": {
            "kind": {
              "const": "import"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "description": "The connector's or the file's name."
            },
            "item": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "description": "The item's id there."
            },
            "status": {
              "enum": [
                "proposed",
                "confirmed"
              ],
              "description": "Proposed until the person confirms it."
            }
          },
          "required": [
            "kind",
            "name",
            "item",
            "status"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "title": "Reflect proposed it from the person's own records",
          "properties": {
            "kind": {
              "const": "noticed"
            },
            "records": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300
              },
              "description": "The ids of the records it was noticed in."
            },
            "status": {
              "enum": [
                "proposed",
                "confirmed"
              ],
              "description": "Proposed until the person confirms it."
            }
          },
          "required": [
            "kind",
            "records",
            "status"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "x-reflect": {
    "app": "home",
    "kind": "food-likes",
    "noun": "preference",
    "category": "quality",
    "good": "soul",
    "community": "person"
  }
}
