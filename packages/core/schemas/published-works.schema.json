{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "published-works.schema.json",
  "title": "Published works",
  "description": "The person's works the person approved for their site, at published/works.json (the site's repository keeps it at content/reflect/works.json), sorted by end (making, knowing, doing), then section, pinned first, then title, with the presentation record that passed the gate and its channel. A public work goes out in full; a foreshadowed work as its end, section and one line only; a private work never. packages/core/src/published.ts writes and checks it.",
  "type": "object",
  "required": [
    "works",
    "presentation",
    "channel"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "works": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "disclosure",
              "id",
              "title",
              "end",
              "section"
            ],
            "additionalProperties": false,
            "properties": {
              "disclosure": {
                "const": "public"
              },
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9](?:[a-z0-9-]{0,58}[a-z0-9])?$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "end": {
                "enum": [
                  "making",
                  "knowing",
                  "doing"
                ]
              },
              "section": {
                "enum": [
                  "projects",
                  "products",
                  "writing",
                  "art",
                  "crafts",
                  "research",
                  "study",
                  "reading",
                  "service",
                  "care",
                  "civic",
                  "talks",
                  "events"
                ]
              },
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "problem": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300,
                "description": "The problem the work addresses, in one sentence"
              },
              "cause": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300,
                "description": "The problem's root cause, in one sentence"
              },
              "solution": {
                "type": "string",
                "minLength": 1,
                "maxLength": 300,
                "description": "The proposed solution, in one sentence"
              },
              "sources": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "connector",
                    "url"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "connector": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]*$",
                      "description": "The connector the work shows on, such as github, etsy, behance, substack, reading-list or calendar"
                    },
                    "url": {
                      "type": "string",
                      "format": "uri"
                    }
                  }
                }
              },
              "status": {
                "enum": [
                  "active",
                  "quiet",
                  "dormant",
                  "archived"
                ],
                "description": "How the work stands, from its sources' evidence where a source gives it"
              },
              "last_activity": {
                "type": "string",
                "format": "date",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "pinned": {
                "const": true
              },
              "links": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "label",
                    "href"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "href": {
                      "type": "string",
                      "minLength": 1,
                      "description": "A web address, or a path on the person's own site"
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "required": [
              "disclosure",
              "end",
              "section",
              "foreshadow"
            ],
            "additionalProperties": false,
            "properties": {
              "disclosure": {
                "const": "foreshadow"
              },
              "end": {
                "enum": [
                  "making",
                  "knowing",
                  "doing"
                ]
              },
              "section": {
                "enum": [
                  "projects",
                  "products",
                  "writing",
                  "art",
                  "crafts",
                  "research",
                  "study",
                  "reading",
                  "service",
                  "care",
                  "civic",
                  "talks",
                  "events"
                ]
              },
              "foreshadow": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    },
    "presentation": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "channel": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    }
  }
}
