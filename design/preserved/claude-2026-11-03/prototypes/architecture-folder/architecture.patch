+export type Sys = Base & {
+  physical: boolean;      // has moving physical parts
+  deterministic: boolean; // the same state and input always give the same result
+  statedRules: boolean;   // its behaviour is fully given by rules someone wrote down
+  traceable: boolean;     // every step can be traced to the rule and input that caused it
+  learned: boolean;       // its behaviour comes from parameters fitted to data
+  stateful: boolean;      // holds state
+  definedTransitions: boolean; // changes state only by defined transitions on events
+  typedSymbols: boolean;  // operates on symbols whose meaning is defined (typed records, glossary terms)
+};
+export const MECH: Term<Sys>[] = [
+  mk("mechanical-system", "mechanical system", "Engineering sense: a machine of physical parts that transmit force and motion. A homonym for us.", ["mechanical engineering usage"],
