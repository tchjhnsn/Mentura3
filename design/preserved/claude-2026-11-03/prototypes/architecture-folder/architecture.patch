+// What kind of offering each thing is: model, app, console, mode, product, capability, library, framework, platform.
+// Torian, 2026-11-01 07:14Z: Claude Code, Cowork and Chat are one app on web, desktop and mobile and differ by
+// capability; the developer platform and the Agent SDK are the same console; Mentura is a model with a Mentura app
+// and a Mentura console; precog is a capability, not a product. This file runs those claims against real records.
+// Facts about Anthropic cite references in mentura-discovery/mentura/research/references/. Exhaustive cross-run.
+//   node offering-vocab.ts            (writes offering-run.json)
+import { freeze, passSet, relation, run, validTest, type Base, type Relation, type Term } from "/home/user/ee-build/schema/terms/engine.ts";
+export type Off = Base & {
+  learned: boolean;          // behaviour comes from parameters fitted to data
+  clientApp: boolean;        // a program people open and work in (a user interface)
+  hostedService: boolean;    // runs on the vendor's servers
+  accounts: boolean;         // people sign in to accounts on it
+  forBuilders: boolean;      // its users set up accounts, keys, billing or agent definitions for what they build
+  inYourProcess: boolean;    // runs inside a process the customer operates
+  callsYourCode: boolean;    // runs code, records or tools the customer supplies (inversion of control)
+  calledByYourCode: boolean; // the customer's code calls it
+  othersBuildOnIt: boolean;  // third parties build their own products on it
+  soldToSegment: boolean;    // offered, priced or marketed to a named group of customers
+  modeOfApp: boolean;        // reached as a tab or mode inside another app
+  abilityOf: boolean;        // it is something another system can do, not a system of its own
+};
+type P = [string, string, (f: Off) => boolean][];
+const mk = (id: string, label: string, form: Term<Off>["form"], meaning: string, sources: string[], props: P, predicts?: Record<string, Relation>): Term<Off> =>
+  ({ id, label, level: "offering", kind: "role", form, meaning, sources, predicts, props: props.map(([pid, says, check]) => ({ id: pid, says, check })) });
+export const OFF: Term<Off>[] = [
+  mk("model", "model", "word", "A learned model: what it does comes from parameters fitted to data. Claude is one; Mentura is to be one (Torian 07:14Z).", ["ML usage; Anthropic S-1 'Claude models'"],
+    [["MO1", "learned parameters", (f) => f.learned], ["MO2", "not an app people open", (f) => !f.clientApp]], { app: "disjoint", console: "disjoint", framework: "disjoint" }),
+  mk("app", "app", "word", "A program people open and work in, with an account. The same app can run on several surfaces (web, desktop, mobile).", ["general usage"],
+    [["AP1", "a client people open", (f) => f.clientApp], ["AP2", "accounts", (f) => f.accounts]], { console: "has_a_kind", model: "disjoint" }),
+  mk("console", "console", "word", "An app for builders: hosted, with accounts, where they manage keys, billing and agent definitions for what they build.", ["platform.claude.com usage (Claude Console)"],
+    [["AP1", "a client people open", (f) => f.clientApp], ["AP2", "accounts", (f) => f.accounts], ["CO1", "hosted", (f) => f.hostedService], ["CO2", "for builders", (f) => f.forBuilders]], { app: "is_a", library: "disjoint" }),
+  mk("mode", "mode (of an app)", "phrase", "A tab or mode reached inside another app, such as Code or Cowork in the Claude desktop app.", ["code.claude.com/docs/en/desktop"],
+    [["MD1", "reached inside another app", (f) => f.modeOfApp], ["MD2", "not an app of its own", (f) => !f.clientApp]], { product: "overlap", app: "disjoint" }),
+  mk("product", "product", "word", "An offering sold to a named group of customers and set apart from its siblings by what it can do. A product can be an app, a mode, a model or a library.", ["Product Anatomy Matrix usage (EE-011)"],
+    [["PR1", "sold to a segment", (f) => f.soldToSegment], ["PR2", "not merely an ability of another system", (f) => !f.abilityOf]], { capability: "disjoint", mode: "overlap", app: "overlap" }),
+  mk("capability", "capability", "word", "Something a system can do, not a system or product of its own. Precog, per Torian 07:14Z.", ["capabilities.json usage (has-capability)"],
+    [["CA1", "an ability of another system", (f) => f.abilityOf], ["CA2", "not an app", (f) => !f.clientApp], ["CA3", "not sold on its own", (f) => !f.soldToSegment]], { product: "disjoint" }),
+  mk("library", "library", "word", "Software the customer's code calls, in the customer's process, that never calls the customer's code.", ["vocabulary.ts LB"],
+    [["LB1", "in your process", (f) => f.inYourProcess], ["LB2", "your code calls it", (f) => f.calledByYourCode], ["LB3", "never calls your code", (f) => !f.callsYourCode], ["LB4", "not a hosted service (added: the engine found a console could pass)", (f) => !f.hostedService]], { framework: "disjoint", console: "disjoint" }),
+  mk("framework", "framework", "word", "Software that runs the code, records or tools you plug in (inversion of control).", ["vocabulary.ts FW"],
+    [["FW3", "calls your code", (f) => f.callsYourCode], ["FW5", "not learned", (f) => !f.learned]], { library: "disjoint", model: "disjoint" }),
+  mk("platform", "platform", "word", "A hosted system with accounts that others build their products on.", ["vocabulary.ts PF"],
+    [["CO1", "hosted", (f) => f.hostedService], ["AP2", "accounts", (f) => f.accounts], ["PF3", "others build on it", (f) => f.othersBuildOnIt]], { console: "overlap" }),
+];
+const KEYS = ["learned", "clientApp", "hostedService", "accounts", "forBuilders", "inYourProcess", "callsYourCode", "calledByYourCode", "othersBuildOnIt", "soldToSegment", "modeOfApp", "abilityOf"] as const;
+type Ex = { id: string; owner: string; facts: Partial<Record<(typeof KEYS)[number], boolean>>; refs: string[]; note?: string };
+// Facts as the references state them. Anything not stated is false and listed in `note`.
+export const EXAMPLES: Ex[] = [
+  { id: "Claude (model family)", owner: "anthropic", facts: { learned: true, calledByYourCode: true, soldToSegment: true }, refs: ["anthropic-s-1-2026"] },
+  { id: "Claude app (web, desktop, mobile)", owner: "anthropic", facts: { clientApp: true, accounts: true, hostedService: true, soldToSegment: true }, refs: ["claude-docs-desktop"], note: "one account and one session list across claude.ai, desktop and the mobile apps" },
+  { id: "Chat (in the Claude app)", owner: "anthropic", facts: { modeOfApp: true, soldToSegment: true }, refs: ["claude-docs-desktop"] },
+  { id: "Cowork (in the Claude app)", owner: "anthropic", facts: { modeOfApp: true, soldToSegment: true, callsYourCode: true }, refs: ["claude-docs-desktop", "anthropic-s-1-2026"], note: "runs your skills and plugins" },
+  { id: "Claude Code (Code tab)", owner: "anthropic", facts: { modeOfApp: true, soldToSegment: true, callsYourCode: true }, refs: ["claude-docs-desktop"] },
+  { id: "Claude Code (CLI)", owner: "anthropic", facts: { clientApp: true, accounts: true, inYourProcess: true, callsYourCode: true, soldToSegment: true }, refs: ["claude-docs-desktop", "claude-docs-agent-sdk-overview"], note: "the same Claude Code also ships as its own terminal client, which reads the same settings files" },
+  { id: "Claude Console", owner: "anthropic", facts: { clientApp: true, accounts: true, hostedService: true, forBuilders: true, othersBuildOnIt: true }, refs: ["claude-docs-managed-agents"], note: "where builders hold API keys and define Managed Agents" },
+  { id: "Claude API (Developer Platform)", owner: "anthropic", facts: { hostedService: true, accounts: true, calledByYourCode: true, othersBuildOnIt: true, soldToSegment: true }, refs: ["anthropic-s-1-2026"] },
+  { id: "Claude Agent SDK", owner: "anthropic", facts: { inYourProcess: true, calledByYourCode: true, callsYourCode: true, othersBuildOnIt: true, soldToSegment: true }, refs: ["claude-docs-agent-sdk-overview"], note: "the docs call it a library, but it runs your hooks and tools, so by our tests it is a framework" },
+  { id: "Claude Managed Agents", owner: "anthropic", facts: { hostedService: true, accounts: true, calledByYourCode: true, callsYourCode: true, othersBuildOnIt: true, soldToSegment: true }, refs: ["claude-docs-agent-sdk-overview", "claude-docs-managed-agents"] },
+  { id: "Claude Duet", owner: "anthropic", facts: { clientApp: true, accounts: true, hostedService: true, soldToSegment: true }, refs: ["claude-2026-10-21-duet", "macrumors-2026-10-21-duet"], note: "a standalone app (iOS, Android) that is also on claude.ai, and uses the Claude account's memory, skills and connectors" },
+  { id: "Claude Tag", owner: "anthropic", facts: { hostedService: true, accounts: true, soldToSegment: true, callsYourCode: true }, refs: ["anthropic-2026-06-23-claude-tag"], note: "has no client of its own; it runs inside Slack" },
+  // Ours, as Torian described them at 07:14Z (designed unless stated).
+  { id: "Mentura (model)", owner: "moses-david", facts: { learned: true, calledByYourCode: true, soldToSegment: true }, refs: ["torian-2026-11-01-0714"], note: "designed; not built" },
+  { id: "Mentura app (web, desktop, mobile)", owner: "moses-david", facts: { clientApp: true, accounts: true, hostedService: true, soldToSegment: true }, refs: ["torian-2026-11-01-0714"], note: "designed" },
+  { id: "Mentura console (venture development platform)", owner: "moses-david", facts: { clientApp: true, accounts: true, hostedService: true, forBuilders: true, othersBuildOnIt: true, soldToSegment: true }, refs: ["torian-2026-11-01-0714"], note: "designed; 'builders' here are founders building ventures" },
+  { id: "Naive (as built)", owner: "moses-david", facts: { inYourProcess: true, callsYourCode: true, calledByYourCode: true, othersBuildOnIt: true, soldToSegment: true }, refs: ["framework-proof.json"], note: "runs on the user's machine; runs the records, modules and agent interactions the user customises" },
+  { id: "Precog", owner: "moses-david", facts: { abilityOf: true }, refs: ["torian-2026-11-01-0714"] },
+];
+if (import.meta.url === `file://${process.argv[1]}`) {
+  const cs: Off[] = []; for (let m = 0; m < 2 ** (KEYS.length + 1); m++) { const f = { confirmed: Boolean(m & 1) } as Off; KEYS.forEach((k, i) => { (f as any)[k] = Boolean(m & (2 << i)); }); cs.push(f); }
+  const sets = new Map(OFF.map((t) => [t.id, passSet(t, cs)]));
+  const valid = OFF.map((t) => ({ id: t.id, hash: freeze(t), problems: validTest(t, cs) }));
+  const preds: any[] = []; for (const a of OFF) for (const [o, w] of Object.entries(a.predicts ?? {})) { const g = relation(sets.get(a.id)!, sets.get(o)!); preds.push({ a: a.id, b: o, predicted: w, got: g, ok: g === w }); }
+  const base = Object.fromEntries(KEYS.map((k) => [k, false]));
+  const rows = EXAMPLES.map((e) => ({ ...e, terms: OFF.filter((t) => run(t, { confirmed: true, ...base, ...e.facts } as Off).pass).map((t) => t.id) }));
+  console.log(`== offering: ${cs.length} cases (exhaustive)`); for (const v of valid) console.log(`${v.id.padEnd(11)} ${v.hash} ${v.problems.length ? v.problems.join("; ") : "valid"}`);
+  for (const p of preds) console.log(`${p.a} ~ ${p.b}: predicted ${p.predicted}, got ${p.got} -> ${p.ok ? "confirmed" : "REFUTED"}`);
+  console.log(`${preds.filter((p) => p.ok).length}/${preds.length} predictions confirmed\n`);
+  for (const r of rows) console.log(`${r.id.padEnd(48)} ${r.terms.join(", ") || "(no term)"}`);
+  const fs = await import("node:fs"); fs.writeFileSync(new URL("./offering-run.json", import.meta.url), JSON.stringify({ ran: new Date().toISOString(), cases: cs.length, valid, predictions: preds, examples: rows }, null, 1));
+}
