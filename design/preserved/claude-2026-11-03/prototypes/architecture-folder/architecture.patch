+    [["BT1", "venture to industry", (f) => f.ventureToIndustry], ["CA1", "an outside body assigned the code", (f) => f.officialCode]],
+    { "belongs-to": "overlap" }),
+  L("depends-on@industry", "depends on", "Industry A depends on industry B when B's output is an input of A (an input-output table cell above zero). Loops are allowed.",
+    ["Leontief input-output model", "BEA input-output accounts"],
+    [["DI1", "industry to industry", (f) => f.industryToIndustry], ["DI2", "input flow", (f) => f.inputFlow]],
+    { supplies: "disjoint", "belongs-to": "disjoint" }),
+  L("supplies", "supplies", "Handoff #147: venture B supplies venture A's inputs. Venture level; never inherited from an industry dependency.",
+    ["Porter (1980)", "HANDOFF_GROK_VENTURE_RECORDS_AND_RELATIONSHIPS_2026-11-01"],
+    [["SP1", "venture to venture", (f) => f.ventureToVenture], ["DI2", "input flow", (f) => f.inputFlow]],
+    { "depends-on@industry": "disjoint", "belongs-to": "disjoint" }),
+];
+
+function cases<F extends Base>(keys: readonly string[], labels: string[], keep: (f: F) => boolean = () => true): F[] {
+  const out: F[] = [];
+  for (let m = 0; m < 2 ** (keys.length + 1); m++) {
+    const f = { confirmed: Boolean(m & 1), label: [...labels, undefined][m % (labels.length + 1)] } as F;
+    keys.forEach((k, i) => { (f as Record<string, unknown>)[k] = Boolean(m & (2 << i)); });
+    if (keep(f)) out.push(f);
+  }
+  return out;
+}
+export const groupingCases = () => cases<Grouping>(["groupsProducers", "groupsBuyers", "byProcess", "bySubstitutes", "byJob", "groupsGroupings", "extractsFromNature", "servicesOnly"], ["industry", "market"]);
+// an edge has exactly one endpoint kind
+export const linkCases = () => cases<Link>(["ventureToIndustry", "industryToIndustry", "ventureToVenture", "productPassesTest", "officialCode", "inputFlow", "shareKnown"], ["industry", "supplier"],
+  (f) => Number(f.ventureToIndustry) + Number(f.industryToIndustry) + Number(f.ventureToVenture) === 1);
+
+function runLevel<F extends Base>(name: string, vocab: Term<F>[], cs: F[]): [number, number] {
+  const sets = new Map(vocab.map((t) => [t.id, passSet(t, cs)])); let ok = 0, n = 0;
+  console.log(`\n== ${name}: ${cs.length} cases`);
+  for (const t of vocab) { const v = validTest(t, cs); console.log(`${t.id.padEnd(22)} ${freeze(t)} ${v.length ? v.join("; ") : "valid"}`); }
+  for (const a of vocab) for (const [o, w] of Object.entries(a.predicts ?? {})) {
+    n++; const g = relation(sets.get(a.id)!, sets.get(o)!); if (g === w) ok++;
+    console.log(`${a.id} ~ ${o}: predicted ${w}, got ${g} -> ${g === w ? "confirmed" : "REFUTED"}`);
+  }
+  return [ok, n];
+}
+
+if (import.meta.url === `file://${process.argv[1]}`) {
+  const [a, b] = runLevel("grouping", GROUPING_VOCAB, groupingCases());
+  const [c, d] = runLevel("link", LINK_VOCAB, linkCases());
+  console.log(`\n${a + c}/${b + d} predictions confirmed`);
+  const base: Link = { confirmed: true, label: undefined, ventureToIndustry: false, industryToIndustry: false, ventureToVenture: false, productPassesTest: false, officialCode: false, inputFlow: false, shareKnown: false } as Link;
+  const ex: [string, Partial<Link>][] = [
+    ["Anthropic -> SIC 7372 prepackaged software (S-1 cover)", { ventureToIndustry: true, officialCode: true }],
+    ["Anthropic -> software publishing (Claude Code passes)", { ventureToIndustry: true, productPassesTest: true }],
+    ["Anthropic -> AI model provision, share unknown", { ventureToIndustry: true, productPassesTest: true }],
+    ["mining -> machinery manufacturing (input flow)", { industryToIndustry: true, inputFlow: true }],
+    ["Amazon -> Anthropic compute (S-1 risk factors)", { ventureToVenture: true, inputFlow: true }],
+  ];
+  console.log("\n== examples");
+  for (const [name, facts] of ex) console.log(`${name.padEnd(58)} ${LINK_VOCAB.filter((t) => run(t, { ...base, ...facts } as Link).pass).map((t) => t.id).join(", ") || "(no term)"}`);
+}
