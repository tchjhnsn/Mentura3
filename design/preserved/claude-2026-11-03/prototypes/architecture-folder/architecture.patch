@@ -0,0 +1,106 @@
+// Query the glossary any way (proposed, 2026-10-31). Torian: fetch one entry, find terms by first letter,
+// by which vowels they hold or in what order, by similar meaning, or by any other query.
+//
+// The records stay JSON (the source of truth). JSON holds data; it does not answer queries. So this loads
+// every entry into SQLite (built into Node, node:sqlite) in memory and adds three functions, which makes any
+// SQL query possible over every field:
+//   regexp(pattern, text)   so  label REGEXP '^b'  works
+//   vowels(text)            the vowels of a word in order: vowels('threshold guardian') = 'eouaia'
+//   similar(a, b)           0..1, how close two texts are in meaning (lexical TF-IDF cosine for now; see note)
+//
+//   node glossary-query.ts get <id>
+//   node glossary-query.ts similar "<a definition in your words>"
+//   node glossary-query.ts scope <function>          the glossary as that function reads it (local meaning first)
+//   node glossary-query.ts sql "<any SELECT>"         tables: terms(id,label,level,meaning,form,status,source,props)
+//                                                             relations(a,b,relation)
+// Note: similar() is word overlap weighted by rarity, which finds "a part that applies rules" -> engine but
+// not synonyms it has never seen. True semantic search needs embeddings: a derived index (a view, never a
+// record) rebuilt when a term's hash changes, from a local or hosted embedding model. Not built yet.
+
+import { DatabaseSync } from "node:sqlite";
+import { readFileSync } from "node:fs";
+import { passSet, relation, type Base, type Term } from "/home/user/ee-build/schema/terms/engine.ts";
+import { VOCAB, elementCases } from "./vocabulary.ts";
+import { REQ_VOCAB, statementCases } from "./requirements-vocab.ts";
+import { PROBLEM_VOCAB, problemCases } from "./problem-vocab.ts";
+import { GEN_VOCAB, modCases } from "./generator-vocab.ts";
+import { ENGINE, KERNEL } from "./terms.ts";
+import { LEVELS as ORG_LEVELS } from "./org-vocab.ts";
+import { REFERENCE_VOCAB, collectionCases, METHOD_VOCAB, methodCases } from "./glossary-vocab.ts";
+import { DRAFT_VOCAB, designCases } from "./venture-draft-vocab.ts";
+import { DATA_VOCAB, dataCases } from "./artifact-vocab.ts";
+
+type Row = { id: string; label: string; level: string; meaning: string; form: string; status: string; source: string; props: string; scope: string };
+const rows: Row[] = []; const rels: [string, string, string][] = [];
+for (const t of JSON.parse(readFileSync("/home/user/ee-build/schema/terms/admitted.json", "utf8")).terms) {
+  rows.push({ id: t.id, label: t.label, level: t.level, meaning: t.meaning, form: t.form ?? "", status: t.status, source: "schema/terms/admitted.json", props: JSON.stringify(t.properties), scope: "venture" });
+  for (const [b, r] of Object.entries(t.relations)) rels.push([t.id, b, r as string]);
+}
+function add<F extends Base>(file: string, terms: Term<F>[], cases?: F[]) {
+  for (const t of terms) if (!rows.some((r) => r.id === t.id && r.level === t.level))
+    rows.push({ id: t.id, label: t.label, level: t.level, meaning: t.meaning, form: t.form ?? "", status: "proposed (sandbox)", source: file, props: JSON.stringify(t.props.map((p) => ({ id: p.id, says: p.says }))), scope: (t as { scope?: string }).scope ?? "venture" });
+  if (cases) { const s = new Map(terms.map((t) => [t.id, passSet(t, cases)])); for (const a of terms) for (const b of terms) if (a !== b) rels.push([a.id, b.id, relation(s.get(a.id)!, s.get(b.id)!)]); }
+}
+add("vocabulary.ts", VOCAB as Term<Base>[], elementCases()); add("requirements-vocab.ts", REQ_VOCAB as Term<Base>[], statementCases());
+add("problem-vocab.ts", PROBLEM_VOCAB as Term<Base>[], problemCases()); add("generator-vocab.ts", GEN_VOCAB.filter((t) => t.id !== "engine") as Term<Base>[], modCases());
+add("terms.ts", [KERNEL, ENGINE] as unknown as Term<Base>[]);
+for (const l of ORG_LEVELS) add("org-vocab.ts", l.terms as unknown as Term<Base>[], l.cases() as Base[]);
+add("glossary-vocab.ts", REFERENCE_VOCAB as unknown as Term<Base>[], collectionCases() as Base[]); add("glossary-vocab.ts", METHOD_VOCAB as unknown as Term<Base>[], methodCases() as Base[]);
+add("venture-draft-vocab.ts", DRAFT_VOCAB as unknown as Term<Base>[], designCases() as Base[]);
+add("artifact-vocab.ts", DATA_VOCAB as unknown as Term<Base>[], dataCases() as Base[]);
+// docs/ontology.json (EE-014): the repo's nouns with their standards. Loaded as entries at level "noun" so one
+// glossary answers every query; conflicts with engine terms show up in the `conflicts` command (issue #143).
+const ONTOLOGY = process.env.EE_REPO ?? "/home/user/ee-build";
+try {
+  for (const x of JSON.parse(readFileSync(`${ONTOLOGY}/docs/ontology.json`, "utf8")).nouns)
+    rows.push({ id: `noun:${x.noun.toLowerCase().replace(/\s+/g, "-")}`, label: x.noun, level: `noun/${x.level}`, meaning: x.meaning, form: x.noun.includes(" ") ? "compound" : "word", status: `ontology ${x.status}`, source: "docs/ontology.json", props: JSON.stringify([{ id: "standard", says: x.standard ?? "" }]), scope: "venture" });
+} catch { /* repo without an ontology */ }
+const USAGE: Record<string, { use: string; avoid: string; instead: Record<string, string> }> = JSON.parse(readFileSync(new URL("./usage.json", import.meta.url), "utf8"));
+
+// similar(): TF-IDF over label + meaning + property sentences
+const words = (s: string) => s.toLowerCase().match(/[a-z]+/g)?.filter((w) => w.length > 2 && !STOP.has(w)).map((w) => w.replace(/(ing|es|s|ed)$/, "")) ?? [];
+const STOP = new Set("the and that its are for not one with from has have who what this all any can into but own more than other others".split(" "));
+const docText = (r: Row) => `${r.label} ${r.meaning} ${JSON.parse(r.props).map((p: { says: string }) => p.says).join(" ")}`;
+const df = new Map<string, number>(); for (const r of rows) for (const w of new Set(words(docText(r)))) df.set(w, (df.get(w) ?? 0) + 1);
+const vec = (s: string) => { const v = new Map<string, number>(); for (const w of words(s)) v.set(w, (v.get(w) ?? 0) + Math.log((rows.length + 1) / ((df.get(w) ?? 0) + 1)) + 1); return v; };
+const cos = (a: Map<string, number>, b: Map<string, number>) => { let d = 0, na = 0, nb = 0; for (const [k, x] of a) { na += x * x; d += x * (b.get(k) ?? 0); } for (const x of b.values()) nb += x * x; return na && nb ? d / Math.sqrt(na * nb) : 0; };
+
+const db = new DatabaseSync(":memory:");
+db.function("regexp", { deterministic: true }, (p, s) => (new RegExp(String(p), "i").test(String(s ?? "")) ? 1 : 0));
+db.function("vowels", { deterministic: true }, (s) => String(s ?? "").toLowerCase().replace(/[^aeiou]/g, ""));
+db.function("similar", { deterministic: true }, (a, b) => Math.round(cos(vec(String(a)), vec(String(b))) * 1000) / 1000);
+db.exec("CREATE TABLE terms (id, label, level, meaning, form, status, source, props, scope); CREATE TABLE relations (a, b, relation);");
+const ins = db.prepare("INSERT INTO terms VALUES (?,?,?,?,?,?,?,?,?)"); for (const r of rows) ins.run(r.id, r.label, r.level, r.meaning, r.form, r.status, r.source, r.props, r.scope);
+const rel = db.prepare("INSERT INTO relations VALUES (?,?,?)"); for (const r of rels) rel.run(...r);
+db.exec("CREATE VIEW docs AS SELECT *, label || ' ' || meaning || ' ' || props AS text FROM terms");
+
+export const query = (sql: string, ...p: (string | number)[]) => db.prepare(sql).all(...p);
+
+if (import.meta.url === `file://${process.argv[1]}`) {
+  const [cmd, arg] = process.argv.slice(2);
+  const show = (r: unknown[]) => console.log(r.length ? r.map((x) => JSON.stringify(x)).join("\n") : "(none)");
+  if (cmd === "get") show(query("SELECT * FROM terms WHERE id = ?", arg));
+  else if (cmd === "similar") show(query("SELECT id, label, level, similar(?, text) AS score FROM docs ORDER BY score DESC LIMIT 5", arg));
+  else if (cmd === "sql") show(query(arg));
+  // read the glossary as one function reads it: its own senses first, then venture-wide terms it has not redefined
+  else if (cmd === "scope") show(query("SELECT label, id, scope, meaning FROM terms t WHERE scope = ? OR (scope = 'venture' AND NOT EXISTS (SELECT 1 FROM terms u WHERE u.label = t.label AND u.scope = ?)) ORDER BY scope != ?, label", arg, arg, arg));
+  // the agent-readable glossary: a generated view (records + usage.json), never edited by hand
+  else if (cmd === "agent") {
+    const out = ["# Glossary (agent-readable view)", "", "Generated by `node glossary-query.ts agent` from the term records and usage.json. Do not edit by hand.", "", "How to use: write with these labels exactly. Before using a word that looks like a term, `get` it; if its meaning is not what you mean, use the term named under Instead. A term with no usage note is not yet safe to use without reading its properties.", ""];
+    let missing = 0;
+    for (const r of [...rows].sort((a, b) => a.label.localeCompare(b.label))) {
+      const u = USAGE[r.id]; if (!u) missing++;
+      const near = rels.filter(([a, , x]) => a === r.id && x !== "disjoint" && x !== "inconclusive").map(([, b, x]) => `${b} (${x})`).slice(0, 6).join(", ");
+      out.push(`## ${r.label}`, "", `${r.meaning}`, "", `- id: \`${r.id}\`, level: ${r.level}, scope: ${r.scope}, status: ${r.status}`,
+        `- Must hold: ${JSON.parse(r.props).map((p: { id: string; says: string }) => `${p.id} ${p.says}`).join("; ")}`,
+        u ? `- Use for: ${u.use}` : "- Use for: (no usage note yet)", ...(u ? [`- Not for: ${u.avoid}`] : []),
+        ...(u && Object.keys(u.instead).length ? [`- Instead: ${Object.entries(u.instead).map(([w, t]) => `${w} -> ${t}`).join("; ")}`] : []),
+        ...(near ? [`- Related: ${near}`] : []), "");
+    }
+    out.push(`---`, `${rows.length} terms; ${rows.length - missing} with usage notes, ${missing} without.`);
+    console.log(out.join("\n"));
+  }
+  // same label, same scope, different meaning: a conflict the engine must settle (issue #143)
+  else if (cmd === "conflicts") show(query("SELECT a.label, a.id AS a, a.source AS a_source, b.id AS b, b.source AS b_source FROM terms a JOIN terms b ON lower(a.label) = lower(b.label) AND a.scope = b.scope AND a.id < b.id AND a.meaning != b.meaning AND a.status NOT LIKE '%retired' AND b.status NOT LIKE '%retired' ORDER BY a.label"));
+  else console.log(`${rows.length} terms, ${rels.length} relations. Usage: get <id> | similar "<text>" | sql "<SELECT ...>"`);
+}
diff --git a/project-files/naive-design/prototypes/architecture/glossary-vocab.ts b/project-files/naive-design/prototypes/architecture/glossary-vocab.ts
