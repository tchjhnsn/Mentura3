+// Knowledge representation siblings of "script" and "schema" (Torian 2026-11-01 07:59Z, from a Google answer).
+// Blind spot tested: in AI, "script" and "schema" (Schank and Abelson; Bartlett) are knowledge structures, while in
+// Naive a schema is a JSON Schema and a script is a program file. Each sense is its own term. Level: representation
+// Run 1: 19/20; refuted program-script ~ production-system overlap (got has_a_kind, the mirror of the confirmed is_a). Fixed the prediction.
+// (a way of writing knowledge or code down). Exhaustive cross-run.   node --experimental-strip-types representation-vocab.ts
+import { freeze, passSet, relation, validTest, type Base, type Relation, type Term } from "/home/user/ee-build/schema/terms/engine.ts";
+export type Rep = Base & {
+  worldKnowledge: boolean;  // represents what an agent knows or expects about the world
+  slots: boolean;           // named slots that fillers occupy
+  defaults: boolean;        // slots carry expected values until filled
+  stereotyped: boolean;     // describes a typical situation, object or event, not one particular case
+  eventSequence: boolean;   // its parts are ordered events
+  nodesEdges: boolean;      // concepts as nodes joined by labelled links
+  primitives: boolean;      // meanings are composed from a small fixed set of primitive acts
+  conditionAction: boolean; // if-then rules that fire on a working memory
+  constrains: boolean;      // decides which instances are valid
+  executable: boolean;      // a program a machine runs
+};
+type P = [string, string, (f: Rep) => boolean][];
+const T = (id: string, label: string, meaning: string, sources: string[], props: P, predicts?: Record<string, Relation>): Term<Rep> =>
+  ({ id, label, level: "representation", kind: "kind", form: id.includes("-") ? "compound" : "word", meaning, sources, predicts, props: props.map(([pid, says, check]) => ({ id: pid, says, check })) } as Term<Rep>);
+const KN: P = [["KN1", "represents world knowledge", (f) => f.worldKnowledge], ["KN2", "not a program", (f) => !f.executable]];
+export const REP_VOCAB: Term<Rep>[] = [
+  T("data-schema", "schema (data schema)", "Naive's sense: a definition of the shape a record must have, used to accept or reject records. JSON Schema in Naive.", ["json-schema-2020-12"],
+    [["DS1", "decides which instances are valid", (f) => f.constrains], ["DS2", "named slots", (f) => f.slots], ["DS3", "not a program", (f) => !f.executable]],
+    { "cognitive-schema": "overlap", frame: "overlap", "program-script": "disjoint", "production-system": "disjoint" }),
+  T("cognitive-schema", "schema (cognitive schema)", "A general structure of what an agent knows about a kind of thing, with slots and default expectations.", ["bartlett-1932-remembering", "torian-google-2026-11-01-0759"],
+    [...KN, ["SL1", "named slots", (f) => f.slots], ["DF1", "defaults", (f) => f.defaults]],
+    { frame: "has_a_kind", script: "has_a_kind", "data-schema": "overlap" }),
+  T("frame", "frame", "Minsky: a structure for a stereotyped situation; fixed top levels, slots filled by instances, defaults until filled. Naive's frame record (packages/*/frames) is one.", ["minsky-1974-frames"],
+    [...KN, ["SL1", "named slots", (f) => f.slots], ["DF1", "defaults", (f) => f.defaults], ["FR1", "stereotyped", (f) => f.stereotyped]],
+    { "cognitive-schema": "is_a", script: "has_a_kind", "semantic-network": "overlap" }),
+  T("script", "script (knowledge script)", "Schank and Abelson: a frame for a stereotyped sequence of events (the restaurant script).", ["schank-abelson-1977-scripts"],
+    [...KN, ["SL1", "named slots", (f) => f.slots], ["DF1", "defaults", (f) => f.defaults], ["FR1", "stereotyped", (f) => f.stereotyped], ["SC1", "ordered events", (f) => f.eventSequence]],
+    { frame: "is_a", "program-script": "disjoint", "conceptual-dependency": "overlap" }),
+  T("program-script", "script (program)", "Naive's sense: a program file an interpreter runs (node schema/check-ventures.mjs).", ["general usage"],
+    [["PS1", "a program", (f) => f.executable]], { script: "disjoint", "data-schema": "disjoint", "production-system": "has_a_kind" }),
+  T("semantic-network", "semantic network", "Quillian: concepts as nodes joined by labelled links (is-a, has-a).", ["quillian-1968-semantic-memory"],
+    [...KN, ["SN1", "nodes and labelled links", (f) => f.nodesEdges]], { frame: "overlap" }),
+  T("conceptual-dependency", "conceptual dependency", "Schank: sentence meaning composed from a small fixed set of primitive acts (PTRANS, ATRANS, MTRANS...), not from verbs.", ["schank-1972-cd"],
+    [...KN, ["CD1", "primitive acts", (f) => f.primitives]], { script: "overlap" }),
+  T("production-system", "production system", "Newell and Simon: if-then rules that fire on a working memory; procedural knowledge that runs.", ["newell-simon-1972-hps"],
+    [["PR1", "condition-action rules", (f) => f.conditionAction], ["PR2", "runs", (f) => f.executable]], { "data-schema": "disjoint", "program-script": "is_a" }),
+];
+const KEYS = ["worldKnowledge", "slots", "defaults", "stereotyped", "eventSequence", "nodesEdges", "primitives", "conditionAction", "constrains", "executable"] as const;
+export function repCases(): Rep[] { const out: Rep[] = []; for (let m = 0; m < 2 ** (KEYS.length + 1); m++) { const f = { confirmed: Boolean(m & 1), label: ["schema", "script", undefined][m % 3] } as Rep; KEYS.forEach((k, i) => { (f as any)[k] = Boolean(m & (2 << i)); }); out.push(f); } return out; }
+if (import.meta.url === `file://${process.argv[1]}`) {
+  const cs = repCases(); const sets = new Map(REP_VOCAB.map((t) => [t.id, passSet(t, cs)])); let ok = 0, n = 0;
+  console.log(`${cs.length} cases`);
+  for (const t of REP_VOCAB) { const v = validTest(t, cs); console.log(`${t.id.padEnd(22)} ${freeze(t)} ${v.length ? v.join("; ") : "valid"}`); }
+  for (const a of REP_VOCAB) for (const [o, w] of Object.entries(a.predicts ?? {})) { n++; const g = relation(sets.get(a.id)!, sets.get(o)!); if (g === w) ok++; console.log(`${a.id} ~ ${o}: predicted ${w}, got ${g} -> ${g === w ? "confirmed" : "REFUTED"}`); }
+  console.log(`${ok}/${n} predictions confirmed`);
+}
