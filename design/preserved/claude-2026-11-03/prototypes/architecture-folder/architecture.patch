diff --git a/project-files/naive-design/prototypes/architecture/RL.lean b/project-files/naive-design/prototypes/architecture/RL.lean
new file mode 100644
index 0000000..2838097
--- /dev/null
+++ b/project-files/naive-design/prototypes/architecture/RL.lean
@@ -0,0 +1,71 @@
+/- Reinforcement-learning methods and the records gate (2026-11-01). Mirrors rl-vocab.ts and gate.ts (U3).
+   Core Lean only. Written in the AI-labs thread; built by the phases thread. -/
+namespace Naive.RL
+
+structure Method where
+  usesReward : Bool
+  onPolicy : Bool
+  rewardHuman : Bool
+  rewardAI : Bool
+  rewardVerifier : Bool
+  learnedRewardModel : Bool
+  critic : Bool
+  groupBaseline : Bool
+  scoringRule : Bool
+  preferencePairs : Bool
+
+def IsRL (m : Method) : Prop := m.usesReward = true
+def RLHF (m : Method) : Prop := IsRL m ∧ m.rewardHuman = true ∧ m.learnedRewardModel = true
+def RLVR (m : Method) : Prop := IsRL m ∧ m.rewardVerifier = true ∧ m.learnedRewardModel = false
+def PPO (m : Method) : Prop := IsRL m ∧ m.onPolicy = true ∧ m.critic = true
+def GRPO (m : Method) : Prop := IsRL m ∧ m.onPolicy = true ∧ m.critic = false ∧ m.groupBaseline = true
+def DPO (m : Method) : Prop := m.preferencePairs = true ∧ m.usesReward = false ∧ m.onPolicy = false
+def ScoringRuleRL (m : Method) : Prop := IsRL m ∧ m.scoringRule = true
+
+theorem rlvr_is_rl {m : Method} (h : RLVR m) : IsRL m := h.1
+
+/-- Verifiable rewards and a learned reward model exclude each other (DeepSeek-R1's choice for reasoning). -/
+theorem rlvr_not_rlhf {m : Method} (hv : RLVR m) (hh : RLHF m) : False := by
+  have a := hv.2.2
+  have b := hh.2.2
+  rw [a] at b
+  exact Bool.noConfusion b
+
+theorem ppo_not_grpo {m : Method} (hp : PPO m) (hg : GRPO m) : False := by
+  have a := hp.2.2
+  have b := hg.2.2.1
+  rw [a] at b
+  exact Bool.noConfusion b
+
+/-- DPO is not reinforcement learning by this definition. -/
+theorem dpo_not_rl {m : Method} (hd : DPO m) (hr : IsRL m) : False := by
+  have a := hd.2.1
+  have b : m.usesReward = true := hr
+  rw [a] at b
+  exact Bool.noConfusion b
+
+/-- Our P2: verifiable rewards with a scoring rule is possible (witness). -/
+theorem p2_exists : ∃ m : Method, RLVR m ∧ ScoringRuleRL m ∧ GRPO m :=
+  ⟨⟨true, true, false, false, true, false, false, true, true, false⟩, ⟨rfl, rfl, rfl⟩, ⟨rfl, rfl⟩, ⟨rfl, rfl, rfl, rfl⟩⟩
+
+-- The update theorem U3 from gate.ts: a claim is admitted only from a read, non-index source with a locator.
+structure Claim where
+  sourceRead : Bool
+  isIndex : Bool
+  hasLocator : Bool
+
+def Admitted (c : Claim) : Prop := c.sourceRead = true ∧ c.isIndex = false ∧ c.hasLocator = true
+
+theorem snippet_not_admitted {c : Claim} (h : c.sourceRead = false) : ¬ Admitted c := by
+  intro ha
+  have b := ha.1
+  rw [h] at b
+  exact Bool.noConfusion b
+
+theorem index_not_admitted {c : Claim} (h : c.isIndex = true) : ¬ Admitted c := by
+  intro ha
+  have b := ha.2.1
+  rw [h] at b
+  exact Bool.noConfusion b
+
+end Naive.RL
