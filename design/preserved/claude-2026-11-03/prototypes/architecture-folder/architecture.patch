--- /dev/null
+++ b/project-files/naive-design/prototypes/architecture/position-blind.ts
@@ -0,0 +1,46 @@
+// Is "engine" behaviour only? (2026-10-31). The term engine already requires every term to be label-blind:
+// renaming a thing never changes its verdict. This adds the same test for position: change only where a
+// module sits (how many import it, how many it imports, whether it is in a cycle) and see whether the
+// verdict moves. Exhaustive over a grid, so "never moves" means never, not "not in a sample".
+//
+//   behavioural  position never changes the verdict
+//   positional   behaviour never changes the verdict
+//   mixed        both do
+//
+//   node position-blind.ts
+
+import { passSet, relation, run, type Term } from "/home/user/ee-build/schema/terms/engine.ts";
+import { ENGINE, KERNEL, type Component } from "./terms.ts";
+
+const E6: Term<Component> = { ...ENGINE, id: "engine+E6", props: [...ENGINE.props, { id: "E6", says: "used by at least one part", check: (f) => f.fanIn >= 1 }] };
+const PARENT: Term<Component> = { id: "parent", label: "parent", level: "component", kind: "role", form: "word", meaning: "Something at least one part is built on.", sources: ["graph theory"], props: [{ id: "PA1", says: "at least one part imports it", check: (f) => f.fanIn >= 1 }] };
+
+type Beh = Omit<Component, "fanIn" | "fanOut" | "inCycle">;
+const allBehaviours: Beh[] = []; const positions: Pick<Component, "fanIn" | "fanOut" | "inCycle">[] = [];
+for (let m = 0; m < 2 ** 8; m++) {
+  const b = (i: number) => Boolean(m & (1 << i));
+  allBehaviours.push({ confirmed: b(0), rulesAsInput: b(1), verdictWithReasons: b(2), domainRefs: b(3) ? 1 : 0, clockOrRandom: b(4), tested: b(5), effects: b(6) ? 1 : 0, lines: b(7) ? 500 : 100 });
+}
+for (let fanIn = 0; fanIn <= 4; fanIn++) for (let fanOut = 0; fanOut <= 3; fanOut++) for (const inCycle of [false, true]) positions.push({ fanIn, fanOut, inCycle });
+
+function classify(t: Term<Component>) {
+  // only confirmed facts: P7 already makes every term fail on unconfirmed facts, which is about evidence, not behaviour
+  const behaviours = allBehaviours.filter((b) => b.confirmed);
+  let movedByPosition = 0, movedByBehaviour = 0, example = "";
+  for (const b of behaviours) { const v = new Set(positions.map((p) => run(t, { ...b, ...p }).pass)); if (v.size > 1) { movedByPosition++; example ||= `same behaviour, different position: ${JSON.stringify(b)}`; } }
+  for (const p of positions) { const v = new Set(behaviours.map((b) => run(t, { ...b, ...p }).pass)); if (v.size > 1) movedByBehaviour++; }
+  const kind = movedByPosition === 0 ? "behavioural" : movedByBehaviour === 0 ? "positional" : "mixed";
+  return { kind, movedByPosition, movedByBehaviour, example };
+}
+
+const behaviours = allBehaviours.filter((b) => b.confirmed);
+const cases = allBehaviours.flatMap((b) => positions.map((p) => ({ ...b, ...p })));
+console.log(`${cases.length} cases (${allBehaviours.length} behaviours x ${positions.length} positions; ${behaviours.length} confirmed behaviours classified)\n`);
+for (const t of [ENGINE, E6, KERNEL, PARENT]) {
+  const c = classify(t);
+  console.log(`${t.id.padEnd(10)} ${c.kind.padEnd(12)} behaviours whose verdict position moves: ${c.movedByPosition}/${behaviours.length}; positions where behaviour matters: ${c.movedByBehaviour}/${positions.length}`);
+}
+const s = (t: Term<Component>) => passSet(t, cases);
+console.log(`\nengine ~ parent: ${relation(s(ENGINE), s(PARENT))}   (is_a would mean every engine is a parent)`);
+console.log(`engine+E6 ~ parent: ${relation(s(E6), s(PARENT))}`);
+console.log(`kernel ~ parent: ${relation(s(KERNEL), s(PARENT))}`);
