diff --git a/project-files/naive-design/prototypes/architecture/rl-vocab.ts b/project-files/naive-design/prototypes/architecture/rl-vocab.ts
new file mode 100644
index 0000000..0791a8a
--- /dev/null
+++ b/project-files/naive-design/prototypes/architecture/rl-vocab.ts
@@ -0,0 +1,114 @@
+// Reinforcement learning methods (Torian, 2026-11-01 04:57Z: glossary of RL terms, graph their relationships, choose
+// our pipelines). One level: a training method. Exhaustive over the facts. The engine's relations ARE the graph.
+//
+//   node rl-vocab.ts
+
+import { freeze, passSet, relation, run, validTest, type Base, type Relation, type Term } from "/home/user/ee-build/schema/terms/engine.ts";
+
+type P<F> = [string, string, (f: F) => boolean][];
+const mk = <F extends Base>(level: string) => (id: string, label: string, meaning: string, sources: string[], props: P<F>, predicts?: Record<string, Relation>): Term<F> =>
+  ({ id, label, level, kind: "role", form: "word", meaning, sources, predicts, props: props.map(([pid, says, check]) => ({ id: pid, says, check })) });
+
+export type Method = Base & {
+  usesReward: boolean;          // the model is updated to raise a scalar reward
+  onPolicy: boolean;            // it samples from the current model during training
+  rewardHuman: boolean;         // the reward comes from human judgments (labels, rankings)
+  rewardAI: boolean;            // the reward comes from an AI judge applying written principles
+  rewardVerifier: boolean;      // the reward comes from an automatic check of correctness (tests, answers, rules)
+  learnedRewardModel: boolean;  // a trained reward model scores outputs
+  critic: boolean;              // a learned value function estimates advantages
+  groupBaseline: boolean;       // the baseline is the mean reward of a group of samples for the same prompt
+  stepLevel: boolean;           // the reward is given per reasoning step, not only for the outcome
+  scoringRule: boolean;         // the reward is a proper scoring rule on stated probabilities (honest odds pay best)
+  preferencePairs: boolean;     // it trains directly on preferred vs rejected pairs
+  demonstrations: boolean;      // it trains on examples of the desired output
+};
+const M = mk<Method>("training method");
+const RL: P<Method>[number] = ["RL1", "updates to raise a reward", (f) => f.usesReward];
+const ON: P<Method>[number] = ["ON1", "samples from the current model", (f) => f.onPolicy];
+export const RL_VOCAB: Term<Method>[] = [
+  M("reinforcement-learning", "reinforcement learning", "Learning by acting and being updated to raise a reward.",
+    ["Sutton and Barto, Reinforcement Learning: An Introduction (2018)", "Wikipedia: Reinforcement learning (index)"],
+    [RL],
+    { rlhf: "has_a_kind", rlaif: "has_a_kind", rlvr: "has_a_kind", ppo: "has_a_kind", grpo: "has_a_kind", "offline-rl": "has_a_kind", dpo: "disjoint", "imitation-learning": "disjoint" }),
+  M("rlhf", "RLHF (reinforcement learning from human feedback)", "Train a reward model on human comparisons of outputs, then optimise the model against it.",
+    ["Ouyang et al., InstructGPT, arXiv 2203.02155 (2022)"],
+    [RL, ["HF1", "reward from human judgments", (f) => f.rewardHuman], ["RM1", "a learned reward model scores outputs", (f) => f.learnedRewardModel]],
+    { "reinforcement-learning": "is_a", rlvr: "disjoint", rlaif: "overlap" }),
+  M("rlaif", "RLAIF / Constitutional AI", "Train a preference model on AI comparisons judged against written principles, then use it as the RL reward.",
+    ["Bai et al., Constitutional AI, arXiv 2212.08073 (2022)"],
+    [RL, ["AF1", "reward from an AI judge applying principles", (f) => f.rewardAI], ["RM1", "a learned reward model scores outputs", (f) => f.learnedRewardModel]],
+    { "reinforcement-learning": "is_a", rlhf: "overlap", rlvr: "disjoint" }),
+  M("rlvr", "RLVR (RL with verifiable rewards)", "The reward is an automatic check of correctness (answers, tests, rules), with no learned reward model. DeepSeek-R1's rule-based rewards are this.",
+    ["Lambert et al., Tülu 3, arXiv 2411.15124 (2024)", "DeepSeek-AI, DeepSeek-R1, arXiv 2501.12948 (2025)"],
+    [RL, ["VR1", "reward from an automatic check", (f) => f.rewardVerifier], ["VR2", "no learned reward model", (f) => !f.learnedRewardModel]],
+    { "reinforcement-learning": "is_a", rlhf: "disjoint", rlaif: "disjoint", "process-reward": "overlap", "scoring-rule-rl": "overlap" }),
+  M("ppo", "PPO", "On-policy RL with a learned critic (value function) estimating advantages; the optimiser InstructGPT used.",
+    ["Schulman et al., PPO, arXiv 1707.06347 (2017)"],
+    [RL, ON, ["CR1", "learned critic", (f) => f.critic]],
+    { "reinforcement-learning": "is_a", grpo: "disjoint", "offline-rl": "disjoint" }),
+  M("grpo", "GRPO", "On-policy RL with no critic: each sample's advantage is its reward against the group of samples for the same prompt.",
+    ["Shao et al., DeepSeekMath, arXiv 2402.03300 (2024): 'GRPO foregoes the critic model'"],
+    [RL, ON, ["CR0", "no critic", (f) => !f.critic], ["GB1", "group baseline", (f) => f.groupBaseline]],
+    { "reinforcement-learning": "is_a", ppo: "disjoint", rlvr: "overlap" }),
+  M("offline-rl", "offline RL", "RL from a fixed log of past actions and rewards, without sampling the current model.",
+    ["Levine et al., Offline RL tutorial, arXiv 2005.01643 (2020)"],
+    [RL, ["OF1", "no sampling from the current model", (f) => !f.onPolicy]],
+    { "reinforcement-learning": "is_a", ppo: "disjoint", grpo: "disjoint" }),
+  M("process-reward", "process reward (step-level)", "Reward each reasoning step, not only the final outcome; beat outcome-only rewards on MATH.",
+    ["Lightman et al., Let's Verify Step by Step, arXiv 2305.20050 (2023)"],
+    [RL, ["ST1", "reward per step", (f) => f.stepLevel]],
+    { rlvr: "overlap", rlhf: "overlap" }),
+  M("scoring-rule-rl", "RL with a proper scoring rule", "Reward stated probabilities by a proper scoring rule (Brier, log), so honest odds pay best. TypeSafe's RLCD names this objective but not its reward.",
+    ["Gneiting and Raftery, Strictly proper scoring rules (2007)", "TypeSafe Jev launch post (RLCD objective)"],
+    [RL, ["SR1", "proper scoring rule on stated probabilities", (f) => f.scoringRule]],
+    { rlvr: "overlap", "reinforcement-learning": "is_a" }),
+  M("dpo", "DPO (direct preference optimization)", "Fine-tune directly on preferred vs rejected pairs with a classification loss; no explicit reward model and no sampling during training.",
+    ["Rafailov et al., DPO, arXiv 2305.18290 (2023)"],
+    [["PP1", "trains on preference pairs", (f) => f.preferencePairs], ["PP2", "no reward-raising update", (f) => !f.usesReward], ["PP3", "no sampling from the current model", (f) => !f.onPolicy]],
+    { "reinforcement-learning": "disjoint", "imitation-learning": "overlap" }),
+  M("imitation-learning", "imitation learning (SFT, behaviour cloning)", "Train on examples of the desired output; no reward.",
+    ["Wikipedia: Reinforcement learning (index); InstructGPT step 1"],
+    [["IM1", "trains on demonstrations", (f) => f.demonstrations], ["IM2", "no reward", (f) => !f.usesReward]],
+    { "reinforcement-learning": "disjoint", dpo: "overlap" }),
+];
+
+export function methodCases(): Method[] {
+  const keys = ["usesReward", "onPolicy", "rewardHuman", "rewardAI", "rewardVerifier", "learnedRewardModel", "critic", "groupBaseline", "stepLevel", "scoringRule", "preferencePairs", "demonstrations"] as const;
+  const out: Method[] = [];
+  for (let m = 0; m < 2 ** (keys.length + 1); m++) {
+    const f = { confirmed: Boolean(m & 1), label: ["RL", undefined][m % 2] } as Method;
+    keys.forEach((k, i) => { (f as Record<string, unknown>)[k] = Boolean(m & (2 << i)); });
+    out.push(f);
+  }
+  return out;
+}
+
+if (import.meta.url === `file://${process.argv[1]}`) {
+  const cs = methodCases();
+  const sets = new Map(RL_VOCAB.map((t) => [t.id, passSet(t, cs)])); let ok = 0, n = 0;
+  const edges: { a: string; b: string; predicted: Relation; got: Relation }[] = [];
+  console.log(`== training method: ${cs.length} cases`);
+  for (const t of RL_VOCAB) { const v = validTest(t, cs); console.log(`${t.id.padEnd(22)} ${freeze(t)} ${v.length ? v.join("; ") : "valid"}`); }
+  for (const a of RL_VOCAB) for (const [o, w] of Object.entries(a.predicts ?? {})) {
+    n++; const g = relation(sets.get(a.id)!, sets.get(o)!); if (g === w) ok++;
+    edges.push({ a: a.id, b: o, predicted: w, got: g });
+    console.log(`${a.id} ~ ${o}: predicted ${w}, got ${g} -> ${g === w ? "confirmed" : "REFUTED"}`);
+  }
+  console.log(`\n${ok}/${n} predictions confirmed`);
+  const base = { confirmed: true, label: undefined, usesReward: false, onPolicy: false, rewardHuman: false, rewardAI: false, rewardVerifier: false, learnedRewardModel: false, critic: false, groupBaseline: false, stepLevel: false, scoringRule: false, preferencePairs: false, demonstrations: false } as Method;
+  const ex: [string, Partial<Method>][] = [
+    ["InstructGPT RL step", { usesReward: true, onPolicy: true, rewardHuman: true, learnedRewardModel: true, critic: true }],
+    ["Constitutional AI RL step", { usesReward: true, onPolicy: true, rewardAI: true, learnedRewardModel: true, critic: true }],
+    ["DeepSeek-R1-Zero", { usesReward: true, onPolicy: true, rewardVerifier: true, groupBaseline: true }],
+    ["Our P1: symbolic checks as rewards, GRPO", { usesReward: true, onPolicy: true, rewardVerifier: true, groupBaseline: true }],
+    ["Our P2: calibrated decisions, Brier reward on check outcomes", { usesReward: true, onPolicy: true, rewardVerifier: true, scoringRule: true, groupBaseline: true }],
+    ["Our P3: founder card choices as pairs, DPO", { preferencePairs: true }],
+    ["Our P4: per-step checks on agent traces", { usesReward: true, onPolicy: true, rewardVerifier: true, stepLevel: true, groupBaseline: true }],
+    ["Our P0: learn from the check-outcome log only", { usesReward: true, rewardVerifier: true }],
+  ];
+  console.log("\n== examples");
+  for (const [name, facts] of ex) console.log(`${name.padEnd(60)} ${RL_VOCAB.filter((t) => run(t, { ...base, ...facts } as Method).pass).map((t) => t.id).join(", ") || "(no term)"}`);
+  const fs = await import("node:fs");
+  fs.writeFileSync(new URL("./rl-graph.json", import.meta.url), JSON.stringify({ level: "training method", cases: cs.length, edges }, null, 1));
+}
