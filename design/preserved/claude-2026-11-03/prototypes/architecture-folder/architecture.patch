+++ b/project-files/naive-design/prototypes/architecture/KGR.lean
@@ -0,0 +1,48 @@
+/- "knowledge graph of record" and its neighbours (2026-11-01). Mirrors kgr-vocab.ts: same facts, same claims.
+   Core Lean only. Written in the AI-labs thread; built by the phases thread. -/
+namespace Naive.KGR
+
+structure Store where
+  nodesAndEdges : Bool
+  namedSlots : Bool
+  numericVectors : Bool
+  learned : Bool
+  similaritySearch : Bool
+  authoritative : Bool
+  sourced : Bool
+  dated : Bool
+  typesDefined : Bool
+  instanceFacts : Bool
+  perItem : Bool
+
+def IsKnowledgeGraph (s : Store) : Prop :=
+  s.nodesAndEdges = true ∧ s.namedSlots = true ∧ s.instanceFacts = true
+def IsSystemOfRecord (s : Store) : Prop := s.authoritative = true
+def IsKGR (s : Store) : Prop :=
+  IsKnowledgeGraph s ∧ IsSystemOfRecord s ∧ s.sourced = true ∧ s.dated = true ∧ s.typesDefined = true
+def IsEmbedding (s : Store) : Prop :=
+  s.numericVectors = true ∧ s.learned = true ∧ s.namedSlots = false ∧ s.perItem = true
+def IsOntology (s : Store) : Prop :=
+  s.typesDefined = true ∧ s.namedSlots = true ∧ s.instanceFacts = false
+
+theorem kgr_is_knowledge_graph {s : Store} (h : IsKGR s) : IsKnowledgeGraph s := h.1
+theorem kgr_is_system_of_record {s : Store} (h : IsKGR s) : IsSystemOfRecord s := h.2.1
+
+/-- Embeddings do not use nodes and cells: nothing is both an embedding and a knowledge graph. -/
+theorem embedding_not_knowledge_graph {s : Store} (he : IsEmbedding s) (hk : IsKnowledgeGraph s) : False := by
+  have h1 := he.2.2.1
+  have h2 := hk.2.1
+  rw [h1] at h2
+  exact Bool.noConfusion h2
+
+/-- A knowledge graph contains an ontology; it is not one. -/
+theorem ontology_not_knowledge_graph {s : Store} (ho : IsOntology s) (hk : IsKnowledgeGraph s) : False := by
+  have h1 := ho.2.2
+  have h2 := hk.2.2
+  rw [h1] at h2
+  exact Bool.noConfusion h2
+
+theorem embedding_not_kgr {s : Store} (he : IsEmbedding s) (hr : IsKGR s) : False :=
+  embedding_not_knowledge_graph he hr.1
+
+end Naive.KGR
diff --git a/project-files/naive-design/prototypes/architecture/Mechanism.lean b/project-files/naive-design/prototypes/architecture/Mechanism.lean
