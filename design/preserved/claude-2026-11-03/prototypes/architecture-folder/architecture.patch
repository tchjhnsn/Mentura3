@@ -0,0 +1,68 @@
+// Problem vocabulary (proposed, 2026-10-31). Torian: a venture's root problem spawns a technical, marketing and
+// hiring version of itself; problems need provenance, a loop agents run, a latency to identify and to solve,
+// and a way to see when one becomes a bottleneck. Level: problem (one node of a venture's problem graph).
+// Sources: Newell and Simon (a problem is a gap between a present and a wanted state), Toyota A3 and Deming
+// PDCA (problem, cause, countermeasure, check), Goldratt's Theory of Constraints (the bottleneck), Naive
+// validation-problem.schema.json (a root problem and its forms, EE-050).
+//
+//   node problem-vocab.ts      validity, exhaustive cross-run, predictions, position-blindness
+
+import { freeze, passSet, relation, run, validTest, type Base, type Relation, type Term } from "/home/user/ee-build/schema/terms/engine.ts";
+
+export const FUNCTIONS = ["venture", "engineering", "marketing", "hiring"] as const;
+export type ProblemNode = Base & {
+  gap: boolean;            // a present state differs from a wanted one
+  hasHolder: boolean;      // someone has it: a customer, the founder, a function of the venture
+  humanOwner: boolean;     // a person owns solving it (agents contribute; owners are people)
+  choice: boolean;         // framed as a choice among two or more options
+  open: boolean;           // not yet solved and verified
+  parents: number;         // problems it was derived from (0, 1, 2)
+  allDeriveFromIt: boolean;// every problem in the venture's graph derives from it
+  fn: (typeof FUNCTIONS)[number];
+  recurrences: number;     // times it came back after being closed (0..3)
+  blocks: number;          // open problems that cannot close until it does (0..3)
+};
+
+const T = (id: string, label: string, form: Term<ProblemNode>["form"], meaning: string, sources: string[], props: [string, string, (f: ProblemNode) => boolean][], predicts?: Record<string, Relation>): Term<ProblemNode> =>
+  ({ id, label, level: "problem", kind: "role", form, meaning, sources, predicts, props: props.map(([pid, says, check]) => ({ id: pid, says, check })) });
+const problem: [string, string, (f: ProblemNode) => boolean][] = [["PR1", "a gap between a present and a wanted state", (f) => f.gap], ["PR2", "someone has it", (f) => f.hasHolder]];
+
+export const PROBLEM_VOCAB: Term<ProblemNode>[] = [
+  T("problem", "problem", "word", "A gap between a present state and a wanted one that someone has.", ["Newell and Simon, Human Problem Solving (1972)"], problem,
+    { decision: "overlap", "root-problem": "has_a_kind", "function-problem": "has_a_kind", bottleneck: "has_a_kind" }),
+  T("root-problem", "root problem", "compound", "The problem the venture exists to solve: it derives from no other problem, and every other problem in the venture derives from it.", ["Naive validation-problem (EE-050: a root problem and its forms)", "graph theory: root"],
+    [...problem, ["RP1", "derives from no other problem", (f) => f.parents === 0], ["RP2", "every problem derives from it", (f) => f.allDeriveFromIt]], { problem: "is_a", "function-problem": "disjoint" }),
+  T("function-problem", "function problem", "compound", "A form of a problem that one function of the venture owns: engineering, marketing, hiring. It derives from at least one other problem.", ["Torian 2026-10-31 (root problem spawns function versions)"],
+    [...problem, ["FP1", "derives from at least one problem", (f) => f.parents >= 1], ["FP2", "owned by a function, not the venture as a whole", (f) => f.fn !== "venture"]], { problem: "is_a", "technical-problem": "has_a_kind" }),
+  T("technical-problem", "technical problem", "compound", "A function problem that engineering owns.", ["Torian 2026-10-31"],
+    [...problem, ["FP1", "derives from at least one problem", (f) => f.parents >= 1], ["TP1", "engineering owns it", (f) => f.fn === "engineering"]], { "function-problem": "is_a" }),
+  T("decision", "decision", "word", "A choice among two or more options that a person has the right to make. A problem framed as a choice is a decision; not every decision answers a gap.", ["Naive decision.schema.json", "EE: owners are always people"],
+    [["DC1", "a choice among options", (f) => f.choice], ["DC2", "a person owns it", (f) => f.humanOwner]], { problem: "overlap" }),
+  T("bottleneck", "bottleneck", "word", "An open problem that keeps coming back or holds other problems open, so the venture's throughput is limited by it.", ["Goldratt, The Goal (1984): Theory of Constraints"],
+    [...problem, ["BN1", "open", (f) => f.open], ["BN2", "came back at least twice or holds at least two problems open", (f) => f.recurrences >= 2 || f.blocks >= 2]], { problem: "is_a" }),
+];
+
+export function problemCases(): ProblemNode[] {
+  const out: ProblemNode[] = []; const labels = ["problem", "bug", "decision", undefined];
+  const B = [false, true];
+  for (const confirmed of B) for (const gap of B) for (const hasHolder of B) for (const humanOwner of B) for (const choice of B) for (const open of B)
+    for (const parents of [0, 1, 2]) for (const allDeriveFromIt of B) for (const fn of FUNCTIONS) for (const recurrences of [0, 1, 2, 3]) for (const blocks of [0, 1, 2, 3])
+      out.push({ confirmed, label: labels[out.length % 4], gap, hasHolder, humanOwner, choice, open, parents, allDeriveFromIt, fn, recurrences, blocks });
+  return out;
+}
+
+if (import.meta.url === `file://${process.argv[1]}`) {
+  const cases = problemCases();
+  console.log(`${cases.length} cases (every combination)`);
+  const sets = new Map(PROBLEM_VOCAB.map((t) => [t.id, passSet(t, cases)]));
+  for (const t of PROBLEM_VOCAB) { const v = validTest(t, cases); console.log(`${t.label.padEnd(18)} ${freeze(t)} ${v.length ? v.join("; ") : "valid"} (${sets.get(t.id)!.size} pass)`); }
+  let ok = 0, n = 0;
+  for (const a of PROBLEM_VOCAB) for (const [o, want] of Object.entries(a.predicts ?? {})) { n++; const got = relation(sets.get(a.id)!, sets.get(o)!); if (got === want) ok++; console.log(`${a.id} ~ ${o}: predicted ${want}, got ${got} -> ${got === want ? "confirmed" : "REFUTED"}`); }
+  console.log(`${ok}/${n} predictions confirmed`);
+  // position-blindness: position = parents, allDeriveFromIt, blocks (where it sits in the graph)
+  for (const t of PROBLEM_VOCAB) {
+    let pos = 0, beh = 0; const key = (f: ProblemNode, k: "pos" | "beh") => k === "pos" ? JSON.stringify([f.gap, f.hasHolder, f.humanOwner, f.choice, f.open, f.fn, f.recurrences]) : JSON.stringify([f.parents, f.allDeriveFromIt, f.blocks]);
+    for (const k of ["pos", "beh"] as const) { const g = new Map<string, Set<boolean>>(); for (const c of cases) if (c.confirmed) { const s = g.get(key(c, k)) ?? new Set(); s.add(run(t, c).pass); g.set(key(c, k), s); } const moved = [...g.values()].filter((s) => s.size > 1).length; if (k === "pos") pos = moved; else beh = moved; }
+    console.log(`${t.id.padEnd(18)} ${pos === 0 ? "intrinsic" : beh === 0 ? "positional" : "mixed"}`);
+  }
+}
