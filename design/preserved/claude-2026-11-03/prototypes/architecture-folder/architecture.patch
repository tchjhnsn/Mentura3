+];
+const FW4 = (f: any) => run(T("framework"), f).pass && f.distributed === true; // candidate: a framework is something you install and run yourself
+console.log(`frozen tests: framework ${freeze(T("framework"))} · platform ${freeze(T("platform"))} · library ${freeze(T("library"))}\n`);
+const rows = S.map((s) => { const f = { ...base, ...s.facts } as any; return { id: s.id, framework: run(T("framework"), f).pass, platform: run(T("platform"), f).pass, library: run(T("library"), f).pass, fw4: FW4(f), failed: { framework: run(T("framework"), f).failed, platform: run(T("platform"), f).failed }, evidence: s.evidence }; });
