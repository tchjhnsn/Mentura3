+# Drafts the architecture record for everything-ecosystem (agent draft, unconfirmed) from the design plus the
+# derived facts in as-built.json. Declared fields are the agent's proposal; derived fields come from code.
+import json, hashlib, collections, datetime
+d = json.load(open('as-built.json')); g = json.load(open('graph.json'))
+files = d['files']
+LAYER = {"schema": "system", "interface": "interface", "purpose": "purpose", "knowledge": "knowledge", "operations": "operations",
+         "governance": "governance", "evidence": "evidence", "platform": "platform", "console": "platform", "verification": "verification",
+         "frameworks": "purpose", "scripts": "system", "(root)": "system"}
+KIND = {"schema/core": "framework core", "schema/checks": "check", "schema/lints": "lint", "schema/terms": "engine",
+        "schema/migrations": "migration", "interface": "router and boundaries", "interface/cli": "command line", "interface/mcp": "mcp server",
+        "interface/api": "api", "interface/harness": "harness adapter", "interface/demo": "demo", "interface/dev": "setup page",
+        "interface/create-venture": "generator", "knowledge/connectors": "connector", "platform/integrations": "integration",
+        "platform/connectors": "connector", "platform/kits": "kit", "platform/webhooks": "webhook", "platform/mcp": "mcp server",
+        "console/app": "app", "console/components": "ui components", "console/lib": "app library", "console/hooks": "ui hooks", "console": "app",
+        "verification": "model", "purpose/frameworks": "framework", "operations/marketing": "operations module", "evidence/skills": "skill code",
+        "scripts": "script", "scripts/pr-review": "script", "(root)": "repo tooling"}
+comps = {c['id']: c for c in g['components']}
+import subprocess, os
+TLA = [p for p in subprocess.run(['git','-C','/home/user/ee-build','ls-files','*.tla'],capture_output=True,text=True).stdout.split() ]
+def models_for(cid, fs):
+    out=set()
+    for p in TLA:
+        if cid != '(root)' and not cid.startswith('schema') and p.startswith(cid + '/'): out.add(p)
+    for f in fs:
+        stem=os.path.basename(f['path']).rsplit('.',1)[0]
+        for p in TLA:
+            if p.startswith('verification/'+stem+'/'): out.add(p)
+    return sorted(out)
+by = collections.defaultdict(list)
+for f in files: by[f['component']].append(f)
+knot = set(['frameworks/telos','interface','interface/api','interface/mcp','knowledge/connectors','operations/marketing','purpose/frameworks','schema/checks','schema/core','schema/lints','schema/migrations','scripts'])
+elements = []
+for cid, c in sorted(comps.items()):
+    fs = by[cid]
+    top = cid.split('/')[0]
+    kind = KIND.get(cid) or ("example" if cid.startswith("schema/examples") else "framework" if top in ("frameworks",) else "feature")
+    elements.append({
+        "id": cid, "kind": kind, "layer": LAYER.get(top, top), "status": [{"value": "built", "valid_from": None, "recorded": "2026-10-31"}],
+        "covers": [cid + "/" if cid not in ("schema/core", "schema/checks", "schema/lints", "(root)") else {"schema/core": "schema/*.mjs (not check-*, lint-*)", "schema/checks": "schema/check-*", "schema/lints": "schema/lint-*", "(root)": "*.mjs"}[cid]],
+        "declared": {"depends_on": sorted({e['to'] for e in g['edges'] if e['from'] == cid})},
+        "derived": {"files": c['files'], "lines": c['lines'], "tests": c['tests'], "external": c['external'],
+                    "models": models_for(cid, fs), "proofs": sorted({p for f in fs for p in f['proved']}),
+                    "in_knot": cid in knot},
+    })
+kern = {"knowledge/connectors/resolve.mjs", "schema/redact.mjs", "schema/terms/engine.ts", "schema/verify.mjs"}
+for k in sorted(kern):
+    f = next(x for x in files if x['path'] == k)
+    elements.append({"id": k, "kind": "kernel" + (" and engine" if k.endswith("engine.ts") else ""), "part_of": f['component'], "layer": LAYER[k.split('/')[0]],
+                     "status": [{"value": "built", "recorded": "2026-10-31"}], "covers": [k], "declared": {"depends_on": []},
+                     "derived": {"files": 1, "lines": f['lines'], "fan_in": f['fanIn'], "tests": int(f['tested']), "proofs": ["lean/Naive/Terms.lean"] if "engine" in k else []}})
+designed = [
+    ("architecture-checks", "check", "system", "A1 to A8: the architecture record against the code", ["schema/terms", "schema/core"]),
+    ("display-theorem", "engine", "interface", "chooses how a record is shown, given the record, the purpose and the surface", ["schema/terms", "schema/core"]),
+    ("conversation-engine", "engine", "operations", "admissible next question (Q1 to Q12) and the chooser", ["schema/terms"]),
+    ("architecture-map-skill", "visualization skill", "interface", "renders this record as the architecture map in a harness", ["display-theorem"]),
+]
+for i, k, l, says, deps in designed:
+    elements.append({"id": i, "kind": k, "layer": l, "says": says, "status": [{"value": "designed", "recorded": "2026-10-31"}], "covers": [], "declared": {"depends_on": deps}, "derived": None})
+context = {
+    "people": [{"id": "founder", "says": "owns every record and decision; always a human"}, {"id": "agent", "says": "contributes drafts and checks; never an owner"}],
