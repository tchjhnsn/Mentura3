+// "industry" and its neighbours (Torian, 2026-11-01 03:20Z: run industry through the glossary; a venture can belong to
+// several industries to varying degrees; industries depend on each other; is raw materials the root?).
+// Two levels: grouping (what a classification groups) and link (an edge in the venture library).
+// Exhaustive over the facts at each level.
+//
+//   node industry-vocab.ts
+
+import { freeze, passSet, relation, run, validTest, type Base, type Relation, type Term } from "/home/user/ee-build/schema/terms/engine.ts";
+
+type P<F> = [string, string, (f: F) => boolean][];
+const mk = <F extends Base>(level: string) => (id: string, label: string, meaning: string, sources: string[], props: P<F>, predicts?: Record<string, Relation>): Term<F> =>
+  ({ id, label, level, kind: "role", form: "word", meaning, sources, predicts, props: props.map(([pid, says, check]) => ({ id: pid, says, check })) });
+
+// ---------- grouping level: what a classification puts together ----------
+export type Grouping = Base & {
+  groupsProducers: boolean;    // its members are businesses that make or sell something
+  groupsBuyers: boolean;       // its members include the buyers
+  byProcess: boolean;          // membership is by production activity (what is made and how)
+  bySubstitutes: boolean;      // membership is by offerings a buyer treats as substitutes
+  byJob: boolean;              // membership is by the job the buyer hires the offering for
+  groupsGroupings: boolean;    // its members are themselves groupings (industries)
+  extractsFromNature: boolean; // members' output is taken from nature (crops, ore, oil, fish, timber)
+  servicesOnly: boolean;       // members' output is a service, not a good
+};
+const G = mk<Grouping>("grouping");
+export const GROUPING_VOCAB: Term<Grouping>[] = [
+  G("industry@naics", "industry", "NAICS: establishments grouped by the production activity they perform; each establishment gets one code by its primary activity.",
