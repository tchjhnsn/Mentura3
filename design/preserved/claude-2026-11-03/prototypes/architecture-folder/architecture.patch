+    tested: f.tested, rulesAsInput: f.rulesAsInput, verdictWithReasons: f.verdictWithReasons, domainRefs: f.domainRefs, inCycle: inCycle.has(f.path),
+  }));
+}
+
+if (import.meta.url === `file://${process.argv[1]}`) {
+  const here = new URL(".", import.meta.url).pathname;
+  const cases = componentCases();
+  const terms = [KERNEL, ENGINE];
+  for (const t of terms) console.log(t.id, freeze(t), validTest(t, cases).length ? validTest(t, cases) : "valid test");
+  const sets = terms.map((t) => passSet(t, cases));
+  const rel = relation(sets[0], sets[1]);
+  console.log(`cross-run: kernel ~ engine = ${rel} (predicted ${KERNEL.predicts!.engine}: ${rel === KERNEL.predicts!.engine ? "confirmed" : "refuted"})`);
+  const real = fromBuilt(`${here}/as-built.json`);
+  const verdicts = real.map((c) => ({ path: c.path, kernel: run(KERNEL, c), engine: run(ENGINE, c), inCycle: c.inCycle }));
+  const realRel = relation(new Set(verdicts.flatMap((v, i) => (v.kernel.pass ? [i] : []))), new Set(verdicts.flatMap((v, i) => (v.engine.pass ? [i] : []))));
