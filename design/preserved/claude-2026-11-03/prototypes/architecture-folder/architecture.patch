@@ -0,0 +1,32 @@
+/- Framework or platform, for real systems (2026-11-01). Mirrors framework-proof.ts. Facts are cited there.
+   Core Lean only; built by the phases thread. -/
+namespace Naive.Products
+
+structure Sys where
+  reusable : Bool
+  callsYourCode : Bool
+  hostedWithAccounts : Bool
+  othersBuildOnIt : Bool
+  standalone : Bool
+  runsAsService : Bool
+  distributed : Bool   -- FW4: installed and run by the user
+
+def Framework (s : Sys) : Prop := s.reusable = true ∧ s.callsYourCode = true
+def FrameworkFW4 (s : Sys) : Prop := Framework s ∧ s.distributed = true
+def Platform (s : Sys) : Prop := s.hostedWithAccounts = true ∧ s.othersBuildOnIt = true ∧ s.standalone = true ∧ s.runsAsService = true
+
+def nextjs : Sys := ⟨true, true, false, true, true, false, true⟩
+def vercel : Sys := ⟨true, true, true, true, true, true, false⟩
+def naive  : Sys := ⟨true, true, false, true, true, false, true⟩
+
+theorem nextjs_framework_not_platform : FrameworkFW4 nextjs ∧ ¬ Platform nextjs :=
+  ⟨⟨⟨rfl, rfl⟩, rfl⟩, fun h => Bool.noConfusion h.1⟩
+theorem naive_framework_not_platform : FrameworkFW4 naive ∧ ¬ Platform naive :=
+  ⟨⟨⟨rfl, rfl⟩, rfl⟩, fun h => Bool.noConfusion h.1⟩
+/-- Without FW4 the framework test lets Vercel in; with it, Vercel is a platform and not a framework. -/
+theorem vercel_platform : Platform vercel ∧ Framework vercel ∧ ¬ FrameworkFW4 vercel :=
+  ⟨⟨rfl, rfl, rfl, rfl⟩, ⟨rfl, rfl⟩, fun h => Bool.noConfusion h.2⟩
+/-- As built, Naive and Next.js have the same facts on these tests. -/
+theorem naive_like_nextjs : naive = nextjs := rfl
+
+end Naive.Products
diff --git a/project-files/naive-design/prototypes/architecture/Proof.lean b/project-files/naive-design/prototypes/architecture/Proof.lean
new file mode 100644
index 0000000..73a7aac
--- /dev/null
+++ b/project-files/naive-design/prototypes/architecture/Proof.lean
@@ -0,0 +1,124 @@
+/- "prove" and its senses, verify and validate, theorem, suite, function and the value-net terms (2026-11-01).
+   Mirrors proof-vocab.ts: the same facts, so a theorem here and a cross-run there say the same thing. -/
+namespace Naive.Proof
+
+structure Warrant where
+  fromAxioms : Bool
+  certain : Bool
+  standardChosen : Bool
+  aboutWorld : Bool
+  refutableTest : Bool
+  againstSpec : Bool
+  againstNeed : Bool
+  machineChecked : Bool
+
+def ProveMath (w : Warrant) : Prop := w.fromAxioms = true ∧ w.certain = true
+def ProveLaw (w : Warrant) : Prop := w.standardChosen = true ∧ w.aboutWorld = true ∧ w.certain = false
+def ProveScience (w : Warrant) : Prop := w.refutableTest = true ∧ w.aboutWorld = true ∧ w.certain = false
+def ProveNaive (w : Warrant) : Prop := ProveLaw w
+def Verify (w : Warrant) : Prop := w.againstSpec = true
+def Validate (w : Warrant) : Prop := w.againstNeed = true
+def TheoremMath (w : Warrant) : Prop := ProveMath w
+def TheoremTorian (w : Warrant) : Prop := w.machineChecked = true
+
+/-- Only the mathematical sense is certain: it never meets the legal or the scientific sense. -/
+theorem math_not_law {w : Warrant} (m : ProveMath w) : ¬ ProveLaw w := by
+  intro l; have h1 := m.2; have h2 := l.2.2; rw [h1] at h2; cases h2
+theorem math_not_science {w : Warrant} (m : ProveMath w) : ¬ ProveScience w := by
+  intro s; have h1 := m.2; have h2 := s.2.2; rw [h1] at h2; cases h2
+/-- Naive's default for claims about the world is the legal sense. -/
+theorem naive_is_law {w : Warrant} : ProveNaive w ↔ ProveLaw w := Iff.rfl
+
+/-- Verify and validate overlap (IEEE 1012): each can hold without the other. -/
+def specOnly : Warrant := ⟨false, false, false, false, false, true, false, false⟩
+def needOnly : Warrant := ⟨false, false, false, false, false, false, true, false⟩
+theorem verify_validate_independent :
+    (Verify specOnly ∧ ¬ Validate specOnly) ∧ (Validate needOnly ∧ ¬ Verify needOnly) :=
+  ⟨⟨rfl, fun h => by cases h⟩, ⟨rfl, fun h => by cases h⟩⟩
+
+/-- Torian's "theorem" (a rule a program checks) overlaps the mathematical one: a pen-and-paper theorem is not a
+    checkable rule, and a lint rule is not a theorem. -/
+def paperTheorem : Warrant := ⟨true, true, false, false, false, false, false, false⟩
+def lintRule : Warrant := ⟨false, false, false, false, false, true, false, true⟩
+theorem theorem_senses_overlap :
+    (TheoremMath paperTheorem ∧ ¬ TheoremTorian paperTheorem) ∧ (TheoremTorian lintRule ∧ ¬ TheoremMath lintRule) :=
+  ⟨⟨⟨rfl, rfl⟩, fun h => by cases h⟩, ⟨rfl, fun h => by cases h.1⟩⟩
+
+structure Grouping where
+  concept : Bool
+  onDisk : Bool
+  holdsRecords : Bool
+  oneScope : Bool
+  toolsTogether : Bool
+  ownsConversations : Bool
+
+def SuiteIndustry (g : Grouping) : Prop := g.toolsTogether = true
+def Suite (g : Grouping) : Prop :=
+  g.toolsTogether = true ∧ g.oneScope = true ∧ (g.concept = true ∧ g.onDisk = false) ∧ g.ownsConversations = false
+def Folder (g : Grouping) : Prop := g.onDisk = true ∧ g.holdsRecords = true
+def Workspace (g : Grouping) : Prop := g.ownsConversations = true ∧ g.oneScope = false
+
+theorem suite_is_industry_suite {g : Grouping} (h : Suite g) : SuiteIndustry g := h.1
+/-- The suite is the concept and the folder its encoding: nothing is both. -/
+theorem suite_not_folder {g : Grouping} (s : Suite g) : ¬ Folder g := by
+  intro f; have h1 := s.2.2.1.2; have h2 := f.1; rw [h1] at h2; cases h2
+/-- Torian 02:49Z: a suite receives conversations, the workspace owns them. -/
+theorem suite_not_workspace {g : Grouping} (s : Suite g) : ¬ Workspace g := by
+  intro w; have h1 := s.2.2.2; have h2 := w.1; rw [h1] at h2; cases h2
+
+structure Fn where
+  mapsInputs : Bool
+  activity : Bool
+  alwaysPresent : Bool
+  grouping : Bool
+  codeModule : Bool
+
+def FunctionMath (f : Fn) : Prop := f.mapsInputs = true ∧ f.activity = false
+def FunctionBusiness (f : Fn) : Prop := f.activity = true
+def FunctionNaive (f : Fn) : Prop := FunctionBusiness f ∧ f.alwaysPresent = true
+def Department (f : Fn) : Prop := FunctionBusiness f ∧ f.grouping = true
+
+theorem naive_function_is_business {f : Fn} (h : FunctionNaive f) : FunctionBusiness f := h.1
+/-- The collision: the mathematical function and the business function never meet. -/
+theorem math_function_not_business {f : Fn} (m : FunctionMath f) : ¬ FunctionBusiness f := by
+  intro b; unfold FunctionBusiness at b; have h1 := m.2; rw [h1] at b; cases b
+
+structure Player where
+  customersValueLess : Bool
+  customersValueMore : Bool
+  suppliersLess : Bool
+  sameJob : Bool
+  otherCategory : Bool
+  buysFromFocal : Bool
+  suppliesFocal : Bool
+  agreement : Bool
+
+def CompetitorVN (p : Player) : Prop := p.customersValueLess = true ∨ p.suppliersLess = true
+def CompetitorMarket (p : Player) : Prop := p.sameJob = true ∧ p.otherCategory = false
+def Complementor (p : Player) : Prop := p.customersValueMore = true
+def Coopetition (p : Player) : Prop := CompetitorVN p ∧ Complementor p
+def Substitute (p : Player) : Prop := p.sameJob = true ∧ p.otherCategory = true
+def Customer (p : Player) : Prop := p.buysFromFocal = true
+
+theorem coopetition_is_competitor {p : Player} (h : Coopetition p) : CompetitorVN p := h.1
+theorem coopetition_is_complementor {p : Player} (h : Coopetition p) : Complementor p := h.2
+theorem substitute_not_market_competitor {p : Player} (s : Substitute p) : ¬ CompetitorMarket p := by
+  intro c; have h1 := s.2; have h2 := c.2; rw [h1] at h2; cases h2
+/-- One player can be a competitor, a complementor and a customer at once, so "prove X is a competitor" names a
+    role and a sense, never a kind of company. -/
+def bothWays : Player := ⟨true, true, false, true, false, true, false, false⟩
+theorem roles_coexist : Coopetition bothWays ∧ Customer bothWays ∧ CompetitorMarket bothWays :=
+  ⟨⟨Or.inl rfl, rfl⟩, rfl, ⟨rfl, rfl⟩⟩
+
+/-- Decided 04:51Z: a partner is a complementor or supplier (channel not yet a fact) with an agreement. -/
+def Supplier (p : Player) : Prop := p.suppliesFocal = true
+def Partner (p : Player) : Prop := p.agreement = true ∧ (Complementor p ∨ Supplier p)
+theorem partner_is_complementor_or_supplier {p : Player} (h : Partner p) : Complementor p ∨ Supplier p := h.2
+/-- An agreement alone does not make a partner (the superseded wider sense). -/
+def agreementOnly : Player := ⟨false, false, false, false, false, false, false, true⟩
+theorem agreement_alone_not_partner : ¬ Partner agreementOnly := fun h => by
+  cases h.2 with
+  | inl c => cases c
+  | inr s => cases s
+
+end Naive.Proof
