+// "capability" and whether provenance is one (Torian 2026-11-01 08:27Z). Sources: ArchiMate 3.2 (capability is a
+// behaviour element: "an ability that an active structure element, such as an organization, person, or system,
+// possesses"), W3C PROV (provenance is information about the entities, activities and agents that produced a thing),
+// Naive interface/provenance.mjs (EE-031). Level: thing in a system. Exhaustive cross-run.
+//   node --experimental-strip-types capability-vocab.ts
+import { freeze, passSet, relation, validTest, type Base, type Relation, type Term } from "/home/user/ee-build/schema/terms/engine.ts";
+export type Thing = Base & {
+  ability: boolean;        // something can be done (behaviour), not a thing that exists
+  holderNamed: boolean;    // names whose ability it is (an organisation, person or system)
+  information: boolean;    // a body of records or data
+  aboutOrigin: boolean;    // says what produced something: entities, activities, agents
+  appendOnly: boolean;     // only ever added to; edits break it
+  structural: boolean;     // a part of the system (a component, module, file): structure, not behaviour
+  producesOrigin: boolean; // its doing produces information about origin
+};
+type P = [string, string, (f: Thing) => boolean][];
+const T = (id: string, label: string, meaning: string, sources: string[], props: P, predicts?: Record<string, Relation>): Term<Thing> =>
+  ({ id, label, level: "thing in a system", kind: "kind", form: id.includes("-") ? "compound" : "word", meaning, sources, predicts, props: props.map(([pid, says, check]) => ({ id: pid, says, check })) } as Term<Thing>);
+const CAP: P = [["CP1", "an ability", (f) => f.ability], ["CP2", "names whose ability it is", (f) => f.holderNamed], ["CP3", "not a structural part", (f) => !f.structural], ["CP4", "not information", (f) => !f.information]];
+export const CAP_VOCAB: Term<Thing>[] = [
+  T("capability", "capability", "ArchiMate: an ability that an organisation, person or system possesses. Behaviour, not structure: a capability is realised by parts, it is not one. Always a capability OF a named holder.", ["archimate-3-2-capability"],
+    CAP, { "provenance-tracking": "has_a_kind", provenance: "disjoint", "provenance-log": "disjoint", "provenance-module": "disjoint" }),
+  T("provenance", "provenance", "W3C PROV: information about the entities, activities and people or agents involved in producing a thing, used to judge its quality and trustworthiness. Information, not an ability.", ["w3c-prov-dm-2013"],
+    [["PV1", "information", (f) => f.information], ["PV2", "about origin", (f) => f.aboutOrigin]], { capability: "disjoint", "provenance-log": "has_a_kind", "provenance-tracking": "disjoint" }),
+  T("provenance-tracking", "provenance tracking", "The capability of a system to keep provenance for what it writes. In Naive, a capability of the records system (naive-core), realised by the provenance module.", ["w3c-prov-dm-2013", "interface/provenance.mjs"],
+    [...CAP, ["PT1", "its doing produces provenance", (f) => f.producesOrigin]], { capability: "is_a", provenance: "disjoint", "provenance-module": "disjoint" }),
+  T("provenance-log", "provenance log", "Naive's provenance record: <venture>/provenance.jsonl, one append-only line per write, hash-chained (EE-031).", ["interface/provenance.mjs", "schema/provenance-entry.schema.json"],
+    [["PV1", "information", (f) => f.information], ["PV2", "about origin", (f) => f.aboutOrigin], ["PL1", "append-only", (f) => f.appendOnly]], { provenance: "is_a", capability: "disjoint" }),
+  T("provenance-module", "provenance module", "The structural part that realises provenance tracking: interface/provenance.mjs and schema/check-provenance.mjs (component 'provenance' in the architecture record).", ["naive.architecture.json element provenance"],
+    [["PM1", "a structural part", (f) => f.structural], ["PT1", "its doing produces provenance", (f) => f.producesOrigin]], { capability: "disjoint", "provenance-tracking": "disjoint", "provenance-log": "overlap" }),
+];
+const KEYS = ["ability", "holderNamed", "information", "aboutOrigin", "appendOnly", "structural", "producesOrigin"] as const;
+export function thingCases(): Thing[] { const out: Thing[] = []; for (let m = 0; m < 2 ** (KEYS.length + 1); m++) { const f = { confirmed: Boolean(m & 1), label: ["provenance", "capability", undefined][m % 3] } as Thing; KEYS.forEach((k, i) => { (f as any)[k] = Boolean(m & (2 << i)); }); out.push(f); } return out; }
+if (import.meta.url === `file://${process.argv[1]}`) {
+  const cs = thingCases(); const sets = new Map(CAP_VOCAB.map((t) => [t.id, passSet(t, cs)])); let ok = 0, n = 0;
+  console.log(`${cs.length} cases`);
+  for (const t of CAP_VOCAB) { const v = validTest(t, cs); console.log(`${t.id.padEnd(20)} ${freeze(t)} ${v.length ? v.join("; ") : "valid"}`); }
+  for (const a of CAP_VOCAB) for (const [o, w] of Object.entries(a.predicts ?? {})) { n++; const g = relation(sets.get(a.id)!, sets.get(o)!); if (g === w) ok++; console.log(`${a.id} ~ ${o}: predicted ${w}, got ${g} -> ${g === w ? "confirmed" : "REFUTED"}`); }
+  console.log(`${ok}/${n} predictions confirmed`);
+}
