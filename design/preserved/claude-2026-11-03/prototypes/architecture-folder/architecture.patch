+// Where each part belongs: the Mentura model, the Mentura console, the Mentura app, or Naive.
+// Torian, 2026-11-01 07:14Z: Mentura is a model (like Claude); there is a Mentura app (web, desktop, mobile) and a
+// Mentura console (a venture development platform, as the Claude Console is a developer platform); Naive is the
+// framework where you customise your agents' interactions with the records and your own records and modules;
+// precog is a capability, partly in the model and partly in Naive's records. "Verify that RL and the rest belong
+// to the model, and that none of it is still assigned to Naive."
+//
+// Each home is a term with stated tests, run exhaustively, so the homes are proved pairwise disjoint over every
+// combination of facts. Then every element of the architecture record, and every part sketched but not yet in it,
+// is run against the four homes from its facts. Exactly one home = placed. Two or more = cannot happen (disjoint).
+// None = it is split (its parts need separate elements) or outside (a supplier), and the reason is printed.
+//   node --experimental-strip-types placement.ts        (writes placement-run.json)
+import { freeze, passSet, relation, run, validTest, type Base, type Relation, type Term } from "/home/user/ee-build/schema/terms/engine.ts";
+export type Part = Base & {
+  learned: boolean;        // behaviour comes from fitted parameters
+  producesModel: boolean;  // exists to train or evaluate the model: training data, rewards, environments, evals
+  hosted: boolean;         // runs on Moses David's servers
+  local: boolean;          // runs on the user's machine
+  shared: boolean;         // holds or serves records shared across accounts (the library)
+  builderUI: boolean;      // a screen where founders set up and run their venture's agents, modules and accounts
+  userUI: boolean;         // a screen where people work with Mentura day to day
+  holdsRecords: boolean;   // stores an account's records (private, not shared)
+  usesModel: boolean;      // calls a learned model it does not own the learning of (Claude, Grok, Jev, later Mentura); allowed anywhere
+  customisable: boolean;   // users change it: their records, modules, or how their agents act on records
+  ours: boolean;           // Moses David builds it (false for suppliers)
+};
+type P = [string, string, (f: Part) => boolean][];
+const mk = (id: string, label: string, meaning: string, props: P, predicts: Record<string, Relation>): Term<Part> =>
+  ({ id, label, level: "placement", kind: "role", form: "compound", meaning, sources: ["Torian 2026-11-01 07:14Z"], predicts, props: props.map(([pid, says, check]) => ({ id: pid, says, check })) });
+const OURS: P[number] = ["H0", "ours", (f) => f.ours];
+export const HOMES: Term<Part>[] = [
+  mk("mentura-model", "Mentura (the model)", "The model and everything that exists to produce it. The RL pipeline is here because it trains the model, not because it sits inside the weights.",
+    [OURS, ["MM1", "learned, or exists to produce the model", (f) => f.learned || f.producesModel], ["MM2", "not a screen", (f) => !f.userUI && !f.builderUI]],
+    { "mentura-console": "disjoint", "mentura-app": "disjoint", naive: "disjoint" }),
+  mk("mentura-console", "Mentura console", "The hosted venture development platform: accounts, the shared library of records, and the builder screens.",
+    [OURS, ["MC1", "hosted", (f) => f.hosted], ["MC2", "holds records (shared or an account's own) or is a builder screen", (f) => f.shared || f.holdsRecords || f.builderUI], ["MC3", "not learned and not model training", (f) => !f.learned && !f.producesModel], ["MC4", "not the day-to-day app", (f) => !f.userUI], ["MC5", "not on the user's machine", (f) => !f.local]],
+    { "mentura-app": "disjoint", naive: "disjoint" }),
+  mk("mentura-app", "Mentura app", "The app people work in, on web, desktop and mobile.",
+    [OURS, ["MA1", "a day-to-day screen", (f) => f.userUI], ["MA2", "not learned and not model training", (f) => !f.learned && !f.producesModel], ["MA3", "not a builder screen", (f) => !f.builderUI]],
+    { naive: "disjoint" }),
+  mk("naive", "Naive", "The framework on the user's machine where they customise their records, modules and how their agents act on records. Acts the same whichever agents drive it.",
+    [OURS, ["NV1", "on the user's machine", (f) => f.local], ["NV2", "not hosted", (f) => !f.hosted], ["NV3", "nothing learned", (f) => !f.learned], ["NV4", "not model training", (f) => !f.producesModel], ["NV5", "no screens of the app or console", (f) => !f.userUI && !f.builderUI]],
+    { "mentura-model": "disjoint" }),
+];
+const KEYS = ["learned", "producesModel", "hosted", "local", "shared", "holdsRecords", "builderUI", "userUI", "usesModel", "customisable", "ours"] as const;
+type F = Partial<Record<(typeof KEYS)[number], boolean>>;
+const L: F = { ours: true, local: true, customisable: true }; // a plain Naive part
+// Every element in naive.architecture.json, with its facts. `why` is the evidence (the element's own `says`).
+export const ELEMENTS: [string, F, string][] = [
+  ...["naive-cli", "mcp-server", "local-api", "dev-server", "generator-cli", "venture-workspace", "naive-core", "router", "write-gate", "provenance", "records-and-paths", "decisions", "lifecycle", "packages-and-kits", "checks", "lints", "term-engine", "upgrades", "releases-and-publishing", "brand", "money-and-team", "founders", "connector-contract", "generator", "function-interfaces", "term-submission"]
+    .map((id) => [id, L, "runs in-process or on 127.0.0.1 (record: part_of naive or naive-core)"] as [string, F, string]),
+  ["test-suite", { ours: true, local: true }, "development only"], ["lean-proofs", { ours: true, local: true }, "development only"], ["tla-models", { ours: true, local: true }, "development only"], ["dev-scripts", { ours: true, local: true }, "development only"],
+  ["agent-harness", { ...L, usesModel: true }, "runs an agent through Discovery and scores the run. The agent is a supplied model; the harness itself learns nothing, so it stays in Naive"],
+  ["verb-commands", { ...L, usesModel: true }, "maps a transcript to a glossary verb and runs it only on confirm; the transcript comes from a supplied speech model"],
+  ["console-app", { ours: true, hosted: true, builderUI: true }, "Next.js operator console, deployed on Vercel"],
+  ["webhooks-server", { ours: true, hosted: true, shared: true }, "receives signed change notices from systems of record"],
+  ["research-mcp", { ours: true, local: true, usesModel: false }, "MCP server over Firecrawl; runs where the agent runs"],
+  ["integrations", { ours: true, hosted: true, shared: true }, "vendor syncs (Rho, GitHub)"],
+  ["hosted-kits", { ours: true, hosted: true, shared: true }, "kits served by the platform"],
+  ["library", { ours: true, hosted: true, shared: true }, "shared research records, references, glossary, modules"],
+  ["tenant-instance", { ours: true, hosted: true, holdsRecords: true, customisable: true }, "one account's own records, hosted; not shared"],
+  ["library-gateway", { ours: true, hosted: true, shared: true }, "serves library records to tenants' agents"],
+  ["trace-intake", { ours: true, hosted: true, shared: true }, "receives consented, de-identified traces"],
+  ["library-curation", { ours: true, hosted: true, shared: true, usesModel: true }, "curator agents (supplied models now, Mentura later) propose updates; a stated rule re-reads sources; a person admits"],
+  ["research-engine", { ours: true, hosted: true, local: true }, "update theorem and research: runs on a library miss at the tenant, and in curation"],
+  ["precog", { ours: true, hosted: true, learned: true, local: true, userUI: true }, "anticipation (learned), needs records (Naive), delivered to the founder (app)"],
+  ["speech-to-text", { learned: true }, "supplier not chosen"],
+];
+// Parts sketched in earlier docs but not yet elements of the record.
+export const SKETCHED: [string, F, string][] = [
+  ["mentura-weights", { ours: true, learned: true }, "the model itself (designed)"],
+  ["rl-p0-offline-from-check-log", { ours: true, producesModel: true }, "RL doc YLQnmD6: offline RL from the check-outcome log"],
+  ["rl-p1-rlvr-grpo", { ours: true, producesModel: true }, "checks as verifiable rewards"],
+  ["rl-p2-brier-scoring", { ours: true, producesModel: true }, "calibrated decisions"],
+  ["rl-p3-dpo-decision-cards", { ours: true, producesModel: true }, "preference tuning on card choices (not RL)"],
+  ["rl-p4-process-reward", { ours: true, producesModel: true }, "process reward on agent traces"],
+  ["rl-environment", { producesModel: true }, "bought: Prime Intellect verifiers ranked first (supplier search)"],
+  ["precog-reward-p5", { ours: true, producesModel: true }, "lead time, Brier, grounding, coverage"],
+  ["check-outcome-log", { ...L }, "every check outcome logged as a record (decided 04:49Z); Naive writes it"],
+  ["training-set-from-check-log", { ours: true, producesModel: true, hosted: true }, "the log, collected with consent, becomes training data"],
+  ["precog-anticipation", { ours: true, learned: true }, "proposes needs before they are hit, calibrated"],
+  ["precog-need-records", { ...L }, "needs, supplier needs, function interests: records the agents read to anticipate"],
+  ["precog-gates", { ...L }, "records, research, proposed update, calibration, proof, alternatives: stated checks"],
+  ["precog-delivery", { ours: true, hosted: true, userUI: true }, "admissible anticipations shown to the founder"],
+  ["research-engine-local", { ...L }, "U1-U3 gate and cache, run at the tenant on a library miss"],
+  ["research-engine-curation", { ours: true, hosted: true, shared: true }, "the same theorem, run where curation re-reads sources"],
+  ["mentura-app-screens", { ours: true, hosted: true, userUI: true }, "web, desktop, mobile (designed)"],
+  ["mentura-console-screens", { ours: true, hosted: true, builderUI: true }, "accounts, keys, agents, modules (designed)"],
+];
+if (import.meta.url === `file://${process.argv[1]}`) {
+  const cs: Part[] = []; for (let m = 0; m < 2 ** (KEYS.length + 1); m++) { const f = { confirmed: Boolean(m & 1) } as Part; KEYS.forEach((k, i) => { (f as any)[k] = Boolean(m & (2 << i)); }); cs.push(f); }
+  const sets = new Map(HOMES.map((t) => [t.id, passSet(t, cs)]));
+  const valid = HOMES.map((t) => ({ id: t.id, hash: freeze(t), problems: validTest(t, cs) }));
+  const pairs: any[] = []; for (let i = 0; i < HOMES.length; i++) for (let j = i + 1; j < HOMES.length; j++) { const g = relation(sets.get(HOMES[i].id)!, sets.get(HOMES[j].id)!); pairs.push({ a: HOMES[i].id, b: HOMES[j].id, got: g, ok: g === "disjoint" }); }
+  const base = Object.fromEntries(KEYS.map((k) => [k, false]));
+  const place = ([id, fx, why]: [string, F, string], from: string) => { const f = { confirmed: true, ...base, ...fx } as Part; const homes = HOMES.filter((t) => run(t, f).pass).map((t) => t.id);
+    const reason = homes.length ? "" : !f.ours ? "outside: a supplier" : (f.learned && f.local) || (f.hosted && f.local) || (f.learned && (f.userUI || f.shared)) ? "split: its parts belong to different homes" : "unplaced";
+    return { id, from, facts: fx, why, homes, reason }; };
+  const rows = [...ELEMENTS.map((e) => place(e, "record")), ...SKETCHED.map((e) => place(e, "sketch"))];
+  const ids = new Set(ELEMENTS.map((e) => e[0]));
+  console.log(`== placement: ${cs.length} cases (exhaustive)`); for (const v of valid) console.log(`${v.id.padEnd(15)} ${v.hash} ${v.problems.length ? v.problems.join("; ") : "valid"}`);
+  for (const p of pairs) console.log(`${p.a} ~ ${p.b}: ${p.got} ${p.ok ? "" : "<- NOT DISJOINT"}`);
+  const t3 = rows.filter((r) => r.homes.includes("naive") && (r.facts.learned || r.facts.producesModel));
+  console.log(`\nT1 homes pairwise disjoint: ${pairs.every((p) => p.ok)}\nT2 no part in two homes: ${rows.every((r) => r.homes.length <= 1)}\nT3 nothing learned or model-training in Naive: ${t3.length === 0}\n`);
+  for (const r of rows) console.log(`${r.from.padEnd(6)} ${r.id.padEnd(30)} ${r.homes[0] ?? r.reason}`);
+  const fs = await import("node:fs"); fs.writeFileSync(new URL("./placement-run.json", import.meta.url), JSON.stringify({ ran: new Date().toISOString(), cases: cs.length, homes: valid, pairs, theorems: { T1: pairs.every((p) => p.ok), T2: rows.every((r) => r.homes.length <= 1), T3: t3.length === 0 }, rows }, null, 1));
+}
