+// What record holds the questions about a system, and how does it relate to problems, assumptions and decisions?
+// (Torian 2026-11-01 08:08Z.) Sources: IBIS (Kunz and Rittel 1970), QOC (MacLean et al. 1991), ISO/IEC/IEEE 42010
+// concerns, the RAID log, Science Buddies' engineering design process (define the problem: what, who). Level:
+// inquiry item (one thing a venture is trying to find out or settle). Exhaustive cross-run.
+//   node --experimental-strip-types inquiry-vocab.ts
+import { freeze, passSet, relation, validTest, type Base, type Relation, type Term } from "/home/user/ee-build/schema/terms/engine.ts";
+export type Inq = Base & {
+  interrogative: boolean; // stated as a question with a set of possible answers
+  answered: boolean;      // an answer is recorded
+  gap: boolean;           // names a gap between how things are and how someone needs them to be
+  holder: boolean;        // names who has it (a stakeholder)
+  heldTrue: boolean;      // is taken as true without confirmation
+  presupposed: boolean;   // another question or claim depends on it being true
+  future: boolean;        // an uncertain event that may happen
+  aboutSystem: boolean;   // about a particular system
+  options: boolean;       // lists options to choose among
+  ownerChooses: boolean;  // a person with the right settles it by choosing
+  byEvidence: boolean;    // settled by gathering evidence, not by choosing
+};
+type P = [string, string, (f: Inq) => boolean][];
+const T = (id: string, label: string, meaning: string, sources: string[], props: P, predicts?: Record<string, Relation>): Term<Inq> =>
+  ({ id, label, level: "inquiry item", kind: "kind", form: id.includes("-") ? "compound" : "word", meaning, sources, predicts, props: props.map(([pid, says, check]) => ({ id: pid, says, check })) } as Term<Inq>);
+const Q: P = [["Q1", "stated as a question", (f) => f.interrogative]];
+export const INQ: Term<Inq>[] = [
+  T("issue", "issue (open question)", "IBIS: a question not yet settled; positions answer it and arguments support or oppose them.", ["kunz-rittel-1970-ibis"],
+    [...Q, ["Q2", "not yet answered", (f) => !f.answered]], { "research-question": "has_a_kind", "open-decision": "has_a_kind", problem: "overlap" }),
+  T("research-question", "research question", "An issue settled by gathering evidence, not by choosing.", ["kunz-rittel-1970-ibis", "Naive validation (EE-050)"],
+    [...Q, ["Q2", "not yet answered", (f) => !f.answered], ["RQ1", "settled by evidence", (f) => f.byEvidence]], { issue: "is_a", "open-decision": "overlap" }),
+  T("open-decision", "open decision", "Naive's decision record while open: a question with options that a person with the right settles by choosing (QOC adds criteria).", ["maclean-1991-qoc", "schema/decision-record.schema.json"],
+    [...Q, ["Q2", "not yet answered", (f) => !f.answered], ["DC1", "options", (f) => f.options], ["DC2", "an owner chooses", (f) => f.ownerChooses]], { issue: "is_a", "research-question": "overlap" }),
+  T("problem", "problem", "A gap between how things are and how someone needs them to be, and who has it (engineering design process: what is the problem, who has it).", ["sciencebuddies-edp", "problem-vocab.ts"],
+    [["PB1", "names a gap", (f) => f.gap], ["PB2", "names who has it", (f) => f.holder]], { issue: "overlap", concern: "overlap", assumption: "overlap" }),
+  T("concern", "concern", "ISO/IEC/IEEE 42010: a matter of relevance or importance regarding a system to a stakeholder. Viewpoints frame concerns.", ["iso-42010-concern"],
+    [["CN1", "about a particular system", (f) => f.aboutSystem], ["CN2", "names who has it", (f) => f.holder]], { problem: "overlap", issue: "overlap" }),
+  T("assumption", "assumption", "RAID log: something taken as true without confirmation.", ["raid-log"],
+    [["AS1", "taken as true unconfirmed", (f) => f.heldTrue]], { premise: "has_a_kind", issue: "overlap" }),
+  T("premise", "premise", "An assumption another question or claim depends on: the thing to attack before answering (Naive frames hold premises and the moves to attack them).", ["schema/frame.schema.json", "gap-hunt skill"],
+    [["AS1", "taken as true unconfirmed", (f) => f.heldTrue], ["PR1", "something depends on it", (f) => f.presupposed]], { assumption: "is_a" }),
+  T("risk", "risk", "RAID log: an uncertain future event with an impact if it happens.", ["raid-log"],
+    [["RK1", "uncertain future event", (f) => f.future]], { issue: "overlap", assumption: "overlap", problem: "overlap" }),
+];
+const KEYS = ["interrogative", "answered", "gap", "holder", "heldTrue", "presupposed", "future", "aboutSystem", "options", "ownerChooses", "byEvidence"] as const;
+export function inqCases(): Inq[] { const out: Inq[] = []; for (let m = 0; m < 2 ** (KEYS.length + 1); m++) { const f = { confirmed: Boolean(m & 1), label: ["question", "problem", undefined][m % 3] } as Inq; KEYS.forEach((k, i) => { (f as any)[k] = Boolean(m & (2 << i)); }); out.push(f); } return out; }
+if (import.meta.url === `file://${process.argv[1]}`) {
+  const cs = inqCases(); const sets = new Map(INQ.map((t) => [t.id, passSet(t, cs)])); let ok = 0, n = 0;
+  console.log(`${cs.length} cases`);
+  for (const t of INQ) { const v = validTest(t, cs); console.log(`${t.id.padEnd(18)} ${freeze(t)} ${v.length ? v.join("; ") : "valid"}`); }
+  for (const a of INQ) for (const [o, w] of Object.entries(a.predicts ?? {})) { n++; const g = relation(sets.get(a.id)!, sets.get(o)!); if (g === w) ok++; console.log(`${a.id} ~ ${o}: predicted ${w}, got ${g} -> ${g === w ? "confirmed" : "REFUTED"}`); }
+  console.log(`${ok}/${n} predictions confirmed`);
+}
