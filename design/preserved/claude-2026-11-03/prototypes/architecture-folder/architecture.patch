+// "declarative chains with generative endpoints" (Torian 2026-11-01 09:00Z; EE-100). Level: part of a route table.
+//   node --experimental-strip-types endpoint-vocab.ts
+import { freeze, passSet, relation, validTest, type Base, type Relation, type Term } from "/home/user/ee-build/schema/terms/engine.ts";
+export type R = Base & {
+  answersRequests: boolean;  // a place requests arrive and get an answer (a route's end)
+  declaredAsData: boolean;   // written down as data (a list of steps), not only as code
+  orderedSteps: boolean;     // a sequence of steps run in order
+  missingTypeOpensResearch: boolean; // when its record type has no schema or generator, it opens research instead of only failing
+  personAdmits: boolean;     // what the research proposes becomes real only when a person admits it
+  makesEndpoints: boolean;   // can result in new endpoints
+};
+type P = [string, string, (f: R) => boolean][];
+const T = (id: string, label: string, meaning: string, sources: string[], props: P, predicts?: Record<string, Relation>): Term<R> =>
+  ({ id, label, level: "route table part", kind: "kind", form: id.includes("-") ? "compound" : "word", meaning, sources, predicts, props: props.map(([pid, says, check]) => ({ id: pid, says, check })) } as Term<R>);
+export const EP: Term<R>[] = [
+  T("endpoint", "endpoint", "Where a request arrives and gets an answer: in Naive, a route such as product/bugs/<id>.", ["common web API usage", "interface/router.mjs routes()"],
+    [["EP1", "answers requests", (f) => f.answersRequests]], { "generative-endpoint": "has_a_kind", "declarative-chain": "disjoint" }),
+  T("declarative-chain", "declarative chain", "A sequence of steps written down as data and run in order, such as the write chain's 13 steps.", ["naive.architecture.json flows.write", "EE-100"],
+    [["DC1", "declared as data", (f) => f.declaredAsData], ["DC2", "ordered steps", (f) => f.orderedSteps], ["DC3", "not itself an endpoint", (f) => !f.answersRequests]], { endpoint: "disjoint" }),
+  T("generative-endpoint", "generative endpoint", "An endpoint that, when its record type has no schema or record generator yet, opens research that proposes them and the route; a person admits them, so the endpoint can produce new endpoints.", ["EE-100", "EE-099"],
+    [["EP1", "answers requests", (f) => f.answersRequests], ["GE1", "a missing type opens research", (f) => f.missingTypeOpensResearch], ["GE2", "a person admits what it proposes", (f) => f.personAdmits], ["GE3", "can make new endpoints", (f) => f.makesEndpoints]], { endpoint: "is_a", "declarative-chain": "disjoint" }),
+];
+const KEYS = ["answersRequests", "declaredAsData", "orderedSteps", "missingTypeOpensResearch", "personAdmits", "makesEndpoints"] as const;
+if (import.meta.url === `file://${process.argv[1]}`) {
+  const cs: R[] = []; for (let m = 0; m < 2 ** (KEYS.length + 1); m++) { const f = { confirmed: Boolean(m & 1), label: ["endpoint", undefined][m % 2] } as R; KEYS.forEach((k, i) => { (f as any)[k] = Boolean(m & (2 << i)); }); cs.push(f); }
+  const sets = new Map(EP.map((t) => [t.id, passSet(t, cs)])); let ok = 0, n = 0;
+  for (const t of EP) { const v = validTest(t, cs); console.log(`${t.id.padEnd(20)} ${freeze(t)} ${v.length ? v.join("; ") : "valid"}`); }
+  for (const a of EP) for (const [o, w] of Object.entries(a.predicts ?? {})) { n++; const g = relation(sets.get(a.id)!, sets.get(o)!); if (g === w) ok++; console.log(`${a.id} ~ ${o}: predicted ${w}, got ${g} -> ${g === w ? "confirmed" : "REFUTED"}`); }
+  console.log(`${ok}/${n} predictions confirmed`);
+}
