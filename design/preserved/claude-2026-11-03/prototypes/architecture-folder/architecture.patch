+// Research terms (Torian, 2026-11-01 04:25Z): store AI research as records; separate research areas from product
+// capabilities; whether to call ourselves an AI lab; neuro-symbolic types (Polity's observer is one too).
+// Three levels, each exhaustive over its facts.
+//
+//   node research-vocab.ts
+
+import { freeze, passSet, relation, run, validTest, type Base, type Relation, type Term } from "/home/user/ee-build/schema/terms/engine.ts";
+
+type P<F> = [string, string, (f: F) => boolean][];
+const mk = <F extends Base>(level: string) => (id: string, label: string, meaning: string, sources: string[], props: P<F>, predicts?: Record<string, Relation>): Term<F> =>
+  ({ id, label, level, kind: "role", form: "word", meaning, sources, predicts, props: props.map(([pid, says, check]) => ({ id: pid, says, check })) });
+
+function cases<F extends Base>(keys: readonly string[], labels: string[]): F[] {
+  const out: F[] = [];
+  for (let m = 0; m < 2 ** (keys.length + 1); m++) {
+    const f = { confirmed: Boolean(m & 1), label: [...labels, undefined][m % (labels.length + 1)] } as F;
+    keys.forEach((k, i) => { (f as Record<string, unknown>)[k] = Boolean(m & (2 << i)); });
+    out.push(f);
+  }
+  return out;
+}
+
+// ---- level 1: a link between a venture and an area of AI
+export type Link = Base & {
+  doesResearch: boolean;   // the venture builds models or methods in the area (papers, trained models, new methods)
+  productOffers: boolean;  // one of its products does the thing for users
+  viaSupplier: boolean;    // the product does it with another venture's model or platform
+  usesPlatform: boolean;   // the venture calls another venture's platform for it
+};
+const L = mk<Link>("venture-area link");
+export const LINK_VOCAB: Term<Link>[] = [
+  L("researches", "researches (an area)", "The venture builds models or methods in the area. A product that merely offers the capability does not count.",
+    ["arXiv category taxonomy (areas)", "research areas doc 2026-11-01"],
+    [["RS1", "builds models or methods in the area", (f) => f.doesResearch]],
+    { "offers-capability": "overlap", "supplied-capability": "overlap", "depends-on-platform": "disjoint" }),
+  L("offers-capability", "offers a capability", "A product of the venture does the thing for its users, by whatever means.",
+    ["Product Anatomy Matrix (2026-11-01)"],
+    [["PC1", "a product does it", (f) => f.productOffers]],
+    { "own-capability": "has_a_kind", "supplied-capability": "has_a_kind", researches: "overlap" }),
+  L("own-capability", "own capability", "A capability the venture's product delivers with the venture's own model or method.",
+    ["research records 2026-11-01"],
+    [["PC1", "a product does it", (f) => f.productOffers], ["OC1", "not via a supplier", (f) => !f.viaSupplier], ["RS1", "builds models or methods in the area", (f) => f.doesResearch]],
+    { "offers-capability": "is_a", "supplied-capability": "disjoint", researches: "is_a" }),
+  L("supplied-capability", "supplied capability", "A capability the venture's product delivers with another venture's model. Claude's voice mode with ElevenLabs text-to-speech is one.",
+    ["The Decoder 2025-05-31 (ElevenLabs as Anthropic's TTS subcontractor)"],
+    [["PC1", "a product does it", (f) => f.productOffers], ["SC1", "via a supplier", (f) => f.viaSupplier]],
+    { "offers-capability": "is_a", "own-capability": "disjoint", "depends-on-platform": "overlap" }),
+  L("depends-on-platform", "depends on a platform (tooling)", "The venture uses another venture's platform for the area and does not research it. Our use of agent runtimes is one.",
+    ["dependency record type (venture library doc)"],
+    [["DP1", "uses another's platform", (f) => f.usesPlatform], ["DP2", "does not research the area", (f) => !f.doesResearch]],
+    { researches: "disjoint", "supplied-capability": "overlap" }),
+];
+
+// ---- level 2: an organization that works with AI
+export type Org = Base & {
+  researchIsMain: boolean;     // research is the organization's main activity
+  publishes: boolean;          // publishes research (papers, open methods or weights)
+  trainsModels: boolean;       // trains models of its own
+  frontierScale: boolean;      // trains at the largest scale of its time
+  sellsProducts: boolean;      // sells products to customers
+  buildsOnOthers: boolean;     // its products run on other ventures' models
+};
+const O = mk<Org>("organization");
+export const ORG_VOCAB: Term<Org>[] = [
+  O("ai-lab", "AI lab", "An organization whose main activity is AI research, which it publishes or ships as models.",
+    ["Common usage: 'research lab' (OpenAI, Anthropic, DeepMind, Thinking Machines Lab, AMI Labs)"],
+    [["AL1", "research is the main activity", (f) => f.researchIsMain], ["AL2", "publishes", (f) => f.publishes]],
+    { "frontier-lab": "has_a_kind", "applied-ai-company": "disjoint" }),
+  O("frontier-lab", "frontier lab", "An AI lab that trains models at the largest scale of its time.",
+    ["Common usage (frontier model developers)"],
+    [["AL1", "research is the main activity", (f) => f.researchIsMain], ["AL2", "publishes", (f) => f.publishes], ["FL1", "trains own models", (f) => f.trainsModels], ["FL2", "at frontier scale", (f) => f.frontierScale]],
+    { "ai-lab": "is_a", "applied-ai-company": "disjoint" }),
+  O("applied-ai-company", "applied AI company", "A company that sells products built on AI, where research is not the main activity.",
+    ["Common usage"],
+    [["AP1", "sells products", (f) => f.sellsProducts], ["AP2", "research is not the main activity", (f) => !f.researchIsMain]],
+    { "ai-lab": "disjoint", "model-builder": "overlap" }),
+  O("model-builder", "model builder", "Any organization that trains models of its own, lab or not.",
+    ["Common usage"],
+    [["FL1", "trains own models", (f) => f.trainsModels]],
+    { "frontier-lab": "has_a_kind", "applied-ai-company": "overlap" }),
+];
+
+// ---- level 3: a system with neural and symbolic parts (Kautz, AAAI 2020)
+export type NS = Base & {
+  neuralPart: boolean;
+  symbolicPart: boolean;
+  symbolicCallsNeural: boolean;   // a symbolic solver calls a model as a subroutine
+  neuralCallsSymbolic: boolean;   // a model calls a symbolic engine as a tool
+  pipeline: boolean;              // the parts run in sequence and pass results
+};
+const N = mk<NS>("neuro-symbolic system");
+export const NS_VOCAB: Term<NS>[] = [
+  N("kautz-type-2", "Symbolic[Neuro] (Kautz Type 2)", "A symbolic solver calls a model as a subroutine (AlphaGo: tree search with a neural evaluator).",
+    ["Kautz, AAAI 2020 (summary: neonvagabond.xyz/mirrors/neuro-symbolic-types.html)"],
+    [["NS0", "has both parts", (f) => f.neuralPart && f.symbolicPart], ["K2", "symbolic calls neural", (f) => f.symbolicCallsNeural], ["K2b", "neural does not call symbolic", (f) => !f.neuralCallsSymbolic]],
+    { "kautz-type-6": "disjoint", "kautz-type-3": "overlap" }),
+  N("kautz-type-3", "Neuro;Symbolic (Kautz Type 3)", "Neural and symbolic parts run in a pipeline and pass results. Our records-first design and Polity's observer ('code decides; models only classify inputs') are this type.",
+    ["Kautz, AAAI 2020", "polity-os rule"],
+    [["NS0", "has both parts", (f) => f.neuralPart && f.symbolicPart], ["K3", "pipeline", (f) => f.pipeline]],
+    { "kautz-type-2": "overlap", "kautz-type-6": "overlap" }),
+  N("kautz-type-6", "Neuro[Symbolic] (Kautz Type 6)", "A model calls a symbolic engine when it needs one (an assistant using a calculator or prover as a tool).",
+    ["Kautz, AAAI 2020 (types 4 to 6 from a search summary; verify)"],
+    [["NS0", "has both parts", (f) => f.neuralPart && f.symbolicPart], ["K6", "neural calls symbolic", (f) => f.neuralCallsSymbolic], ["K6b", "symbolic does not call neural", (f) => !f.symbolicCallsNeural]],
+    { "kautz-type-2": "disjoint", "kautz-type-3": "overlap" }),
+];
+
+function report<F extends Base>(name: string, vocab: Term<F>[], cs: F[], ex: [string, Partial<F>][], base: F) {
+  const sets = new Map(vocab.map((t) => [t.id, passSet(t, cs)])); let ok = 0, n = 0;
+  console.log(`\n== ${name}: ${cs.length} cases`);
+  for (const t of vocab) { const v = validTest(t, cs); console.log(`${t.id.padEnd(22)} ${freeze(t)} ${v.length ? v.join("; ") : "valid"}`); }
+  for (const a of vocab) for (const [o, w] of Object.entries(a.predicts ?? {})) {
+    n++; const g = relation(sets.get(a.id)!, sets.get(o)!); if (g === w) ok++;
+    console.log(`${a.id} ~ ${o}: predicted ${w}, got ${g} -> ${g === w ? "confirmed" : "REFUTED"}`);
+  }
+  console.log(`${ok}/${n} predictions confirmed`);
+  for (const [nm, facts] of ex) console.log(`  ${nm.padEnd(52)} ${vocab.filter((t) => run(t, { ...base, ...facts } as F).pass).map((t) => t.id).join(", ") || "(no term)"}`);
+  return [ok, n];
+}
+
+if (import.meta.url === `file://${process.argv[1]}`) {
+  const lb = { confirmed: true, label: undefined, doesResearch: false, productOffers: false, viaSupplier: false, usesPlatform: false } as Link;
+  const ob = { confirmed: true, label: undefined, researchIsMain: false, publishes: false, trainsModels: false, frontierScale: false, sellsProducts: false, buildsOnOthers: false } as Org;
+  const nb = { confirmed: true, label: undefined, neuralPart: true, symbolicPart: true, symbolicCallsNeural: false, neuralCallsSymbolic: false, pipeline: false } as NS;
+  const r = [
+    report("link", LINK_VOCAB, cases<Link>(["doesResearch", "productOffers", "viaSupplier", "usesPlatform"], ["area"]), [
+      ["Anthropic ~ language", { doesResearch: true, productOffers: true }],
+      ["Anthropic ~ speech (voice mode via ElevenLabs)", { productOffers: true, viaSupplier: true }],
+      ["ElevenLabs ~ speech", { doesResearch: true, productOffers: true }],
+      ["ElevenLabs ~ language (Claude selectable)", { productOffers: true, viaSupplier: true, usesPlatform: true }],
+      ["Naive ~ agents (run on others' runtimes)", { productOffers: true, viaSupplier: true, usesPlatform: true }],
+      ["Naive ~ logic and verification (term engine, Lean)", { doesResearch: true, productOffers: true }],
+    ], lb),
+    report("organization", ORG_VOCAB, cases<Org>(["researchIsMain", "publishes", "trainsModels", "frontierScale", "sellsProducts", "buildsOnOthers"], ["lab", "company"]), [
+      ["Anthropic", { researchIsMain: true, publishes: true, trainsModels: true, frontierScale: true, sellsProducts: true }],
+      ["TypeSafe (Jev)", { researchIsMain: true, publishes: true, trainsModels: true, sellsProducts: true }],
+      ["ElevenLabs", { trainsModels: true, sellsProducts: true, buildsOnOthers: true }],
+      ["Naive + Mentura today", { sellsProducts: true, buildsOnOthers: true }],
+      ["Naive + Mentura if research became main and published", { researchIsMain: true, publishes: true, sellsProducts: true, buildsOnOthers: true }],
+    ], ob),
+    report("neuro-symbolic", NS_VOCAB, cases<NS>(["neuralPart", "symbolicPart", "symbolicCallsNeural", "neuralCallsSymbolic", "pipeline"], ["system"]), [
+      ["AlphaGo", { symbolicCallsNeural: true }],
+      ["Records-first (model proposes, checks decide)", { pipeline: true }],
+      ["Mentura research engine (engine calls a model)", { pipeline: true, symbolicCallsNeural: true }],
+      ["Polity observer ('code decides; models classify')", { pipeline: true }],
+      ["Assistant calling Lean through a tool", { neuralCallsSymbolic: true }],
+    ], nb),
+  ];
+  console.log(`\nTOTAL ${r.reduce((a, x) => a + x[0], 0)}/${r.reduce((a, x) => a + x[1], 0)}`);
+}
