+// Kinds of model (Torian, 2026-11-01 04:03Z: Jev is a model that does not generate language; "a language model is a
+// System 2 model"; world models). One level: model (a trained neural network). Exhaustive over the facts.
+//
+//   node model-vocab.ts
+
+import { freeze, passSet, relation, run, validTest, type Base, type Relation, type Term } from "/home/user/ee-build/schema/terms/engine.ts";
+
+type P<F> = [string, string, (f: F) => boolean][];
+const mk = <F extends Base>(level: string) => (id: string, label: string, meaning: string, sources: string[], props: P<F>, predicts?: Record<string, Relation>): Term<F> =>
+  ({ id, label, level, kind: "role", form: "word", meaning, sources, predicts, props: props.map(([pid, says, check]) => ({ id: pid, says, check })) });
+
+export type Model = Base & {
+  generatesText: boolean;       // its output is new text, token by token
+  deliberates: boolean;         // spends extra computation on intermediate steps before its answer (test-time reasoning)
+  typedOutput: boolean;         // returns one of a fixed set of typed outcomes (a choice, yes/no, a score)
+  calibrated: boolean;          // its probabilities are trained to be honest
+  predictsNextState: boolean;   // predicts how an environment changes given a state and an action
+  vectorPerItem: boolean;       // returns one vector per input item
+};
+const M = mk<Model>("model");
+export const MODEL_VOCAB: Term<Model>[] = [
+  M("language-model", "language model", "A model that generates text by predicting the next token.",
+    ["Bengio et al. 2003", "survey arXiv 2502.17419"],
+    [["LM1", "generates text", (f) => f.generatesText]],
+    { "reasoning-model": "has_a_kind", "decision-model": "disjoint", "embedding-model": "disjoint" }),
+  M("reasoning-model", "reasoning model", "A language model that writes intermediate steps before its answer; the System 2 analogue in the survey.",
+    ["From System 1 to System 2 (arXiv 2502.17419)"],
+    [["LM1", "generates text", (f) => f.generatesText], ["RM1", "deliberates before answering", (f) => f.deliberates]],
+    { "language-model": "is_a", "decision-model": "disjoint" }),
+  M("decision-model", "decision model", "A non-generative model that returns one typed outcome with a calibrated probability, for code to read. TypeSafe's Jev; TypeSafe calls it a System One model.",
+    ["typesafe.ai/manifesto", "latent.space/p/jev"],
+    [["DM1", "no text generated", (f) => !f.generatesText], ["DM2", "typed output", (f) => f.typedOutput], ["DM3", "calibrated", (f) => f.calibrated]],
+    { "language-model": "disjoint", "reasoning-model": "disjoint", "embedding-model": "disjoint", "world-model": "overlap" }),
+  M("embedding-model", "embedding model", "A model that returns one vector per input item, so similar items lie close.",
+    ["Mikolov et al. 2013"],
+    [["EM1", "one vector per item", (f) => f.vectorPerItem], ["EM2", "no text generated", (f) => !f.generatesText], ["EM3", "no typed outcome", (f) => !f.typedOutput]],
+    { "language-model": "disjoint", "decision-model": "disjoint" }),
+  M("world-model", "world model", "A model that predicts the next state of an environment given a state and an action (JEPA, Genie, Cosmos).",
+    ["Ha and Schmidhuber, World Models (2018)", "LeCun, A Path Towards Autonomous Machine Intelligence (2022)"],
+    [["WM1", "predicts next state from state and action", (f) => f.predictsNextState]],
+    { "language-model": "overlap", "decision-model": "overlap" }),
+];
+
+export function modelCases(): Model[] {
+  const keys = ["generatesText", "deliberates", "typedOutput", "calibrated", "predictsNextState", "vectorPerItem"] as const;
+  const labels = ["model", "AI"];
+  const out: Model[] = [];
+  for (let m = 0; m < 2 ** (keys.length + 1); m++) {
+    const f = { confirmed: Boolean(m & 1), label: [...labels, undefined][m % (labels.length + 1)] } as Model;
+    keys.forEach((k, i) => { (f as Record<string, unknown>)[k] = Boolean(m & (2 << i)); });
+    out.push(f);
+  }
+  return out;
+}
+
+if (import.meta.url === `file://${process.argv[1]}`) {
+  const cs = modelCases();
+  const sets = new Map(MODEL_VOCAB.map((t) => [t.id, passSet(t, cs)])); let ok = 0, n = 0;
+  console.log(`== model: ${cs.length} cases`);
+  for (const t of MODEL_VOCAB) { const v = validTest(t, cs); console.log(`${t.id.padEnd(18)} ${freeze(t)} ${v.length ? v.join("; ") : "valid"}`); }
+  for (const a of MODEL_VOCAB) for (const [o, w] of Object.entries(a.predicts ?? {})) {
+    n++; const g = relation(sets.get(a.id)!, sets.get(o)!); if (g === w) ok++;
+    console.log(`${a.id} ~ ${o}: predicted ${w}, got ${g} -> ${g === w ? "confirmed" : "REFUTED"}`);
+  }
+  console.log(`\n${ok}/${n} predictions confirmed`);
+  const base = { confirmed: true, label: undefined, generatesText: false, deliberates: false, typedOutput: false, calibrated: false, predictsNextState: false, vectorPerItem: false } as Model;
+  const ex: [string, Partial<Model>][] = [
+    ["Jev (TypeSafe)", { typedOutput: true, calibrated: true }],
+    ["Base chat model", { generatesText: true }],
+    ["Reasoning model (o1-style)", { generatesText: true, deliberates: true }],
+    ["Genie 3 / Cosmos-style world model", { predictsNextState: true }],
+    ["Text embedding model", { vectorPerItem: true }],
+  ];
+  console.log("\n== examples");
+  for (const [name, facts] of ex) console.log(`${name.padEnd(36)} ${MODEL_VOCAB.filter((t) => run(t, { ...base, ...facts } as Model).pass).map((t) => t.id).join(", ") || "(no term)"}`);
+}
