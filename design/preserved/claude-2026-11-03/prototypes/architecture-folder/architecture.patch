+++ b/project-files/naive-design/prototypes/architecture/Capability.lean
@@ -0,0 +1,38 @@
+/- Capability and provenance (2026-11-01, Torian: "is provenance a capability?"). Mirrors capability-vocab.ts.
+   Core Lean only. -/
+namespace Naive.Capability
+
+structure Thing where
+  ability : Bool
+  holderNamed : Bool
+  information : Bool
+  aboutOrigin : Bool
+  appendOnly : Bool
+  structural : Bool
+  producesOrigin : Bool
+
+/-- ArchiMate: an ability of a named holder; behaviour, not structure and not information. -/
+def Capability (t : Thing) : Prop :=
+  t.ability = true ∧ t.holderNamed = true ∧ t.structural = false ∧ t.information = false
+/-- W3C PROV: information about origin. -/
+def Provenance (t : Thing) : Prop := t.information = true ∧ t.aboutOrigin = true
+def Tracking (t : Thing) : Prop := Capability t ∧ t.producesOrigin = true
+def Log (t : Thing) : Prop := Provenance t ∧ t.appendOnly = true
+def Module (t : Thing) : Prop := t.structural = true ∧ t.producesOrigin = true
+
+theorem tracking_is_capability {t : Thing} (h : Tracking t) : Capability t := h.1
+theorem log_is_provenance {t : Thing} (h : Log t) : Provenance t := h.1
+/-- The answer to Torian's question: provenance is information, so it is never a capability. -/
+theorem provenance_not_capability {t : Thing} (p : Provenance t) (c : Capability t) : False := by
+  unfold Provenance at p; unfold Capability at c; simp_all
+/-- The module realises the capability; it is not the capability (structure, not behaviour). -/
+theorem module_not_capability {t : Thing} (m : Module t) (c : Capability t) : False := by
+  unfold Module at m; unfold Capability at c; simp_all
+theorem log_not_capability {t : Thing} (l : Log t) (c : Capability t) : False :=
+  provenance_not_capability l.1 c
+/-- A module and a log overlap (a structural part that is also an append-only provenance file). -/
+def moduleAndLog : Thing := ⟨false, false, true, true, true, true, true⟩
+theorem module_log_overlap : Module moduleAndLog ∧ Log moduleAndLog := by
+  simp [Module, Log, Provenance, moduleAndLog]
+
+end Naive.Capability
diff --git a/project-files/naive-design/prototypes/architecture/Conversation.lean b/project-files/naive-design/prototypes/architecture/Conversation.lean
new file mode 100644
index 0000000..a9bc0ba
