+// The idea pipeline (Torian 2026-11-01 07:35Z): how an idea moves from sketched to designed, architected,
+// implemented, verified and proved, held statefully and sandboxed, so every idea flows through one chain.
+// Each stage is a term with stated tests over an idea's evidence. Stages are proved pairwise disjoint over every
+// combination of facts; combinations that match no stage are ILLEGAL states (for example: in the record but its
+// checks fail), and the run lists them, because the check must flag them. Then every element of the architecture
+// record and every sketched part is given its stage from evidence, never from a declared label.
+//   node --experimental-strip-types stage.ts          (writes stage-run.json)
+import { freeze, passSet, relation, run, validTest, type Base, type Term } from "/home/user/ee-build/schema/terms/engine.ts";
+import { readFileSync, writeFileSync, existsSync } from "node:fs";
+export type Ev = Base & {
+  captured: boolean;       // the idea exists as a record (an idea dump, a message, a problem record)
+  drawn: boolean;          // a sketch exists: a doc, artifact or drawing (not checkable)
+  termsAdmitted: boolean;  // every new word it uses is admitted by the term engine
+  traced: boolean;         // it traces to a need or requirement
+  inRecord: boolean;       // it is an element (or flow) of the master architecture record
+  recordChecks: boolean;   // arch-check passes with it in the record
+  codeExists: boolean;     // code that implements it exists on main
+  conforms: boolean;       // a conformance check (A12 flow anchors, derived facts) shows code = design
+  tested: boolean;         // it has tests that pass
+  proved: boolean;         // the claims about it are Lean theorems that build
+  retired: boolean;        // taken out by a decision
+};
+type P = [string, string, (f: Ev) => boolean][];
+const ALIVE: P[number] = ["S0", "not retired", (f) => !f.retired];
+const mk = (id: string, meaning: string, props: P): Term<Ev> =>
+  ({ id, label: id, level: "idea stage", kind: "role", form: "word", meaning, sources: ["Torian 2026-11-01 07:35Z; verbs-vocab.ts (sketch, design, architect); G0-G4 gate chain (architecture-record, 2026-10-31)"], props: props.map(([pid, says, check]) => ({ id: pid, says, check })) });
+const designedEv = (f: Ev) => f.drawn && f.termsAdmitted && f.traced;
+export const STAGES: Term<Ev>[] = [
+  mk("captured", "The idea exists as a record and nothing more: no drawing yet.", [ALIVE, ["CP1", "captured", (f) => f.captured], ["CP2", "nothing drawn", (f) => !f.drawn], ["CP3", "not in the record", (f) => !f.inRecord], ["CP4", "no code", (f) => !f.codeExists]]),
+  mk("sketched", "A drawing exists. Not checkable. Lives only in the sandbox.", [ALIVE, ["SK1", "drawn", (f) => f.drawn], ["SK2", "not yet designed (terms or trace missing)", (f) => !(f.termsAdmitted && f.traced)], ["SK3", "not in the record", (f) => !f.inRecord], ["SK4", "no code", (f) => !f.codeExists]]),
+  mk("designed", "Its words pass the term engine (gate G0) and it traces to a need. Still in the sandbox.", [ALIVE, ["DE1", "drawn, terms admitted, traced", designedEv], ["DE2", "not in the record", (f) => !f.inRecord], ["DE3", "no code", (f) => !f.codeExists]]),
+  mk("architected", "Appended to the master architecture record with its checks passing (G1). The blueprint code is built from.", [ALIVE, ["AR1", "in the record", (f) => f.inRecord], ["AR2", "record checks pass", (f) => f.recordChecks], ["AR3", "terms admitted and traced", (f) => f.termsAdmitted && f.traced], ["AR4", "no code yet", (f) => !f.codeExists]]),
+  mk("implemented", "Code exists for an architected part, but conformance or tests are not yet shown.", [ALIVE, ["AR1", "in the record", (f) => f.inRecord], ["AR2", "record checks pass", (f) => f.recordChecks], ["IM1", "code exists", (f) => f.codeExists], ["IM2", "not yet verified", (f) => !(f.conforms && f.tested)]]),
+  mk("verified", "Code conforms to the design (G2) and its tests pass (G3).", [ALIVE, ["AR1", "in the record", (f) => f.inRecord], ["AR2", "record checks pass", (f) => f.recordChecks], ["IM1", "code exists", (f) => f.codeExists], ["VE1", "conforms", (f) => f.conforms], ["VE2", "tested", (f) => f.tested], ["VE3", "not yet proved", (f) => !f.proved]]),
+  mk("proved", "Verified, and its claims are Lean theorems that build (G4).", [ALIVE, ["AR1", "in the record", (f) => f.inRecord], ["AR2", "record checks pass", (f) => f.recordChecks], ["IM1", "code exists", (f) => f.codeExists], ["VE1", "conforms", (f) => f.conforms], ["VE2", "tested", (f) => f.tested], ["PR1", "proved", (f) => f.proved]]),
+  mk("retired", "Taken out by a decision; kept, never deleted.", [["RT1", "retired", (f) => f.retired]]),
+];
+export const ORDER = ["captured", "sketched", "designed", "architected", "implemented", "verified", "proved"];
+// Transitions: only to the next stage, each through one gate and one kind of actor; any stage to retired by a person.
+export const TRANSITIONS = [
+  { from: "captured", to: "sketched", gate: "a drawing: a doc, artifact or diagram", by: "any agent or person, in the sandbox" },
+  { from: "sketched", to: "designed", gate: "G0 vocabulary: new words run through the term engine; trace to a need", by: "any agent, in the sandbox" },
+  { from: "designed", to: "architected", gate: "G1: append to the master record; arch-check passes", by: "an agent may append when every check passes; Torian confirms later (card 06:20Z)" },
+  { from: "architected", to: "implemented", gate: "a pull request whose code names the element", by: "Grok builds from the PR handoff (we plan, Grok builds)" },
+  { from: "implemented", to: "verified", gate: "G2 conformance (flow-check A12, derived facts) and G3 tests", by: "CI and the checks; no person needed" },
+  { from: "verified", to: "proved", gate: "G4: Lean theorems for its claims build", by: "the phases thread builds Lean" },
+  { from: "verified", to: "implemented", gate: "regression: a conformance or test check fails", by: "the checks, automatically" },
+  { from: "*", to: "retired", gate: "an amend with a decision record", by: "a person" },
+];
+export const SANDBOX = { paths: ["naive-design/prototypes/", "naive-design/*.md", "claude.ai artifacts and docs"], rules: [
+  "SB1 below architected, an idea lives only in the sandbox: no element in the record, no code on main",
+  "SB2 code on main never imports from the sandbox",
+  "SB3 code on main for a part the record does not hold is drift: it must be architected or removed",
+] };
+const KEYS = ["captured", "drawn", "termsAdmitted", "traced", "inRecord", "recordChecks", "codeExists", "conforms", "tested", "proved", "retired"] as const;
+if (import.meta.url === `file://${process.argv[1]}`) {
+  const cs: Ev[] = []; for (let m = 0; m < 2 ** (KEYS.length + 1); m++) { const f = { confirmed: Boolean(m & 1) } as Ev; KEYS.forEach((k, i) => { (f as any)[k] = Boolean(m & (2 << i)); }); cs.push(f); }
+  const sets = new Map(STAGES.map((t) => [t.id, passSet(t, cs)]));
+  const valid = STAGES.map((t) => ({ id: t.id, hash: freeze(t), problems: validTest(t, cs) }));
+  const pairs: any[] = []; for (let i = 0; i < STAGES.length; i++) for (let j = i + 1; j < STAGES.length; j++) pairs.push({ a: STAGES[i].id, b: STAGES[j].id, got: relation(sets.get(STAGES[i].id)!, sets.get(STAGES[j].id)!) });
+  const covered = new Set<number>(); for (const s of sets.values()) for (const x of s) covered.add(x);
+  const illegal = cs.map((c, i) => [c, i] as const).filter(([c, i]) => c.confirmed && !covered.has(i));
+  const sample = (pred: (f: Ev) => boolean) => illegal.some(([c]) => pred(c));
+  const illegalKinds = [
+    ["in the record but its checks fail", (f: Ev) => !f.retired && f.inRecord && !f.recordChecks],
+    ["code exists but the record does not hold it (drift, SB3)", (f: Ev) => !f.retired && f.codeExists && !f.inRecord],
+    ["in the record without admitted terms or a trace, and no code", (f: Ev) => !f.retired && f.inRecord && f.recordChecks && !f.codeExists && !(f.termsAdmitted && f.traced)],
+    ["nothing exists: not captured, drawn, recorded or coded", (f: Ev) => !f.retired && !f.captured && !f.drawn && !f.inRecord && !f.codeExists],
+  ].map(([says, pred]: any) => ({ says, occurs: sample(pred) }));
+  const explained = illegal.every(([c]) => illegalKinds.some((k: any, idx) => [
+    (f: Ev) => !f.retired && f.inRecord && !f.recordChecks, (f: Ev) => !f.retired && f.codeExists && !f.inRecord,
+    (f: Ev) => !f.retired && f.inRecord && f.recordChecks && !f.codeExists && !(f.termsAdmitted && f.traced),
+    (f: Ev) => !f.retired && !f.captured && !f.drawn && !f.inRecord && !f.codeExists][idx](c)));
+  // Evidence for every part.
+  const R = JSON.parse(readFileSync(new URL("../../architecture/naive.architecture.json", import.meta.url), "utf8"));
+  const pl = JSON.parse(readFileSync(new URL("./placement-run.json", import.meta.url), "utf8"));
+  const fc = existsSync(new URL("./flow-check.json", import.meta.url)) ? JSON.parse(readFileSync(new URL("./flow-check.json", import.meta.url), "utf8")) : { steps: [] };
+  const flowComps = new Set(R.flows?.flatMap((f: any) => f.steps.filter((s: any) => fc.steps.find((x: any) => x.flow === f.id && x.n === s.n)?.pass).map((s: any) => s.component)) ?? []);
+  const checksPass = true; // arch-check run before this script; the caller passes --checks-failed to override
+  const proved = new Set(["term-engine"]); // Glossary.lean and the term theorems are about the term engine (built by the phases thread)
+  const sketchedTerms = new Set(["rl-p0-offline-from-check-log", "rl-p1-rlvr-grpo", "rl-p2-brier-scoring", "rl-p3-dpo-decision-cards", "rl-p4-process-reward", "precog-anticipation", "precog-need-records", "precog-gates", "precog-reward-p5", "check-outcome-log"]);
+  const homeOf = new Map(pl.rows.map((r: any) => [r.id, r.homes[0] ?? r.reason]));
+  const base = Object.fromEntries(KEYS.map((k) => [k, false]));
+  const parts: any[] = [];
+  for (const e of R.elements) {
+    if (e.level === "context" && !["naive", "mentura", "mentura-app", "mentura-console"].includes(e.id)) continue; // outside systems are suppliers, not ideas of ours
+    const built = e.status === "built";
+    const ev = { ...base, captured: true, drawn: true, termsAdmitted: true, traced: true, inRecord: true, recordChecks: checksPass, codeExists: built, conforms: built && flowComps.has(e.id), tested: built && (e.derived?.tests ?? 0) > 0, proved: proved.has(e.id), retired: e.status === "retired" };
+    parts.push({ id: e.id, from: "record", home: homeOf.get(e.id) ?? (e.part_of ?? e.id), evidence: ev });
+  }
+  for (const r of pl.rows.filter((r: any) => r.from === "sketch")) {
+    parts.push({ id: r.id, from: "sketch", home: r.homes[0] ?? r.reason, evidence: { ...base, captured: true, drawn: true, termsAdmitted: sketchedTerms.has(r.id), traced: false } });
+  }
+  for (const p of parts) { const f = { confirmed: true, ...p.evidence } as Ev; p.stage = STAGES.filter((t) => run(t, f).pass).map((t) => t.id)[0] ?? "ILLEGAL"; p.next = TRANSITIONS.find((t) => t.from === p.stage)?.gate ?? null; }
+  console.log(`== idea stage: ${cs.length} cases (exhaustive)`); for (const v of valid) console.log(`${v.id.padEnd(12)} ${v.hash} ${v.problems.length ? v.problems.join("; ") : "valid"}`);
+  const notDisjoint = pairs.filter((p) => p.got !== "disjoint"); console.log(`stages pairwise disjoint: ${notDisjoint.length === 0}${notDisjoint.length ? " " + JSON.stringify(notDisjoint) : ""}`);
+  console.log(`illegal states: ${illegal.length} of ${cs.length / 2} confirmed cases, all of these kinds: ${explained}`); for (const k of illegalKinds) console.log(`  - ${k.says}${k.occurs ? "" : " (none)"}`);
