+++ b/project-files/naive-design/prototypes/architecture/Model.lean
@@ -0,0 +1,41 @@
+/- Kinds of model: language, reasoning, decision (System One), embedding, world (2026-11-01).
+   Mirrors model-vocab.ts. Core Lean only. Written in the AI-labs thread; built by the phases thread. -/
+namespace Naive.Model
+
+structure M where
+  generatesText : Bool
+  deliberates : Bool
+  typedOutput : Bool
+  calibrated : Bool
+  predictsNextState : Bool
+  vectorPerItem : Bool
+
+def IsLanguage (m : M) : Prop := m.generatesText = true
+def IsReasoning (m : M) : Prop := IsLanguage m ∧ m.deliberates = true
+def IsDecision (m : M) : Prop := m.generatesText = false ∧ m.typedOutput = true ∧ m.calibrated = true
+def IsEmbedding (m : M) : Prop := m.vectorPerItem = true ∧ m.generatesText = false ∧ m.typedOutput = false
+def IsWorld (m : M) : Prop := m.predictsNextState = true
+
+theorem reasoning_is_language {m : M} (h : IsReasoning m) : IsLanguage m := h.1
+
+/-- Jev does not generate language: nothing is both a decision model and a language model. -/
+theorem decision_not_language {m : M} (hd : IsDecision m) (hl : IsLanguage m) : False := by
+  have a := hd.1
+  have b : m.generatesText = true := hl
+  rw [a] at b
+  exact Bool.noConfusion b
+
+theorem decision_not_reasoning {m : M} (hd : IsDecision m) (hr : IsReasoning m) : False :=
+  decision_not_language hd hr.1
+
+theorem decision_not_embedding {m : M} (hd : IsDecision m) (he : IsEmbedding m) : False := by
+  have a := hd.2.1
+  have b := he.2.2
+  rw [a] at b
+  exact Bool.noConfusion b
+
+/-- A world model can also decide: the two kinds overlap (witness). -/
+theorem world_decision_overlap : ∃ m : M, IsWorld m ∧ IsDecision m :=
+  ⟨⟨false, false, true, true, true, false⟩, rfl, rfl, rfl, rfl⟩
+
+end Naive.Model
diff --git a/project-files/naive-design/prototypes/architecture/Placement.lean b/project-files/naive-design/prototypes/architecture/Placement.lean
new file mode 100644
index 0000000..e00554b
--- /dev/null
+++ b/project-files/naive-design/prototypes/architecture/Placement.lean
@@ -0,0 +1,126 @@
+/- Where each part belongs, and what kind of offering each thing is (2026-11-01, Torian 07:14Z).
+   Mirrors placement.ts (homes) and offering-vocab.ts (offering kinds). Facts are cited there.
+   Core Lean only; built by the phases thread. -/
+namespace Naive.Placement
+
+structure Part where
+  learned : Bool
+  producesModel : Bool
+  hosted : Bool
+  onDevice : Bool  -- `local` is a Lean keyword
+  shared : Bool
+  holdsRecords : Bool
+  builderUI : Bool
+  userUI : Bool
+  usesModel : Bool
+  ours : Bool
+
+def ModelHome (p : Part) : Prop :=
+  p.ours = true ∧ (p.learned = true ∨ p.producesModel = true) ∧ p.userUI = false ∧ p.builderUI = false
+def ConsoleHome (p : Part) : Prop :=
+  p.ours = true ∧ p.hosted = true ∧ (p.shared = true ∨ p.holdsRecords = true ∨ p.builderUI = true) ∧
+  p.learned = false ∧ p.producesModel = false ∧ p.userUI = false ∧ p.onDevice = false
+def AppHome (p : Part) : Prop :=
+  p.ours = true ∧ p.userUI = true ∧ p.learned = false ∧ p.producesModel = false ∧ p.builderUI = false
+def NaiveHome (p : Part) : Prop :=
+  p.ours = true ∧ p.onDevice = true ∧ p.hosted = false ∧ p.learned = false ∧ p.producesModel = false ∧
+  p.userUI = false ∧ p.builderUI = false
+
+/-- T3: nothing learned and nothing that trains the model is ever placed in Naive. -/
+theorem model_not_naive (p : Part) : ModelHome p → ¬ NaiveHome p := by
+  intro ⟨_, h, _, _⟩ ⟨_, _, _, hl, hp, _, _⟩
+  cases h with
+  | inl h => rw [hl] at h; exact Bool.noConfusion h
+  | inr h => rw [hp] at h; exact Bool.noConfusion h
+
+theorem model_not_console (p : Part) : ModelHome p → ¬ ConsoleHome p := by
+  intro ⟨_, h, _, _⟩ ⟨_, _, _, hl, hp, _, _⟩
+  cases h with
+  | inl h => rw [hl] at h; exact Bool.noConfusion h
+  | inr h => rw [hp] at h; exact Bool.noConfusion h
+
+theorem model_not_app (p : Part) : ModelHome p → ¬ AppHome p := by
+  intro ⟨_, _, hu, _⟩ ⟨_, hu', _⟩
+  rw [hu] at hu'; exact Bool.noConfusion hu'
+
+theorem console_not_app (p : Part) : ConsoleHome p → ¬ AppHome p := by
+  intro ⟨_, _, _, _, _, hu, _⟩ ⟨_, hu', _⟩
+  rw [hu] at hu'; exact Bool.noConfusion hu'
+
+theorem console_not_naive (p : Part) : ConsoleHome p → ¬ NaiveHome p := by
+  intro ⟨_, hh, _⟩ ⟨_, _, hh', _⟩
+  rw [hh] at hh'; exact Bool.noConfusion hh'
+
+theorem app_not_naive (p : Part) : AppHome p → ¬ NaiveHome p := by
+  intro ⟨_, hu, _⟩ ⟨_, _, _, _, _, hu', _⟩
+  rw [hu] at hu'; exact Bool.noConfusion hu'
+
+/-- Naive may call any model (usesModel) and stays Naive: the field is not in NaiveHome. -/
+--                              learned producesModel hosted local shared holds builder user usesModel ours
+def agentHarness : Part :=      ⟨false, false, false, true, false, false, false, false, true,  true⟩
+def rlP1 : Part :=              ⟨false, true,  false, false, false, false, false, false, false, true⟩
+def checkOutcomeLog : Part :=   ⟨false, false, false, true, false, false, false, false, false, true⟩
+def library : Part :=           ⟨false, false, true,  false, true,  false, false, false, false, true⟩
+def precog : Part :=            ⟨true,  false, true,  true,  false, false, false, true,  false, true⟩
+
+theorem agent_harness_in_naive : NaiveHome agentHarness := ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩
+theorem rl_p1_in_model : ModelHome rlP1 := ⟨rfl, Or.inr rfl, rfl, rfl⟩
+theorem check_log_in_naive : NaiveHome checkOutcomeLog := ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩
+theorem library_in_console : ConsoleHome library := ⟨rfl, rfl, Or.inl rfl, rfl, rfl, rfl, rfl⟩
+/-- Precog as one part has no home: it must be split into anticipation, need records, gates and delivery. -/
+theorem precog_has_no_single_home :
+    ¬ ModelHome precog ∧ ¬ ConsoleHome precog ∧ ¬ AppHome precog ∧ ¬ NaiveHome precog :=
+  ⟨fun h => Bool.noConfusion h.2.2.1, fun h => Bool.noConfusion h.2.2.2.1,
+   fun h => Bool.noConfusion h.2.2.1, fun h => Bool.noConfusion h.2.2.1⟩
+
+end Naive.Placement
+
+namespace Naive.Offering
+
+structure Off where
+  learned : Bool
+  clientApp : Bool
+  hostedService : Bool
+  accounts : Bool
+  forBuilders : Bool
+  inYourProcess : Bool
+  callsYourCode : Bool
+  calledByYourCode : Bool
+  soldToSegment : Bool
+  modeOfApp : Bool
+  abilityOf : Bool
+
+def Model (o : Off) : Prop := o.learned = true ∧ o.clientApp = false
+def App (o : Off) : Prop := o.clientApp = true ∧ o.accounts = true
+def Console (o : Off) : Prop := App o ∧ o.hostedService = true ∧ o.forBuilders = true
+def Library (o : Off) : Prop :=
+  o.inYourProcess = true ∧ o.calledByYourCode = true ∧ o.callsYourCode = false ∧ o.hostedService = false
+def Framework (o : Off) : Prop := o.callsYourCode = true ∧ o.learned = false
+def Product (o : Off) : Prop := o.soldToSegment = true ∧ o.abilityOf = false
+def Capability (o : Off) : Prop := o.abilityOf = true ∧ o.clientApp = false ∧ o.soldToSegment = false
+
+theorem console_is_app (o : Off) : Console o → App o := fun h => h.1
+theorem model_not_app (o : Off) : Model o → ¬ App o := by
+  intro ⟨_, hc⟩ ⟨hc', _⟩; rw [hc] at hc'; exact Bool.noConfusion hc'
+theorem capability_not_product (o : Off) : Capability o → ¬ Product o := by
+  intro ⟨ha, _⟩ ⟨_, ha'⟩; rw [ha] at ha'; exact Bool.noConfusion ha'
+theorem library_not_framework (o : Off) : Library o → ¬ Framework o := by
+  intro ⟨_, _, hc, _⟩ ⟨hc', _⟩; rw [hc] at hc'; exact Bool.noConfusion hc'
+
+--                        learned client hosted accts builders inProc calls called sold mode ability
+def agentSdk : Off :=     ⟨false, false, false, false, false, true,  true,  true,  true,  false, false⟩
+def claudeConsole : Off := ⟨false, true,  true,  true,  true,  false, false, false, false, false, false⟩
+def precog : Off :=       ⟨false, false, false, false, false, false, false, false, false, false, true⟩
+def mentura : Off :=      ⟨true,  false, false, false, false, false, false, true,  true,  false, false⟩
+
+/-- The Agent SDK is not the Console: it has no client and runs in your process. -/
+theorem agent_sdk_not_console : ¬ Console agentSdk := fun h => Bool.noConfusion h.1.1
+/-- The docs call the Agent SDK a library; it runs your hooks and tools, so by our tests it is a framework. -/
+theorem agent_sdk_framework_not_library : Framework agentSdk ∧ ¬ Library agentSdk :=
+  ⟨⟨rfl, rfl⟩, fun h => Bool.noConfusion h.2.2.1⟩
+theorem claude_console_is_console : Console claudeConsole := ⟨⟨rfl, rfl⟩, rfl, rfl⟩
+theorem precog_is_capability : Capability precog ∧ ¬ Product precog :=
+  ⟨⟨rfl, rfl, rfl⟩, fun h => Bool.noConfusion h.2⟩
+theorem mentura_is_model : Model mentura := ⟨rfl, rfl⟩
+
+end Naive.Offering
diff --git a/project-files/naive-design/prototypes/architecture/Precog.lean b/project-files/naive-design/prototypes/architecture/Precog.lean
new file mode 100644
index 0000000..f6d4600
--- /dev/null
+++ b/project-files/naive-design/prototypes/architecture/Precog.lean
@@ -0,0 +1,97 @@
+/- Need vs constraint, and precog's admissibility gate (2026-11-01). Mirrors precog-vocab.ts.
+   Core Lean only. Written in the AI-labs thread; built by the phases thread. -/
+namespace Naive.Precog
+
+structure Stmt where
+  servesGoal : Bool
+  gap : Bool
+  isEndState : Bool
+  restricts : Bool
+  verifiable : Bool
+  reliesOnOther : Bool
+  supplierCanMeet : Bool
+
+def Need (s : Stmt) : Prop := s.servesGoal = true ∧ s.gap = true ∧ s.isEndState = false
+def Constraint (s : Stmt) : Prop := s.restricts = true ∧ s.verifiable = true
+def Requirement (s : Stmt) : Prop := s.verifiable = true
+def Goal (s : Stmt) : Prop := s.isEndState = true
+def SupplierNeed (s : Stmt) : Prop := Need s ∧ s.reliesOnOther = true ∧ s.supplierCanMeet = true
+
+theorem constraint_is_requirement {s : Stmt} (h : Constraint s) : Requirement s := h.2
+
+theorem need_not_goal {s : Stmt} (hn : Need s) (hg : Goal s) : False := by
+  have a := hn.2.2
+  have b : s.isEndState = true := hg
+  rw [a] at b
+  exact Bool.noConfusion b
+
+/-- A need is not a constraint: a need that restricts nothing exists. -/
+theorem need_without_constraint : ∃ s : Stmt, Need s ∧ ¬ Constraint s :=
+  ⟨⟨true, true, false, false, false, false, false⟩, ⟨rfl, rfl, rfl⟩, fun h => Bool.noConfusion h.1⟩
+
+/-- A constraint is not a need: a constraint with no gap exists. -/
+theorem constraint_without_need : ∃ s : Stmt, Constraint s ∧ ¬ Need s :=
+  ⟨⟨false, false, false, true, true, false, false⟩, ⟨rfl, rfl⟩, fun h => Bool.noConfusion h.1⟩
+
+/-- But they can coincide (a runway shortfall is both). -/
+theorem need_and_constraint : ∃ s : Stmt, Need s ∧ Constraint s :=
+  ⟨⟨true, true, false, true, true, false, false⟩, ⟨rfl, rfl, rfl⟩, ⟨rfl, rfl⟩⟩
+
+theorem supplier_need_is_need {s : Stmt} (h : SupplierNeed s) : Need s := h.1
+
+structure Ant where
+  raisedEarly : Bool
+  abstains : Bool
+  confidence : Bool
+  citesRecords : Bool
+  researched : Bool
+  cached : Bool
+  proposedUpdate : Bool
+  calibrated : Bool
+  correct : Bool
+  alternatives : Bool
+  claimsProof : Bool
+  proofChecked : Bool
+
+def GroundedBy (a : Ant) : Prop :=
+  a.citesRecords = true ∨ (a.researched = true ∧ a.cached = true ∧ a.proposedUpdate = true)
+def Grounded (a : Ant) : Prop := a.confidence = true ∧ GroundedBy a
+def WrongReasons (a : Ant) : Prop := a.confidence = true ∧ ¬ GroundedBy a
+def Overconfident (a : Ant) : Prop := a.confidence = true ∧ a.calibrated = false
+def FalseProof (a : Ant) : Prop := a.claimsProof = true ∧ a.proofChecked = false
+def Admissible (a : Ant) : Prop :=
+  a.raisedEarly = true ∧ a.abstains = false ∧ a.confidence = true ∧ GroundedBy a ∧
+  a.calibrated = true ∧ a.alternatives = true ∧ (a.claimsProof = true → a.proofChecked = true)
+
+theorem admissible_grounded {a : Ant} (h : Admissible a) : Grounded a := ⟨h.2.2.1, h.2.2.2.1⟩
+
+theorem admissible_not_wrong_reasons {a : Ant} (h : Admissible a) (w : WrongReasons a) : False :=
+  w.2 h.2.2.2.1
+
+theorem admissible_not_overconfident {a : Ant} (h : Admissible a) (o : Overconfident a) : False := by
+  have x := h.2.2.2.2.1
+  have y := o.2
+  rw [x] at y
+  exact Bool.noConfusion y
+
+/-- No admissible anticipation carries a false proof. -/
+theorem admissible_no_false_proof {a : Ant} (h : Admissible a) (f : FalseProof a) : False := by
+  have x := h.2.2.2.2.2.2 f.1
+  have y := f.2
+  rw [x] at y
+  exact Bool.noConfusion y
+
+/-- Being right does not make a confidence grounded: a correct, calibrated, ungrounded case exists. -/
+theorem lucky_guess_exists : ∃ a : Ant, a.correct = true ∧ a.calibrated = true ∧ WrongReasons a :=
+  ⟨⟨true, false, true, false, false, false, false, true, true, true, false, false⟩, rfl, rfl,
+   ⟨rfl, fun h => by
+      cases h with
+      | inl h => exact Bool.noConfusion h
+      | inr h => exact Bool.noConfusion h.1⟩⟩
+
+/-- Missing records do not block admission if research was run, cached and proposed as an update. -/
+theorem research_path_admissible : ∃ a : Ant, a.citesRecords = false ∧ Admissible a :=
+  ⟨⟨true, false, true, false, true, true, true, true, false, true, false, false⟩, rfl,
+   ⟨rfl, rfl, rfl, Or.inr ⟨rfl, rfl, rfl⟩, rfl, rfl, fun h => Bool.noConfusion h⟩⟩
+
+end Naive.Precog
diff --git a/project-files/naive-design/prototypes/architecture/Problems.lean b/project-files/naive-design/prototypes/architecture/Problems.lean
new file mode 100644
index 0000000..8e24345
--- /dev/null
+++ b/project-files/naive-design/prototypes/architecture/Problems.lean
@@ -0,0 +1,30 @@
+/- Problem graph (proposed, 2026-10-31). `derivesFrom c p`: problem c is a form of problem p. -/
+namespace Naive.Problems
+variable {α : Type} (derivesFrom : α → α → Prop)
+
+def IsRoot (r : α) : Prop := (∀ q, ¬ derivesFrom r q)
+/-- d traces back to a through one or more derivations. -/
+inductive Traces : α → α → Prop
+  | step {c p : α} : derivesFrom c p → Traces c p
+  | trans {c p q : α} : derivesFrom c p → Traces p q → Traces c q
+
+/-- A function problem derives from some problem, so it is never the root. -/
+theorem function_problem_not_root {c p : α} (h : derivesFrom c p) : ¬ IsRoot derivesFrom c :=
+  fun hr => hr p h
+
+/-- The root problem is unique when every problem other than the root traces to it. -/
+theorem root_unique {r s : α} (_hr : IsRoot derivesFrom r) (hs : IsRoot derivesFrom s)
+    (all : ∀ x, x ≠ r → Traces derivesFrom x r) : s = r := by
+  cases Classical.em (s = r) with
+  | inl e => exact e
+  | inr ne =>
+    cases all s ne with
+    | step h => exact absurd h (hs _)
+    | trans h _ => exact absurd h (hs _)
+
+/-- A problem that holds another open is a parent in the blocking graph: a bottleneck by blocking
+    has children, as a kernel does. Recurrence alone does not make it one. -/
+theorem blocking_has_dependents (blocks : α → α → Prop) {b : α} (h : ∃ x y, x ≠ y ∧ blocks b x ∧ blocks b y) :
+    ∃ x, blocks b x :=
+  let ⟨x, _, _, hx, _⟩ := h; ⟨x, hx⟩
+end Naive.Problems
