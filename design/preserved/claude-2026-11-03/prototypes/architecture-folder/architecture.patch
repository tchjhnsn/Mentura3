+/- Generators and engines (2026-11-01; record generator, EE-099). Mirrors generator-vocab.ts. Core Lean only. -/
+namespace Naive.Generator
+
+structure Mod where
+  producesInstances : Bool
+  fromSpecOrSeed : Bool
+  deterministic : Bool
+  verdict : Bool
+  rulesAsInput : Bool
+  domainFree : Bool
+  tested : Bool
+  outputCases : Bool
+  writesFiles : Bool
+  newProject : Bool
+  fromSchema : Bool
+  outputsRecord : Bool
+
+def Gen (m : Mod) : Prop := m.producesInstances = true ∧ m.fromSpecOrSeed = true ∧ m.deterministic = true
+def CaseGen (m : Mod) : Prop := Gen m ∧ m.outputCases = true ∧ m.writesFiles = false
+def ProjectGen (m : Mod) : Prop := Gen m ∧ m.writesFiles = true ∧ m.newProject = true
+def CodeGen (m : Mod) : Prop := Gen m ∧ m.writesFiles = true ∧ m.fromSchema = true
+def RecordGen (m : Mod) : Prop := Gen m ∧ m.outputsRecord = true ∧ m.writesFiles = false
+def Engine (m : Mod) : Prop :=
+  m.rulesAsInput = true ∧ m.verdict = true ∧ m.domainFree = true ∧ m.deterministic = true ∧ m.tested = true
+
+theorem record_gen_is_gen {m : Mod} (h : RecordGen m) : Gen m := h.1
+/-- A record generator writes nothing itself; a code generator writes files. -/
+theorem record_not_code {m : Mod} (r : RecordGen m) (c : CodeGen m) : False := by
+  unfold RecordGen at r; unfold CodeGen at c; simp_all
+theorem record_not_project {m : Mod} (r : RecordGen m) (p : ProjectGen m) : False := by
+  unfold RecordGen at r; unfold ProjectGen at p; simp_all
+/-- A record generator can also be an engine (it applies a schema's rules and returns why a draft fails). -/
+def both : Mod := ⟨true, true, true, true, true, true, true, false, false, false, false, true⟩
+theorem record_gen_engine_overlap : RecordGen both ∧ Engine both := by
+  simp [RecordGen, Gen, Engine, both]
+
+end Naive.Generator
