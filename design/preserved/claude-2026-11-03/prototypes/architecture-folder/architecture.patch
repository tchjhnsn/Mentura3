+// Need vs constraint, and precog (Torian, 2026-11-01 05:25Z: is a need a constraint; make precog as proactive
+// as possible while as accurate as possible; penalize overconfidence and confidence for the wrong reasons).
+// Two levels, each enumerated exhaustively.
+//
+//   node precog-vocab.ts
+
+import { freeze, passSet, relation, run, validTest, type Base, type Relation, type Term } from "/home/user/ee-build/schema/terms/engine.ts";
+
+type P<F> = [string, string, (f: F) => boolean][];
+const mk = <F extends Base>(level: string, kind: string) => (id: string, label: string, meaning: string, sources: string[], props: P<F>, predicts?: Record<string, Relation>): Term<F> =>
+  ({ id, label, level, kind, form: "word", meaning, sources, predicts, props: props.map(([pid, says, check]) => ({ id: pid, says, check })) } as Term<F>);
+
+// ---------- level 1: a statement in a venture's records ----------
+export type Stmt = Base & {
+  servesGoal: boolean;        // traces to a goal of the venture
+  gap: boolean;               // what is required exceeds what is available
+  isEndState: boolean;        // the statement is itself the desired end state
+  restricts: boolean;         // narrows the set of acceptable solutions
+  verifiable: boolean;        // can be checked as met or not met
+  reliesOnOther: boolean;     // can only be met by something outside the venture's control
+  supplierCanMeet: boolean;   // a third party sells something that meets it
+};
+const S = mk<Stmt>("venture statement", "statement");
+export const NEED_VOCAB: Term<Stmt>[] = [
+  S("need", "need", "A gap between what a goal requires and what is available. Not the goal itself.",
+    ["Kaufman, needs assessment: a need is the gap between current and required results", "ISO/IEC/IEEE 29148:2018, stakeholder needs"],
+    [["N1", "serves a goal", (f) => f.servesGoal], ["N2", "required exceeds available", (f) => f.gap], ["N3", "not itself the end state", (f) => !f.isEndState]],
+    { constraint: "overlap", goal: "disjoint", dependency: "overlap", "supplier-need": "has_a_kind", requirement: "overlap" }),
+  S("constraint", "constraint", "A verifiable statement that narrows the acceptable solutions (budget, law, interface, time).",
+    ["ISO/IEC/IEEE 29148:2018 3.1: constraint, an externally imposed limitation on the system, its design or implementation"],
+    [["K1", "restricts acceptable solutions", (f) => f.restricts], ["K2", "verifiable", (f) => f.verifiable]],
+    { requirement: "is_a", need: "overlap" }),
+  S("requirement", "requirement", "A verifiable statement of what must hold. Constraints are one kind.",
+    ["ISO/IEC/IEEE 29148:2018 3.1.19: requirement, statement which translates or expresses a need and its associated constraints and conditions"],
+    [["R1", "verifiable", (f) => f.verifiable]],
+    { constraint: "has_a_kind" }),
+  S("goal", "goal", "A desired end state.",
+    ["ISO/IEC/IEEE 29148:2018; goal-oriented requirements engineering (van Lamsweerde 2001)"],
+    [["G1", "is the end state", (f) => f.isEndState]],
+    { need: "disjoint" }),
+  S("dependency", "dependency", "Can only be met by something outside the venture's control.",
+    ["PMBOK: external dependency"],
+    [["D1", "relies on another party", (f) => f.reliesOnOther]],
+    { need: "overlap", "supplier-need": "has_a_kind" }),
+  S("supplier-need", "supplier need", "A need that relies on another party and that a third party sells something to meet. What precog looks for before the venture feels it.",
+    ["derived: need with dependency and a market for it"],
+    [["N1", "serves a goal", (f) => f.servesGoal], ["N2", "required exceeds available", (f) => f.gap], ["N3", "not itself the end state", (f) => !f.isEndState],
+     ["D1", "relies on another party", (f) => f.reliesOnOther], ["SN1", "a third party sells something that meets it", (f) => f.supplierCanMeet]],
+    { need: "is_a", dependency: "is_a" }),
+];
+
+// ---------- level 2: one anticipation raised by precog ----------
+export type Ant = Base & {
+  raisedEarly: boolean;     // raised before the founder or a record stated the need (lead time > 0)
+  abstains: boolean;        // declines to raise it (reject option)
+  confidence: boolean;      // states a confidence
+  citesRecords: boolean;    // the confidence cites records that hold the premise
+  researched: boolean;      // research was run when records were missing
+  cached: boolean;          // the research was cached as references
+  proposedUpdate: boolean;  // a record update was proposed to the record keeper
+  calibrated: boolean;      // on held-out records, stated confidence matches observed frequency
+  correct: boolean;         // the need later materialised
+  alternatives: boolean;    // offers two or more options with risk/reward and activities/outcomes
+  claimsProof: boolean;     // claims a guarantee (proved, certified)
+  proofChecked: boolean;    // the claimed guarantee passed a check (Lean, conformal holdout)
+};
+const A = mk<Ant>("anticipation", "act");
+const grounded = (f: Ant) => f.citesRecords || (f.researched && f.cached && f.proposedUpdate);
+export const PRECOG_VOCAB: Term<Ant>[] = [
+  A("proactive", "proactive suggestion", "Raised before the need was stated, and not withheld.",
+    ["Lu et al. 2024, Proactive Agent (arXiv 2410.12361)"],
+    [["P1", "raised early", (f) => f.raisedEarly], ["P2", "not abstaining", (f) => !f.abstains]],
+    { abstention: "disjoint", admissible: "has_a_kind" }),
+  A("abstention", "abstention", "Precog withholds the suggestion (selective prediction's reject option), which trades coverage for risk.",
+    ["Geifman and El-Yaniv 2017, Selective classification (arXiv 1705.08500)"],
+    [["AB1", "abstains", (f) => f.abstains]],
+    { proactive: "disjoint" }),
+  A("grounded", "grounded confidence", "A stated confidence that cites records, or whose research was run, cached and sent as a proposed update.",
+    ["ours: records-gated generation (gate.ts U1-U3)"],
+    [["GR1", "states a confidence", (f) => f.confidence], ["GR2", "cites records, or researched + cached + update proposed", grounded]],
+    { "wrong-reasons": "disjoint", overconfident: "overlap", admissible: "has_a_kind" }),
+  A("calibrated", "calibrated confidence", "Stated confidence matches observed frequency on held-out records (scored by a proper scoring rule).",
+    ["Brier 1950; Gneiting and Raftery 2007, strictly proper scoring rules"],
+    [["CA1", "states a confidence", (f) => f.confidence], ["CA2", "calibrated", (f) => f.calibrated]],
+    { overconfident: "disjoint", grounded: "overlap" }),
+  A("overconfident", "overconfidence", "Stated confidence higher than the observed frequency. Penalized.",
+    ["calibration literature; Torian 05:25Z"],
+    [["OC1", "states a confidence", (f) => f.confidence], ["OC2", "not calibrated", (f) => !f.calibrated]],
+    { calibrated: "disjoint", admissible: "disjoint" }),
+  A("wrong-reasons", "confident for the wrong reasons", "Confident and even correct, but with no records and no research. Penalized even when right.",
+    ["Torian 05:25Z; cf. process supervision (Lightman et al. 2023)"],
+    [["WR1", "states a confidence", (f) => f.confidence], ["WR2", "not grounded", (f) => !grounded(f)]],
+    { grounded: "disjoint", admissible: "disjoint", "lucky-guess": "has_a_kind" }),
+  A("lucky-guess", "lucky guess", "Confident for the wrong reasons and the need did materialise. An outcome-only reward would pay it.",
+    ["derived"],
+    [["WR1", "states a confidence", (f) => f.confidence], ["WR2", "not grounded", (f) => !grounded(f)], ["LG1", "turned out correct", (f) => f.correct]],
+    { "wrong-reasons": "is_a" }),
+  A("false-proof", "false proof", "Claims a guarantee that did not pass a check. Penalized hardest.",
+    ["Torian 05:25Z"],
+    [["FP1", "claims a guarantee", (f) => f.claimsProof], ["FP2", "guarantee not checked", (f) => !f.proofChecked]],
+    { certified: "disjoint", admissible: "disjoint" }),
+  A("certified", "certified suggestion", "Claims a guarantee and it passed a check (a Lean proof, or conformal coverage on held-out records).",
+    ["Angelopoulos and Bates 2021, conformal prediction (arXiv 2107.07511)"],
+    [["CE1", "claims a guarantee", (f) => f.claimsProof], ["CE2", "guarantee checked", (f) => f.proofChecked]],
+    { "false-proof": "disjoint", calibrated: "overlap" }),
+  A("admissible", "admissible anticipation", "What precog's gate lets through: proactive, grounded, calibrated, with alternatives, and no unchecked guarantee.",
+    ["ours"],
+    [["P1", "raised early", (f) => f.raisedEarly], ["P2", "not abstaining", (f) => !f.abstains],
+     ["GR1", "states a confidence", (f) => f.confidence], ["GR2", "grounded", grounded], ["CA2", "calibrated", (f) => f.calibrated],
+     ["AL1", "offers alternatives", (f) => f.alternatives], ["NF1", "no unchecked guarantee", (f) => !f.claimsProof || f.proofChecked]],
+    { proactive: "is_a", grounded: "is_a", calibrated: "is_a", overconfident: "disjoint", "wrong-reasons": "disjoint", "false-proof": "disjoint" }),
+];
+
+function cases<F extends Base>(keys: readonly string[], label: string): F[] {
+  const out: F[] = [];
+  for (let m = 0; m < 2 ** (keys.length + 1); m++) {
+    const f = { confirmed: Boolean(m & 1), label: [label, undefined][m % 2] } as F;
+    keys.forEach((k, i) => { (f as Record<string, unknown>)[k] = Boolean(m & (2 << i)); });
+    out.push(f);
+  }
+  return out;
+}
+export const stmtCases = () => cases<Stmt>(["servesGoal", "gap", "isEndState", "restricts", "verifiable", "reliesOnOther", "supplierCanMeet"], "need");
+export const antCases = () => cases<Ant>(["raisedEarly", "abstains", "confidence", "citesRecords", "researched", "cached", "proposedUpdate", "calibrated", "correct", "alternatives", "claimsProof", "proofChecked"], "precog");
+
+function level<F extends Base>(name: string, vocab: Term<F>[], cs: F[]) {
+  const sets = new Map(vocab.map((t) => [t.id, passSet(t, cs)])); let ok = 0, n = 0;
+  const edges: { a: string; b: string; predicted: Relation; got: Relation }[] = [];
+  console.log(`== ${name}: ${cs.length} cases`);
+  for (const t of vocab) { const v = validTest(t, cs); console.log(`${t.id.padEnd(16)} ${freeze(t)} ${v.length ? v.join("; ") : "valid"}`); }
+  for (const a of vocab) for (const [o, w] of Object.entries(a.predicts ?? {})) {
+    n++; const g = relation(sets.get(a.id)!, sets.get(o)!); if (g === w) ok++;
+    edges.push({ a: a.id, b: o, predicted: w, got: g });
+    console.log(`${a.id} ~ ${o}: predicted ${w}, got ${g} -> ${g === w ? "confirmed" : "REFUTED"}`);
+  }
+  console.log(`${ok}/${n} predictions confirmed\n`);
+  return { level: name, cases: cs.length, ok, n, edges };
+}
+
+if (import.meta.url === `file://${process.argv[1]}`) {
+  const r1 = level("venture statement", NEED_VOCAB, stmtCases());
+  const r2 = level("anticipation", PRECOG_VOCAB, antCases());
+  const b1 = { confirmed: true, label: undefined, servesGoal: false, gap: false, isEndState: false, restricts: false, verifiable: false, reliesOnOther: false, supplierCanMeet: false } as Stmt;
+  const ex1: [string, Partial<Stmt>][] = [
+    ["Ship v1 by March", { isEndState: true, servesGoal: true, verifiable: true }],
+    ["Budget under $2k/month for inference", { restricts: true, verifiable: true }],
+    ["Need voice for the founder interviews (no TTS yet)", { servesGoal: true, gap: true, reliesOnOther: true, supplierCanMeet: true }],
+    ["Need counsel before investment packages", { servesGoal: true, gap: true, reliesOnOther: true, supplierCanMeet: true, verifiable: true }],
+    ["Records must be append-only", { restricts: true, verifiable: true, servesGoal: true }],
+    ["Runway shortfall: 4 months short of Validation exit", { servesGoal: true, gap: true, restricts: true, verifiable: true }],
+  ];
+  console.log("== examples (statement)");
+  for (const [nm, fx] of ex1) console.log(`${nm.padEnd(56)} ${NEED_VOCAB.filter((t) => run(t, { ...b1, ...fx } as Stmt).pass).map((t) => t.id).join(", ") || "(no term)"}`);
+  const b2 = { confirmed: true, label: undefined, raisedEarly: false, abstains: false, confidence: false, citesRecords: false, researched: false, cached: false, proposedUpdate: false, calibrated: false, correct: false, alternatives: false, claimsProof: false, proofChecked: false } as Ant;
+  const ex2: [string, Partial<Ant>][] = [
+    ["'You will need a TTS vendor in 3 weeks' citing the interview plan", { raisedEarly: true, confidence: true, citesRecords: true, calibrated: true, alternatives: true }],
+    ["Same, no records, but it came true", { raisedEarly: true, confidence: true, calibrated: true, correct: true, alternatives: true }],
+    ["Same, records missing, researched + cached + proposed update", { raisedEarly: true, confidence: true, researched: true, cached: true, proposedUpdate: true, calibrated: true, alternatives: true }],
+    ["'Proven: post-product GTM wins' with no check", { raisedEarly: true, confidence: true, citesRecords: true, calibrated: true, alternatives: true, claimsProof: true }],
+    ["Withheld: not enough records to say", { abstains: true }],
+    ["Researched but not cached", { raisedEarly: true, confidence: true, researched: true, calibrated: true, alternatives: true }],
+  ];
+  console.log("\n== examples (anticipation)");
+  for (const [nm, fx] of ex2) console.log(`${nm.padEnd(66)} ${PRECOG_VOCAB.filter((t) => run(t, { ...b2, ...fx } as Ant).pass).map((t) => t.id).join(", ") || "(no term)"}`);
+  const fs = await import("node:fs");
+  fs.writeFileSync(new URL("./precog-graph.json", import.meta.url), JSON.stringify([r1, r2], null, 1));
+}
