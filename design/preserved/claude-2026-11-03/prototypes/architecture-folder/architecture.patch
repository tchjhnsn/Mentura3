+// Records, views and artifacts (proposed, 2026-11-01). Found missing when the agent glossary's usage note for
+// "record" pointed to "artifact", which had no entry. Decided vocabulary (2026-10-29): records are the source of
+// truth; artifacts are views of them; records are never published, only artifacts. Level: data. Exhaustive.
+//
+//   node artifact-vocab.ts
+
+import { freeze, passSet, relation, validTest, type Base, type Relation, type Term } from "/home/user/ee-build/schema/terms/engine.ts";
+
+export type Data = Base & {
+  conformsToSchema: boolean; // validated against a schema
+  sourceOfTruth: boolean;    // edits are made here; nothing it holds is derived
+  derivedFromRecords: boolean; // built from records by a generator or a person
+  regenerable: boolean;      // can be rebuilt from its records without loss
+  forPeople: boolean;        // made to be read, shown or shared (a page, doc, deck, report)
+};
+const T = (id: string, label: string, meaning: string, sources: string[], props: [string, string, (f: Data) => boolean][], predicts?: Record<string, Relation>): Term<Data> =>
+  ({ id, label, level: "data", kind: "role", form: "word", meaning, sources, predicts, props: props.map(([pid, says, check]) => ({ id: pid, says, check })) });
+export const DATA_VOCAB: Term<Data>[] = [
+  T("record@data", "record", "One piece of the venture's data that conforms to a schema and is the source of truth: edits are made to it, and nothing in it is derived.",
+    ["Naive: records vs artifacts (decided 2026-10-29)"],
+    [["RC2", "conforms to a schema", (f) => f.conformsToSchema], ["RC4", "is the source of truth", (f) => f.sourceOfTruth && !f.derivedFromRecords]],
+    { view: "disjoint", artifact: "disjoint" }),
+  T("view", "view", "Data derived from records that can be rebuilt from them without loss. Never edited by hand; change the records and rebuild.",
+    ["ANSI/SPARC three-schema architecture (external view, 1975)", "SQL views"],
+    [["VW1", "derived from records", (f) => f.derivedFromRecords], ["VW2", "can be rebuilt from its records", (f) => f.regenerable], ["VW3", "not a source of truth", (f) => !f.sourceOfTruth]],
+    { artifact: "has_a_kind" }),
+  T("artifact", "artifact", "A view made for people to read, show or share: a page, doc, deck or report. The only thing a venture publishes; records stay private.",
+    ["Naive: records never published, only artifacts (decided 2026-10-30)"],
+    [["VW1", "derived from records", (f) => f.derivedFromRecords], ["VW2", "can be rebuilt from its records", (f) => f.regenerable], ["VW3", "not a source of truth", (f) => !f.sourceOfTruth], ["AR1", "made for people", (f) => f.forPeople]],
+    { view: "is_a", "record@data": "disjoint" }),
+];
+const KEYS = ["conformsToSchema", "sourceOfTruth", "derivedFromRecords", "regenerable", "forPeople"] as const;
+export function dataCases(): Data[] { const out: Data[] = []; for (let m = 0; m < 2 ** (KEYS.length + 1); m++) { const f = { confirmed: Boolean(m & 1), label: ["record", "artifact", undefined][m % 3] } as Data; KEYS.forEach((k, i) => { (f as Record<string, unknown>)[k] = Boolean(m & (2 << i)); }); out.push(f); } return out; }
+if (import.meta.url === `file://${process.argv[1]}`) {
+  const cs = dataCases(); const sets = new Map(DATA_VOCAB.map((t) => [t.id, passSet(t, cs)])); let ok = 0, n = 0;
+  for (const t of DATA_VOCAB) { const v = validTest(t, cs); console.log(`${t.id.padEnd(12)} ${freeze(t)} ${v.length ? v.join("; ") : "valid"}`); }
+  for (const a of DATA_VOCAB) for (const [o, w] of Object.entries(a.predicts ?? {})) { n++; const g = relation(sets.get(a.id)!, sets.get(o)!); if (g === w) ok++; console.log(`${a.id} ~ ${o}: predicted ${w}, got ${g} -> ${g === w ? "confirmed" : "REFUTED"}`); }
+  console.log(`${ok}/${n} predictions confirmed`);
+}
