+// Reconcile the ontology (docs/ontology.json) with the engine's terms where one label has two meanings
+// (issue #143, 2026-11-01). Each sense becomes a term over the same facts; the cross-run says whether they are
+// one meaning (equal), one inside the other (is_a / has_a_kind), two senses (overlap) or two words (disjoint).
+//
+//   node reconcile-ontology.ts
+
+import { passSet, relation, validTest, type Base, type Relation, type Term } from "/home/user/ee-build/schema/terms/engine.ts";
+
+const term = <F extends Base>(id: string, level: string, props: [string, string, (f: F) => boolean][]): Term<F> =>
+  ({ id, label: id.split("@")[0], level, kind: "role", form: "word", meaning: "", sources: [], props: props.map(([pid, says, check]) => ({ id: pid, says, check })) });
+function exhaustive<F extends Base>(keys: string[], extra: Record<string, unknown[]> = {}): F[] {
+  let out: Record<string, unknown>[] = [{}];
+  for (const k of ["confirmed", ...keys]) out = out.flatMap((o) => [{ ...o, [k]: false }, { ...o, [k]: true }]);
+  for (const [k, vs] of Object.entries(extra)) out = out.flatMap((o) => vs.map((v) => ({ ...o, [k]: v })));
+  return out.map((o, i) => ({ ...o, label: ["x", "y", undefined][i % 3] }) as F);
+}
+type Pair = { label: string; engine: string; ontology: string; verdict: Relation; resolution: string };
+const out: Pair[] = [];
+function pair<F extends Base>(label: string, a: Term<F>, b: Term<F>, cases: F[], resolution: (r: Relation) => string) {
+  for (const t of [a, b]) { const v = validTest(t, cases); if (v.length) throw new Error(v.join("; ")); }
+  const r = relation(passSet(a, cases), passSet(b, cases));
+  out.push({ label, engine: a.id, ontology: b.id, verdict: r, resolution: resolution(r) });
+}
+
+// function: engine = a kind of work that exists even when null; ontology = a business function with one accountable owner
+type Fn = Base & { kindOfWork: boolean; hasOwner: boolean };
+pair("function", term<Fn>("function", "org", [["FN1", "a kind of work", (f) => f.kindOfWork]]),
+  term<Fn>("function@ontology", "org", [["FN1", "a kind of work", (f) => f.kindOfWork], ["OF1", "has one accountable owner", (f) => f.hasOwner]]),
+  exhaustive<Fn>(["kindOfWork", "hasOwner"]),
+  (r) => r === "has_a_kind" ? "one word: the ontology describes an owned function, a kind of function. A null function has no owner, so 'one accountable owner' moves to the owner field, not the meaning; the ontology's 'department is the alias' is superseded by EE-090" : r);
+
+// role: engine = held by one person (or open); ontology = a person's or agent's job. The code decides: governance/delegation.json
+// grants roles to agents (MENTURA_ACTOR_ID merges as its role), so agents do hold roles.
+type Rl = Base & { position: boolean; holder: "person" | "agent" | "none" };
+pair("role", term<Rl>("role", "org", [["RL1", "a position with responsibilities", (f) => f.position], ["RL2", "held by one person or open", (f) => f.holder !== "agent"]]),
+  term<Rl>("role@ontology", "org", [["RL1", "a position with responsibilities", (f) => f.position], ["OR1", "held by a person or an agent", (f) => f.holder !== "none"]]),
+  exhaustive<Rl>(["position"], { holder: ["person", "agent", "none"] }),
+  (r) => r === "overlap" ? "one word, engine definition wrong: the code lets agents hold roles (delegation.json). Fix: held by one person, one agent, or open; ownership of a function stays with people" : r);
+
+// view: engine = data derived from records (SQL view); ontology = a route rendered as a page for a person (MVC view)
+type Vw = Base & { derived: boolean; regenerable: boolean; forPeople: boolean; isPage: boolean };
+pair("view", term<Vw>("view", "data", [["VW1", "derived from records", (f) => f.derived], ["VW2", "rebuildable", (f) => f.regenerable]]),
+  term<Vw>("view@ontology", "data", [["VW1", "derived from records", (f) => f.derived], ["VW2", "rebuildable", (f) => f.regenerable], ["OV1", "a page for a person", (f) => f.forPeople && f.isPage]]),
+  exhaustive<Vw>(["derived", "regenerable", "forPeople", "isPage"]),
+  (r) => r === "has_a_kind" ? "one word: the ontology's view (a rendered page) is a kind of the engine's view, and a kind of artifact. Keep view as the genus; the ontology sense is 'page'" : r);
+
+// interface: engine = the agreed boundary two elements share (C4, ISO 42010); ontology = a tool a person works through across >= 4 layers
+type If = Base & { isContract: boolean; runsAsTool: boolean; spansLayers: boolean };
+pair("interface", term<If>("interface", "element", [["IF1", "the agreed boundary itself", (f) => f.isContract && !f.runsAsTool]]),
+  term<If>("interface@ontology", "element", [["OI1", "a tool a person works through", (f) => f.runsAsTool], ["OI2", "reaches most other layers", (f) => f.spansLayers]]),
+  exhaustive<If>(["isContract", "runsAsTool", "spansLayers"]),
+  (r) => r === "disjoint" ? "two words under one label. The ontology marks its sense 'ours'; standards first means ours is renamed. Candidate standard name: 'user interface' (narrowed), or the workspace's 'harness' (G-029: a first-party interface over a product)" : r);
+
+// decision: engine = a choice a person has the right to make; ontology = a logged choice with an id
+type Dc = Base & { choice: boolean; hasRight: boolean; logged: boolean };
+pair("decision", term<Dc>("decision", "problem", [["DC1", "a choice among options", (f) => f.choice], ["DC2", "made by someone with the right", (f) => f.hasRight]]),
+  term<Dc>("decision@ontology", "problem", [["DC1", "a choice among options", (f) => f.choice], ["OD1", "logged with an id", (f) => f.logged]]),
+  exhaustive<Dc>(["choice", "hasRight", "logged"]),
+  (r) => r === "overlap" ? "two senses: a decision is the choice; a decision record is the logged one. An unlogged decision (a card answer) is exactly issue #141. Label the ontology sense 'decision record'" : r);
+
+for (const p of out) console.log(`${p.label.padEnd(10)} engine ~ ontology: ${p.verdict.padEnd(10)} ${p.resolution}`);
+console.log("schema, record: same meaning in both (paraphrase); keep the engine wording and point the ontology at it.");
