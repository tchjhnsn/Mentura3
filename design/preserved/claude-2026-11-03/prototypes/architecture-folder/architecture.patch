+// Terms from the workspace-owned conversations design (Torian 2026-11-01 02:49Z: a conversation belongs to the
+// workspace; ventures and the founder suite receive it by triage). Two levels, exhaustive.
+//
+//   node conversation-vocab.ts
+
+import { freeze, passSet, relation, validTest, type Base, type Relation, type Term } from "/home/user/ee-build/schema/terms/engine.ts";
+import { GROUPING_VOCAB, type Grouping } from "./proof-vocab.ts";
+
+type P<F> = [string, string, (f: F) => boolean][];
+const mk = <F extends Base>(level: string) => (id: string, label: string, kind: "role" | "act", meaning: string, sources: string[], props: P<F>, predicts?: Record<string, Relation>): Term<F> =>
+  ({ id, label, level, kind, form: "word", meaning, sources, predicts, props: props.map(([pid, says, check]) => ({ id: pid, says, check })) });
+
+// workspace senses join the grouping level from proof-vocab.ts
+const G = mk<Grouping>("grouping");
+const WORKSPACE_SENSES: Term<Grouping>[] = [
+  G("workspace@g025", "workspace", "role", "G-025: ~/workspace, a plain folder holding the vault, the code and worktrees.", ["G-025"],
+    [["FD1", "a path in a file tree", (f) => f.onDisk], ["FD2", "holds records", (f) => f.holdsRecords], ["WS2", "not one founder's or venture's", (f) => !f.oneScope]],
+    { workspace: "overlap", folder: "is_a" }),
+  G("workspace@claude", "workspace", "role", "A Claude project: a container of threads and tools, off disk.", ["claude.ai projects"],
+    [["SU1", "tools meant to be used together", (f) => f.toolsTogether], ["WS1", "owns conversations", (f) => f.ownsConversations], ["NP1", "not a path", (f) => !f.onDisk]],
+    { workspace: "overlap", suite: "disjoint" }),
+];
+
+export type Line = Base & {
+  refsConversation: boolean; // names a conversation by id
+  lineHash: boolean;         // carries the hash of a line
+  holdsText: boolean;        // carries the words themselves
+  bySubject: boolean;        // sends lines somewhere according to what they are about
+  byUrgency: boolean;        // orders by urgency
+  personConfirmed: boolean;  // a person confirms each routing
+  appendOnly: boolean;       // routings are never edited, only superseded
+  onExit: boolean;           // produced when a venture leaves the workspace
+  aboutWhat: boolean;        // says what a line is about
+  isTitle: boolean;          // is a thread's name
+};
+const L = mk<Line>("line");
+const LINE_VOCAB: Term<Line>[] = [
+  L("citation", "citation", "role", "A reference to a source that lets a reader find it.", ["Chicago Manual of Style, ch. 14"],
+    [["CT1", "names a conversation (the source) by id", (f) => f.refsConversation]], { receipt: "has_a_kind" }),
+  L("receipt", "receipt", "role", "Proposed: a suite's reference to a routed line: conversation id plus line hash, never the text.", ["conversations design (2026-11-01)"],
+    [["CT1", "names a conversation by id", (f) => f.refsConversation], ["RC1", "carries the line's hash", (f) => f.lineHash], ["RC2", "never the text", (f) => !f.holdsText]],
+    { citation: "is_a", "sealed-excerpt": "disjoint" }),
+  L("routing", "routing", "act", "Sending each item to a destination by a rule about the item.", ["common usage (mail, network routing)"],
+    [["RT1", "by what the item is about", (f) => f.bySubject]], { triage: "has_a_kind" }),
+  L("triage@medicine", "triage", "act", "Sorting patients by urgency to decide who is treated first.", ["WHO Emergency Triage Assessment and Treatment (2005)"],
+    [["TG1", "by urgency", (f) => f.byUrgency]], { triage: "overlap" }),
+  L("triage", "triage", "act", "Proposed: routing each input line by subject to one or more suites; an agent may propose, a person confirms; append-only.", ["conversations design (2026-11-01)"],
+    [["RT1", "by what the item is about", (f) => f.bySubject], ["TR1", "a person confirms", (f) => f.personConfirmed], ["TR2", "append-only", (f) => f.appendOnly]],
+    { routing: "is_a" }),
+  L("subject", "subject", "role", "Proposed: what a line is about; not a thread's title.", ["conversations design (2026-11-01)", "Dublin Core (subject)"],
+    [["SJ1", "says what a line is about", (f) => f.aboutWhat], ["SJ2", "not a title", (f) => !f.isTitle]], { title: "disjoint" }),
+  L("title", "title", "role", "A thread's name.", ["Dublin Core (title)"], [["TT1", "a thread's name", (f) => f.isTitle]]),
+  L("excerpt", "excerpt", "role", "A passage taken from a larger text.", ["Merriam-Webster (excerpt)"],
+    [["EX1", "carries the words", (f) => f.holdsText], ["CT1", "names its source", (f) => f.refsConversation]], { "sealed-excerpt": "has_a_kind" }),
+  L("sealed-excerpt", "sealed excerpt", "role", "Proposed: what a venture takes on exit: its routed lines, their hashes and routing entries.", ["conversations design (2026-11-01)"],
+    [["EX1", "carries the words", (f) => f.holdsText], ["CT1", "names its source", (f) => f.refsConversation], ["RC1", "carries the line's hash", (f) => f.lineHash], ["SE1", "made on exit", (f) => f.onExit]],
+    { excerpt: "is_a" }),
+];
+LINE_VOCAB.forEach((t) => { if (t.id === "sealed-excerpt") t.form = "compound"; });
+
+function cases<F extends Base>(keys: string[]): F[] {
+  const out: F[] = [];
+  for (let m = 0; m < 2 ** (keys.length + 1); m++) {
+    const f = { confirmed: Boolean(m & 1), label: ["x", "y", undefined][m % 3] } as F;
+    keys.forEach((k, i) => { (f as Record<string, unknown>)[k] = Boolean(m & (2 << i)); });
+    out.push(f);
+  }
+  return out;
+}
+function runLevel<F extends Base>(name: string, vocab: Term<F>[], cs: F[], only?: Set<string>): [number, number] {
+  const sets = new Map(vocab.map((t) => [t.id, passSet(t, cs)])); let ok = 0, n = 0;
+  console.log(`\n== ${name}: ${cs.length} cases`);
+  for (const t of vocab) if (!only || only.has(t.id)) { const v = validTest(t, cs); console.log(`${t.id.padEnd(18)} ${freeze(t)} ${v.length ? v.join("; ") : "valid"}`); }
+  for (const a of vocab) if (!only || only.has(a.id)) for (const [o, w] of Object.entries(a.predicts ?? {})) {
+    n++; const g = relation(sets.get(a.id)!, sets.get(o)!); if (g === w) ok++;
+    console.log(`${a.id} ~ ${o}: predicted ${w}, got ${g} -> ${g === w ? "confirmed" : "REFUTED"}`);
+  }
+  return [ok, n];
+}
+if (import.meta.url === `file://${process.argv[1]}`) {
+  const [a, b] = runLevel("grouping (workspace senses)", [...GROUPING_VOCAB, ...WORKSPACE_SENSES], cases(["concept", "onDisk", "holdsRecords", "oneScope", "toolsTogether", "ownsConversations"]), new Set(WORKSPACE_SENSES.map((t) => t.id)));
+  const [c, d] = runLevel("line", LINE_VOCAB, cases(["refsConversation", "lineHash", "holdsText", "bySubject", "byUrgency", "personConfirmed", "appendOnly", "onExit", "aboutWhat", "isTitle"]));
+  console.log(`\n${a + c}/${b + d} predictions confirmed`);
+}
