@@ -0,0 +1,28 @@
+// A12: is the architecture implemented the way it is designed? (Torian 2026-11-01 07:35Z.)
+// For each flow in naive.architecture.json, every step's anchor must occur in its file at the given git ref,
+// and steps in the same file must occur in the declared order. A missing anchor means the code no longer does
+// that step (or does it differently); an out-of-order anchor means the chain changed. Reads code, never edits it.
+//   node --experimental-strip-types flow-check.ts [git-ref=origin/main] [repo=/home/user/everything-ecosystem]
+import { execFileSync } from "node:child_process";
+import { readFileSync, writeFileSync } from "node:fs";
+const ref = process.argv[2] ?? "origin/main", repo = process.argv[3] ?? "/home/user/everything-ecosystem";
+const rec = JSON.parse(readFileSync(new URL("../../architecture/naive.architecture.json", import.meta.url), "utf8"));
+const sha = execFileSync("git", ["-C", repo, "rev-parse", "--short", ref], { encoding: "utf8" }).trim();
+const src = new Map<string, string>();
+const read = (f: string) => { if (!src.has(f)) { let t = ""; try { t = execFileSync("git", ["-C", repo, "show", `${ref}:${f}`], { encoding: "utf8", maxBuffer: 1 << 26, stdio: ["ignore", "pipe", "ignore"] }); } catch { t = ""; } src.set(f, t); } return src.get(f)!; }; // a missing file fails every step in it
+const out: any[] = [];
+for (const flow of rec.flows ?? []) {
+  const last = new Map<string, number>();
+  for (const s of flow.steps) {
+    const text = read(s.file), at = text.indexOf(s.anchor);
+    const line = at < 0 ? null : text.slice(0, at).split("\n").length;
+    const order = at < 0 || !last.has(s.file) || at > last.get(s.file)!;
+    if (at >= 0) last.set(s.file, at);
+    out.push({ flow: flow.id, n: s.n, step: s.id, file: s.file, line, found: at >= 0, in_order: order, pass: at >= 0 && order });
+  }
+}
+for (const o of out) console.log(`${o.pass ? "PASS" : "FAIL"} ${o.flow}.${String(o.n).padStart(2)} ${o.step.padEnd(20)} ${o.file}:${o.line ?? "?"}${o.found ? "" : "  anchor not found"}${o.in_order ? "" : "  out of order"}`);
+const ok = out.every((o) => o.pass);
+console.log(`\nA12 ${ok ? "PASS" : "FAIL"}: ${out.filter((o) => o.pass).length}/${out.length} steps implemented as designed at ${ref} ${sha}`);
+writeFileSync(new URL("./flow-check.json", import.meta.url), JSON.stringify({ ran: new Date().toISOString(), ref, sha, ok, steps: out }, null, 1));
+process.exitCode = ok ? 0 : 1;
