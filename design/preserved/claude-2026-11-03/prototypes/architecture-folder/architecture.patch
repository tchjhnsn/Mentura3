+    const v = verdicts.find((x) => x.path === c.path)!;
+    console.log(`says engine/kernel: ${c.path}  kernel ${v.kernel.pass ? "pass" : "fails " + v.kernel.failed}  engine ${v.engine.pass ? "pass" : "fails " + v.engine.failed}`);
+  }
