@@ -0,0 +1,66 @@
+"""README theorem (proposed, 2026-11-01). Decides, from the dependency graph and the file tree, which nodes
+need a README next to them, and whether a file is a hub that its folder README must name.
+
+  R1 boundary    others depend on it: some file outside the folder imports a file inside it (an interface)
+  R2 navigation  it has 5 or more direct children, so a reader needs a map
+  R3 area        it is a top-level folder
+  exempt         instance data, example ventures, generated or vendored folders, dot folders
+  H1 hub file    a file imported by 5+ files outside its folder, or with 50+ descendants: the folder
+                 README names it with a line on what it offers
+  F1 promotion   a single file that needs a README of its own is a component trying to get out: give it a
+                 folder (GitHub shows one README per folder), do not write FILE.README.md
+
+usage: python3 readme-theorem.py <repo> <as-built.json>
+"""
+import json, os, subprocess, sys
+repo, built = sys.argv[1], sys.argv[2]
+files = [f for f in subprocess.run(["git", "-C", repo, "ls-files"], capture_output=True, text=True).stdout.split("\n") if f]
+EXEMPT = ("instance/", "schema/examples/", "node_modules/", ".", "site/public/", "console/public/", "attached")
+kids, readme = {}, set()
+for f in files:
+    p = f.split("/")
+    for i in range(len(p)):
+        d = "/".join(p[:i]) or "."
+        kids.setdefault(d, set()).add(p[i])
+    if p[-1] == "README.md": readme.add("/".join(p[:-1]) or ".")
+g = json.load(open(built))
+imports = {f["path"]: f["imports"] for f in g["files"]}
+inside = lambda f, d: d == "." or f.startswith(d + "/")
+users = {}
+for a, bs in imports.items():
+    for b in bs:
+        for d in kids:
+            if inside(b, d) and not inside(a, d): users.setdefault(d, set()).add(a)
+need, why = {}, {}
+for d, c in kids.items():
+    if d != "." and (d.startswith(EXEMPT) or any(s.startswith(".") for s in d.split("/"))): continue
+    if "." in d.split("/")[-1] and d not in kids: continue
+    if not any(x in kids for x in [d]) : continue
+    r = []
+    if users.get(d) and sum(1 for f in imports if inside(f, d)) >= 2: r.append("R1")
+    if len(c) >= 5: r.append("R2")
+    if d.count("/") == 0: r.append("R3")
+    if r: need[d] = r
+missing = sorted((d for d in need if d not in readme), key=lambda d: (-len(users.get(d, ())), d))
+print(f"folders needing a README: {len(need)}; have one: {sum(1 for d in need if d in readme)}; missing: {len(missing)}")
+for d in missing[:20]: print(f"  missing {d:45s} {'+'.join(need[d])}  used by {len(users.get(d, ()))} outside")
+# H1 hubs not named in their folder README
+fanout = {}
+for a, bs in imports.items():
+    for b in bs: fanout.setdefault(b, set()).add(a)
+def desc(n, seen=None):
+    seen = seen if seen is not None else set()
+    for c in fanout.get(n, ()):
+        if c not in seen: seen.add(c); desc(c, seen)
+    return seen
+hubs = []
+for f in imports:
+    d = os.path.dirname(f) or "."
+    ext = [u for u in fanout.get(f, ()) if not inside(u, d)]
+    if len(ext) >= 5 or len(desc(f)) >= 50:
+        txt = open(os.path.join(repo, d, "README.md")).read() if d in readme else ""
+        named = os.path.basename(f) in txt or os.path.splitext(os.path.basename(f))[0] in txt
+        hubs.append((f, len(ext), len(desc(f)), named))
+print(f"hub files: {len(hubs)}; named in their folder README: {sum(h[3] for h in hubs)}")
+for f, e, n, ok in sorted(hubs, key=lambda h: -h[2]):
+    if not ok: print(f"  not named  {f:45s} {e} outside users, {n} descendants")
