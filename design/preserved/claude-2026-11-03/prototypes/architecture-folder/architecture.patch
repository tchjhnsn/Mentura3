@@ -0,0 +1,86 @@
+// Kernel and engine as glossary terms (proposed, 2026-10-31), run through the same pipeline as every term:
+// define -> freeze -> valid test -> cross-run -> Lean -> record as proposed. Level: component (one source file),
+// with facts derived from the code by derive.ts, never from what docs call it (the label).
+//
+//   node terms.ts            prints validity, the cross-run, verdicts on the real repo, and label vs verdict
+
+import { readFileSync } from "node:fs";
+import { freeze, passSet, relation, rng, run, validTest, type Base, type Term } from "/home/user/ee-build/schema/terms/engine.ts";
+
+export type Component = Base & {
+  fanIn: number; fanOut: number; lines: number; effects: number; clockOrRandom: boolean;
+  tested: boolean; rulesAsInput: boolean; verdictWithReasons: boolean; domainRefs: number; inCycle: boolean;
+};
+
+export const KERNEL: Term<Component> = {
+  id: "kernel", label: "kernel", level: "component", kind: "role", form: "word",
+  meaning: "A small, trusted core that other parts rely on and that relies on nothing inside the system, so trusting it is cheap and everything above it inherits that trust.",
+  props: [
+    { id: "K1", says: "depended on: at least three other parts import it", check: (f) => f.fanIn >= 3 },
+    { id: "K2", says: "depends on nothing inside the system", check: (f) => f.fanOut === 0 },
+    { id: "K3", says: "small enough to read whole: at most 300 lines", check: (f) => f.lines <= 300 },
+    { id: "K4", says: "no effects: no files, network, process, clock or randomness", check: (f) => f.effects === 0 },
+    { id: "K5", says: "tested", check: (f) => f.tested },
+  ],
+  sources: ["de Bruijn criterion (a small trusted checker)", "LCF approach (Milner)", "microkernel minimality (Liedtke 1995)"],
+  lean: ["Naive.Architecture.leaf_not_in_cycle"],
+  predicts: { engine: "overlap" },
+};
+
+export const ENGINE: Term<Component> = {
+  id: "engine", label: "engine", level: "component", kind: "role", form: "word",
+  meaning: "A part that applies rules it is given to facts it is given and returns a verdict with reasons, the same way every time, without knowing the domain the rules are about.",
+  props: [
+    { id: "E1", says: "rules are inputs, not written into it", check: (f) => f.rulesAsInput },
+    { id: "E2", says: "returns which rules failed, not a bare yes or no", check: (f) => f.verdictWithReasons },
+    { id: "E3", says: "domain-free: reads no venture schema or route by name", check: (f) => f.domainRefs === 0 },
+    { id: "E4", says: "deterministic: no clock or randomness", check: (f) => !f.clockOrRandom },
+    { id: "E5", says: "tested", check: (f) => f.tested },
+  ],
+  sources: ["rule engine / production system (Forgy, Rete 1982)", "the Naive term engine (schema/terms/engine.ts)"],
+  predicts: { kernel: "overlap" },
+};
+
+export function componentCases(seed = 19, n = 20000): Component[] {
+  const r = rng(seed); const b = (p = 0.5) => r() < p;
+  return Array.from({ length: n }, () => ({
+    confirmed: b(0.9), label: ["kernel", "engine", "util", undefined][Math.floor(r() * 4)],
+    fanIn: Math.floor(r() * 8), fanOut: b(0.4) ? 0 : Math.floor(r() * 6), lines: Math.floor(r() * 800),
+    effects: b(0.5) ? 0 : 1 + Math.floor(r() * 3), clockOrRandom: b(0.3), tested: b(0.6), rulesAsInput: b(0.3),
+    verdictWithReasons: b(0.5), domainRefs: b(0.6) ? 0 : Math.floor(r() * 5), inCycle: b(0.1),
+  }));
+}
+
+export function fromBuilt(asBuilt: string): (Component & { path: string })[] {
+  const d = JSON.parse(readFileSync(asBuilt, "utf8"));
+  const inCycle = new Set<string>(d.cycles.flat());
+  return d.files.filter((f: { path: string }) => !/(-test|\/test)\.(mjs|ts)$/.test(f.path)).map((f: Record<string, never>) => ({
+    path: f.path, confirmed: true, fanIn: f.fanIn, fanOut: (f.imports as string[]).length, lines: f.lines,
