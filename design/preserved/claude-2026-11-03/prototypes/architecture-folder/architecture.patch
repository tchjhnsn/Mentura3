+// A fourth sense, the JavaScript generator function (function*), is a language feature, not a role; excluded.
+// Level: module (one source file), same facts style as kernel and engine. Exhaustive cross-run.
+//
+//   node generator-vocab.ts
+
+import { freeze, passSet, relation, validTest, type Base, type Relation, type Term } from "/home/user/ee-build/schema/terms/engine.ts";
+
+export type Mod = Base & {
+  producesInstances: boolean;  // its output is new things (cases, files, code), not a judgement about given things
+  fromSpecOrSeed: boolean;     // what it makes is fixed by an input it is given: a spec, template, schema or seed
+  deterministic: boolean;      // same input, same output
+  verdict: boolean;            // returns which rules failed and why
+  rulesAsInput: boolean;
+  domainFree: boolean;
+  tested: boolean;
+  outputCases: boolean;        // output is test cases held in memory
+  writesFiles: boolean;        // output is written to disk
+  newProject: boolean;         // the files are a new project or venture, from templates
+  fromSchema: boolean;         // the spec is a schema, and the output is source code or types
+  outputsRecord: boolean;      // the output is one record that passes its type's schema
+};
+const T = (id: string, label: string, form: Term<Mod>["form"], meaning: string, sources: string[], props: [string, string, (f: Mod) => boolean][], predicts?: Record<string, Relation>): Term<Mod> =>
+  ({ id, label, level: "module", kind: "role", form, meaning, sources, predicts, props: props.map(([pid, says, check]) => ({ id: pid, says, check })) });
+const gen: [string, string, (f: Mod) => boolean][] = [["G1", "produces new instances", (f) => f.producesInstances], ["G2", "what it makes is fixed by a given spec, template, schema or seed", (f) => f.fromSpecOrSeed], ["G3", "same input, same output", (f) => f.deterministic]];
+
+export const GEN_VOCAB: Term<Mod>[] = [
+  T("generator", "generator", "word", "A part that makes new things (test cases, files, code) from a spec, template, schema or seed it is given, the same way every time.", ["ISO/IEC/IEEE 24765: generator (a program that produces other programs or data)", "Naive create-venture (EE-082)"], gen,
+    { "case-generator": "has_a_kind", "project-generator": "has_a_kind", "code-generator": "has_a_kind", "record-generator": "has_a_kind", engine: "overlap" }),
+  T("case-generator", "case generator", "compound", "A generator whose output is test cases from a seed, so a check runs over many cases and reproduces.", ["property-based testing (QuickCheck, Claessen and Hughes 2000)", "schema/terms/levels.ts"],
+    [...gen, ["CG1", "outputs test cases", (f) => f.outputCases], ["CG2", "writes nothing to disk", (f) => !f.writesFiles]], { generator: "is_a", "project-generator": "disjoint", "code-generator": "disjoint" }),
+  T("project-generator", "project generator", "compound", "A generator that writes a new project from templates: create-next-app for Next.js, create-venture for Naive. Also called a scaffolder.", ["create-next-app", "Naive create-venture (EE-082)"],
+    [...gen, ["PG1", "writes files", (f) => f.writesFiles], ["PG2", "the files are a new project", (f) => f.newProject]], { generator: "is_a", "code-generator": "overlap" }),
+  T("code-generator", "code generator", "compound", "A generator that writes source code or types derived from a schema, so the code cannot drift from the schema.", ["ISO/IEC/IEEE 24765: code generator", "Naive record type generator (#124)"],
+    [...gen, ["CD1", "writes files", (f) => f.writesFiles], ["CD2", "derived from a schema", (f) => f.fromSchema]], { generator: "is_a", "record-generator": "disjoint" }),
+  T("record-generator", "record generator", "compound", "Torian 2026-11-01 07:55Z: the script beside each schema. It tells the agent what to ask, then drafts one record that passes the schema, and hands it to the write chain; it never stores anything itself.", ["Torian 2026-11-01 07:55Z", "interface/writes.mjs (the write chain it hands to)"],
+    [...gen, ["RG1", "outputs one record that passes its schema", (f) => f.outputsRecord], ["RG2", "writes nothing itself", (f) => !f.writesFiles]], { generator: "is_a", "code-generator": "disjoint", "project-generator": "disjoint", "case-generator": "overlap", engine: "overlap" }),
+  T("engine", "engine", "word", "(module level, as in terms.ts) A part that applies rules it is given to facts it is given and returns a verdict with reasons, the same way every time, without knowing the domain.", ["terms.ts E1-E5"],
+    [["E1", "rules are inputs", (f) => f.rulesAsInput], ["E2", "verdict with reasons", (f) => f.verdict], ["E3", "domain-free", (f) => f.domainFree], ["E4", "deterministic", (f) => f.deterministic], ["E5", "tested", (f) => f.tested]], { generator: "overlap" }),
+];
+
+const KEYS = ["producesInstances", "fromSpecOrSeed", "deterministic", "verdict", "rulesAsInput", "domainFree", "tested", "outputCases", "writesFiles", "newProject", "fromSchema", "outputsRecord"] as const;
+export function modCases(): Mod[] {
+  const out: Mod[] = []; const labels = ["generator", "engine", "scaffold", undefined];
+  for (let m = 0; m < 2 ** (KEYS.length + 1); m++) { const f = { confirmed: Boolean(m & 1), label: labels[m % 4] } as Mod; KEYS.forEach((k, i) => { (f as Record<string, unknown>)[k] = Boolean(m & (2 << i)); }); out.push(f); }
+  return out;
+}
+
+if (import.meta.url === `file://${process.argv[1]}`) {
+  const cases = modCases(); console.log(`${cases.length} cases (every combination)`);
+  const sets = new Map(GEN_VOCAB.map((t) => [t.id, passSet(t, cases)]));
+  for (const t of GEN_VOCAB) { const v = validTest(t, cases); console.log(`${t.label.padEnd(18)} ${freeze(t)} ${v.length ? v.join("; ") : "valid"} (${sets.get(t.id)!.size} pass)`); }
+  let ok = 0, n = 0;
+  for (const a of GEN_VOCAB) for (const [o, want] of Object.entries(a.predicts ?? {})) { n++; const got = relation(sets.get(a.id)!, sets.get(o)!); if (got === want) ok++; console.log(`${a.id} ~ ${o}: predicted ${want}, got ${got} -> ${got === want ? "confirmed" : "REFUTED"}`); }
+  console.log(`${ok}/${n} predictions confirmed`);
+}
