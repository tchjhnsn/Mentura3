+import fs from "node:fs"; import path from "node:path"; import {execSync} from "node:child_process";
+const dm=JSON.parse(fs.readFileSync("schema/data-model.json","utf8"));
+const files=execSync("git ls-files '*.mjs' '*.ts' '*.js'",{encoding:"utf8"}).split("\n").filter(f=>f&&!/node_modules|test|\.d\.ts/.test(f));
+const src=Object.fromEntries(files.map(f=>[f,fs.readFileSync(f,"utf8")]));
+const writes=f=>/writeFileSync|writeFile\(|appendFileSync|writeRecord|write\(/.test(src[f]);
+const out=[];
+for(const r of dm.records){
+  const base=path.basename(r.schema||"");
+  const pathTails=(r.paths||[]).map(p=>path.basename(p).replace(/[<*].*$/,"")).filter(t=>t.length>4&&!t.startsWith("<"));
+  const refs=files.filter(f=>src[f].includes(base)||(r.id.length>3&&new RegExp(`["'\`]${r.id}["'\`]`).test(src[f])));
+  const checks=refs.filter(f=>/check-|validate|lint/.test(path.basename(f)));
+  const gens=refs.filter(f=>!/check-|validate|lint/.test(path.basename(f))&&writes(f));
+  const beside=fs.existsSync(r.schema?.replace(".schema.json",".mjs")||"x");
+  out.push({id:r.id,layer:r.layer,schema:r.schema,checks:checks.length,gens:gens.slice(0,4),nGen:gens.length,beside});
+}
+const none=out.filter(o=>o.nGen===0);
+console.log("record types",out.length,"with some writer",out.length-none.length,"none",none.length,"generator file beside schema",out.filter(o=>o.beside).length);
+console.log("NONE:",none.map(o=>o.id).join(", "));
+fs.writeFileSync(process.argv[2],JSON.stringify(out,null,1));
