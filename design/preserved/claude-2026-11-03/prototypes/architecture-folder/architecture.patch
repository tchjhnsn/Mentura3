+// From ideas to a venture (proposed, 2026-11-01). Torian: a venture is produced by an idea or a succession of
+// ideas, not by creating a venture; the blank venture template lives in the founder suite until it is full
+// enough; "what is the equivalent of a minimally viable product for a venture?" Level: venture design (the
+// founder suite's working copy of a possible venture). Exhaustive.
+//
+//   node venture-draft-vocab.ts
+
+import { freeze, passSet, relation, validTest, type Base, type Relation, type Term } from "/home/user/ee-build/schema/terms/engine.ts";
+
+export type Design = Base & { founder: boolean; fromIdeas: boolean; identityStated: boolean; rootProblemWithHolder: boolean; everyFunctionAddressed: boolean; discoveryExitCriteria: boolean; legalEntity: boolean; evidenceOfDemand: boolean };
+const T = (id: string, label: string, form: Term<Design>["form"], meaning: string, sources: string[], props: [string, string, (f: Design) => boolean][], predicts?: Record<string, Relation>): Term<Design> =>
+  ({ id, label, level: "venture-design", kind: "role", form, meaning, sources, predicts, props: props.map(([pid, says, check]) => ({ id: pid, says, check })) });
+const mvv: [string, string, (f: Design) => boolean][] = [
+  ["MV1", "has a founder", (f) => f.founder], ["MV2", "grew from the founder's ideas", (f) => f.fromIdeas],
+  ["MV3", "identity stated: who it is for and its essential why", (f) => f.identityStated], ["MV4", "a root problem with someone who has it", (f) => f.rootProblemWithHolder],
+  ["MV5", "every function addressed: a position or an explicit null", (f) => f.everyFunctionAddressed], ["MV6", "Discovery exit criteria stated", (f) => f.discoveryExitCriteria]];
+export const DRAFT_VOCAB = [
+  T("venture-draft", "venture draft", "compound", "A possible venture held in the founder suite, growing from the founder's ideas. It is not yet a venture.", ["Torian 2026-11-01: ideas produce a venture; the blank template lives in the founder suite"],
+    [["VD1", "has a founder", (f) => f.founder], ["VD2", "grew from the founder's ideas", (f) => f.fromIdeas], ["VD3", "not yet minimally viable", (f) => !(f.identityStated && f.rootProblemWithHolder && f.everyFunctionAddressed && f.discoveryExitCriteria)]],
+    { "minimally-viable-venture": "disjoint" }),
+  T("minimally-viable-venture", "minimally viable venture", "compound", "The smallest venture design that can enter Discovery: a founder, an identity, a root problem someone has, every function addressed (even as null), and the exit criteria Discovery will be judged by. No legal entity or customer evidence is required; those come after.", ["by analogy with Ries's minimum viable product (The Lean Startup, 2011): the least that can start learning", "Naive phases: Discovery is the first phase"],
+    mvv, { "venture-draft": "disjoint", "legal-venture": "has_a_kind" }),
+  T("legal-venture", "legal venture", "compound", "A minimally viable venture that has formed a legal entity.", ["venture identity vs legal entity (research note 2026-10-31)"],
+    [...mvv, ["LV1", "a legal entity is formed", (f) => f.legalEntity]], { "minimally-viable-venture": "is_a" }),
+];
+const KEYS = ["founder", "fromIdeas", "identityStated", "rootProblemWithHolder", "everyFunctionAddressed", "discoveryExitCriteria", "legalEntity", "evidenceOfDemand"] as const;
+export function designCases(): Design[] { const out: Design[] = []; for (let m = 0; m < 2 ** (KEYS.length + 1); m++) { const f = { confirmed: Boolean(m & 1), label: ["venture", "draft", undefined][m % 3] } as Design; KEYS.forEach((k, i) => { (f as Record<string, unknown>)[k] = Boolean(m & (2 << i)); }); out.push(f); } return out; }
+if (import.meta.url === `file://${process.argv[1]}`) {
+  const cs = designCases(); const sets = new Map(DRAFT_VOCAB.map((t) => [t.id, passSet(t, cs)])); let ok = 0, n = 0;
+  for (const t of DRAFT_VOCAB) { const v = validTest(t, cs); console.log(`${t.id.padEnd(26)} ${freeze(t)} ${v.length ? v.join("; ") : "valid"}`); }
+  for (const a of DRAFT_VOCAB) for (const [o, w] of Object.entries(a.predicts ?? {})) { n++; const g = relation(sets.get(a.id)!, sets.get(o)!); if (g === w) ok++; console.log(`${a.id} ~ ${o}: predicted ${w}, got ${g} -> ${g === w ? "confirmed" : "REFUTED"}`); }
+  console.log(`${ok}/${n} predictions confirmed`);
+}
