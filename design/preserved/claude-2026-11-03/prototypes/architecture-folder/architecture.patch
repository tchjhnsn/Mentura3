@@ -0,0 +1,41 @@
+/- Terms from the workspace-owned conversations design (2026-11-01). Mirrors conversation-vocab.ts. -/
+namespace Naive.Conversation
+
+structure Line where
+  refsConversation : Bool
+  lineHash : Bool
+  holdsText : Bool
+  bySubject : Bool
+  byUrgency : Bool
+  personConfirmed : Bool
+  appendOnly : Bool
+  onExit : Bool
+  aboutWhat : Bool
+  isTitle : Bool
+
+def Citation (l : Line) : Prop := l.refsConversation = true
+def Receipt (l : Line) : Prop := Citation l ∧ l.lineHash = true ∧ l.holdsText = false
+def Routing (l : Line) : Prop := l.bySubject = true
+def Triage (l : Line) : Prop := Routing l ∧ l.personConfirmed = true ∧ l.appendOnly = true
+def TriageMedicine (l : Line) : Prop := l.byUrgency = true
+def Subject (l : Line) : Prop := l.aboutWhat = true ∧ l.isTitle = false
+def Title (l : Line) : Prop := l.isTitle = true
+def Excerpt (l : Line) : Prop := l.holdsText = true ∧ Citation l
+def SealedExcerpt (l : Line) : Prop := Excerpt l ∧ l.lineHash = true ∧ l.onExit = true
+
+theorem receipt_is_citation {l : Line} (h : Receipt l) : Citation l := h.1
+theorem triage_is_routing {l : Line} (h : Triage l) : Routing l := h.1
+theorem sealed_is_excerpt {l : Line} (h : SealedExcerpt l) : Excerpt l := h.1
+/-- A receipt never carries the text; a sealed excerpt always does. -/
+theorem receipt_not_sealed {l : Line} (r : Receipt l) : ¬ SealedExcerpt l := by
+  intro s; have h1 := r.2.2; have h2 := s.1.1; rw [h1] at h2; cases h2
+theorem subject_not_title {l : Line} (s : Subject l) : ¬ Title l := by
+  intro t; unfold Title at t; have h1 := s.2; rw [h1] at t; cases t
+/-- Our triage is not the medical one: it routes by subject, not urgency. Each holds without the other. -/
+def bySubjectOnly : Line := ⟨false, false, false, true, false, true, true, false, false, false⟩
+def byUrgencyOnly : Line := ⟨false, false, false, false, true, false, false, false, false, false⟩
+theorem triage_senses_overlap :
+    (Triage bySubjectOnly ∧ ¬ TriageMedicine bySubjectOnly) ∧ (TriageMedicine byUrgencyOnly ∧ ¬ Triage byUrgencyOnly) :=
+  ⟨⟨⟨rfl, rfl, rfl⟩, fun h => by cases h⟩, ⟨rfl, fun h => by cases h.1⟩⟩
+
+end Naive.Conversation
