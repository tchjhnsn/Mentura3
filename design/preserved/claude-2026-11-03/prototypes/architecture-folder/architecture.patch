+// "knowledge graph of record" and its neighbours (Torian, 2026-11-01 03:35Z: add it to the glossary; how does it
+// differ from a vector embedding?). Run 1: 17/19, the engine refuted 'a knowledge graph of record overlaps an ontology'
+// (it came out is_a); fix: an ontology holds kinds only (Gruber), so a knowledge graph contains one and is not one.
+// Run 2: 19/19, but model weights passed as an embedding; fix: an embedding is one vector per input item (EM4). One level: store (a way of holding knowledge). Exhaustive over the facts.
+//
+//   node kgr-vocab.ts
+
+import { freeze, passSet, relation, run, validTest, type Base, type Relation, type Term } from "/home/user/ee-build/schema/terms/engine.ts";
+
+type P<F> = [string, string, (f: F) => boolean][];
+const mk = <F extends Base>(level: string) => (id: string, label: string, meaning: string, sources: string[], props: P<F>, predicts?: Record<string, Relation>): Term<F> =>
+  ({ id, label, level, kind: "role", form: "word", meaning, sources, predicts, props: props.map(([pid, says, check]) => ({ id: pid, says, check })) });
+
+export type Store = Base & {
+  nodesAndEdges: boolean;   // holds things and typed links between them
+  namedSlots: boolean;      // each value sits in a slot a person named (a cell, a property)
+  numericVectors: boolean;  // holds fixed-length lists of numbers
+  learned: boolean;         // its contents were produced by training a model
+  similaritySearch: boolean;// answers "what is near this?"
+  authoritative: boolean;   // designated as the source of truth for its data
+  sourced: boolean;         // every value carries a reference to where it came from
+  dated: boolean;           // every value carries when it was true (as_of)
+  typesDefined: boolean;    // a schema or ontology defines the kinds of node and link
+  perItem: boolean;         // one vector per input item (a word, a document, a node)
+  instanceFacts: boolean;   // holds facts about particular things (Anthropic's revenue), not only kinds
+};
+const S = mk<Store>("store");
+export const STORE_VOCAB: Term<Store>[] = [
+  S("knowledge-graph", "knowledge graph", "Knowledge held as entities (nodes) and typed relations (edges), with values in named properties.",
+    ["Hogan et al., 'Knowledge Graphs', ACM Computing Surveys (2021)"],
+    [["KG1", "nodes and typed edges", (f) => f.nodesAndEdges], ["KG2", "values in named slots", (f) => f.namedSlots], ["KG3", "facts about particular things", (f) => f.instanceFacts]],
+    { "knowledge-graph-of-record": "has_a_kind", embedding: "disjoint", ontology: "disjoint", "system-of-record": "overlap" }),
+  S("system-of-record", "system of record", "The store designated as the authoritative source for a given piece of data.",
+    ["Common enterprise IT usage (authoritative data source)"],
+    [["SR1", "designated source of truth", (f) => f.authoritative]],
+    { "knowledge-graph-of-record": "has_a_kind", "knowledge-graph": "overlap", embedding: "overlap" }),
+  S("knowledge-graph-of-record", "knowledge graph of record", "Ours: a knowledge graph that is the system of record for what it holds, where every value carries its source and the date it was true, and the kinds of node and edge are defined in the glossary and schemas.",
+    ["The venture library and industry graph (2026-11-01)", "records-vs-artifacts rule (2026-10-29)"],
+    [["KG1", "nodes and typed edges", (f) => f.nodesAndEdges], ["KG2", "values in named slots", (f) => f.namedSlots], ["KG3", "facts about particular things", (f) => f.instanceFacts], ["SR1", "designated source of truth", (f) => f.authoritative],
+     ["KR1", "every value sourced", (f) => f.sourced], ["KR2", "every value dated", (f) => f.dated], ["KR3", "types defined", (f) => f.typesDefined]],
+    { "knowledge-graph": "is_a", "system-of-record": "is_a", embedding: "disjoint", ontology: "disjoint" }),
+  S("embedding", "embedding", "A fixed-length vector of numbers a trained model computes for a piece of data, so that similar meanings lie close; no number is a named slot.",
+    ["Mikolov et al., word2vec (2013)", "Bengio et al., neural language model (2003)"],
+    [["EM1", "numeric vectors", (f) => f.numericVectors], ["EM2", "learned by a model", (f) => f.learned], ["EM3", "no named slots", (f) => !f.namedSlots], ["EM4", "one vector per input item", (f) => f.perItem]],
+    { "knowledge-graph": "disjoint", "knowledge-graph-of-record": "disjoint", "vector-database": "overlap", "system-of-record": "overlap" }),
+  S("vector-database", "vector database", "A store of vectors that answers nearest-neighbour queries, usually with metadata beside each vector.",
+    ["Common industry usage (e.g. FAISS, Johnson et al. 2017)"],
+    [["EM1", "numeric vectors", (f) => f.numericVectors], ["VD1", "similarity search", (f) => f.similaritySearch]],
+    { embedding: "overlap", "knowledge-graph": "overlap" }),
+  S("ontology", "ontology", "An explicit specification of the kinds of thing and relation in a domain; it holds kinds, not facts about particular things. A knowledge graph contains one; it is not one.",
+    ["Gruber, 'A translation approach to portable ontology specifications' (1993)"],
+    [["ON1", "types defined", (f) => f.typesDefined], ["KG2", "named slots", (f) => f.namedSlots], ["ON2", "kinds only, no facts about particular things", (f) => !f.instanceFacts]],
+    { "knowledge-graph": "disjoint", "knowledge-graph-of-record": "disjoint" }),
+];
+
+export function storeCases(): Store[] {
+  const keys = ["nodesAndEdges", "namedSlots", "numericVectors", "learned", "similaritySearch", "authoritative", "sourced", "dated", "typesDefined", "instanceFacts", "perItem"] as const;
+  const labels = ["knowledge graph", "embedding"];
+  const out: Store[] = [];
+  for (let m = 0; m < 2 ** (keys.length + 1); m++) {
+    const f = { confirmed: Boolean(m & 1), label: [...labels, undefined][m % (labels.length + 1)] } as Store;
+    keys.forEach((k, i) => { (f as Record<string, unknown>)[k] = Boolean(m & (2 << i)); });
+    out.push(f);
+  }
+  return out;
+}
+
+if (import.meta.url === `file://${process.argv[1]}`) {
+  const cs = storeCases();
+  const sets = new Map(STORE_VOCAB.map((t) => [t.id, passSet(t, cs)])); let ok = 0, n = 0;
+  console.log(`== store: ${cs.length} cases`);
+  for (const t of STORE_VOCAB) { const v = validTest(t, cs); console.log(`${t.id.padEnd(28)} ${freeze(t)} ${v.length ? v.join("; ") : "valid"}`); }
+  for (const a of STORE_VOCAB) for (const [o, w] of Object.entries(a.predicts ?? {})) {
+    n++; const g = relation(sets.get(a.id)!, sets.get(o)!); if (g === w) ok++;
+    console.log(`${a.id} ~ ${o}: predicted ${w}, got ${g} -> ${g === w ? "confirmed" : "REFUTED"}`);
+  }
+  console.log(`\n${ok}/${n} predictions confirmed`);
+  const base = { confirmed: true, label: undefined, nodesAndEdges: false, namedSlots: false, numericVectors: false, learned: false, similaritySearch: false, authoritative: false, sourced: false, dated: false, typesDefined: false, instanceFacts: false, perItem: false } as Store;
+  const ex: [string, Partial<Store>][] = [
+    ["Mentura research library (Anthropic, OpenAI studies)", { nodesAndEdges: true, namedSlots: true, authoritative: true, sourced: true, dated: true, typesDefined: true, instanceFacts: true }],
+    ["An embedding of Anthropic's S-1 summary", { numericVectors: true, learned: true, perItem: true }],
+    ["Model weights of a language model", { numericVectors: true, learned: true }],
+    ["Wikidata", { nodesAndEdges: true, namedSlots: true, sourced: true, typesDefined: true, instanceFacts: true }],
+    ["Our glossary + schemas (kinds only)", { namedSlots: true, typesDefined: true }],
+  ];
+  console.log("\n== examples");
+  for (const [name, facts] of ex) console.log(`${name.padEnd(54)} ${STORE_VOCAB.filter((t) => run(t, { ...base, ...facts } as Store).pass).map((t) => t.id).join(", ") || "(no term)"}`);
+}
