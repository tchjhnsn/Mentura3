+++ b/project-files/naive-design/prototypes/architecture/glossary-vocab.ts
@@ -0,0 +1,161 @@
+// What a glossary is, and its neighbours (proposed, 2026-11-01). Torian: define glossary, run "glossary" through
+// itself, and run index, catalog, directory, registry and other near-synonyms the same way. Also loop and skill.
+//
+// Two levels:
+//   reference  a collection of entries (what kind of thing each entry is about, and what each entry gives)
+//   method     a way of working an agent or person carries out
+// Exhaustive over every combination of facts.
+//
+//   node glossary-vocab.ts
+
+import { freeze, passSet, relation, run, validTest, type Base, type Relation, type Term } from "/home/user/ee-build/schema/terms/engine.ts";
+
+// ---------- reference level ----------
+/** What each entry is about. One kind per collection; a mixed collection is "mixed". */
+export type EntryKind = "term" | "item" | "party" | "mixed";
+export type Collection = Base & {
+  entryKind: EntryKind;
+  definesMeaning: boolean;   // each entry says what its term means
+  oneField: boolean;         // entries are limited to one subject field, work or venture
+  hasLocators: boolean;      // each entry points to places in a body of content (pages, files, lines)
+  describesAttributes: boolean; // each entry describes its subject by attributes (author, size, price, status)
+  givesContact: boolean;     // each entry says where its subject is or how to reach it
+  authorityRecords: boolean; // an authority enters each entry, and being entered gives the subject a status
+  relatesEntries: boolean;   // entries name relations to other entries (broader, narrower, related)
+  usageNotes: boolean;       // each entry says how and when to use the term (do, don't, scope)
+};
+const C = (id: string, label: string, meaning: string, sources: string[], props: [string, string, (f: Collection) => boolean][], predicts?: Record<string, Relation>): Term<Collection> =>
+  ({ id, label, level: "reference", kind: "role", form: label.includes(" ") ? "compound" : "word", meaning, sources, predicts, props: props.map(([pid, says, check]) => ({ id: pid, says, check })) });
+
+const isTerms: [string, string, (f: Collection) => boolean] = ["E1", "its entries are terms (words or phrases)", (f) => f.entryKind === "term"];
+const defines: [string, string, (f: Collection) => boolean] = ["E2", "each entry says what its term means", (f) => f.definesMeaning];
+const glossaryProps: [string, string, (f: Collection) => boolean][] = [isTerms, defines, ["GL1", "limited to one subject field, work or venture", (f) => f.oneField]];
+
+export const REFERENCE_VOCAB: Term<Collection>[] = [
+  C("dictionary", "dictionary", "A collection whose entries are terms, each with what it means.",
+    ["ISO 1087:2019 3.7.1 dictionary; Merriam-Webster"], [isTerms, defines],
+    { glossary: "has_a_kind", index: "overlap", thesaurus: "overlap" }),
+  C("glossary", "glossary", "A collection of the terms of one subject field, work or venture, each with what it means. In a venture it is the base of the knowledge base: every other record's prose uses its terms.",
+    ["ISO 1087:2019 (glossary: terminological dictionary of one subject field)", "ANSI/NISO Z39.19-2005 §4.1 (glossary: a list of terms, usually with definitions)"], glossaryProps,
+    { dictionary: "is_a", index: "overlap", catalog: "disjoint", directory: "disjoint", registry: "overlap", thesaurus: "overlap", "agent-glossary": "has_a_kind" }),
+  C("agent-glossary", "agent-readable glossary", "A glossary whose every entry also says how and when to use the term, so an agent (or a new person) can write with it correctly.",
+    ["Torian 2026-11-01", "ISO 1087:2019 (usage note)"], [...glossaryProps, ["AG1", "each entry says how and when to use the term", (f) => f.usageNotes]],
+    { glossary: "is_a" }),
+  C("index", "index", "A collection of terms or names, each pointing to the places in a body of content where it occurs. An index locates; it need not define.",
+    ["ISO 999:1996 (index: entries with locators)", "Chicago Manual of Style ch. 15"],
+    [["IX1", "its entries are terms", (f) => f.entryKind === "term"], ["IX2", "each entry points to places in a body of content", (f) => f.hasLocators]],
+    { glossary: "overlap", catalog: "disjoint" }),
+  C("catalog", "catalog", "A collection of items (books, products, datasets, services), each described by its attributes.",
+    ["IFLA LRM / RDA (bibliographic description)", "Data Catalog Vocabulary DCAT (W3C 2020)"],
+    [["CA1", "its entries are items", (f) => f.entryKind === "item"], ["CA2", "each entry describes its item by attributes", (f) => f.describesAttributes]],
+    { glossary: "disjoint", registry: "overlap", directory: "disjoint" }),
+  C("directory", "directory", "A collection of parties (people, organisations, services) saying where each is or how to reach it.",
+    ["ITU-T X.500 (directory)", "telephone directory"],
+    [["DI1", "its entries are parties", (f) => f.entryKind === "party"], ["DI2", "each entry says where its party is or how to reach it", (f) => f.givesContact]],
+    { glossary: "disjoint", registry: "overlap" }),
+  C("registry", "registry", "A collection kept by an authority, where being entered gives the subject a status (registered, admitted, in force). Its entries can be of any kind.",
+    ["ISO/IEC 11179-1:2023 (metadata registry)", "company registers"],
+    [["RG1", "an authority enters each entry and entry gives a status", (f) => f.authorityRecords]],
+    { glossary: "overlap", catalog: "overlap", directory: "overlap" }),
+  C("thesaurus", "thesaurus", "A collection of terms in which each entry names its relations to other entries (broader, narrower, related, use-for). It need not define.",
+    ["ISO 25964-1:2011", "ANSI/NISO Z39.19-2005"],
+    [["TH1", "its entries are terms", (f) => f.entryKind === "term"], ["TH2", "entries name relations to other entries", (f) => f.relatesEntries]],
+    { glossary: "overlap", dictionary: "overlap" }),
+];
+
+const KEYS = ["definesMeaning", "oneField", "hasLocators", "describesAttributes", "givesContact", "authorityRecords", "relatesEntries", "usageNotes"] as const;
+const KINDS: EntryKind[] = ["term", "item", "party", "mixed"];
+export function collectionCases(): Collection[] {
+  const out: Collection[] = [];
+  for (const entryKind of KINDS) for (let m = 0; m < 2 ** (KEYS.length + 1); m++) {
+    const f = { entryKind, confirmed: Boolean(m & 1), label: ["glossary", "index", undefined][m % 3] } as Collection;
+    KEYS.forEach((k, i) => { (f as Record<string, unknown>)[k] = Boolean(m & (2 << i)); });
+    out.push(f);
+  }
+  return out;
+}
+
+/** The glossary run through itself: the facts of the glossary this repo actually keeps (schema/terms/admitted.json
+ *  plus the sandbox vocabularies), read off its records, not assumed. */
+export function ourGlossary(admitted: { terms: { id: string; meaning?: string; usage?: unknown; relations?: object; sources?: unknown[] }[] }, usage: Record<string, unknown> = {}): Collection {
+  const ts = admitted.terms;
+  return {
+    confirmed: true, label: "glossary",
+    entryKind: "term",
+    definesMeaning: ts.every((t) => typeof t.meaning === "string" && t.meaning.length > 0),
+    oneField: true, // every entry is scoped to the venture vocabulary (scope field, default "venture")
+    hasLocators: false, // entries cite sources, not places in a body of content where the term occurs
+    describesAttributes: false,
+    givesContact: false,
+    authorityRecords: true, // admission by the engine gives a term its status (proposed, admitted)
+    relatesEntries: ts.every((t) => t.relations && Object.keys(t.relations).length > 0),
+    usageNotes: ts.every((t) => t.usage !== undefined || usage[t.id] !== undefined),
+  };
+}
+
+// ---------- method level ----------
+export type Method = Base & {
+  steps: boolean;          // a sequence of steps in order
+  returnsToStart: boolean; // after the last step it begins again (on a trigger or until a condition)
+  trigger: boolean;        // says when it starts
+  instructions: boolean;   // written as instructions for whoever carries it out
+  packaged: boolean;       // a named, loadable unit (a file with a name and description)
+  agentCarriesOut: boolean;// an agent or person carries it out; it does not run by itself
+  runsItself: boolean;     // code or a scheduler runs it with no one carrying it out
+};
+const M = (id: string, label: string, meaning: string, sources: string[], props: [string, string, (f: Method) => boolean][], predicts?: Record<string, Relation>): Term<Method> =>
+  ({ id, label, level: "method", kind: "act", form: "word", meaning, sources, predicts, props: props.map(([pid, says, check]) => ({ id: pid, says, check })) });
+export const METHOD_VOCAB: Term<Method>[] = [
+  M("procedure", "procedure", "A sequence of steps carried out in order.", ["ISO 9000:2015 3.4.5 (procedure: specified way to carry out an activity)"],
+    [["PR1", "a sequence of steps in order", (f) => f.steps]], { loop: "has_a_kind", skill: "overlap" }),
+  M("loop", "loop", "A procedure that begins again after its last step, each time its trigger fires or until a condition is met. The problem loop and PDCA are loops.",
+    ["Deming/Shewhart PDCA", "Boyd OODA", "problem loop (Naive, 2026-10-31)"],
+    [["PR1", "a sequence of steps in order", (f) => f.steps], ["LP1", "begins again after its last step", (f) => f.returnsToStart], ["LP2", "says when it starts or stops", (f) => f.trigger]],
+    { procedure: "is_a", skill: "overlap" }),
+  M("skill", "skill", "A packaged, named set of instructions that says when to use it, which an agent loads and carries out. A skill may hold a procedure or a loop, or only guidance.",
+    ["Anthropic Agent Skills (SKILL.md: name, description, instructions), 2025"],
+    [["SK1", "written as instructions", (f) => f.instructions], ["SK2", "a named, loadable unit", (f) => f.packaged], ["SK3", "says when to use it", (f) => f.trigger],
+     ["SK4", "an agent carries it out; it does not run by itself", (f) => f.agentCarriesOut && !f.runsItself]],
+    { procedure: "overlap", loop: "overlap", routine: "disjoint" }),
+  M("routine", "routine", "A procedure that code or a scheduler runs by itself on a trigger (a cron job, a CI workflow).",
+    ["cron (Unix V7, 1979)", "GitHub Actions workflows"],
+    [["PR1", "a sequence of steps in order", (f) => f.steps], ["RT1", "runs by itself", (f) => f.runsItself], ["RT2", "says when it starts", (f) => f.trigger]],
+    { skill: "disjoint", procedure: "is_a" }),
+];
+const MKEYS = ["steps", "returnsToStart", "trigger", "instructions", "packaged", "agentCarriesOut", "runsItself"] as const;
+export function methodCases(): Method[] {
+  const out: Method[] = [];
+  for (let m = 0; m < 2 ** (MKEYS.length + 1); m++) {
+    const f = { confirmed: Boolean(m & 1), label: ["skill", "loop", undefined][m % 3] } as Method;
+    MKEYS.forEach((k, i) => { (f as Record<string, unknown>)[k] = Boolean(m & (2 << i)); });
+    out.push(f);
+  }
+  return out;
+}
+
+function runLevel<F extends Base>(name: string, vocab: Term<F>[], cases: F[]): [number, number] {
+  const sets = new Map(vocab.map((t) => [t.id, passSet(t, cases)])); let ok = 0, n = 0;
+  console.log(`\n== ${name}: ${cases.length} cases`);
+  for (const t of vocab) { const v = validTest(t, cases); console.log(`${t.id.padEnd(16)} ${freeze(t)} ${v.length ? v.join("; ") : "valid"}`); }
+  for (const a of vocab) for (const [o, w] of Object.entries(a.predicts ?? {})) {
+    n++; const g = relation(sets.get(a.id)!, sets.get(o)!); if (g === w) ok++;
+    console.log(`${a.id} ~ ${o}: predicted ${w}, got ${g} -> ${g === w ? "confirmed" : "REFUTED"}`);
+  }
+  return [ok, n];
+}
+
+if (import.meta.url === `file://${process.argv[1]}`) {
+  const [a, b] = runLevel("reference", REFERENCE_VOCAB, collectionCases());
+  const [c, d] = runLevel("method", METHOD_VOCAB, methodCases());
+  console.log(`\n${a + c}/${b + d} predictions confirmed`);
+  const { readFileSync } = await import("node:fs");
+  const admitted = JSON.parse(readFileSync("/home/user/ee-build/schema/terms/admitted.json", "utf8"));
+  const ours = ourGlossary(admitted);
+  console.log(`\n== the glossary run through itself (${admitted.terms.length} admitted terms)`);
+  console.log(JSON.stringify(ours));
+  for (const t of REFERENCE_VOCAB) { const r = run(t, ours); console.log(`${t.id.padEnd(16)} ${r.pass ? "PASS" : "fail " + r.failed.join(",")}`); }
+  const usage = JSON.parse(readFileSync(new URL("./usage.json", import.meta.url), "utf8"));
+  const withUsage = ourGlossary(admitted, usage);
+  console.log(`\n== again, with usage.json read as part of the glossary`);
+  for (const t of REFERENCE_VOCAB) { const r = run(t, withUsage); console.log(`${t.id.padEnd(16)} ${r.pass ? "PASS" : "fail " + r.failed.join(",")}`); }
+}
