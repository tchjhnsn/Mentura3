@@ -0,0 +1,75 @@
+// Records-gated generation (Torian, 2026-11-01 04:57Z). A generation of a given type may run only when the records it
+// needs exist. Missing records trigger research; research is logged as a trace and every fetch is cached as a
+// reference, but nothing becomes a record unless the update theorem admits it.
+//
+//   node gate.ts   (gates the RL graph: one edge per engine relation; needs a read source behind both terms)
+
+import fs from "node:fs";
+import crypto from "node:crypto";
+
+const LIB = "/mnt/project-files/mentura-discovery/mentura/research";
+const CACHE = `${LIB}/references/search-cache`;
+const now = "2026-11-01T05:05:00Z";
+
+// ---- the update theorem: what a fetched exchange may change
+export type Fetch = { kind: "search" | "fetch"; query?: string; url?: string; read: boolean; tier: "primary" | "reputable reporting" | "index"; claims: { about: string; text: string; locator?: string }[] };
+export type Verdict = { cache: true; admit: { about: string; text: string }[]; hold: { about: string; text: string; why: string }[] };
+/** U1 every exchange is cached. U2 a claim becomes a record only if its source was READ (not a snippet), is not an
+ *  index, and the claim carries a locator. U3 anything else is held as a reference only: the gate stays closed for
+ *  outputs that need it. (U4, contested values, and U5, freshness, are checked against existing cells; not here.) */
+export function update(f: Fetch): Verdict {
+  const v: Verdict = { cache: true, admit: [], hold: [] };
+  for (const c of f.claims) {
+    const why = !f.read ? "source not read (snippet only)" : f.tier === "index" ? "index source" : !c.locator ? "no locator" : "";
+    if (why) v.hold.push({ ...c, why }); else v.admit.push(c);
+  }
+  return v;
+}
+const key = (s: string) => crypto.createHash("sha256").update(s.trim().toLowerCase()).digest("hex").slice(0, 16);
+/** U2 for searches: a cached exchange for the same query or URL answers without fetching again. */
+export function cached(q: string): unknown | undefined {
+  const p = `${CACHE}/${key(q)}.json`; return fs.existsSync(p) ? JSON.parse(fs.readFileSync(p, "utf8")) : undefined;
+}
+export function cache(q: string, entry: object) { fs.writeFileSync(`${CACHE}/${key(q)}.json`, JSON.stringify({ key: key(q), q, cached_at: now, ...entry }, null, 1)); }
+
+// ---- this session's exchanges, cached (searches and fetches made while studying RL)
+const EXCHANGES: (Fetch & { title: string; terms: string[] })[] = [
+  { kind: "fetch", url: "https://arxiv.org/abs/2203.02155", read: true, tier: "primary", title: "InstructGPT", terms: ["rlhf", "imitation-learning"], claims: [{ about: "rlhf", text: "SFT on demonstrations, then RL from human rankings", locator: "abstract" }, { about: "imitation-learning", text: "step 1: supervised fine-tuning on labeler demonstrations (re-read from cache, no new fetch)", locator: "abstract" }] },
+  { kind: "fetch", url: "https://arxiv.org/abs/2212.08073", read: true, tier: "primary", title: "Constitutional AI", terms: ["rlaif"], claims: [{ about: "rlaif", text: "preference model from AI comparisons against principles as RL reward", locator: "abstract" }] },
+  { kind: "fetch", url: "https://arxiv.org/abs/2305.18290", read: true, tier: "primary", title: "DPO", terms: ["dpo"], claims: [{ about: "dpo", text: "classification loss, no sampling during fine-tuning", locator: "abstract" }] },
+  { kind: "fetch", url: "https://arxiv.org/html/2402.03300", read: true, tier: "primary", title: "DeepSeekMath (GRPO)", terms: ["grpo"], claims: [{ about: "grpo", text: "GRPO foregoes the critic model, baseline from group scores", locator: "GRPO section" }] },
