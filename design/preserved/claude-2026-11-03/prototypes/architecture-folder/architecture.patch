+
+type P<F> = [string, string, (f: F) => boolean][];
+const mk = <F extends Base>(level: string) => (id: string, label: string, meaning: string, sources: string[], props: P<F>, predicts?: Record<string, Relation>): Term<F> =>
+  ({ id, label, level, kind: "act", form: "word", meaning, sources, predicts, props: props.map(([pid, says, check]) => ({ id: pid, says, check })) });
+
+// ---------- warrant level: how a claim was established ----------
+export type Warrant = Base & {
+  fromAxioms: boolean;     // derived from axioms and definitions by valid inference
+  certain: boolean;        // nothing learned later can overturn it, given its axioms
+  standardChosen: boolean; // a standard of proof was stated before the evidence was weighed
+  aboutWorld: boolean;     // the claim is about the world, not about definitions
+  refutableTest: boolean;  // it survived a test that could have refuted it
+  againstSpec: boolean;    // checked against a specification
+  againstNeed: boolean;    // checked against the real need of the people it is for
+  machineChecked: boolean; // a program checks it (Lean, a test, a lint)
+};
