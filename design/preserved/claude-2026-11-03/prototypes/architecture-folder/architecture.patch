+  mk("rule-engine", "rule engine", "Evaluates stated rules against facts, deterministically.", ["production-rule systems usage"],
+    [["RE1", "stated rules", (f) => f.statedRules], ["RE2", "deterministic", (f) => f.deterministic]], { "records-mechanism": "has_a_kind", "learned-model": "overlap" }),
+  mk("symbolic-system", "symbolic system", "Operates on symbols with defined meanings by stated rules. The symbolic half of neuro-symbolic.", ["Newell and Simon 1976 (not opened); Kautz types"],
+    [["SY1", "typed symbols", (f) => f.typedSymbols], ["SY2", "stated rules", (f) => f.statedRules]], { "records-mechanism": "has_a_kind", "learned-model": "overlap" }),
+  mk("learned-model", "learned model", "Behaviour comes from parameters fitted to data (an LLM, Jev, our future Mentura models).", ["ML usage"],
+    [["LM1", "learned parameters", (f) => f.learned]], { "records-mechanism": "disjoint", mechanism: "overlap" }),
+  mk("records-mechanism", "records mechanism", "How Naive's records system acts: typed records change only by defined transitions, each by a stated rule, deterministically, every step traceable, and nothing learned decides. Models propose; this decides.", ["ours; decided positioning 2026-11-01 04:33Z"],
+    [["ME0", "not physical", (f) => !f.physical], ["DT1", "deterministic", (f) => f.deterministic], ["MC1", "stated rules", (f) => f.statedRules], ["MC2", "traceable", (f) => f.traceable],
+     ["SM1", "holds state", (f) => f.stateful], ["SM2", "defined transitions", (f) => f.definedTransitions], ["SY1", "typed symbols", (f) => f.typedSymbols], ["NL1", "nothing learned decides", (f) => !f.learned]],
+    { mechanism: "is_a", "deterministic-system": "is_a", "state-machine": "is_a", "rule-engine": "is_a", "symbolic-system": "is_a", "learned-model": "disjoint", "mechanical-system": "disjoint" }),
+];
+if (import.meta.url === `file://${process.argv[1]}`) {
+  const keys = ["physical", "deterministic", "statedRules", "traceable", "learned", "stateful", "definedTransitions", "typedSymbols"];
+  const cs: Sys[] = []; for (let m = 0; m < 2 ** (keys.length + 1); m++) { const f = { confirmed: Boolean(m & 1), label: ["mechanism", undefined][m % 2] } as Sys; keys.forEach((k, i) => { (f as any)[k] = Boolean(m & (2 << i)); }); cs.push(f); }
+  const sets = new Map(MECH.map((t) => [t.id, passSet(t, cs)])); let ok = 0, n = 0;
+  console.log(`== system behaviour: ${cs.length} cases`);
+  for (const t of MECH) { const v = validTest(t, cs); console.log(`${t.id.padEnd(22)} ${freeze(t)} ${v.length ? v.join("; ") : "valid"}`); }
+  for (const a of MECH) for (const [o, w] of Object.entries(a.predicts ?? {})) { n++; const g = relation(sets.get(a.id)!, sets.get(o)!); if (g === w) ok++; console.log(`${a.id} ~ ${o}: predicted ${w}, got ${g} -> ${g === w ? "confirmed" : "REFUTED"}`); }
+  console.log(`${ok}/${n} predictions confirmed`);
