+# Builds a TLA+ model of a flow in the architecture record, for pstack's statechart (Torian 2026-11-01 08:42Z:
+# the architecture record should produce a statechart). Every state and step comes from the record's
+# flows[].steps (does, on_fail, rules); nothing is typed by hand. Rules checked come from the record's design:
+# schema before store, provenance for every store, a refused write touches nothing, an agent never stores a
+# record on a gated route.
+#   python3 gen-statechart.py write  ->  naive-design/verification/<flow>-chain/
+import json, sys, hashlib, os
+REC = "/mnt/project-files/naive-design/architecture/naive.architecture.json"
+raw = open(REC).read(); rec = json.loads(raw); sha = hashlib.sha256(raw.encode()).hexdigest()
+flow = next(f for f in rec["flows"] if f["id"] == (sys.argv[1] if len(sys.argv) > 1 else "write"))
+out = f"/mnt/project-files/naive-design/verification/{flow['id']}-chain"; os.makedirs(out, exist_ok=True)
+steps = flow["steps"]; n = len(steps)
+store = next(s["n"] for s in steps if s["id"] == "store")
+def kinds(s):
+    f = (s.get("on_fail") or "").lower(); k = set()
+    if "refused" in f or "error" in f: k.add("refused")
+    if "draft" in f: k.add("draft")
+    return k
+agent_only = lambda s: "agent" in s["does"].lower()
+name = "WriteChain" if flow["id"] == "write" else flow["id"].title() + "Chain"
+acts, nxt = [], []
+for s in steps:
+    i, k = s["n"], kinds(s)
+    guard = f'pc = {i}'
+    if s["id"] == "store":
+        acts.append(f'Store == {guard} /\\ pc\' = {i+1} /\\ stored\' = TRUE /\\ UNCHANGED <<typeKnown, actor, gated, schemaOk, logged, asDraft>>')
+    elif s["id"] == "provenance":
+        acts.append(f'Log == {guard} /\\ pc\' = {i+1} /\\ logged\' = TRUE /\\ UNCHANGED <<typeKnown, actor, gated, schemaOk, stored, asDraft>>')
+    elif s.get("generative"):
+        acts.append(f'Pass{i} == {guard} /\\ typeKnown /\\ pc\' = {i+1} /\\ UNCHANGED <<typeKnown, actor, gated, schemaOk, stored, logged, asDraft>>')
+        acts.append(f'Research{i} == {guard} /\\ ~typeKnown /\\ pc\' = Researching /\\ UNCHANGED <<typeKnown, actor, gated, schemaOk, stored, logged, asDraft>>')
+        acts.append(f'Admit == pc = Researching /\\ typeKnown\' = TRUE /\\ pc\' = {i} /\\ UNCHANGED <<actor, gated, schemaOk, stored, logged, asDraft>>')
+        acts.append(f'Reject == pc = Researching /\\ pc\' = Refused /\\ UNCHANGED <<typeKnown, actor, gated, schemaOk, stored, logged, asDraft>>')
+    elif i == n:
+        acts.append(f'Answer == {guard} /\\ pc\' = Answered /\\ UNCHANGED <<typeKnown, actor, gated, schemaOk, stored, logged, asDraft>>')
+    else:
+        setok = "schemaOk' = TRUE" if s["id"] == "schema" else "UNCHANGED schemaOk"
