@@ -0,0 +1,77 @@
+/-
+Genealogy of a dependency graph (proposed, 2026-10-31). Orientation: `builtOn c p` means c imports p,
+so p is c's parent (the thing it is built on). Family words are positions in this relation, not kinds.
+-/
+namespace Naive.Genealogy
+variable {α : Type} (builtOn : α → α → Prop)
+
+def IsParent (p : α) : Prop := ∃ c, builtOn c p
+def IsSource (n : α) : Prop := ∀ q, ¬ builtOn n q
+def IsLeaf (n : α) : Prop := ∀ c, ¬ builtOn c n
+def IsGrandparent (g : α) : Prop := ∃ c d, builtOn c g ∧ builtOn d c
+
+/-- d descends from p: a chain of one or more "built on" steps. -/
+inductive Desc : α → α → Prop
+  | child {p c : α} : builtOn c p → Desc p c
+  | step {p c d : α} : builtOn c p → Desc c d → Desc p d
+
+theorem grandparent_is_parent {g : α} : IsGrandparent builtOn g → IsParent builtOn g :=
+  fun ⟨c, _, h, _⟩ => ⟨c, h⟩
+
+theorem has_descendant_is_parent {p d : α} : Desc builtOn p d → IsParent builtOn p
+  | .child h => ⟨_, h⟩
+  | .step h _ => ⟨_, h⟩
+
+theorem parent_not_leaf {p : α} : IsParent builtOn p → ¬ IsLeaf builtOn p :=
+  fun ⟨c, h⟩ hl => hl c h
+
+/-- Kernel's positional tests: K1 (at least three distinct dependents) and K2 (no dependencies). -/
+def KernelShape (k : α) : Prop :=
+  (∃ a b c, a ≠ b ∧ b ≠ c ∧ a ≠ c ∧ builtOn a k ∧ builtOn b k ∧ builtOn c k) ∧ IsSource builtOn k
+
+/-- "A father is a parent": anything with the kernel shape is a source and a parent. -/
+theorem kernel_is_source_and_parent {k : α} : KernelShape builtOn k → IsSource builtOn k ∧ IsParent builtOn k :=
+  fun ⟨⟨a, _, _, _, _, _, ha, _, _⟩, hs⟩ => ⟨hs, ⟨a, ha⟩⟩
+
+/-- Source and parent are independent: a lone node is a source and a leaf, not a parent. So "root"
+    (no parent) never implies "parent" (has children), and an engine nobody uses is still an engine. -/
+theorem source_not_always_parent : IsSource (fun _ _ : Unit => False) () ∧ ¬ IsParent (fun _ _ : Unit => False) () :=
+  ⟨fun _ h => h, fun ⟨_, h⟩ => h⟩
+
+end Naive.Genealogy
+
+namespace Naive.Genealogy
+/-- A module's facts split in two: what it does, and where it sits. -/
+structure Behaviour where
+  rulesAsInput : Bool
+  verdictWithReasons : Bool
+  domainFree : Bool
+  deterministic : Bool
+  tested : Bool
+structure Position where
+  fanIn : Nat
+  fanOut : Nat
+structure Module where
+  b : Behaviour
+  p : Position
+
+/-- E1 to E5, exactly as the glossary states them. -/
+def isEngine (m : Module) : Prop :=
+  m.b.rulesAsInput ∧ m.b.verdictWithReasons ∧ m.b.domainFree ∧ m.b.deterministic ∧ m.b.tested
+/-- The rejected variant with E6: used by at least one part. -/
+def isEngineE6 (m : Module) : Prop := isEngine m ∧ m.p.fanIn ≥ 1
+
+/-- Engine is behaviour only: two modules that do the same thing get the same verdict wherever they sit. -/
+theorem engine_position_blind (b : Behaviour) (p q : Position) : isEngine ⟨b, p⟩ ↔ isEngine ⟨b, q⟩ :=
+  Iff.rfl
+
+/-- With E6 that fails: the same module stops being an engine when its last user deletes an import. -/
+theorem engineE6_not_position_blind :
+    ∃ b p q, isEngineE6 ⟨b, p⟩ ∧ ¬ isEngineE6 ⟨b, q⟩ :=
+  ⟨⟨true, true, true, true, true⟩, ⟨1, 0⟩, ⟨0, 0⟩,
+   ⟨⟨rfl, rfl, rfl, rfl, rfl⟩, by decide⟩, fun ⟨_, h⟩ => by simp at h⟩
+
+/-- So engine does not imply parent: an engine with no users exists. -/
+theorem engine_not_always_used : ∃ m, isEngine m ∧ m.p.fanIn = 0 :=
+  ⟨⟨⟨true, true, true, true, true⟩, ⟨0, 0⟩⟩, ⟨rfl, rfl, rfl, rfl, rfl⟩, rfl⟩
+end Naive.Genealogy
