+    { "prove@science": "overlap", "prove@naive": "equal" }),
+  W("prove@science", "prove", "Never strictly: a hypothesis is corroborated by surviving tests that could have refuted it. Provisional.",
+    ["Popper, The Logic of Scientific Discovery (1959)"],
+    [["PS1", "survived a test that could have refuted it", (f) => f.refutableTest], ["PL2", "a claim about the world", (f) => f.aboutWorld], ["DF1", "defeasible", (f) => !f.certain]],
+    { corroborate: "equal", validate: "overlap" }),
+  W("corroborate", "corroborate", "Popper: a hypothesis gains support by surviving a severe test; it is never verified.",
+    ["Popper, The Logic of Scientific Discovery (1959), ch. 10"],
+    [["PS1", "survived a test that could have refuted it", (f) => f.refutableTest], ["PL2", "a claim about the world", (f) => f.aboutWorld], ["DF1", "defeasible", (f) => !f.certain]]),
+  W("prove@naive", "prove", "Naive's default for anything about the world: establish to a standard stated first. Lean proofs keep prove@math.",
+    ["Venture comparison plan (2026-11-01)"],
+    [["PL1", "a standard of proof was stated first", (f) => f.standardChosen], ["PL2", "a claim about the world", (f) => f.aboutWorld], ["DF1", "defeasible", (f) => !f.certain]]),
+  W("verify", "verify", "IEEE 1012 verification: check that a thing meets its specification (built it right).",
