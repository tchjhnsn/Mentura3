@@ -0,0 +1,114 @@
+// "Venture Anatomy Matrix" and "holding" (proposed in the AI-labs anatomy thread, 2026-11-01), run through the term
+// engine against their neighbours. Two levels: instrument (what a matrix scores) and organization (what holds what).
+// Exhaustive over 2^7 facts per level.
+//
+//   node anatomy-vocab.ts
+
+import { freeze, passSet, relation, run, validTest, type Base, type Relation, type Term } from "/home/user/ee-build/schema/terms/engine.ts";
+
+type P<F> = [string, string, (f: F) => boolean][];
+const mk = <F extends Base>(level: string) => (id: string, label: string, meaning: string, sources: string[], props: P<F>, predicts?: Record<string, Relation>): Term<F> =>
+  ({ id, label, level, kind: "role", form: "word", meaning, sources, predicts, props: props.map(([pid, says, check]) => ({ id: pid, says, check })) });
+
+// ---------- instrument level ----------
+export type Instrument = Base & {
+  itemsByCriteria: boolean; // scores items against criteria in a grid
+  unitVenture: boolean;     // what it describes is a venture
+  unitProduct: boolean;     // what it describes is a product
+  rowsAreParts: boolean;    // its rows are the parts the unit must be able to state (core, risks, control, capital ...)
+  rankAgainstCore: boolean; // ranks items against one core promise
+  evidenceLadder: boolean;  // each cell is a level on an evidence ladder (absent, stated, cited, verified)
+  partPhases: boolean;      // each part names the phase by which it must hold
+};
+const I = mk<Instrument>("instrument");
+export const INSTRUMENT_VOCAB: Term<Instrument>[] = [
+  I("decision-matrix", "matrix", "Items scored against criteria in a grid.", ["Pugh, concept selection matrix (1981)"],
+    [["MX1", "scores items against criteria", (f) => f.itemsByCriteria]], { "product-anatomy-matrix": "has_a_kind", "venture-anatomy-matrix": "has_a_kind" }),
+  I("product-anatomy-matrix", "Product Anatomy Matrix", "Ours: a venture's products scored against its one core promise, with roles and a Succession Matrix phase.",
+    ["purpose/frameworks/product-anatomy (2026-10-26)"],
+    [["MX1", "scores items against criteria", (f) => f.itemsByCriteria], ["PA1", "describes products", (f) => f.unitProduct], ["PA2", "ranks against one core promise", (f) => f.rankAgainstCore]],
+    { "venture-anatomy-matrix": "overlap", "decision-matrix": "is_a" }),
+  I("venture-anatomy-matrix", "Venture Anatomy Matrix", "Proposed: a venture's parts, taken from the S-1 section list, each scored on the evidence ladder, each with the phase by which it must hold. Products is one part.",
+    ["AI-labs anatomy doc (2026-11-01)", "anthropic-s-1-2026 (section list)"],
+    [["MX1", "scores items against criteria", (f) => f.itemsByCriteria], ["VA1", "describes a venture", (f) => f.unitVenture], ["VA2", "rows are the venture's parts", (f) => f.rowsAreParts],
+     ["VA3", "cells are evidence-ladder levels", (f) => f.evidenceLadder], ["VA4", "each part has a phase by which it must hold", (f) => f.partPhases]],
+    { "decision-matrix": "is_a", "due-diligence-checklist": "is_a", "product-anatomy-matrix": "overlap" }),
+  I("due-diligence-checklist", "due diligence checklist", "Industry: the list of what a company must be able to state and evidence about itself, by area, before an investment, acquisition or offering.",
+    ["SEC Regulation S-K (items of disclosure)", "common transaction practice"],
+    [["VA1", "describes a venture", (f) => f.unitVenture], ["VA2", "rows are the venture's parts", (f) => f.rowsAreParts]],
+    { "venture-anatomy-matrix": "has_a_kind" }),
+];
+
+// ---------- organization level ----------
+export type Org = Base & {
+  undertaken: boolean;        // someone undertakes it (the ontology's venture)
+  hasOneCore: boolean;        // it has one core promise of its own
+  holdsVentures: boolean;     // it controls one or more other ventures
+  coresDiffer: boolean;       // the ventures it holds have different cores
+  operatesItself: boolean;    // it makes or sells something itself, not only through what it holds
+  legalEntity: boolean;       // it is a legal entity
+  ownGovernance: boolean;     // it has its own control, capital and related-party parts
+};
+const O = mk<Org>("organization");
+export const ORG_VOCAB: Term<Org>[] = [
+  O("venture", "venture", "Ontology: anything a builder undertakes, from a hobby to a company. Ventures can hold ventures.", ["docs/ontology.json (venture)"],
+    [["VN1", "undertaken by someone", (f) => f.undertaken]], { "venture@vam": "has_a_kind", holding: "has_a_kind" }),
+  O("venture@vam", "venture", "The Venture Anatomy Matrix's: an undertaking with one core promise of its own.", ["AI-labs anatomy doc (2026-11-01)"],
+    [["VN1", "undertaken by someone", (f) => f.undertaken], ["VC1", "has one core of its own", (f) => f.hasOneCore]],
+    { venture: "is_a", holding: "disjoint" }),
+  O("holding", "holding", "Proposed: a level above the venture that holds several ventures with different cores, has no core of its own, and has its own control, capital and related-party parts (SpaceX holding Space and AI; a founder with several ventures).",
+    ["AI-labs anatomy doc (2026-11-01)"],
+    [["VN1", "undertaken by someone", (f) => f.undertaken], ["HD1", "holds ventures", (f) => f.holdsVentures], ["HD2", "the ventures it holds have different cores", (f) => f.coresDiffer],
+     ["HD3", "has no core of its own", (f) => !f.hasOneCore], ["HD4", "has its own control, capital and related parties", (f) => f.ownGovernance]],
+    { venture: "is_a", "venture@vam": "disjoint", group: "is_a", "holding-company": "overlap", "parent-company": "overlap" }),
+  O("holding-company", "holding company", "Industry: a legal entity whose business is owning controlling stakes in other companies; it does not operate itself.",
+    ["Black's Law Dictionary (holding company)", "Bank Holding Company Act (1956)"],
+    [["HD1", "holds ventures", (f) => f.holdsVentures], ["HC1", "does not operate itself", (f) => !f.operatesItself], ["LE1", "a legal entity", (f) => f.legalEntity]],
+    { "parent-company": "disjoint", group: "is_a", holding: "overlap" }),
+  O("parent-company", "parent company", "Industry: a legal entity that controls subsidiaries and also operates itself.",
+    ["IFRS 10 (parent)", "common corporate usage"],
+    [["HD1", "holds ventures", (f) => f.holdsVentures], ["PC1", "operates itself", (f) => f.operatesItself], ["LE1", "a legal entity", (f) => f.legalEntity]],
+    { "holding-company": "disjoint", group: "is_a" }),
+  O("group", "group", "IFRS 10: a parent and its subsidiaries, taken together.", ["IFRS 10 Appendix A (group)"],
+    [["HD1", "holds ventures", (f) => f.holdsVentures]], { holding: "has_a_kind", "holding-company": "has_a_kind", "parent-company": "has_a_kind" }),
+];
+
+function cases<F extends Base>(keys: readonly string[], labels: string[]): F[] {
+  const out: F[] = [];
+  for (let m = 0; m < 2 ** (keys.length + 1); m++) {
+    const f = { confirmed: Boolean(m & 1), label: [...labels, undefined][m % (labels.length + 1)] } as F;
+    keys.forEach((k, i) => { (f as Record<string, unknown>)[k] = Boolean(m & (2 << i)); });
+    out.push(f);
+  }
+  return out;
+}
+export const instrumentCases = () => cases<Instrument>(["itemsByCriteria", "unitVenture", "unitProduct", "rowsAreParts", "rankAgainstCore", "evidenceLadder", "partPhases"], ["matrix", "checklist"]);
+export const orgCases = () => cases<Org>(["undertaken", "hasOneCore", "holdsVentures", "coresDiffer", "operatesItself", "legalEntity", "ownGovernance"], ["venture", "holding"]);
+
+function runLevel<F extends Base>(name: string, vocab: Term<F>[], cs: F[]): [number, number] {
+  const sets = new Map(vocab.map((t) => [t.id, passSet(t, cs)])); let ok = 0, n = 0;
+  console.log(`\n== ${name}: ${cs.length} cases`);
+  for (const t of vocab) { const v = validTest(t, cs); console.log(`${t.id.padEnd(24)} ${freeze(t)} ${v.length ? v.join("; ") : "valid"}`); }
+  for (const a of vocab) for (const [o, w] of Object.entries(a.predicts ?? {})) {
+    n++; const g = relation(sets.get(a.id)!, sets.get(o)!); if (g === w) ok++;
+    console.log(`${a.id} ~ ${o}: predicted ${w}, got ${g} -> ${g === w ? "confirmed" : "REFUTED"}`);
+  }
+  return [ok, n];
+}
+
+if (import.meta.url === `file://${process.argv[1]}`) {
+  const [a, b] = runLevel("instrument", INSTRUMENT_VOCAB, instrumentCases());
+  const [c, d] = runLevel("organization", ORG_VOCAB, orgCases());
+  console.log(`\n${a + c}/${b + d} predictions confirmed`);
+  const ex: [string, Partial<Org>][] = [
+    ["SpaceX (Space and AI, operates launches itself)", { undertaken: true, holdsVentures: true, coresDiffer: true, operatesItself: true, legalEntity: true, ownGovernance: true }],
+    ["Alphabet-style pure holding", { undertaken: true, holdsVentures: true, coresDiffer: true, legalEntity: true, ownGovernance: true }],
+    ["Torian (founder of several ventures)", { undertaken: true, holdsVentures: true, coresDiffer: true, ownGovernance: true }],
+    ["Anthropic", { undertaken: true, hasOneCore: true, operatesItself: true, legalEntity: true, ownGovernance: true }],
+  ];
+  console.log("\n== examples");
+  for (const [name, facts] of ex) {
+    const f = { confirmed: true, undertaken: false, hasOneCore: false, holdsVentures: false, coresDiffer: false, operatesItself: false, legalEntity: false, ownGovernance: false, ...facts } as Org;
+    console.log(`${name.padEnd(48)} ${ORG_VOCAB.filter((t) => run(t, f).pass).map((t) => t.id).join(", ")}`);
+  }
+}
