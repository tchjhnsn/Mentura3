@@ -0,0 +1,83 @@
+// "symbolic design" and the kind of AI system we build (Torian, 2026-11-01 03:46Z): symbolic vs neural, TypeSafe's
+// System One models ("prod, not God"), and what to call Naive + Mentura's records-first approach.
+// One level: system (a piece of software that uses AI, or does not). Exhaustive over the facts.
+//
+//   node approach-vocab.ts
+
+import { freeze, passSet, relation, run, validTest, type Base, type Relation, type Term } from "/home/user/ee-build/schema/terms/engine.ts";
+
+type P<F> = [string, string, (f: F) => boolean][];
+const mk = <F extends Base>(level: string) => (id: string, label: string, meaning: string, sources: string[], props: P<F>, predicts?: Record<string, Relation>): Term<F> =>
+  ({ id, label, level, kind: "role", form: "word", meaning, sources, predicts, props: props.map(([pid, says, check]) => ({ id: pid, says, check })) });
+
+export type Sys = Base & {
+  symbolicPart: boolean;     // has a part whose meaning sits in human-readable symbols (records, rules, types, logic)
+  neuralPart: boolean;       // has a part whose meaning sits in learned weights (a model)
+  codeIsConsumer: boolean;   // the model's output is read by code, not by a person
+  typedOutput: boolean;      // the model returns typed decisions (choice, yes/no, score), not prose
+  calibrated: boolean;       // the model's probabilities are trained to be honest
+  conversational: boolean;   // the model is built to reply to people in text
+  symbolicDecides: boolean;  // only the symbolic part writes what counts as true; the neural part proposes
+};
+const S = mk<Sys>("system");
+export const SYSTEM_VOCAB: Term<Sys>[] = [
+  S("symbolic-system", "symbolic", "Knowledge and decisions held in human-readable symbols: records, rules, types, logic (classical or symbolic AI, expert systems, proof assistants). No learned part.",
+    ["Symbolic AI: 'methods based on high-level symbolic (human-readable) representations' (Wikipedia)"],
+    [["SY1", "has a symbolic part", (f) => f.symbolicPart], ["SY2", "has no neural part", (f) => !f.neuralPart]],
+    { "neural-system": "disjoint", "neuro-symbolic-system": "disjoint" }),
+  S("neural-system", "neural (connectionist, subsymbolic)", "Knowledge held in learned weights of a model; no human-readable part carries the meaning.",
+    ["Connectionist / subsymbolic AI (Wikipedia, Symbolic AI)"],
+    [["NU1", "has a neural part", (f) => f.neuralPart], ["NU2", "has no symbolic part", (f) => !f.symbolicPart]],
+    { "symbolic-system": "disjoint", "neuro-symbolic-system": "disjoint", "system-one-model": "has_a_kind", "assistant-model": "has_a_kind" }),
+  S("neuro-symbolic-system", "neuro-symbolic", "A system with both a neural part and a symbolic part working together.",
+    ["Sheth et al., 'Neurosymbolic AI: Why, What, and How' (arXiv 2305.00813)"],
+    [["SY1", "has a symbolic part", (f) => f.symbolicPart], ["NU1", "has a neural part", (f) => f.neuralPart]],
+    { "records-first-system": "has_a_kind", "symbolic-system": "disjoint", "neural-system": "disjoint" }),
+  S("system-one-model", "System One model", "TypeSafe AI: a model whose consumer is code, returning typed decisions with calibrated probabilities (Jev).",
+    ["latent.space/p/jev (2026)", "typesafe.ai/manifesto ('We're building prod, not God')"],
+    [["NU1", "has a neural part", (f) => f.neuralPart], ["NU2", "has no symbolic part", (f) => !f.symbolicPart], ["S1a", "code is the consumer", (f) => f.codeIsConsumer],
+     ["S1b", "typed output", (f) => f.typedOutput], ["S1c", "calibrated probabilities", (f) => f.calibrated]],
+    { "neural-system": "is_a", "assistant-model": "disjoint" }),
+  S("assistant-model", "assistant model", "A chat model trained to reply helpfully to people in text (RLHF chatbots).",
+    ["typesafe.ai/manifesto ('trained to be a helpful, articulate, pleasant assistant')"],
+    [["NU1", "has a neural part", (f) => f.neuralPart], ["NU2", "has no symbolic part", (f) => !f.symbolicPart], ["AS1", "converses with people", (f) => f.conversational], ["AS2", "a person is the consumer", (f) => !f.codeIsConsumer]],
+    { "neural-system": "is_a", "system-one-model": "disjoint" }),
+  S("records-first-system", "records-first system", "Proposed for Naive + Mentura: a neuro-symbolic system where only the symbolic part (records, theorems, code) decides what is true; models read sources and propose, and every proposal carries a reference and is checked.",
+    ["Venture library doc (2026-11-01)", "polity-os rule 'Code decides; models only classify inputs'"],
+    [["SY1", "has a symbolic part", (f) => f.symbolicPart], ["NU1", "has a neural part", (f) => f.neuralPart], ["RF1", "only the symbolic part decides", (f) => f.symbolicDecides]],
+    { "neuro-symbolic-system": "is_a", "symbolic-system": "disjoint", "system-one-model": "disjoint" }),
+];
+
+export function sysCases(): Sys[] {
+  const keys = ["symbolicPart", "neuralPart", "codeIsConsumer", "typedOutput", "calibrated", "conversational", "symbolicDecides"] as const;
+  const labels = ["AI", "model"];
+  const out: Sys[] = [];
+  for (let m = 0; m < 2 ** (keys.length + 1); m++) {
+    const f = { confirmed: Boolean(m & 1), label: [...labels, undefined][m % (labels.length + 1)] } as Sys;
+    keys.forEach((k, i) => { (f as Record<string, unknown>)[k] = Boolean(m & (2 << i)); });
+    out.push(f);
+  }
+  return out;
+}
+
+if (import.meta.url === `file://${process.argv[1]}`) {
+  const cs = sysCases();
+  const sets = new Map(SYSTEM_VOCAB.map((t) => [t.id, passSet(t, cs)])); let ok = 0, n = 0;
+  console.log(`== system: ${cs.length} cases`);
+  for (const t of SYSTEM_VOCAB) { const v = validTest(t, cs); console.log(`${t.id.padEnd(24)} ${freeze(t)} ${v.length ? v.join("; ") : "valid"}`); }
+  for (const a of SYSTEM_VOCAB) for (const [o, w] of Object.entries(a.predicts ?? {})) {
+    n++; const g = relation(sets.get(a.id)!, sets.get(o)!); if (g === w) ok++;
+    console.log(`${a.id} ~ ${o}: predicted ${w}, got ${g} -> ${g === w ? "confirmed" : "REFUTED"}`);
+  }
+  console.log(`\n${ok}/${n} predictions confirmed`);
+  const base = { confirmed: true, label: undefined, symbolicPart: false, neuralPart: false, codeIsConsumer: false, typedOutput: false, calibrated: false, conversational: false, symbolicDecides: false } as Sys;
+  const ex: [string, Partial<Sys>][] = [
+    ["Jev (TypeSafe)", { neuralPart: true, codeIsConsumer: true, typedOutput: true, calibrated: true }],
+    ["Claude.ai chat", { neuralPart: true, conversational: true }],
+    ["Lean proof checker", { symbolicPart: true }],
+    ["Naive + Mentura (records, theorems, models that draft)", { symbolicPart: true, neuralPart: true, codeIsConsumer: true, symbolicDecides: true }],
+    ["An app that lets a chatbot write the database directly", { symbolicPart: true, neuralPart: true, conversational: true }],
+  ];
+  console.log("\n== examples");
+  for (const [name, facts] of ex) console.log(`${name.padEnd(56)} ${SYSTEM_VOCAB.filter((t) => run(t, { ...base, ...facts } as Sys).pass).map((t) => t.id).join(", ") || "(no term)"}`);
+}
