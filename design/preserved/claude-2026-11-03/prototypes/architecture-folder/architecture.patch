+<title>Naive Dependency Map</title>
+<meta name="claude:viewport-fit-sides" content="cover">
+<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&family=JetBrains+Mono:wght@400;600&display=swap">
+<style>
+/* Layout: a summary strip on top, then the as-built graph drawn in rank bands (things others depend on sink to the bottom), with a detail panel for the selected part. */
+:root{
+  --bg:#f6f7f5; --panel:#ffffff; --fg:#1d2321; --muted:#5d6763; --line:#c9d0cc;
+  --accent:#1f6f5c; --accent-soft:#d8ece5; --knot:#b4462a; --knot-soft:#f7e3dc; --kernel:#5a4fb0; --kernel-soft:#e7e4f7;
+  --body:"Atkinson Hyperlegible",system-ui,sans-serif; --mono:"JetBrains Mono",ui-monospace,monospace;
+}
+@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
+  --bg:#141917; --panel:#1c2220; --fg:#e4ebe7; --muted:#9aa6a1; --line:#34403b;
+  --accent:#5cc2a4; --accent-soft:#1f3a32; --knot:#f08a6c; --knot-soft:#3d2219; --kernel:#a79cf2; --kernel-soft:#2a2645; color-scheme:dark}}
+:root[data-theme="dark"]{
+  --bg:#141917; --panel:#1c2220; --fg:#e4ebe7; --muted:#9aa6a1; --line:#34403b;
+  --accent:#5cc2a4; --accent-soft:#1f3a32; --knot:#f08a6c; --knot-soft:#3d2219; --kernel:#a79cf2; --kernel-soft:#2a2645; color-scheme:dark}
+body{background:var(--bg);color:var(--fg);font:15px/1.5 var(--body);padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px));padding-block:24px 48px}
+.wrap{max-width:1180px;margin:0 auto;display:grid;gap:20px}
+h1{font-size:1.6rem;margin:0;text-wrap:balance}
+h2{font-size:1.05rem;margin:0 0 8px}
+p{margin:0;max-width:68ch}
+.sub{color:var(--muted)}
+code,.mono{font-family:var(--mono);font-size:.82em}
+.facts{display:grid;grid-template-columns:repeat(auto-fit,minmax(170px,1fr));gap:12px}
+.fact{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:12px 14px;display:grid;gap:2px;min-width:0}
+.fact b{font:600 1.4rem var(--mono);font-variant-numeric:tabular-nums}
+.fact.knot b{color:var(--knot)} .fact.kernel b{color:var(--kernel)}
+.fact span{color:var(--muted);font-size:.86rem}
+.main{display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:16px;align-items:start}
+@media (max-width:860px){.main{grid-template-columns:minmax(0,1fr)}}
+.graph{background:var(--panel);border:1px solid var(--line);border-radius:8px;overflow-x:auto;min-width:0}
+.legend{display:flex;flex-wrap:wrap;gap:14px;padding:10px 14px;border-bottom:1px solid var(--line);font-size:.84rem;color:var(--muted)}
+.legend i{display:inline-block;width:12px;height:12px;border-radius:3px;margin-right:6px;vertical-align:-1px;border:1.5px solid var(--line)}
+.legend .lk{background:var(--knot-soft);border-color:var(--knot)} .legend .lr{background:var(--kernel-soft);border-color:var(--kernel)} .legend .ln{background:var(--panel)}
+svg text{fill:var(--fg);font:12px var(--mono)}
+svg .n rect{fill:var(--panel);stroke:var(--line);stroke-width:1.5;cursor:pointer}
+svg .n.knot rect{fill:var(--knot-soft);stroke:var(--knot)}
+svg .n.kern rect{stroke:var(--kernel);stroke-width:2.5}
+svg .n.sel rect{stroke:var(--accent);stroke-width:3}
+svg .n:focus-visible rect{stroke:var(--accent);stroke-width:3;stroke-dasharray:4 2}
+svg .n.dim{opacity:.25}
+svg .n text.small{fill:var(--muted);font-size:10.5px}
+svg path.e{fill:none;stroke:var(--line);stroke-width:1.2}
+svg path.e.mut{stroke:var(--knot);stroke-opacity:.55}
+svg path.e.down{stroke:var(--accent);stroke-width:2;stroke-opacity:1}
+svg path.e.up{stroke:var(--kernel);stroke-width:2;stroke-opacity:1}
+svg path.e.dim{stroke-opacity:.08}
+svg .band{fill:var(--bg)} svg .bandlabel{fill:var(--muted);font:11px var(--body);letter-spacing:.06em;text-transform:uppercase}
+aside{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:14px;display:grid;gap:10px;min-width:0}
+aside ul{margin:0;padding-left:18px} aside li{overflow-wrap:anywhere}
+.pill{display:inline-block;font-size:.75rem;padding:1px 8px;border-radius:99px;border:1px solid var(--line);color:var(--muted)}
+.pill.k{border-color:var(--knot);color:var(--knot)}
+.notes{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:16px}
+.note{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:14px;display:grid;gap:8px;align-content:start;min-width:0}
+.note ul{margin:0;padding-left:18px} .note li{overflow-wrap:anywhere}
+</style>
