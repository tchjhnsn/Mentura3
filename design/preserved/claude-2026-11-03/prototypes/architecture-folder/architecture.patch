+import { run, freeze } from "/home/user/ee-build/schema/terms/engine.ts";
+import { VOCAB, type Element } from "./vocabulary.ts";
+const T = (id: string) => VOCAB.find((t) => t.id === id)!;
+const base: Element = { confirmed: true, human: false, hasParent: false, allReachIt: false, standalone: false, runsOrStoresSeparately: false, storesData: false, singleSourceUnit: false, groupsUnitsBehindContract: false, isContract: false, definesDataShape: false, isDataInstance: false, reusableAcrossProducts: false, callsYourCode: false, calledByYourCode: false, hostedWithAccounts: false, othersBuildOnIt: false } as Element;
+type Sys = { id: string; facts: Partial<Element> & { distributed?: boolean }; evidence: Record<string, string> };
+const S: Sys[] = [
+  { id: "Next.js", facts: { standalone: true, runsOrStoresSeparately: true, reusableAcrossProducts: true, callsYourCode: true, othersBuildOnIt: true, distributed: true },
+    evidence: { callsYourCode: "it renders the pages and route handlers you put in app/ (file-system conventions)", distributed: "MIT package you install and run yourself (npm next)", hostedWithAccounts: "no: Next.js itself has no accounts" } },
+  { id: "Vercel", facts: { standalone: true, runsOrStoresSeparately: true, reusableAcrossProducts: true, callsYourCode: true, hostedWithAccounts: true, othersBuildOnIt: true, distributed: false },
+    evidence: { hostedWithAccounts: "you sign in; it builds and serves your project", callsYourCode: "it invokes your functions", distributed: "a service, not something you install" } },
+  { id: "Naive (as built, main 2507d1a)", facts: { standalone: true, runsOrStoresSeparately: true, reusableAcrossProducts: true, callsYourCode: true, storesData: true, othersBuildOnIt: true, distributed: true },
+    evidence: { callsYourCode: "it runs your venture's records in its conventions: schema/packages.mjs orders records into waves and moves each when what it reads is confirmed; interface/kit-boundary.mjs wraps a kit you supply. Its 'your code' is records and kits, not functions", distributed: "package.json name naive-framework, CLI bin; MIT LICENSE on main", hostedWithAccounts: "no: CLI, stdio MCP server, API on 127.0.0.1 for one machine" } },
+  { id: "Hosted library + tenants (designed)", facts: { standalone: true, runsOrStoresSeparately: true, storesData: true, hostedWithAccounts: true, othersBuildOnIt: true, reusableAcrossProducts: true, calledByYourCode: true, distributed: false },
