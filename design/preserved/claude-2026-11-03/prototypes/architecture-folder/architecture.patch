@@ -0,0 +1,38 @@
+/- Symbolic, neural, neuro-symbolic, System One model, assistant model, records-first system (2026-11-01).
+   Mirrors approach-vocab.ts. Core Lean only. Written in the AI-labs thread; built by the phases thread. -/
+namespace Naive.Approach
+
+structure Sys where
+  symbolicPart : Bool
+  neuralPart : Bool
+  codeIsConsumer : Bool
+  typedOutput : Bool
+  calibrated : Bool
+  conversational : Bool
+  symbolicDecides : Bool
+
+def IsSymbolic (s : Sys) : Prop := s.symbolicPart = true ∧ s.neuralPart = false
+def IsNeural (s : Sys) : Prop := s.neuralPart = true ∧ s.symbolicPart = false
+def IsNeuroSymbolic (s : Sys) : Prop := s.symbolicPart = true ∧ s.neuralPart = true
+def IsSystemOne (s : Sys) : Prop :=
+  IsNeural s ∧ s.codeIsConsumer = true ∧ s.typedOutput = true ∧ s.calibrated = true
+def IsAssistant (s : Sys) : Prop := IsNeural s ∧ s.conversational = true ∧ s.codeIsConsumer = false
+def IsRecordsFirst (s : Sys) : Prop := IsNeuroSymbolic s ∧ s.symbolicDecides = true
+
+theorem system_one_is_neural {s : Sys} (h : IsSystemOne s) : IsNeural s := h.1
+theorem records_first_is_neuro_symbolic {s : Sys} (h : IsRecordsFirst s) : IsNeuroSymbolic s := h.1
+
+theorem system_one_not_assistant {s : Sys} (h1 : IsSystemOne s) (h2 : IsAssistant s) : False := by
+  have a := h1.2.1
+  have b := h2.2.2
+  rw [a] at b
+  exact Bool.noConfusion b
+
+/-- A System One model is a part we use, not what we are: nothing is both. -/
+theorem records_first_not_system_one {s : Sys} (hr : IsRecordsFirst s) (h1 : IsSystemOne s) : False := by
+  have a := hr.1.1
+  have b := h1.1.2
+  rw [a] at b
+  exact Bool.noConfusion b
+
+end Naive.Approach
diff --git a/project-files/naive-design/prototypes/architecture/Architecture.lean b/project-files/naive-design/prototypes/architecture/Architecture.lean
new file mode 100644
index 0000000..692a26d
--- /dev/null
+++ b/project-files/naive-design/prototypes/architecture/Architecture.lean
@@ -0,0 +1,44 @@
+/-
+  Architecture facts proved once for every dependency graph (proposed, 2026-10-31).
+  A graph is any relation `dep a b` ("a imports b"). Core Lean only.
+-/
+namespace Naive.Architecture
+
+/-- `Reach dep a b`: a path of one or more dependency edges from `a` to `b`. -/
+inductive Reach {α : Type} (dep : α → α → Prop) : α → α → Prop
+  | edge {a b} : dep a b → Reach dep a b
+  | step {a b c} : dep a b → Reach dep b c → Reach dep a c
+
+/-- Every path starts with an edge out of where it starts. -/
+theorem reach_first {α : Type} {dep : α → α → Prop} {a c : α} (h : Reach dep a c) : ∃ b, dep a b := by
+  cases h with
+  | edge e => exact ⟨_, e⟩
+  | step e _ => exact ⟨_, e⟩
+
+/-- K2 makes a part a leaf; a leaf is in no cycle. So a kernel can never sit inside an import cycle,
+    whatever else the graph holds. -/
+theorem leaf_not_in_cycle {α : Type} {dep : α → α → Prop} {k : α} (leaf : ∀ b, ¬ dep k b) : ¬ Reach dep k k := by
+  intro h
+  obtain ⟨b, e⟩ := reach_first h
+  exact leaf b e
+
+/-- A leaf reaches nothing, so trusting it never requires trusting anything else in the system. -/
+theorem leaf_reaches_nothing {α : Type} {dep : α → α → Prop} {k : α} (leaf : ∀ b, ¬ dep k b) (c : α) : ¬ Reach dep k c := by
+  intro h
+  obtain ⟨b, e⟩ := reach_first h
+  exact leaf b e
+
+/-- Layering: if every edge goes strictly down a rank, the graph has no cycle at all. -/
+theorem ranked_acyclic {α : Type} {dep : α → α → Prop} (rank : α → Nat)
+    (down : ∀ a b, dep a b → rank b < rank a) : ∀ a c, Reach dep a c → rank c < rank a := by
+  intro a c h
+  induction h with
+  | edge e => exact down _ _ e
+  | step e _ ih => exact Nat.lt_trans ih (down _ _ e)
+
+theorem ranked_no_cycle {α : Type} {dep : α → α → Prop} (rank : α → Nat)
+    (down : ∀ a b, dep a b → rank b < rank a) (a : α) : ¬ Reach dep a a := by
+  intro h
+  exact Nat.lt_irrefl _ (ranked_acyclic rank down a a h)
+
+end Naive.Architecture
diff --git a/project-files/naive-design/prototypes/architecture/Capability.lean b/project-files/naive-design/prototypes/architecture/Capability.lean
new file mode 100644
index 0000000..b6412f6
