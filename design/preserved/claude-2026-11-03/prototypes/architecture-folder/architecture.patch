+++ b/project-files/naive-design/prototypes/architecture/Glossary.lean
@@ -0,0 +1,95 @@
+/- What a glossary is, and its neighbours (proposed, 2026-11-01). Mirrors glossary-vocab.ts: the same
+   properties, so a theorem here and a cross-run there say the same thing. -/
+namespace Naive.Glossary
+
+inductive EntryKind | term | item | party | mixed
+  deriving DecidableEq
+
+structure Collection where
+  entryKind : EntryKind
+  definesMeaning : Bool
+  oneField : Bool
+  hasLocators : Bool
+  describesAttributes : Bool
+  givesContact : Bool
+  authorityRecords : Bool
+  relatesEntries : Bool
+  usageNotes : Bool
+
+def IsDictionary (c : Collection) : Prop := c.entryKind = .term ∧ c.definesMeaning = true
+def IsGlossary (c : Collection) : Prop := IsDictionary c ∧ c.oneField = true
+def IsAgentGlossary (c : Collection) : Prop := IsGlossary c ∧ c.usageNotes = true
+def IsIndex (c : Collection) : Prop := c.entryKind = .term ∧ c.hasLocators = true
+def IsCatalog (c : Collection) : Prop := c.entryKind = .item ∧ c.describesAttributes = true
+def IsDirectory (c : Collection) : Prop := c.entryKind = .party ∧ c.givesContact = true
+def IsRegistry (c : Collection) : Prop := c.authorityRecords = true
+def IsThesaurus (c : Collection) : Prop := c.entryKind = .term ∧ c.relatesEntries = true
+
+theorem glossary_is_dictionary {c : Collection} (h : IsGlossary c) : IsDictionary c := h.1
+theorem agent_glossary_is_glossary {c : Collection} (h : IsAgentGlossary c) : IsGlossary c := h.1
+
+/-- No collection is both a glossary and a catalog: their entries are different kinds of thing. -/
+theorem glossary_not_catalog {c : Collection} (g : IsGlossary c) : ¬ IsCatalog c := by
+  intro k; have h1 := g.1.1; have h2 := k.1; rw [h1] at h2; cases h2
+
+theorem glossary_not_directory {c : Collection} (g : IsGlossary c) : ¬ IsDirectory c := by
+  intro d; have h1 := g.1.1; have h2 := d.1; rw [h1] at h2; cases h2
+
+/-- A glossary can also be an index: the two overlap, neither contains the other. -/
+def both : Collection := ⟨.term, true, true, true, false, false, false, false, false⟩
+def glossOnly : Collection := ⟨.term, true, true, false, false, false, false, false, false⟩
+def indexOnly : Collection := ⟨.term, false, false, true, false, false, false, false, false⟩
+theorem glossary_index_overlap :
+    (IsGlossary both ∧ IsIndex both) ∧ (IsGlossary glossOnly ∧ ¬ IsIndex glossOnly) ∧ (IsIndex indexOnly ∧ ¬ IsGlossary indexOnly) := by
+  refine ⟨⟨⟨⟨rfl, rfl⟩, rfl⟩, ⟨rfl, rfl⟩⟩, ⟨⟨⟨rfl, rfl⟩, rfl⟩, fun h => by cases h.2⟩, ⟨rfl, rfl⟩, fun h => by cases h.1.2⟩
+
+/-- The glossary run through itself: the facts read off schema/terms/admitted.json (2026-11-01). -/
+def ours : Collection := ⟨.term, true, true, false, false, false, true, true, false⟩
+theorem ours_is_glossary : IsGlossary ours := ⟨⟨rfl, rfl⟩, rfl⟩
+theorem ours_not_agent_glossary : ¬ IsAgentGlossary ours := fun h => by cases h.2
+theorem ours_is_registry_and_thesaurus : IsRegistry ours ∧ IsThesaurus ours := ⟨rfl, rfl, rfl⟩
+
+/- Method level. -/
+structure Method where
+  steps : Bool
+  returnsToStart : Bool
+  trigger : Bool
+  instructions : Bool
+  packaged : Bool
+  agentCarriesOut : Bool
+  runsItself : Bool
+
+def IsProcedure (m : Method) : Prop := m.steps = true
+def IsLoop (m : Method) : Prop := IsProcedure m ∧ m.returnsToStart = true ∧ m.trigger = true
+def IsSkill (m : Method) : Prop :=
+  m.instructions = true ∧ m.packaged = true ∧ m.trigger = true ∧ m.agentCarriesOut = true ∧ m.runsItself = false
+def IsRoutine (m : Method) : Prop := IsProcedure m ∧ m.runsItself = true ∧ m.trigger = true
+
+theorem loop_is_procedure {m : Method} (h : IsLoop m) : IsProcedure m := h.1
+theorem routine_is_procedure {m : Method} (h : IsRoutine m) : IsProcedure m := h.1
+/-- A skill is carried out by an agent; a routine runs by itself. Nothing is both. -/
+theorem skill_not_routine {m : Method} (s : IsSkill m) : ¬ IsRoutine m := by
+  intro r; have h1 := s.2.2.2.2; have h2 := r.2.1; rw [h1] at h2; cases h2
+/-- A skill can hold a loop (the problem-loop skill does): skill and loop overlap. -/
+def problemLoopSkill : Method := ⟨true, true, true, true, true, true, false⟩
+theorem problem_loop_skill_is_both : IsSkill problemLoopSkill ∧ IsLoop problemLoopSkill :=
+  ⟨⟨rfl, rfl, rfl, rfl, rfl⟩, ⟨rfl, rfl, rfl⟩⟩
+
+end Naive.Glossary
+
+/- Records, views and artifacts (artifact-vocab.ts). -/
+namespace Naive.Data
+structure Data where
+  conformsToSchema : Bool
+  sourceOfTruth : Bool
+  derivedFromRecords : Bool
+  regenerable : Bool
+  forPeople : Bool
+def IsRecord (d : Data) : Prop := d.conformsToSchema = true ∧ d.sourceOfTruth = true ∧ d.derivedFromRecords = false
+def IsView (d : Data) : Prop := d.derivedFromRecords = true ∧ d.regenerable = true ∧ d.sourceOfTruth = false
+def IsArtifact (d : Data) : Prop := IsView d ∧ d.forPeople = true
+theorem artifact_is_view {d : Data} (h : IsArtifact d) : IsView d := h.1
+/-- Nothing is both a record and an artifact: a record is the source of truth, an artifact never is. -/
+theorem record_not_artifact {d : Data} (r : IsRecord d) : ¬ IsArtifact d := by
+  intro a; have h1 := r.2.1; have h2 := a.1.2.2; rw [h1] at h2; cases h2
+end Naive.Data
diff --git a/project-files/naive-design/prototypes/architecture/Identity.lean b/project-files/naive-design/prototypes/architecture/Identity.lean
new file mode 100644
index 0000000..3b47727
--- /dev/null
+++ b/project-files/naive-design/prototypes/architecture/Identity.lean
@@ -0,0 +1,49 @@
+/- Idea -> identity pipeline and cross-function exchanges (2026-11-01). Mirrors identity-vocab.ts levels 2 and 3.
+   Core Lean only. Written in the AI-labs thread; built by the phases thread. -/
+namespace Naive.Identity
+
+structure Thing where
+  stated : Bool
+  purpose : Bool
+  goals : Bool
+  distinguishing : Bool
+  persists : Bool
+  homeFunction : Bool
+  needs : Bool
+  requirements : Bool
+  constraints : Bool
+  nextPhase : Bool
+  realized : Bool  -- `instance` is a Lean keyword
+
+def HasIdentity (t : Thing) : Prop :=
+  t.purpose = true ∧ t.distinguishing = true ∧ t.persists = true ∧ t.homeFunction = true
+def Idea (t : Thing) : Prop := t.stated = true ∧ ¬ HasIdentity t
+def Shaped (t : Thing) : Prop := HasIdentity t ∧ t.goals = true ∧ t.needs = true ∧ t.requirements = true ∧ t.constraints = true
+def Ready (t : Thing) : Prop := Shaped t ∧ t.nextPhase = true
+def Instance (t : Thing) : Prop := HasIdentity t ∧ t.realized = true
+
+theorem idea_not_identity {t : Thing} (h : Idea t) (i : HasIdentity t) : False := h.2 i
+theorem ready_is_shaped {t : Thing} (h : Ready t) : Shaped t := h.1
+theorem shaped_has_identity {t : Thing} (h : Shaped t) : HasIdentity t := h.1
+/-- Nothing moves to its next phase without needs, requirements and constraints derived. -/
+theorem ready_has_constraints {t : Thing} (h : Ready t) : t.constraints = true := h.1.2.2.2.2
+theorem instance_not_idea {t : Thing} (h : Instance t) (i : Idea t) : False := i.2 h.1
+
+structure Ex where
+  differentFunctions : Bool
+  triggeredByRecord : Bool
+  research : Bool
+  writesOwn : Bool
+  writesOwner : Bool
+
+def InformedResearch (e : Ex) : Prop :=
+  e.differentFunctions = true ∧ e.triggeredByRecord = true ∧ e.research = true ∧ e.writesOwn = true ∧ e.writesOwner = false
+def CrossWrite (e : Ex) : Prop := e.differentFunctions = true ∧ e.writesOwner = true
+
+theorem informed_never_cross_writes {e : Ex} (h : InformedResearch e) (c : CrossWrite e) : False := by
+  have a := h.2.2.2.2
+  have b := c.2
+  rw [a] at b
+  exact Bool.noConfusion b
+
+end Naive.Identity
diff --git a/project-files/naive-design/prototypes/architecture/Industry.lean b/project-files/naive-design/prototypes/architecture/Industry.lean
new file mode 100644
index 0000000..7a8fe2e
--- /dev/null
+++ b/project-files/naive-design/prototypes/architecture/Industry.lean
@@ -0,0 +1,68 @@
+/- "industry" and its neighbours (2026-11-01). Mirrors industry-vocab.ts: the same facts, so a theorem here and a
+   cross-run there say the same thing. Core Lean only, no Mathlib.
+   NOT YET BUILT: this cloud session has no Lean toolchain (installing one was refused). Build on the Mac with
+   `lean Industry.lean` before raising any term to decided. -/
+namespace Naive.Industry
+
+structure Grouping where
+  groupsProducers : Bool
+  groupsBuyers : Bool
+  byProcess : Bool
+  bySubstitutes : Bool
+  byJob : Bool
+  groupsGroupings : Bool
+  extractsFromNature : Bool
+  servicesOnly : Bool
+
+def IsIndustryNaics (g : Grouping) : Prop := g.groupsProducers = true ∧ g.byProcess = true
+def IsPrimary (g : Grouping) : Prop := IsIndustryNaics g ∧ g.extractsFromNature = true
+def IsService (g : Grouping) : Prop := IsIndustryNaics g ∧ g.servicesOnly = true ∧ g.extractsFromNature = false
+def IsSector (g : Grouping) : Prop := IsIndustryNaics g ∧ g.groupsGroupings = true
+
+theorem primary_is_industry {g : Grouping} (h : IsPrimary g) : IsIndustryNaics g := h.1
+theorem sector_is_industry {g : Grouping} (h : IsSector g) : IsIndustryNaics g := h.1
+
+theorem primary_service_disjoint {g : Grouping} (hp : IsPrimary g) (hs : IsService g) : False := by
+  have h1 := hp.2
+  have h2 := hs.2.2
+  rw [h1] at h2
+  exact Bool.noConfusion h2
+
+/-- Edges in the library: exactly one endpoint kind each. -/
+inductive Ends where
+  | ventureToIndustry
+  | industryToIndustry
+  | ventureToVenture
+
+structure Link where
+  ends : Ends
+  productPassesTest : Bool
+  officialCode : Bool
+  inputFlow : Bool
+
+def BelongsTo (l : Link) : Prop := l.ends = .ventureToIndustry ∧ l.productPassesTest = true
+def ClassifiedAs (l : Link) : Prop := l.ends = .ventureToIndustry ∧ l.officialCode = true
+def DependsOn (l : Link) : Prop := l.ends = .industryToIndustry ∧ l.inputFlow = true
+def Supplies (l : Link) : Prop := l.ends = .ventureToVenture ∧ l.inputFlow = true
+
+/-- No inheritance: an industry dependency is never a venture supply edge. -/
+theorem depends_not_supplies {l : Link} (hd : DependsOn l) (hs : Supplies l) : False := by
+  have h := hd.1.symm.trans hs.1
+  cases h
+
+/-- A code without membership, and membership without a code, both exist (Anthropic's SIC 7372 is the first kind). -/
+def codeOnly : Link := ⟨.ventureToIndustry, false, true, false⟩
+def memberOnly : Link := ⟨.ventureToIndustry, true, false, false⟩
+theorem classified_overlaps_belongs :
+    (ClassifiedAs codeOnly ∧ ¬ BelongsTo codeOnly) ∧ (BelongsTo memberOnly ∧ ¬ ClassifiedAs memberOnly) := by
+  refine ⟨⟨⟨rfl, rfl⟩, fun h => Bool.noConfusion h.2⟩, ⟨⟨rfl, rfl⟩, fun h => Bool.noConfusion h.2⟩⟩
+
+/-- Industries as a directed graph: `feeds a b` means a's output is an input of b. A root is fed by nothing. -/
+def IsRoot (feeds : Nat → Nat → Prop) (n : Nat) : Prop := ∀ m, ¬ feeds m n
+
+/-- Two industries in a loop (0 = mining, 1 = machinery): mining feeds machinery and machinery feeds mining,
+    so the primary industry is not a root. Raw materials are a base, not a root. -/
+def loop : Nat → Nat → Prop := fun a b => (a = 0 ∧ b = 1) ∨ (a = 1 ∧ b = 0)
+theorem primary_in_loop_not_root : ¬ IsRoot loop 0 := fun h => h 1 (Or.inr ⟨rfl, rfl⟩)
+
+end Naive.Industry
diff --git a/project-files/naive-design/prototypes/architecture/Inquiry.lean b/project-files/naive-design/prototypes/architecture/Inquiry.lean
new file mode 100644
index 0000000..e405bf3
--- /dev/null
+++ b/project-files/naive-design/prototypes/architecture/Inquiry.lean
@@ -0,0 +1,40 @@
+/- Inquiry items: issue, research question, open decision, problem, concern, assumption, premise, risk (2026-11-01).
+   Mirrors inquiry-vocab.ts. Core Lean only. -/
+namespace Naive.Inquiry
+
+structure Inq where
+  interrogative : Bool
+  answered : Bool
+  gap : Bool
+  holder : Bool
+  heldTrue : Bool
+  presupposed : Bool
+  future : Bool
+  aboutSystem : Bool
+  options : Bool
+  ownerChooses : Bool
+  byEvidence : Bool
+
+def Issue (q : Inq) : Prop := q.interrogative = true ∧ q.answered = false
+def ResearchQuestion (q : Inq) : Prop := Issue q ∧ q.byEvidence = true
+def OpenDecision (q : Inq) : Prop := Issue q ∧ q.options = true ∧ q.ownerChooses = true
+def Problem (q : Inq) : Prop := q.gap = true ∧ q.holder = true
+def Assumption (q : Inq) : Prop := q.heldTrue = true
+def Premise (q : Inq) : Prop := Assumption q ∧ q.presupposed = true
+def Risk (q : Inq) : Prop := q.future = true
+
+theorem research_question_is_issue {q : Inq} (h : ResearchQuestion q) : Issue q := h.1
+theorem open_decision_is_issue {q : Inq} (h : OpenDecision q) : Issue q := h.1
+theorem premise_is_assumption {q : Inq} (h : Premise q) : Assumption q := h.1
+/-- An answered question is no longer an issue, research question or open decision. -/
+theorem answered_not_issue {q : Inq} (a : q.answered = true) : ¬ Issue q := by
+  intro i; unfold Issue at i; simp_all
+/-- Problem and issue overlap: a gap can be stated as a question, and each exists without the other. -/
+def both : Inq := ⟨true, false, true, true, false, false, false, false, false, false, false⟩
+def gapOnly : Inq := ⟨false, false, true, true, false, false, false, false, false, false, false⟩
+def questionOnly : Inq := ⟨true, false, false, false, false, false, false, false, false, false, false⟩
+theorem problem_issue_overlap :
+    (Problem both ∧ Issue both) ∧ (Problem gapOnly ∧ ¬ Issue gapOnly) ∧ (Issue questionOnly ∧ ¬ Problem questionOnly) := by
+  simp [Problem, Issue, both, gapOnly, questionOnly]
+
+end Naive.Inquiry
diff --git a/project-files/naive-design/prototypes/architecture/KGR.lean b/project-files/naive-design/prototypes/architecture/KGR.lean
new file mode 100644
