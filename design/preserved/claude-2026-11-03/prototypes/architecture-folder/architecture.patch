+// Requirement vocabulary (proposed, 2026-10-31): goal, non-goal, requirement, functional requirement,
+// quality requirement, non-requirement, constraint, fitness function. Level: statement (one entry in a design
+// record). Exhaustive cross-run over every combination of yes/no facts.
+// Sources: ISO/IEC/IEEE 29148 (requirements, constraints), ISO/IEC 25010 (quality characteristics),
+// MoSCoW ("won't have"), design-doc practice (non-goals), Ford, Parsons and Kua (fitness functions).
+//
+//   node requirements-vocab.ts
+
+import { freeze, passSet, relation, validTest, type Base, type Relation, type Term } from "/home/user/ee-build/schema/terms/engine.ts";
+
+export type Statement = Base & {
+  isCheck: boolean;          // executable code that checks something, not a sentence of intent
+  endState: boolean;         // names a state of the world we could reach
+  measured: boolean;         // has a measure with a target
+  committed: boolean;        // we commit to it
+  declined: boolean;         // we explicitly say we will not do or aim for it
+  mustHold: boolean;         // a condition the system or venture must meet
+  verifiable: boolean;       // a check, evidence or a person can say whether it holds
+  derivesFromGoal: boolean;  // traces to a goal
+  aboutBehaviour: boolean;   // what the system does
+  aboutQuality: boolean;     // how well it does it (25010: speed, reliability, security, maintainability...)
+  limitsHow: boolean;        // restricts how it is built, not what it does
+  setOutsideDesign: boolean; // fixed by law, budget, a founder rule or a technology choice the design may not change
+  deterministic: boolean;    // a check that gives the same answer every time
+};
+
+const T = (id: string, label: string, form: Term<Statement>["form"], meaning: string, sources: string[], props: [string, string, (f: Statement) => boolean][], predicts?: Record<string, Relation>): Term<Statement> =>
+  ({ id, label, level: "statement", kind: "role", form, meaning, sources, predicts, props: props.map(([pid, says, check]) => ({ id: pid, says, check })) });
+
+const sentence = (f: Statement) => !f.isCheck;
+export const REQ_VOCAB: Term<Statement>[] = [
+  T("goal", "goal", "word", "An end state we commit to reaching, with a measure that says when we have.", ["goal-oriented requirements engineering", "Naive goal.schema.json"],
+    [["GO1", "a statement, not a check", sentence], ["GO2", "names an end state", (f) => f.endState], ["GO3", "measured", (f) => f.measured], ["GO4", "committed", (f) => f.committed && !f.declined]],
+    { "non-goal": "disjoint", requirement: "overlap" }),
+  T("non-goal", "non-goal", "compound", "An end state we explicitly decline to aim for, written down so nobody builds toward it.", ["design-doc practice: goals and non-goals"],
+    [["NG1", "a statement, not a check", sentence], ["NG2", "names an end state", (f) => f.endState], ["NG3", "explicitly declined", (f) => f.declined && !f.committed]],
+    { goal: "disjoint", "non-requirement": "overlap" }),
+  T("requirement", "requirement", "word", "A condition the system must meet, traced to a goal and verifiable.", ["ISO/IEC/IEEE 29148: requirement", "Naive requirement.schema.json"],
+    [["RQ1", "a statement, not a check", sentence], ["RQ2", "must hold", (f) => f.mustHold], ["RQ3", "verifiable", (f) => f.verifiable], ["RQ4", "committed", (f) => f.committed && !f.declined], ["RQ5", "traces to a goal", (f) => f.derivesFromGoal]],
+    { "functional-requirement": "has_a_kind", "quality-requirement": "has_a_kind", "non-requirement": "disjoint", constraint: "overlap", "fitness-function": "disjoint" }),
+  T("functional-requirement", "functional requirement", "compound", "A requirement about what the system does.", ["ISO/IEC/IEEE 29148"],
+    [["RQ1", "a statement, not a check", sentence], ["RQ2", "must hold", (f) => f.mustHold], ["RQ3", "verifiable", (f) => f.verifiable], ["RQ4", "committed", (f) => f.committed && !f.declined], ["RQ5", "traces to a goal", (f) => f.derivesFromGoal],
+     ["FR1", "about behaviour", (f) => f.aboutBehaviour], ["FR2", "not about how well", (f) => !f.aboutQuality]],
+    { requirement: "is_a", "quality-requirement": "disjoint" }),
+  T("quality-requirement", "quality requirement", "compound", "A requirement about how well the system does something: speed, reliability, security, maintainability. Also called non-functional.", ["ISO/IEC 25010 quality characteristics"],
+    [["RQ1", "a statement, not a check", sentence], ["RQ2", "must hold", (f) => f.mustHold], ["RQ3", "verifiable", (f) => f.verifiable], ["RQ4", "committed", (f) => f.committed && !f.declined], ["RQ5", "traces to a goal", (f) => f.derivesFromGoal],
+     ["QR1", "about how well", (f) => f.aboutQuality]],
+    { requirement: "is_a", "functional-requirement": "disjoint" }),
+  T("non-requirement", "non-requirement", "compound", "A condition we explicitly will not meet this time: MoSCoW's \"won't have\".", ["MoSCoW prioritization"],
+    [["NR1", "a statement, not a check", sentence], ["NR2", "shaped as a condition", (f) => f.mustHold], ["NR3", "explicitly declined", (f) => f.declined && !f.committed]],
+    { requirement: "disjoint", "non-goal": "overlap" }),
+  T("constraint", "constraint", "word", "A limit on how the system is built, set outside the design: law, budget, a founder rule, a fixed technology. The design must respect it and may not change it.", ["ISO/IEC/IEEE 29148: design constraint", "Naive constraints.schema.json"],
+    [["CN1", "a statement, not a check", sentence], ["CN2", "limits how, not what", (f) => f.limitsHow], ["CN3", "set outside the design", (f) => f.setOutsideDesign], ["CN4", "committed", (f) => f.committed && !f.declined], ["CN5", "must hold", (f) => f.mustHold]],
+    { requirement: "overlap", "fitness-function": "disjoint" }),
+  T("fitness-function", "fitness function", "compound", "An automated check that measures how well the architecture meets a quality requirement, every time it runs.", ["Ford, Parsons and Kua, Building Evolutionary Architectures (2017)"],
+    [["FF1", "an executable check", (f) => f.isCheck], ["FF2", "assesses a quality", (f) => f.aboutQuality], ["FF3", "deterministic", (f) => f.deterministic], ["FF4", "traces to a goal", (f) => f.derivesFromGoal]],
+    { requirement: "disjoint", constraint: "disjoint" }),
+];
+
+const KEYS = ["isCheck", "endState", "measured", "committed", "declined", "mustHold", "verifiable", "derivesFromGoal", "aboutBehaviour", "aboutQuality", "limitsHow", "setOutsideDesign", "deterministic"] as const;
+export function statementCases(): Statement[] {
+  const labels = ["goal", "requirement", "constraint", "nonsense", undefined];
+  const out: Statement[] = [];
+  for (let m = 0; m < 2 ** (KEYS.length + 1); m++) {
+    const f = { confirmed: Boolean(m & 1), label: labels[m % 5] } as Statement;
+    KEYS.forEach((k, i) => { (f as Record<string, unknown>)[k] = Boolean(m & (2 << i)); });
+    out.push(f);
+  }
+  return out;
+}
+
+if (import.meta.url === `file://${process.argv[1]}`) {
+  const cases = statementCases();
+  const sets = new Map(REQ_VOCAB.map((t) => [t.id, passSet(t, cases)]));
+  let bad = 0;
+  for (const t of REQ_VOCAB) { const v = validTest(t, cases); if (v.length) bad++; console.log(`${t.label.padEnd(24)} ${freeze(t)} ${v.length ? v.join("; ") : "valid"} (${sets.get(t.id)!.size} pass)`); }
+  let ok = 0, n = 0;
+  for (const a of REQ_VOCAB) for (const [o, want] of Object.entries(a.predicts ?? {})) {
+    n++; const got = relation(sets.get(a.id)!, sets.get(o)!); if (got === want) ok++;
+    console.log(`${a.id} ~ ${o}: predicted ${want}, got ${got} -> ${got === want ? "confirmed" : "REFUTED"}`);
+  }
+  console.log(`${ok}/${n} predictions confirmed`);
+  if (bad) process.exitCode = 1;
+}
