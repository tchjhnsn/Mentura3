+// Torian 2026-11-01 07:53Z: "Is Mentura a neurosymbolic model and Naive a symbolic records framework?"
+// Runs each subject through our own glossary terms (approach, store, mechanism). Facts cite code or records.
+//   node --experimental-strip-types ontology-run.ts
+import { run } from "/home/user/ee-build/schema/terms/engine.ts";
+import { writeFileSync } from "node:fs";
+import { SYSTEM_VOCAB, type Sys } from "./approach-vocab.ts";
+import { STORE_VOCAB, type Store } from "./kgr-vocab.ts";
+import { MECH, type Sys as Mech } from "./mechanism-vocab.ts";
+
+const F = false, T = true;
+const sys: [string, string, Sys][] = [
+  ["Jev", "ventures/typesafe/products/jev.json: typed outputs, calibrated, code consumer (vendor claims)",
+    { confirmed: T, label: "model", symbolicPart: F, neuralPart: T, codeIsConsumer: T, typedOutput: T, calibrated: T, conversational: F, symbolicDecides: F }],
+  ["Mentura model (planned, Jev-like)", "products/mentura.json: kind open; Torian 07:53Z 'Mentura should operate like Jev'",
+    { confirmed: F, label: "model", symbolicPart: F, neuralPart: T, codeIsConsumer: T, typedOutput: T, calibrated: T, conversational: F, symbolicDecides: F }],
+  ["'neuro-symbolic model' (the phrase)", "a model with a symbolic part; tests whether the phrase names a model or a system",
+    { confirmed: F, label: "model", symbolicPart: T, neuralPart: T, codeIsConsumer: T, typedOutput: T, calibrated: T, conversational: F, symbolicDecides: F }],
+  ["Naive alone", "framework: schema/*.json, interface/writes.mjs; no weights in the repo",
+    { confirmed: T, label: "AI", symbolicPart: T, neuralPart: F, codeIsConsumer: F, typedOutput: F, calibrated: F, conversational: F, symbolicDecides: T }],
+  ["Naive + Jev (judge slot)", "platform/integrations/jev.mjs, schema/caching.mjs NAIVE_JUDGE_CMD; write chain step person-settles",
+    { confirmed: T, label: "AI", symbolicPart: T, neuralPart: T, codeIsConsumer: T, typedOutput: T, calibrated: T, conversational: F, symbolicDecides: T }],
+];
+const store: [string, string, Store][] = [
+  ["Naive venture records (as built)", "schema/data-model.json refs on 55/117 types; provenance-entry is per write (entity, sha256), not per value; no per-value as_of",
+    { confirmed: T, label: "knowledge graph", nodesAndEdges: T, namedSlots: T, numericVectors: F, learned: F, similaritySearch: F, authoritative: T, sourced: F, dated: F, typesDefined: T, instanceFacts: T, perItem: F }],
+  ["Mentura library study records", "mentura/research/references/*.json carry quotes, url, retrieved; ventures/* cite them",
+    { confirmed: F, label: "knowledge graph", nodesAndEdges: T, namedSlots: T, numericVectors: F, learned: F, similaritySearch: F, authoritative: T, sourced: T, dated: T, typesDefined: T, instanceFacts: T, perItem: F }],
+];
+const mech: [string, string, Mech][] = [
+  ["Naive write chain", "flows.write 13 steps, A12 13/13 at 2507d1a; stage transitions Stage.lean",
+    { confirmed: T, physical: F, deterministic: T, statedRules: T, traceable: T, learned: F, stateful: T, definedTransitions: T, typedSymbols: T }],
+  ["Naive + Jev routing", "a learned judge chooses the route; code then checks it",
+    { confirmed: T, physical: F, deterministic: F, statedRules: F, traceable: T, learned: T, stateful: T, definedTransitions: T, typedSymbols: T }],
+];
+const out: any[] = [];
+const go = (level: string, rows: any[], vocab: any[]) => { for (const [s, why, f] of rows) {
+  const passes = vocab.filter((t) => run(t, f).pass).map((t) => t.id);
+  const near = vocab.map((t) => [t.id, run(t, f).failed] as const).filter(([, x]) => x.length > 0 && x.length <= 2).map(([id, x]) => `${id} (fails ${x.join(",")})`);
+  out.push({ level, subject: s, evidence: why, passes, near });
+  console.log(`[${level}] ${s}\n   is: ${passes.join(", ") || "none"}\n   near misses: ${near.join("; ") || "none"}`); } };
+go("system", sys, SYSTEM_VOCAB); go("store", store, STORE_VOCAB); go("mechanism", mech, MECH);
+writeFileSync(new URL("./ontology-run.json", import.meta.url), JSON.stringify({ ran: new Date().toISOString(), out }, null, 1));
