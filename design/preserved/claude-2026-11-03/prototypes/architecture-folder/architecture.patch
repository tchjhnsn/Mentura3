+// Caches the precog research fetches (2026-11-01 05:25Z request) through the same update theorem as gate.ts.
+import fs from "node:fs"; import crypto from "node:crypto";
+const CACHE = "/mnt/project-files/mentura-discovery/mentura/research/references/search-cache";
+const key = (s: string) => crypto.createHash("sha256").update(s.trim().toLowerCase()).digest("hex").slice(0, 16);
+type C = { about: string; text: string; locator?: string };
+const X: { url: string; title: string; read: boolean; tier: string; claims: C[] }[] = [
+  { url: "https://arxiv.org/abs/2410.12361", title: "Lu et al. 2024, Proactive Agent", read: true, tier: "primary",
+    claims: [{ about: "proactive", text: "reward model trained on accepted/rejected proactive predictions; ProactiveBench 6,790 events; F1 66.47%", locator: "abstract" }] },
+  { url: "https://arxiv.org/abs/1705.08500", title: "Geifman and El-Yaniv 2017, Selective Classification for DNNs", read: true, tier: "primary",
+    claims: [{ about: "abstention", text: "reject option gives guaranteed risk at a chosen confidence; e.g. 2% top-5 error with 99.9% probability at ~60% coverage", locator: "abstract" }] },
+  { url: "https://arxiv.org/abs/2107.07511", title: "Angelopoulos and Bates 2021, Gentle intro to conformal prediction", read: true, tier: "primary",
+    claims: [{ about: "certified", text: "distribution-free prediction sets with user-specified coverage, finite-sample", locator: "abstract" }] },
+  { url: "https://arxiv.org/abs/2103.09568", title: "Hayes et al. 2022, Practical guide to multi-objective RL", read: true, tier: "primary",
+    claims: [{ about: "multi-objective", text: "argues linear scalarization of objectives oversimplifies; utility over objectives, Pareto sets", locator: "abstract" }] },
+  { url: "https://en.wikipedia.org/wiki/Value_of_information", title: "Wikipedia, Value of information", read: true, tier: "index",
+    claims: [{ about: "value-of-information", text: "expected gain from information before deciding; Howard 1966", locator: "lead" }] },
+];
+for (const x of X) {
+  const hold = x.claims.filter((c) => x.tier === "index" || !x.read || !c.locator).map((c) => ({ ...c, why: x.tier === "index" ? "index source" : !x.read ? "source not read" : "no locator" }));
+  const admit = x.claims.filter((c) => !hold.some((h) => h.text === c.text));
+  fs.writeFileSync(`${CACHE}/${key(x.url)}.json`, JSON.stringify({ key: key(x.url), q: x.url, cached_at: "2026-11-01T05:30:00Z", kind: "fetch", ...x, verdict: { cache: true, admit, hold } }, null, 1));
+  console.log(`${x.title.padEnd(60)} admit ${admit.length} hold ${hold.length}`);
+}
+console.log(`cache: ${fs.readdirSync(CACHE).length} entries`);
