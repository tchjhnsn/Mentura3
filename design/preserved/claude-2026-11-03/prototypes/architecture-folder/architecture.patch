+// Terms from Anthropic's S-1 (filed 2026-10-26) that collide with ours, run through the term engine (proposed,
+// 2026-11-01). The S-1's own words are run as their own senses (@s1), never copied over ours: the engine says
+// whether the two senses are equal, nested, overlapping or disjoint. Level: stack (what a piece of AI software is).
+// Source: reference anthropic-s-1-2026 (Select Defined Terms; Business; the figure "Value delivered to customers /
+// Platform / Models"). Exhaustive over 2^8 facts.
+//
+//   node s1-vocab.ts
+
+import { freeze, passSet, relation, run, validTest, type Base, type Relation, type Term } from "/home/user/ee-build/schema/terms/engine.ts";
+import { METHOD_VOCAB, methodCases, type Method } from "./glossary-vocab.ts";
+
+export type Stack = Base & {
+  isModel: boolean;            // trained weights that turn an input into an output (inference)
+  wrapsModel: boolean;         // software around a model: it calls the model and handles context and tools
+  runsAgentLoop: boolean;      // the model directs its own steps and tool calls, repeating until the task is done
+  personWorksThrough: boolean; // a person works through it directly, in a session
+  reachesMostLayers: boolean;  // reaches at least four of the six venture layers (EE-093's test for a harness)
+  offersPrimitives: boolean;   // exposes building blocks (API, SDK, protocol) for developers to compose
+  othersBuildOn: boolean;      // third parties build their own products on it
+  endUserProduct: boolean;     // a finished product delivered to the people who use it
+};
+const S = (id: string, label: string, meaning: string, sources: string[], props: [string, string, (f: Stack) => boolean][], predicts?: Record<string, Relation>): Term<Stack> =>
+  ({ id, label, level: "stack", kind: "role", form: "word", meaning, sources, predicts, props: props.map(([pid, says, check]) => ({ id: pid, says, check })) });
+
+export const STACK_VOCAB: Term<Stack>[] = [
+  S("model@ai", "model", "Trained weights that turn an input into an output. Not the software around it. In the S-1's figure, the Models row (Mythos, Opus, Sonnet, Haiku).",
+    ["anthropic-s-1-2026: model weights, LLMs, inference (Select Defined Terms)", "NIST AI 100-1 (2023)"],
+    [["MD1", "trained weights that turn input into output", (f) => f.isModel], ["MD2", "not the software around a model", (f) => !f.wrapsModel]],
+    { "harness@s1": "disjoint", "platform@s1": "disjoint", application: "disjoint" }),
+  S("harness", "harness", "Ours (EE-093): a tool through which a person, with agents, works across at least four of the six layers in one session.",
+    ["EE-093", "docs/ontology.json"],
+    [["HN1", "a person works through it", (f) => f.personWorksThrough], ["HN2", "reaches at least four of the six layers", (f) => f.reachesMostLayers]],
+    { "harness@s1": "overlap", application: "overlap" }),
+  // Narrowed to HS1 alone on 2026-11-01 when harness took this sense in the ontology (EE-096): with HS2 (runs the agent
+  // loop) a chatbot, which the ontology already calls an AI harness, would not be a harness. Industry usage is the
+  // software around a model; an agent harness is the kind that runs the agent loop.
+  S("harness@s1", "harness", "The S-1's and the industry's: the software around a model that runs it, giving it context and tools and carrying out what it asks. Its examples are the Agent SDK and Claude Managed Agents (no person needed) and Claude Code.",
+    ["anthropic-s-1-2026: Business (\"a harness that translates intent into\"), figure row Harnesses", "industry usage (harness, agent harness)"],
+    [["HS1", "software around a model", (f) => f.wrapsModel]],
+    { harness: "overlap", "agent-harness": "has_a_kind", "platform@s1": "overlap", "model@ai": "disjoint" }),
+  S("agent-harness", "agent harness", "Ours (ontology): an AI harness in which the model directs its own steps and tool use in a loop, between a person's turns. The ontology calls it the default kind of harness.",
+    ["docs/ontology.json (agent harness)"],
+    [["HS1", "software around a model", (f) => f.wrapsModel], ["HS2", "runs the agent loop", (f) => f.runsAgentLoop], ["AH1", "a person works through it", (f) => f.personWorksThrough]],
+    { "harness@s1": "is_a", harness: "is_a" }),
+  // Decided 2026-11-01 02:13Z (card): harness takes the S-1 / industry sense; ours is renamed workbench.
+  S("workbench", "workbench", "Ours (renamed from harness, 2026-11-01): a tool through which a person, with agents, works across at least four of the six layers in one session. Narrows the industry workbench.",
+    ["Eclipse Platform Workbench (2001)", "Fowler, Language Workbenches (2005)", "EE-093 (superseded)"],
+    [["HN1", "a person works through it", (f) => f.personWorksThrough], ["HN2", "reaches at least four of the six layers", (f) => f.reachesMostLayers]],
+    { "workbench@industry": "is_a", "harness@s1": "overlap", harness: "equal" }),
+  S("workbench@industry", "workbench", "Industry: one environment in which a person does many kinds of work on a project (Eclipse Workbench, language workbenches).",
+    ["Eclipse Platform Workbench (2001)", "Fowler, Language Workbenches (2005)"],
+    [["HN1", "a person works through it", (f) => f.personWorksThrough]],
+    { workbench: "has_a_kind" }),
+  S("platform@s1", "platform", "The S-1's: the layer between models and applications that offers primitives (features, context management, infrastructure, harnesses) which customers build on.",
+    ["anthropic-s-1-2026: \"Our platform unifies frontier intelligence with the harnesses, connectors, governance, and orchestration\"; primitives (Select Defined Terms)"],
+    [["PL1", "offers building blocks", (f) => f.offersPrimitives], ["PL2", "others build their own products on it", (f) => f.othersBuildOn], ["PL3", "is not the model itself", (f) => !f.isModel]],
+    { platform: "is_a", "harness@s1": "overlap", "model@ai": "disjoint" }),
+  S("platform", "platform", "Industry sense, and the gate of our Platform phase (\"Others build on it\"): something third parties build their own products on.",
+    ["Gawer & Cusumano, Platform Leadership (2002)", "Parker, Van Alstyne & Choudary, Platform Revolution (2016)", "purpose/frameworks/product-anatomy/phases.json (platform gate)"],
+    [["PL2", "others build their own products on it", (f) => f.othersBuildOn]],
+    { "platform@s1": "has_a_kind" }),
+  S("application", "application", "The S-1's: a finished product people use directly (Chat, Code, Cowork, Tag), built on the models and platform.",
+    ["anthropic-s-1-2026: \"delivered to customers through our models, platform, and applications\""],
+    [["AP1", "a finished product for the people who use it", (f) => f.endUserProduct], ["AP2", "a person works through it", (f) => f.personWorksThrough],
+     // AP3 added after the first run refuted application ~ model@ai (disjoint): nothing said an application is not the model.
+     ["AP3", "is software, not the model itself", (f) => !f.isModel]],
+    { harness: "overlap", "harness@s1": "overlap", "model@ai": "disjoint" }),
+];
+const KEYS = ["isModel", "wrapsModel", "runsAgentLoop", "personWorksThrough", "reachesMostLayers", "offersPrimitives", "othersBuildOn", "endUserProduct"] as const;
+export function stackCases(): Stack[] {
+  const out: Stack[] = [];
+  for (let m = 0; m < 2 ** (KEYS.length + 1); m++) {
+    const f = { confirmed: Boolean(m & 1), label: ["harness", "platform", undefined][m % 3] } as Stack;
+    KEYS.forEach((k, i) => { (f as Record<string, unknown>)[k] = Boolean(m & (2 << i)); });
+    out.push(f);
+  }
+  return out;
+}
+
+// The S-1's agent loop, at the method level beside our loop.
+const agentLoop: Term<Method> = {
+  id: "agent-loop", label: "agent loop", level: "method", kind: "act", form: "word",
+  meaning: "The S-1's: the cycle in which an agent receives a task, acts, observes the result and decides its next step, repeating until the task is complete.",
+  sources: ["anthropic-s-1-2026: agent loop (Select Defined Terms)"], predicts: { loop: "is_a", skill: "overlap", routine: "disjoint" },
+  props: [{ id: "PR1", says: "a sequence of steps in order", check: (f) => f.steps }, { id: "LP1", says: "begins again after its last step", check: (f) => f.returnsToStart },
+    { id: "LP2", says: "says when it starts or stops", check: (f) => f.trigger }, { id: "AL1", says: "an agent carries it out", check: (f) => f.agentCarriesOut && !f.runsItself }],
+};
+
+function runLevel<F extends Base>(name: string, vocab: Term<F>[], cases: F[], only?: string[]): [number, number] {
+  const sets = new Map(vocab.map((t) => [t.id, passSet(t, cases)])); let ok = 0, n = 0;
+  console.log(`\n== ${name}: ${cases.length} cases`);
+  for (const t of vocab.filter((t) => !only || only.includes(t.id))) { const v = validTest(t, cases); console.log(`${t.id.padEnd(16)} ${freeze(t)} ${v.length ? v.join("; ") : "valid"}`); }
+  for (const a of vocab.filter((t) => !only || only.includes(t.id))) for (const [o, w] of Object.entries(a.predicts ?? {})) {
+    n++; const g = relation(sets.get(a.id)!, sets.get(o)!); if (g === w) ok++;
+    console.log(`${a.id} ~ ${o}: predicted ${w}, got ${g} -> ${g === w ? "confirmed" : "REFUTED"}`);
+  }
+  return [ok, n];
+}
+
+if (import.meta.url === `file://${process.argv[1]}`) {
+  const [a, b] = runLevel("stack", STACK_VOCAB, stackCases());
+  const [c, d] = runLevel("method", [...METHOD_VOCAB, agentLoop], methodCases(), ["agent-loop"]);
+  console.log(`\n${a + c}/${b + d} predictions confirmed`);
+  // Where the S-1's examples land.
+  const ex: [string, Partial<Stack>][] = [
+    ["Claude Opus (a model)", { isModel: true }],
+    ["Agent SDK", { wrapsModel: true, runsAgentLoop: true, offersPrimitives: true, othersBuildOn: true }],
+    ["Claude Code", { wrapsModel: true, runsAgentLoop: true, personWorksThrough: true, reachesMostLayers: true, endUserProduct: true }],
+    ["a coding agent used only on code", { wrapsModel: true, runsAgentLoop: true, personWorksThrough: true, endUserProduct: true }],
+    ["Claude Chat", { wrapsModel: true, personWorksThrough: true, endUserProduct: true }],
+    ["Model Context Protocol", { offersPrimitives: true, othersBuildOn: true }],
+  ];
+  console.log("\n== the S-1's examples");
+  for (const [name, facts] of ex) {
+    const f = { confirmed: true, ...Object.fromEntries(KEYS.map((k) => [k, false])), ...facts } as Stack;
+    console.log(`${name.padEnd(34)} ${STACK_VOCAB.filter((t) => run(t, f).pass).map((t) => t.id).join(", ") || "none"}`);
+  }
+}
