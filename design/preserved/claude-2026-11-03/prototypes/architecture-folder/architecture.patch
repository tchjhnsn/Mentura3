+
+// ---------- comparison level: one player relative to a focal venture (value net) ----------
+export type Player = Base & {
+  customersValueLess: boolean; // customers value the focal product less when they have this player's
+  customersValueMore: boolean; // customers value the focal product more when they have this player's
+  suppliersLess: boolean;      // suppliers find the focal venture less attractive when they also supply this player
+  sameJob: boolean;            // serves the same customer job
+  otherCategory: boolean;      // from a different product category
+  buysFromFocal: boolean;      // pays the focal venture
+  suppliesFocal: boolean;      // the focal venture pays it for an input
+  agreement: boolean;          // a standing agreement to create value together
+};
+const C = mk<Player>("comparison");
+export const COMPARISON_VOCAB: Term<Player>[] = [
+  C("competitor@vn", "competitor", "Value net: customers value your product less when they have theirs, or suppliers find you less attractive when they also supply them.",
+    ["Brandenburger and Nalebuff, Co-opetition (1996)"],
+    [["CP1", "lowers the focal product's value to customers or suppliers", (f) => f.customersValueLess || f.suppliersLess]],
+    { "complementor": "overlap", "competitor@market": "overlap", substitute: "overlap", customer: "overlap" }),
+  C("competitor@market", "competitor", "Common usage: a firm serving the same customer job in the same category.", ["Porter, Competitive Strategy (1980)"],
+    [["CM1", "same customer job", (f) => f.sameJob], ["CM2", "same category", (f) => !f.otherCategory]], { substitute: "disjoint" }),
+  C("complementor", "complementor", "Value net: customers value your product more when they have theirs.", ["Brandenburger and Nalebuff (1996)"],
+    [["CO1", "raises the focal product's value to customers", (f) => f.customersValueMore]]),
+  C("co-opetition", "co-opetition", "One player who is both a competitor and a complementor.", ["Brandenburger and Nalebuff (1996)"],
+    [["CP1", "lowers the focal product's value to customers or suppliers", (f) => f.customersValueLess || f.suppliersLess], ["CO1", "raises the focal product's value to customers", (f) => f.customersValueMore]],
+    { "competitor@vn": "is_a", complementor: "is_a" }),
+  C("substitute", "substitute", "Porter: a product from another category that meets the same need.", ["Porter (1980), five forces"],
+    [["CM1", "same customer job", (f) => f.sameJob], ["SB1", "another category", (f) => f.otherCategory]]),
+  C("customer", "customer", "A player who pays the focal venture.", ["Brandenburger and Nalebuff (1996)"],
+    [["CU1", "pays the focal venture", (f) => f.buysFromFocal]], { supplier: "overlap" }),
+  C("supplier", "supplier", "A player the focal venture pays for an input.", ["Brandenburger and Nalebuff (1996)"],
+    [["SP1", "supplies the focal venture", (f) => f.suppliesFocal]]),
+  // Superseded 04:51Z (Torian, card): the wider "any player with an agreement" gave way to PR #147's definition.
+  // Channel is not a fact at this level yet, so PT2 covers complementor and supplier only.
+  C("partner", "partner", "Decided 2026-11-01 04:51Z: a complementor, supplier or channel with whom an agreement exists. A fact about a contract.",
+    ["PR #147 handoff (definitions)", "Torian, decision card 04:51Z"],
+    [["PT1", "a standing agreement", (f) => f.agreement], ["PT2", "a complementor or supplier (channel: not yet a fact here)", (f) => f.customersValueMore || f.suppliesFocal]],
+    { "competitor@vn": "overlap", supplier: "overlap", complementor: "overlap" }),
+];
+
+function cases<F extends Base>(keys: readonly string[]): F[] {
+  const out: F[] = [];
+  for (let m = 0; m < 2 ** (keys.length + 1); m++) {
+    const f = { confirmed: Boolean(m & 1), label: ["x", "y", undefined][m % 3] } as F;
+    keys.forEach((k, i) => { (f as Record<string, unknown>)[k] = Boolean(m & (2 << i)); });
+    out.push(f);
+  }
+  return out;
+}
+const keysOf = <F>(o: Record<string, unknown>) => Object.keys(o);
+
+function runLevel<F extends Base>(name: string, vocab: Term<F>[], cs: F[]): [number, number] {
+  const sets = new Map(vocab.map((t) => [t.id, passSet(t, cs)])); let ok = 0, n = 0;
+  console.log(`\n== ${name}: ${cs.length} cases`);
+  for (const t of vocab) { const v = validTest(t, cs); console.log(`${t.id.padEnd(20)} ${freeze(t)} ${v.length ? v.join("; ") : "valid"}`); }
+  for (const a of vocab) for (const [o, w] of Object.entries(a.predicts ?? {})) {
+    n++; const g = relation(sets.get(a.id)!, sets.get(o)!); if (g === w) ok++;
+    console.log(`${a.id} ~ ${o}: predicted ${w}, got ${g} -> ${g === w ? "confirmed" : "REFUTED"}`);
+  }
+  return [ok, n];
+}
+
+if (import.meta.url === `file://${process.argv[1]}`) {
+  const lv: [string, Term<any>[], string[]][] = [
+    ["warrant", WARRANT_VOCAB, ["fromAxioms", "certain", "standardChosen", "aboutWorld", "refutableTest", "againstSpec", "againstNeed", "machineChecked"]],
+    ["grouping", GROUPING_VOCAB, ["concept", "onDisk", "holdsRecords", "oneScope", "toolsTogether", "ownsConversations"]],
+    ["function", FUNCTION_VOCAB, ["mapsInputs", "activity", "alwaysPresent", "grouping", "codeModule"]],
+    ["comparison", COMPARISON_VOCAB, ["customersValueLess", "customersValueMore", "suppliersLess", "sameJob", "otherCategory", "buysFromFocal", "suppliesFocal", "agreement"]],
+  ];
+  let ok = 0, n = 0;
+  for (const [name, v, keys] of lv) { const [a, b] = runLevel(name, v, cases(keys)); ok += a; n += b; }
+  console.log(`\n${ok}/${n} predictions confirmed`);
+  const cursor = { confirmed: true, customersValueLess: true, customersValueMore: true, suppliersLess: false, sameJob: true, otherCategory: false, buysFromFocal: true, suppliesFocal: false, agreement: false };
+  console.log(`\nCursor relative to Anthropic (illustrative facts, not evidence): ${COMPARISON_VOCAB.filter((t) => run(t, cursor as Player).pass).map((t) => t.id).join(", ")}`);
+}
