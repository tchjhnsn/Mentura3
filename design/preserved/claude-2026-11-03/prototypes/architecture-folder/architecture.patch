index 0000000..29f925e
--- /dev/null
+++ b/project-files/naive-design/prototypes/architecture/morphology.ts
@@ -0,0 +1,71 @@
+// Linguistic structure in the glossary (proposed, 2026-10-31). Torian's chart: roots and affixes -> lexical
+// stems -> nouns (arguments) and verbs (predicates) -> syntax -> semantics and pragmatics -> a root hash.
+// This file tests whether a term's word structure predicts the relations the engine finds:
+//
+//   L1 negation prefix (non-X)        -> disjoint from X
+//   L2 association prefix (co-X)      -> is_a X
+//   L3 endocentric compound (A B)     -> is_a B, when B is an admitted term at the same level; an idiom is exempt
+//   L4 meaning hashes compose (Merkle) -> a term's hash covers the hashes of the terms it is built from,
+//                                         so redefining "goal" marks "non-goal" stale
+//
+//   node morphology.ts
+
+import { createHash } from "node:crypto";
+import { readFileSync } from "node:fs";
+import { freeze, passSet, relation, type Base, type Relation, type Term } from "/home/user/ee-build/schema/terms/engine.ts";
+import { VOCAB, elementCases } from "./vocabulary.ts";
+import { REQ_VOCAB, statementCases } from "./requirements-vocab.ts";
+
+type Morph = { pos: "noun" | "verb"; root: string; prefix?: "non" | "co"; head?: string; idiom?: true };
+/** Word structure of each term. root: the free morpheme the meaning grows from; head: the right-hand
+ *  word of a compound, which English compounds are usually a kind of. */
+export const MORPH: Record<string, Morph> = {
+  founder: { pos: "noun", root: "found" }, "co-founder": { pos: "noun", root: "found", prefix: "co" },
+  "early-employee": { pos: "noun", root: "employ", head: "employee" }, mentor: { pos: "noun", root: "mentor" },
+  coach: { pos: "noun", root: "coach" }, friend: { pos: "noun", root: "friend" },
+  "unearned-candour": { pos: "noun", root: "candour", head: "candour" }, "threshold-guardian": { pos: "noun", root: "guard", head: "guardian" },
+  "phase-gate": { pos: "noun", root: "gate", head: "gate" },
+  person: { pos: "noun", root: "person" }, "software-system": { pos: "noun", root: "system", head: "system" },
+  container: { pos: "noun", root: "contain" }, "data-store": { pos: "noun", root: "store", head: "store" },
+  component: { pos: "noun", root: "compon" }, module: { pos: "noun", root: "mod" }, interface: { pos: "noun", root: "face" },
+  schema: { pos: "noun", root: "schema" }, record: { pos: "noun", root: "record" }, framework: { pos: "noun", root: "frame" },
+  library: { pos: "noun", root: "libr" }, platform: { pos: "noun", root: "form" }, root: { pos: "noun", root: "root" },
+  goal: { pos: "noun", root: "goal" }, "non-goal": { pos: "noun", root: "goal", prefix: "non" },
+  requirement: { pos: "noun", root: "require" }, "functional-requirement": { pos: "noun", root: "require", head: "requirement" },
+  "quality-requirement": { pos: "noun", root: "require", head: "requirement" }, "non-requirement": { pos: "noun", root: "require", prefix: "non" },
+  constraint: { pos: "noun", root: "strain" }, "fitness-function": { pos: "noun", root: "function", head: "function" },
+};
+
+// relations: admitted repo terms from admitted.json, the sandbox vocabularies by running them
+const rel: Record<string, Record<string, Relation>> = {};
+const levelOf: Record<string, string> = {};
+for (const t of JSON.parse(readFileSync("/home/user/ee-build/schema/terms/admitted.json", "utf8")).terms) { rel[t.id] = t.relations; levelOf[t.id] = t.level; }
+function crossRun<F extends Base>(terms: Term<F>[], cases: F[]) {
+  const sets = new Map(terms.map((t) => [t.id, passSet(t, cases)]));
+  for (const a of terms) { levelOf[a.id] = a.level; rel[a.id] = {}; for (const b of terms) if (a.id !== b.id) rel[a.id][b.id] = relation(sets.get(a.id)!, sets.get(b.id)!); }
+}
+crossRun(VOCAB as Term<Base>[], elementCases()); crossRun(REQ_VOCAB as Term<Base>[], statementCases());
+
+const out: string[] = []; let pass = 0, fail = 0, gaps = 0;
+const base = (id: string) => id.replace(/^(non|co)-/, "");
+for (const [id, m] of Object.entries(MORPH)) {
+  if (m.prefix === "non") { const g = rel[id]?.[base(id)]; g === "disjoint" ? pass++ : fail++; out.push(`L1 ${id} ~ ${base(id)}: ${g} ${g === "disjoint" ? "ok" : "FAILS"}`); }
+  if (m.prefix === "co") { const g = rel[id]?.[base(id)]; g === "is_a" ? pass++ : fail++; out.push(`L2 ${id} ~ ${base(id)}: ${g} ${g === "is_a" ? "ok" : "FAILS"}`); }
+  if (m.head && !m.idiom) {
+    if (!(m.head in rel)) { gaps++; out.push(`L3 ${id}: head "${m.head}" is not an admitted term (gap)`); continue; }
+    const g = rel[id]?.[m.head]; g === "is_a" || g === "equal" ? pass++ : fail++; out.push(`L3 ${id} ~ ${m.head}: ${g} ${g === "is_a" ? "ok" : "FAILS"}`);
+  }
+}
+console.log(out.join("\n"));
+console.log(`\n${pass} pass, ${fail} fail, ${gaps} gaps (heads not yet in the glossary)`);
+
+// L4: Merkle hashes over word structure
+const own: Record<string, string> = {};
+for (const t of [...VOCAB, ...REQ_VOCAB] as Term<Base>[]) own[t.id] = freeze(t);
+const parts = (id: string) => { const m = MORPH[id]; return [m?.prefix ? base(id) : undefined, m?.head].filter((x): x is string => !!x && x in own && x !== id); };
+function root(id: string, o = own): string { return createHash("sha256").update(o[id] + parts(id).map((p) => root(p, o)).join("")).digest("hex").slice(0, 16); }
+const before = root("non-goal");
+const changed = { ...own, goal: "0000000000000000" };
+console.log(`\nL4 root hash of non-goal: ${before}; after redefining goal: ${root("non-goal", changed)} -> ${before !== root("non-goal", changed) ? "stale, as it should be" : "NOT stale"}`);
+console.log(`   functional-requirement after redefining requirement: ${root("functional-requirement") !== root("functional-requirement", { ...own, requirement: "0" }) ? "stale" : "NOT stale"}`);
+if (fail) process.exitCode = 1;
