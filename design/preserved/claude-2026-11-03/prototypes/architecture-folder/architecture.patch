@@ -0,0 +1,76 @@
+// Checks that run against the master architecture record (naive.architecture.json). Requirements AR1-AR8 and the
+// runnable behaviour checks B1, B5, B6, B7, plus A9 (confidential elements stay out of outside handoffs).
+//   node arch-check.ts        exit 1 if any check fails
+import fs from "node:fs"; import crypto from "node:crypto"; import { execSync } from "node:child_process";
+const P = "/mnt/project-files/naive-design/architecture/naive.architecture.json";
+const raw = fs.readFileSync(P, "utf8"); const r = JSON.parse(raw); const sha = crypto.createHash("sha256").update(raw).digest("hex");
+const TERMS = new Set(["person", "software system", "container", "data store", "component", "module", "interface", "schema", "record", "framework", "library", "platform", "root"]); // vocabulary.ts
+const LEVELS = new Set(["context", "container", "component", "code"]); const STATUS = new Set(["designed", "built", "retired"]);
+const ids = new Set<string>(r.elements.map((e: any) => e.id));
+const out: { id: string; ok: boolean; detail: string }[] = [];
+const chk = (id: string, bad: string[], what: string) => out.push({ id, ok: bad.length === 0, detail: bad.length ? `${bad.length} ${what}: ${bad.slice(0, 6).join(", ")}` : "pass" });
+
+chk("A1", r.elements.filter((e: any) => !TERMS.has(e.term) || !LEVELS.has(e.level)).map((e: any) => e.id), "elements without a vocabulary term or level");
+chk("A2", [...r.elements.filter((e: any) => e.part_of && !ids.has(e.part_of)).map((e: any) => `${e.id}.part_of`),
+           ...r.relations.filter((x: any) => !ids.has(x.from) || !ids.has(x.to)).map((x: any) => `${x.from}->${x.to}`)], "dangling references");
+chk("A3", [...r.elements.filter((e: any) => !STATUS.has(e.status)).map((e: any) => e.id),
+           ...r.relations.filter((x: any) => x.declared && !STATUS.has(x.status)).map((x: any) => `${x.from}->${x.to}`)], "without a status");
+const needs = new Set((r.needs ?? []).map((n: any) => n.id));
+chk("A4", (r.requirements ?? []).filter((q: any) => !needs.has(q.traces_to) || !q.check).map((q: any) => q.id), "requirements not traced to a need or without a check");
+chk("A5", (r.behaviours ?? []).filter((b: any) => !ids.has(b.element) || !b.breach || !b.detect).map((b: any) => b.id), "behaviours missing element, breach or detection");
+chk("A6", (r.amendment_log ?? []).filter((a: any) => !["append", "amend"].includes(a.kind) || (a.kind === "amend" && !a.decision)).map((a: any) => a.at), "log entries that are not append/amend, or amendments without a decision");
+if (!(r.amendment_log ?? []).length) out.push({ id: "A6", ok: false, detail: "no change log" });
+// A7: each local view file must embed the current record hash
+const views: [string, string][] = [["architecture-map", new URL("./architecture-map.html", import.meta.url).pathname]];
+chk("A7", views.filter(([, f]) => !fs.existsSync(f) || !fs.readFileSync(f, "utf8").includes(sha.slice(0, 12))).map(([v]) => `${v} (record ${sha.slice(0, 12)})`), "views built from an older record");
+// A8: declared content survives re-derivation (static: the deriver keeps declared sections)
+const deriver = fs.readFileSync(new URL("./build-record-v2.py", import.meta.url), "utf8");
+chk("A8", ["needs", "behaviours", "amendment_log", "declared"].filter((k) => !deriver.includes(k)), "declared keys the deriver would drop");
+// A9: confidential elements never appear in outside handoffs (Grok)
