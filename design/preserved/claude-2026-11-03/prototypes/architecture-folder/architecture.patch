+// Precog's parts, the idea -> identity pipeline, and how functions talk (Torian, 2026-11-01 05:45Z).
+// Three levels, each enumerated exhaustively.   node identity-vocab.ts
+import { freeze, passSet, relation, run, validTest, type Base, type Relation, type Term } from "/home/user/ee-build/schema/terms/engine.ts";
+
+type P<F> = [string, string, (f: F) => boolean][];
+const mk = <F extends Base>(level: string, kind: string) => (id: string, label: string, meaning: string, sources: string[], props: P<F>, predicts?: Record<string, Relation>): Term<F> =>
+  ({ id, label, level, kind, form: "phrase", meaning, sources, predicts, props: props.map(([pid, says, check]) => ({ id: pid, says, check })) } as Term<F>);
+
+// ---------- level 1: a capability of a decision-support system (precog's parts) ----------
+export type Cap = Base & {
+  predicts: boolean;        // outputs a statement about a future state
+  actsOnPrediction: boolean;// changes what it does now because of that prediction
+  unprompted: boolean;      // acts without an explicit request
+  canAbstain: boolean;      // may decline to output
+  confidence: boolean;      // outputs a confidence with each answer
+  matchesFrequency: boolean;// stated confidence matches observed frequency
+  outputsSet: boolean;      // outputs a set of candidates, not one
+  coverageGuarantee: boolean;// the set contains the truth at a stated rate, distribution-free
+  pricesInformation: boolean;// estimates the gain from getting information before deciding
+  manyObjectives: boolean;  // scores options on several objectives at once
+  nonDominated: boolean;    // returns only options no other option beats on every objective
+  demandSignals: boolean;   // the prediction is about demand, from recent signals
+  scansWeakSignals: boolean;// searches broadly for early signs of change
+};
+const C = mk<Cap>("capability", "capability");
+export const PARTS: Term<Cap>[] = [
+  C("forecast", "forecast", "Outputs a statement about a future state.", ["general usage"],
+    [["FC1", "predicts a future state", (f) => f.predicts]],
+    { "anticipatory-system": "has_a_kind", "demand-sensing": "has_a_kind", "horizon-scanning": "overlap" }),
+  C("anticipatory-system", "anticipatory system", "Uses a prediction of the future to change what it does now.", ["Rosen 1985, Anticipatory Systems (not opened)"],
+    [["FC1", "predicts a future state", (f) => f.predicts], ["AS1", "acts now on the prediction", (f) => f.actsOnPrediction]],
+    { forecast: "is_a", "proactive-agent": "has_a_kind" }),
+  C("proactive-agent", "proactive agent", "An anticipatory system that acts without being asked.", ["Lu et al. 2024, arXiv 2410.12361"],
+    [["FC1", "predicts a future state", (f) => f.predicts], ["AS1", "acts now on the prediction", (f) => f.actsOnPrediction], ["PA1", "unprompted", (f) => f.unprompted]],
+    { "anticipatory-system": "is_a", "selective-prediction": "overlap" }),
+  C("selective-prediction", "selective prediction", "May abstain, deciding from a confidence whether to answer (the reject option).", ["Geifman and El-Yaniv 2017, arXiv 1705.08500"],
+    [["SP1", "can abstain", (f) => f.canAbstain], ["SP2", "states a confidence", (f) => f.confidence]],
+    { calibration: "overlap", "conformal-prediction": "overlap" }),
+  C("calibration", "calibration", "Stated confidence matches observed frequency.", ["Brier 1950; Gneiting and Raftery 2007 (not opened)"],
+    [["CA1", "states a confidence", (f) => f.confidence], ["CA2", "matches frequency", (f) => f.matchesFrequency]],
+    { "selective-prediction": "overlap", "conformal-prediction": "overlap" }),
+  C("conformal-prediction", "conformal prediction", "Outputs a set that contains the truth at a stated rate, without assumptions on the data's distribution.", ["Angelopoulos and Bates 2021, arXiv 2107.07511"],
+    [["CP1", "outputs a set", (f) => f.outputsSet], ["CP2", "coverage guaranteed", (f) => f.coverageGuarantee]],
+    { calibration: "overlap", "pareto-set": "overlap" }),
+  C("value-of-information", "value of information", "Estimates what information is worth before deciding, so research is done when it pays.", ["Howard 1966 (index only)"],
+    [["VI1", "prices information", (f) => f.pricesInformation]],
+    { "proactive-agent": "overlap" }),
+  C("multi-objective", "multi-objective optimization", "Scores options on several objectives at once.", ["Hayes et al. 2022, arXiv 2103.09568"],
+    [["MO1", "several objectives", (f) => f.manyObjectives]],
+    { "pareto-set": "has_a_kind" }),
+  C("pareto-set", "Pareto set", "Only the options that no other option beats on every objective.", ["Hayes et al. 2022"],
+    [["MO1", "several objectives", (f) => f.manyObjectives], ["PS1", "non-dominated only", (f) => f.nonDominated], ["CP1", "outputs a set", (f) => f.outputsSet]],
+    { "multi-objective": "is_a", "conformal-prediction": "overlap" }),
+  C("demand-sensing", "demand sensing", "Forecasts demand from recent signals (supply chain).", ["supply-chain usage (not opened)"],
+    [["FC1", "predicts a future state", (f) => f.predicts], ["DS1", "about demand, from recent signals", (f) => f.demandSignals]],
+    { forecast: "is_a" }),
+  C("horizon-scanning", "horizon scanning", "Searches broadly for early signs of change; it need not forecast.", ["strategic foresight usage (not opened)"],
+    [["HS1", "scans for weak signals", (f) => f.scansWeakSignals]],
+    { forecast: "overlap" }),
+];
+
+// ---------- level 2: one thing in a venture's records, as it moves from idea to instance ----------
+export type Thing = Base & {
+  stated: boolean;          // someone stated it
+  purpose: boolean;         // its essential why is stated (purpose, core promise; R-02)
+  goals: boolean;           // its contingent why is stated (goals, ambitions; these may change)
+  distinguishing: boolean;  // properties that make it this thing and not another (function, roles, personality, ...)
+  persists: boolean;        // those properties are fixed as what must stay the same through later phases
+  homeFunction: boolean;    // belongs to a venture function (the thing is not itself a function; R-08, R-11)
+  needs: boolean;           // its needs are derived
+  requirements: boolean;    // its requirements are derived
+  constraints: boolean;     // its constraints are derived
+  nextPhase: boolean;       // a next phase with work is assigned
+  instance: boolean;        // something real now matches it (a person hired, a supplier signed)
+};
+const T = mk<Thing>("venture thing", "stage");
+const ident = (f: Thing) => f.purpose && f.distinguishing && f.persists && f.homeFunction;
+export const PIPE: Term<Thing>[] = [
+  T("idea", "idea", "Stated, but without the properties that would say what must stay the same.", ["Torian 05:45Z; Greek idea, form or pattern seen (Wiktionary)"],
+    [["ID1", "stated", (f) => f.stated], ["ID2", "no identity yet", (f) => !ident(f)]],
+    { identity: "disjoint" }),
+  T("identity", "identity", "What must stay the same about the thing through every later phase: its purpose, its distinguishing properties, and the venture function it belongs to. Goals are not identity; they may change.", ["Latin idem, the same (Wiktionary); Torian 05:45Z"],
+    [["IT1", "purpose stated", (f) => f.purpose], ["IT2", "distinguishing properties", (f) => f.distinguishing], ["IT3", "fixed as what persists", (f) => f.persists], ["IT4", "belongs to a venture function", (f) => f.homeFunction]],
+    { idea: "disjoint", "shaped-identity": "has_a_kind" }),
+  T("shaped-identity", "shaped identity", "An identity whose goals are stated and whose needs, requirements and constraints are derived.", ["Torian 05:45Z"],
+    [["IT1", "purpose", (f) => f.purpose], ["IT2", "distinguishing", (f) => f.distinguishing], ["IT3", "persists", (f) => f.persists], ["IT4", "home function", (f) => f.homeFunction],
+     ["SH0", "goals stated", (f) => f.goals], ["SH1", "needs derived", (f) => f.needs], ["SH2", "requirements derived", (f) => f.requirements], ["SH3", "constraints derived", (f) => f.constraints]],
+    { identity: "is_a", "ready-identity": "has_a_kind" }),
+  T("ready-identity", "identity ready for its next phase", "A shaped identity with its next phase assigned (research the market, post the job, search leads).", ["Torian 05:45Z"],
+    [["IT1", "purpose", (f) => f.purpose], ["IT2", "distinguishing", (f) => f.distinguishing], ["IT3", "persists", (f) => f.persists], ["IT4", "home function", (f) => f.homeFunction],
+     ["SH0", "goals", (f) => f.goals], ["SH1", "needs", (f) => f.needs], ["SH2", "requirements", (f) => f.requirements], ["SH3", "constraints", (f) => f.constraints], ["NP1", "next phase assigned", (f) => f.nextPhase]],
+    { "shaped-identity": "is_a" }),
+  T("instance", "instance", "Something real that matches an identity.", ["Torian 05:45Z"],
+    [["IT1", "purpose", (f) => f.purpose], ["IT2", "distinguishing", (f) => f.distinguishing], ["IT3", "persists", (f) => f.persists], ["IT4", "home function", (f) => f.homeFunction], ["IN1", "a real thing matches", (f) => f.instance]],
+    { identity: "is_a", idea: "disjoint" }),
+];
+
+// ---------- level 3: an exchange between two functions ----------
+export type Ex = Base & {
+  differentFunctions: boolean; // asker and owner are different functions
+  asks: boolean;               // the asker sends typed questions
+  citesOwnerRecord: boolean;   // the questions cite a record the owner keeps
+  triggeredByRecord: boolean;  // a record write in the owner's function triggered it
+  research: boolean;           // the asker runs research
+  writesOwn: boolean;          // the result is written to the asker's own records
+  writesOwner: boolean;        // the result is written into the owner's records
+};
+const X = mk<Ex>("function exchange", "act");
+export const XFN: Term<Ex>[] = [
+  X("inquiry", "cross-function inquiry", "One function asks another typed questions about a record the other keeps.", ["ours; cf. requisition in procure-to-pay"],
+    [["IQ1", "different functions", (f) => f.differentFunctions], ["IQ2", "asks questions", (f) => f.asks], ["IQ3", "cites the owner's record", (f) => f.citesOwnerRecord]],
+    { "informed-research": "overlap" }),
+  X("informed-research", "informed research", "Research a function runs because another function's record changed, written only to its own records.", ["Torian 05:45Z"],
+    [["IR1", "different functions", (f) => f.differentFunctions], ["IR2", "triggered by the owner's record", (f) => f.triggeredByRecord], ["IR3", "runs research", (f) => f.research], ["IR4", "writes own records", (f) => f.writesOwn], ["IR5", "never writes the owner's records", (f) => !f.writesOwner]],
+    { "cross-write": "disjoint", inquiry: "overlap" }),
+  X("cross-write", "cross-write", "A function writes into records another function owns. Forbidden; it would break ownership and provenance.", ["ours: records have one owning function"],
+    [["CW1", "different functions", (f) => f.differentFunctions], ["CW2", "writes the owner's records", (f) => f.writesOwner]],
+    { "informed-research": "disjoint" }),
+];
+
+function cases<F extends Base>(keys: readonly string[], label: string): F[] {
+  const out: F[] = [];
+  for (let m = 0; m < 2 ** (keys.length + 1); m++) {
+    const f = { confirmed: Boolean(m & 1), label: [label, undefined][m % 2] } as F;
+    keys.forEach((k, i) => { (f as Record<string, unknown>)[k] = Boolean(m & (2 << i)); }); out.push(f);
+  }
+  return out;
+}
+function level<F extends Base>(name: string, vocab: Term<F>[], cs: F[]) {
+  const sets = new Map(vocab.map((t) => [t.id, passSet(t, cs)])); let ok = 0, n = 0;
+  console.log(`== ${name}: ${cs.length} cases`);
+  for (const t of vocab) { const v = validTest(t, cs); console.log(`${t.id.padEnd(22)} ${freeze(t)} ${v.length ? v.join("; ") : "valid"}`); }
+  for (const a of vocab) for (const [o, w] of Object.entries(a.predicts ?? {})) {
+    n++; const g = relation(sets.get(a.id)!, sets.get(o)!); if (g === w) ok++;
+    console.log(`${a.id} ~ ${o}: predicted ${w}, got ${g} -> ${g === w ? "confirmed" : "REFUTED"}`);
+  }
+  console.log(`${ok}/${n} predictions confirmed\n`);
+}
+if (import.meta.url === `file://${process.argv[1]}`) {
+  level("capability", PARTS, cases<Cap>(["predicts", "actsOnPrediction", "unprompted", "canAbstain", "confidence", "matchesFrequency", "outputsSet", "coverageGuarantee", "pricesInformation", "manyObjectives", "nonDominated", "demandSignals", "scansWeakSignals"], "precog"));
+  level("venture thing", PIPE, cases<Thing>(["stated", "purpose", "goals", "distinguishing", "persists", "homeFunction", "needs", "requirements", "constraints", "nextPhase", "instance"], "hire"));
+  level("function exchange", XFN, cases<Ex>(["differentFunctions", "asks", "citesOwnerRecord", "triggeredByRecord", "research", "writesOwn", "writesOwner"], "finance"));
+  // Precog, the product, as specified: which parts does it pass?
+  const precog = { confirmed: true, predicts: true, actsOnPrediction: true, unprompted: true, canAbstain: true, confidence: true, matchesFrequency: true, outputsSet: true, coverageGuarantee: false, pricesInformation: true, manyObjectives: true, nonDominated: true, demandSignals: false, scansWeakSignals: true } as Cap;
+  console.log("== Precog (product, as specified) passes:", PARTS.filter((t) => run(t, precog).pass).map((t) => t.id).join(", "));
+  const b = { confirmed: true, stated: true, purpose: false, goals: false, distinguishing: false, persists: false, homeFunction: false, needs: false, requirements: false, constraints: false, nextPhase: false, instance: false } as Thing;
+  const hire: [string, Partial<Thing>][] = [
+    ["'We need to hire someone'", {}],
+    ["+ purpose, engineering, roles, personality, fixed", { purpose: true, distinguishing: true, persists: true, homeFunction: true }],
+    ["+ goals, needs, requirements, constraints", { purpose: true, goals: true, distinguishing: true, persists: true, homeFunction: true, needs: true, requirements: true, constraints: true }],
+    ["+ next phase: post the job, search leads", { purpose: true, goals: true, distinguishing: true, persists: true, homeFunction: true, needs: true, requirements: true, constraints: true, nextPhase: true }],
+    ["a lead who matches", { purpose: true, goals: true, distinguishing: true, persists: true, homeFunction: true, needs: true, requirements: true, constraints: true, nextPhase: true, instance: true }],
+  ];
+  console.log("\n== the hire, stage by stage");
+  for (const [nm, fx] of hire) console.log(`${nm.padEnd(64)} ${PIPE.filter((t) => run(t, { ...b, ...fx } as Thing).pass).map((t) => t.id).join(", ")}`);
+}
