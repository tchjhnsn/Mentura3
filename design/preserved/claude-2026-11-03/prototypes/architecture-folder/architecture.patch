+  console.log("kernel in a cycle (must be none):", verdicts.filter((v) => v.kernel.pass && v.inCycle).length);
+  // label vs verdict: files whose own header calls them an engine or kernel
+  const repo = "/home/user/ee-build";
+  const named = real.filter((c) => /\b(the|an?|this) (\w+ )?(engine|kernel)\b/i.test(readFileSync(`${repo}/${c.path}`, "utf8").split("\n").slice(0, 8).join(" ")));
