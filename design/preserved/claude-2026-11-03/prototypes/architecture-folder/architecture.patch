@@ -0,0 +1,132 @@
+// The technical architecture vocabulary (proposed, 2026-10-31), run through the term engine like every
+// glossary term. Torian: words like system, interface, framework, schema and root must mean something we
+// can check, and the record must say how they relate (parent, child, sibling). Sources: ISO/IEC/IEEE 42010
+// (system, architecture description), the C4 model (person, software system, container, component, code),
+// ISO/IEC/IEEE 24765 SEVOCAB (interface, framework, library, schema), Fowler on inversion of control.
+//
+// Two kinds of relation, never mixed:
+//   is_a     read off pass sets at one level (the engine's cross-run): "a data store is a container"
+//   part_of  the containment tree between levels: a container is part of a system. Not a pass-set relation;
+//            Lean proves the tree has exactly one root.
+//
+//   node vocabulary.ts     validity, cross-run, predictions
+
+import { freeze, passSet, relation, validTest, type Base, type Relation, type Term } from "/home/user/ee-build/schema/terms/engine.ts";
+
+/** One element of a software architecture, described by what it does, never by its name or folder. */
+export type Element = Base & {
+  human: boolean;                 // a person
+  hasParent: boolean;             // part of a larger element we describe
+  allReachIt: boolean;            // every element in its hierarchy is part of it, directly or not
+  standalone: boolean;            // delivers value to people on its own, with its own owner and release
+  runsOrStoresSeparately: boolean;// its own process, app or data store: it can be started, deployed or backed up alone
+  storesData: boolean;            // holds data that outlives a run
+  singleSourceUnit: boolean;      // one source file or module
+  groupsUnitsBehindContract: boolean; // several modules that others reach only through a stated contract
+  isContract: boolean;            // the agreed boundary itself: operations, messages or formats two elements share
+  definesDataShape: boolean;      // says what valid data looks like
+  isDataInstance: boolean;        // data itself
+  reusableAcrossProducts: boolean;
+  callsYourCode: boolean;         // inversion of control: it calls the code you plug in
+  calledByYourCode: boolean;      // you call it
+  hostedWithAccounts: boolean;    // run by its owner for others, who sign in
+  othersBuildOnIt: boolean;       // other products are built on top of it
+};
+
+const T = (id: string, label: string, form: Term<Element>["form"], meaning: string, sources: string[], props: [string, string, (f: Element) => boolean][], predicts?: Record<string, Relation>, lean?: string[]): Term<Element> =>
+  ({ id, label, level: "element", kind: "role", form, meaning, sources, lean, predicts, props: props.map(([pid, says, check]) => ({ id: pid, says, check })) });
+
+const notPerson = (f: Element) => !f.human;
+
+export const VOCAB: Term<Element>[] = [
+  T("person", "person", "word", "A human who uses the system or owns what it holds. Agents are not people: an agent acts through a harness, which is a software system.",
+    ["C4 model: person"], [["PE1", "a human", (f) => f.human]], { "software-system": "disjoint", agent: "disjoint" }),
+  T("software-system", "software system", "compound", "The highest level of software we describe: something that delivers value to people on its own, with its own owner and release, made of containers.",
+    ["C4 model: software system", "ISO/IEC/IEEE 42010: system"],
+    [["S1", "not a person", notPerson], ["S2", "delivers value on its own", (f) => f.standalone], ["S3", "not a single file or a contract", (f) => !f.singleSourceUnit && !f.isContract], ["S4", "can be run or deployed: it runs or stores data separately", (f) => f.runsOrStoresSeparately]],
+    { container: "disjoint", component: "disjoint", module: "disjoint", root: "overlap" }),
+  T("container", "container", "word", "A part of a software system that runs or stores data separately: an app, a process, a server, a database or a file store. (C4's word; nothing to do with Docker.)",
+    ["C4 model: container"],
+    [["CT1", "not a person", notPerson], ["CT2", "part of a software system", (f) => f.hasParent], ["CT3", "runs or stores data separately", (f) => f.runsOrStoresSeparately], ["CT4", "not itself standalone", (f) => !f.standalone], ["CT5", "not a single source file", (f) => !f.singleSourceUnit]],
+    { component: "disjoint", module: "disjoint", "data-store": "has_a_kind" }),
+  T("data-store", "data store", "compound", "A container whose job is to keep data: a database, a file store, the venture's records on disk.",
+    ["C4 model: container (database, file system)"],
+    [["DS1", "not a person", notPerson], ["DS2", "part of a software system", (f) => f.hasParent], ["DS3", "runs or stores data separately", (f) => f.runsOrStoresSeparately], ["DS4", "not itself standalone", (f) => !f.standalone], ["DS5", "not a single source file", (f) => !f.singleSourceUnit], ["DS6", "stores data", (f) => f.storesData]],
+    { container: "is_a" }),
+  T("component", "component", "word", "A group of modules inside one container that others reach only through a stated contract. It cannot run on its own.",
+    ["C4 model: component", "ISO/IEC/IEEE 24765: component"],
+    [["CP1", "not a person", notPerson], ["CP2", "part of a container", (f) => f.hasParent], ["CP3", "does not run or store separately", (f) => !f.runsOrStoresSeparately], ["CP4", "groups modules behind a contract", (f) => f.groupsUnitsBehindContract], ["CP5", "not a single source file", (f) => !f.singleSourceUnit]],
+    { module: "disjoint", interface: "disjoint" }),
+  T("module", "module", "word", "One unit of source code: in Naive, one file. Kernels and engines are kinds of module, judged by their own tests.",
+    ["C4 model: code", "ISO/IEC/IEEE 24765: module"],
+    [["MD1", "not a person", notPerson], ["MD2", "one source unit", (f) => f.singleSourceUnit], ["MD3", "part of something larger", (f) => f.hasParent]],
+    { interface: "overlap" }),
+  T("interface", "interface", "word", "The agreed boundary where two elements meet: the operations, messages or file formats they share. An interface is a contract, not a running thing; containers and components provide or use it.",
+    ["ISO/IEC/IEEE 24765: interface (a shared boundary)"],
+    [["IF1", "not a person", notPerson], ["IF2", "a contract between elements", (f) => f.isContract], ["IF3", "does not run or store anything itself", (f) => !f.runsOrStoresSeparately && !f.storesData], ["IF4", "is not itself a group of code", (f) => !f.groupsUnitsBehindContract]],
+    { schema: "overlap", component: "disjoint" }),
+  T("schema", "schema", "word", "A definition of what valid data looks like (here, JSON Schema). A schema defines a record type; records conform to it. It is a contract for data, so a schema is a kind of interface when two parts exchange that data.",
+    ["ISO/IEC/IEEE 24765: schema", "JSON Schema 2020-12"],
+    [["SC1", "not a person", notPerson], ["SC2", "defines a data shape", (f) => f.definesDataShape], ["SC3", "is not data itself", (f) => !f.isDataInstance]],
+    { record: "disjoint", interface: "overlap" }),
+  T("record", "record", "word", "One piece of the venture's data, conforming to a schema. Records are the source of truth; artifacts are views of them.",
+    ["Naive: records vs artifacts (decided 2026-10-29)"],
+    [["RC1", "not a person", notPerson], ["RC2", "is data", (f) => f.isDataInstance], ["RC3", "does not define a shape", (f) => !f.definesDataShape]], { schema: "disjoint" }),
+  T("framework", "framework", "word", "Reusable software that calls the code you plug into it (inversion of control): you fill in its conventions, it runs them. Naive is a framework for ventures, the way Next.js is for web apps.",
+    ["ISO/IEC/IEEE 24765: framework", "Fowler, Inversion of Control (2005)"],
+    [["FW1", "not a person", notPerson], ["FW2", "reusable across products", (f) => f.reusableAcrossProducts], ["FW3", "calls your code", (f) => f.callsYourCode]],
+    { library: "disjoint", platform: "overlap" }),
+  T("library", "library", "word", "Reusable software your code calls; it never calls you back.",
+    ["ISO/IEC/IEEE 24765: library", "Fowler, Inversion of Control (2005)"],
+    [["LB1", "not a person", notPerson], ["LB2", "reusable across products", (f) => f.reusableAcrossProducts], ["LB3", "called by your code", (f) => f.calledByYourCode], ["LB4", "does not call your code", (f) => !f.callsYourCode]],
+    { framework: "disjoint" }),
+  T("platform", "platform", "word", "A software system its owner runs for others, who sign in and build their own products on it. Naive is the framework (EE-041). Which product is the platform is open since EE-097 (2026-11-01): Mentura is now Moses David's kind of AI, not the platform.",
+    ["EE-041 framework/platform split", "Vercel to Next.js as the reference pair"],
+    [["PF1", "not a person", notPerson], ["PF2", "hosted, with accounts", (f) => f.hostedWithAccounts], ["PF3", "others build on it", (f) => f.othersBuildOnIt], ["PF4", "delivers value on its own", (f) => f.standalone], ["PF5", "runs as a service", (f) => f.runsOrStoresSeparately && !f.singleSourceUnit && !f.isContract]],
+    { "software-system": "is_a" }),
+  T("root", "root", "word", "A position, not a kind: the one element in a hierarchy that has no parent and that every other element is part of. The root of the architecture record is the software system. (Distinct from \"root coherence\" in Polity, a theological sense.)",
+    ["graph theory: root of a rooted tree", "ISO/IEC/IEEE 24765: root"],
+    [["RT1", "has no parent", (f) => !f.hasParent], ["RT2", "every element in the hierarchy is part of it", (f) => f.allReachIt]],
+    { "software-system": "overlap" }, ["Naive.Structure.root_unique"]),
+];
+// Not cross-run here: agent (a role a harness plays, at the relationship level), layer (a property of a set
+// of elements, proved in Lean as ranked_no_cycle), kernel and engine (module level, terms.ts).
+
+/** Every combination of the facts (2^17 with confirmed), not a sample: with only yes/no facts, enumeration is
+ *  exact, so "disjoint" means no element could pass both, not that a random sample happened to miss one.
+ *  (A sampled run first reported framework ~ platform as disjoint; the seeded generator never produced the
+ *  combination. Enumeration found the overlap.) */
+const KEYS = ["human", "hasParent", "allReachIt", "standalone", "runsOrStoresSeparately", "storesData", "singleSourceUnit",
+  "groupsUnitsBehindContract", "isContract", "definesDataShape", "isDataInstance", "reusableAcrossProducts", "callsYourCode",
+  "calledByYourCode", "hostedWithAccounts", "othersBuildOnIt"] as const;
+export function elementCases(): Element[] {
+  const labels = ["system", "core", "schema", "layer", undefined];
+  const out: Element[] = [];
+  for (let m = 0; m < 2 ** (KEYS.length + 1); m++) {
+    const f = { confirmed: Boolean(m & 1), label: labels[m % 5] } as Element;
+    KEYS.forEach((k, i) => { (f as Record<string, unknown>)[k] = Boolean(m & (2 << i)); });
+    out.push(f);
+  }
+  return out;
+}
+
+if (import.meta.url === `file://${process.argv[1]}`) {
+  const cases = elementCases();
+  const sets = new Map(VOCAB.map((t) => [t.id, passSet(t, cases)]));
+  let bad = 0;
+  for (const t of VOCAB) {
+    const v = validTest(t, cases);
+    if (v.length) bad++;
+    console.log(`${t.label.padEnd(16)} ${freeze(t)} ${v.length ? v.join("; ") : "valid"} (${sets.get(t.id)!.size} pass)`);
+  }
+  console.log("\ncross-run (rows: term ~ other):");
+  const res: Record<string, Record<string, Relation>> = {};
+  for (const a of VOCAB) for (const o of VOCAB) if (a.id !== o.id) (res[a.id] ||= {})[o.id] = relation(sets.get(a.id)!, sets.get(o.id)!);
+  for (const a of VOCAB) console.log(a.id.padEnd(16), Object.entries(res[a.id]).map(([k, v]) => `${k}:${v}`).join(" "));
+  console.log("\npredictions:");
+  for (const a of VOCAB) for (const [o, want] of Object.entries(a.predicts ?? {})) {
+    const got = res[a.id][o];
+    console.log(`${a.id} ~ ${o}: predicted ${want}, got ${got ?? "(not at this level)"} -> ${got === undefined ? "n/a" : got === want ? "confirmed" : "REFUTED"}`);
+  }
+  if (bad) process.exitCode = 1;
+}
