+// Organisation and function vocabulary (proposed, 2026-11-01). Torian: org chart, department; "we say marketing
+// is a function, but what does marketing mean, how do we prove something is marketing, how do we verify it in
+// code?" Also local meaning: a term can mean one thing in one function and another elsewhere.
+// Three levels, each exhaustive:
+//   org        an element of how a venture is organised: function, department, role, org chart
+//   activity   one piece of work, judged by what it does, never by the folder it sits in
+//   process    a sequence of stages, for the three senses of "pipeline" (local meaning)
+//
+//   node org-vocab.ts
+
+import { freeze, passSet, relation, validTest, type Base, type Relation, type Term } from "/home/user/ee-build/schema/terms/engine.ts";
+
+type P<F> = [string, string, (f: F) => boolean][];
+const mk = <F extends Base>(level: string) => (id: string, label: string, form: Term<F>["form"], meaning: string, sources: string[], props: P<F>, predicts?: Record<string, Relation>, scope = "venture"): Term<F> & { scope: string } =>
+  ({ id, label, level, kind: "role", form, meaning, sources, predicts, scope, props: props.map(([pid, says, check]) => ({ id: pid, says, check })) });
+const exhaustive = <F extends Base>(keys: readonly string[], labels: (string | undefined)[]) => {
+  const out: F[] = [];
+  for (let m = 0; m < 2 ** (keys.length + 1); m++) { const f = { confirmed: Boolean(m & 1), label: labels[m % labels.length] } as F; keys.forEach((k, i) => { (f as Record<string, unknown>)[k] = Boolean(m & (2 << i)); }); out.push(f); }
+  return out;
+};
+
+// ---- org level
+export type Org = Base & { kindOfWork: boolean; groupOfPeople: boolean; position: boolean; isRecord: boolean; reportingTree: boolean; existsWithNoPeople: boolean };
+const O = mk<Org>("org");
+export const ORG_VOCAB = [
+  O("function", "function", "word", "A kind of work every venture must have done, whether or not anyone is assigned to it: marketing, finance, engineering. A function exists even when it is null (no people, no records).", ["Porter value chain (primary and support activities)", "Naive phases/functions: functions are always true of a venture, even if null"],
+    [["FN1", "a kind of work", (f) => f.kindOfWork], ["FN2", "exists with no people", (f) => f.existsWithNoPeople], ["FN3", "not a group of people", (f) => !f.groupOfPeople], ["FN4", "not a position (engine run 1 found function~role overlapping without it)", (f) => !f.position], ["FN5", "not a record (run 1: function~org chart overlapped)", (f) => !f.isRecord]], { department: "disjoint", role: "disjoint", "org-chart": "disjoint" }),
+  O("department", "department", "word", "A group of people the venture forms to carry out one or more functions. A solo venture has functions but no departments.", ["organisation design (Galbraith, Designing Organizations)"],
+    [["DP1", "a group of people", (f) => f.groupOfPeople], ["DP2", "not a single position", (f) => !f.position], ["DP3", "not a record", (f) => !f.isRecord]], { function: "disjoint", role: "disjoint" }),
+  O("role", "role", "word", "A position with responsibilities, held at a time by one person or one agent, or by nobody while it is open. Ownership of a function stays with people; an agent holds a role only as a contributor (governance/delegation.json).", ["RACI", "org design", "schema/delegation.schema.json: roles granted to agents (reconciled with docs/ontology.json, issue #143)"],
+    [["RL1", "a position", (f) => f.position], ["RL2", "not a group of people", (f) => !f.groupOfPeople], ["RL3", "not a record", (f) => !f.isRecord]], { department: "disjoint" }),
+  O("org-chart", "org chart", "compound", "A record: the tree of roles and departments by reporting line. It is a view of who reports to whom, not the people or the work.", ["organisational chart"],
+    [["OC1", "a record", (f) => f.isRecord], ["OC2", "a reporting tree", (f) => f.reportingTree]], { function: "disjoint", role: "disjoint", department: "disjoint" }),
+];
+
+// ---- activity level
+export type Activity = Base & { forMarket: boolean; aboutOfferingValue: boolean; communicates: boolean; exchangeWithBuyer: boolean; buildsOffering: boolean; staffs: boolean; movesMoney: boolean };
+const A = mk<Activity>("activity");
+export const ACTIVITY_VOCAB = [
+  A("marketing", "marketing", "word", "Work aimed at a market (people outside the venture who might buy or use it) that creates, communicates, delivers or exchanges the value of an offering (AMA, 2017). An activity is marketing by what it does, not by the folder it sits in.", ["American Marketing Association definition (approved 2017)", "Kotler, Marketing Management"],
+    [["MK1", "aimed at a market", (f) => f.forMarket], ["MK2", "about the value of an offering", (f) => f.aboutOfferingValue]], { sales: "has_a_kind", "product-development": "overlap", hiring: "overlap", finance: "overlap" }),
+  A("sales", "sales", "word", "Work that closes an exchange of an offering with a specific buyer.", ["AMA: selling as part of exchanging"],
+    [["SL1", "aimed at a market", (f) => f.forMarket], ["SL2", "about the value of an offering", (f) => f.aboutOfferingValue], ["SL3", "an exchange with a specific buyer", (f) => f.exchangeWithBuyer]], { marketing: "is_a" }),
+  A("product-development", "product development", "compound", "Work that builds the offering itself. In software ventures most of it is engineering.", ["Ulrich and Eppinger, Product Design and Development"],
+    [["PD1", "builds the offering", (f) => f.buildsOffering]], { marketing: "overlap" }),
+  A("hiring", "hiring", "word", "Work that brings people into the venture to fill roles.", ["human capital (Naive department catalog)"],
+    [["HR1", "staffs the venture", (f) => f.staffs]], { marketing: "overlap" }),
+  A("finance", "finance", "word", "Work that moves, raises or accounts for the venture's money.", ["Naive department catalog: finance"],
+    [["FI1", "moves or accounts for money", (f) => f.movesMoney]]),
+];
+
+// ---- process level: one word, three local meanings
+export type Process = Base & { stagesInOrder: boolean; automated: boolean; itemsAreDeals: boolean; itemsAreCodeChanges: boolean; itemsAreProblems: boolean };
+const PR = mk<Process>("process");
+const stages: P<Process> = [["PL1", "items move through stages in order", (f) => f.stagesInOrder]];
+export const PIPELINE_SENSES = [
+  PR("pipeline@sales", "pipeline", "word", "Deals moving through stages from first contact to close.", ["sales pipeline"], [...stages, ["PS1", "items are deals", (f) => f.itemsAreDeals], ["PS2", "not code changes (run 1: a deal and a code change were not kept apart)", (f) => !f.itemsAreCodeChanges]], { "pipeline@engineering": "disjoint" }, "sales"),
+  PR("pipeline@engineering", "pipeline", "word", "The automated checks a code change passes on its way to main (CI).", ["continuous integration"], [...stages, ["PE1", "automated", (f) => f.automated], ["PE2", "items are code changes", (f) => f.itemsAreCodeChanges], ["PE3", "not deals", (f) => !f.itemsAreDeals]], { "pipeline@sales": "disjoint" }, "engineering"),
+  PR("pipeline@naive", "pipeline", "word", "A problem's path from signal to a merged, verified fix (the problem loop).", ["Naive problem loop (proposed 2026-10-31)"], [...stages, ["PN1", "items are problems", (f) => f.itemsAreProblems]], { "pipeline@engineering": "overlap" }, "venture"),
+];
+
+export const LEVELS = [
+  { terms: ORG_VOCAB, cases: () => exhaustive<Org>(["kindOfWork", "groupOfPeople", "position", "isRecord", "reportingTree", "existsWithNoPeople"], ["department", "function", undefined]) },
+  { terms: ACTIVITY_VOCAB, cases: () => exhaustive<Activity>(["forMarket", "aboutOfferingValue", "communicates", "exchangeWithBuyer", "buildsOffering", "staffs", "movesMoney"], ["marketing", "sales", undefined]) },
+  { terms: PIPELINE_SENSES, cases: () => exhaustive<Process>(["stagesInOrder", "automated", "itemsAreDeals", "itemsAreCodeChanges", "itemsAreProblems"], ["pipeline", undefined]) },
+];
+
+if (import.meta.url === `file://${process.argv[1]}`) {
+  let ok = 0, n = 0;
+  for (const { terms, cases } of LEVELS) {
+    const cs = cases() as Base[]; const ts = terms as Term<Base>[];
+    console.log(`\n${ts[0].level}: ${cs.length} cases`);
+    const sets = new Map(ts.map((t) => [t.id, passSet(t, cs)]));
+    for (const t of ts) { const v = validTest(t, cs); console.log(`  ${t.id.padEnd(22)} ${freeze(t)} ${v.length ? v.join("; ") : "valid"}`); }
+    for (const a of ts) for (const [o, want] of Object.entries(a.predicts ?? {})) { n++; const got = relation(sets.get(a.id)!, sets.get(o)!); if (got === want) ok++; console.log(`  ${a.id} ~ ${o}: predicted ${want}, got ${got} -> ${got === want ? "confirmed" : "REFUTED"}`); }
+  }
+  console.log(`\n${ok}/${n} predictions confirmed`);
+}
