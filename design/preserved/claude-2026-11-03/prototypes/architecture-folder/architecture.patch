+++ b/project-files/naive-design/prototypes/architecture/Anatomy.lean
@@ -0,0 +1,74 @@
+/- "Venture Anatomy Matrix" and "holding" (proposed 2026-11-01) against their neighbours. Mirrors anatomy-vocab.ts:
+   the same facts, so a theorem here and a cross-run there say the same thing. -/
+namespace Naive.Anatomy
+
+structure Instrument where
+  itemsByCriteria : Bool
+  unitVenture : Bool
+  unitProduct : Bool
+  rowsAreParts : Bool
+  rankAgainstCore : Bool
+  evidenceLadder : Bool
+  partPhases : Bool
+
+def IsDecisionMatrix (i : Instrument) : Prop := i.itemsByCriteria = true
+def IsProductAnatomyMatrix (i : Instrument) : Prop :=
+  IsDecisionMatrix i ∧ i.unitProduct = true ∧ i.rankAgainstCore = true
+def IsDueDiligenceChecklist (i : Instrument) : Prop := i.unitVenture = true ∧ i.rowsAreParts = true
+def IsVentureAnatomyMatrix (i : Instrument) : Prop :=
+  IsDecisionMatrix i ∧ IsDueDiligenceChecklist i ∧ i.evidenceLadder = true ∧ i.partPhases = true
+
+theorem vam_is_decision_matrix {i : Instrument} (h : IsVentureAnatomyMatrix i) : IsDecisionMatrix i := h.1
+theorem vam_is_due_diligence_checklist {i : Instrument} (h : IsVentureAnatomyMatrix i) : IsDueDiligenceChecklist i := h.2.1
+
+/-- The two matrices overlap: one instrument can be both, and each can exist without the other. -/
+def both : Instrument := ⟨true, true, true, true, true, true, true⟩
+def vamOnly : Instrument := ⟨true, true, false, true, false, true, true⟩
+def pamOnly : Instrument := ⟨true, false, true, false, true, false, false⟩
+theorem matrices_overlap :
+    (IsVentureAnatomyMatrix both ∧ IsProductAnatomyMatrix both) ∧
+    (IsVentureAnatomyMatrix vamOnly ∧ ¬ IsProductAnatomyMatrix vamOnly) ∧
+    (IsProductAnatomyMatrix pamOnly ∧ ¬ IsVentureAnatomyMatrix pamOnly) :=
+  ⟨⟨⟨rfl, ⟨rfl, rfl⟩, rfl, rfl⟩, ⟨rfl, rfl, rfl⟩⟩,
+   ⟨⟨rfl, ⟨rfl, rfl⟩, rfl, rfl⟩, fun h => by cases h.2.1⟩,
+   ⟨⟨rfl, rfl, rfl⟩, fun h => by cases h.2.1.1⟩⟩
+
+structure Org where
+  undertaken : Bool
+  hasOneCore : Bool
+  holdsVentures : Bool
+  coresDiffer : Bool
+  operatesItself : Bool
+  legalEntity : Bool
+  ownGovernance : Bool
+
+/-- Ontology: anything undertaken; ventures can hold ventures. -/
+def IsVenture (o : Org) : Prop := o.undertaken = true
+/-- The matrix's venture: one core of its own. -/
+def IsVentureVam (o : Org) : Prop := IsVenture o ∧ o.hasOneCore = true
+def IsHolding (o : Org) : Prop :=
+  IsVenture o ∧ o.holdsVentures = true ∧ o.coresDiffer = true ∧ o.hasOneCore = false ∧ o.ownGovernance = true
+def IsGroup (o : Org) : Prop := o.holdsVentures = true
+def IsHoldingCompany (o : Org) : Prop := o.holdsVentures = true ∧ o.operatesItself = false ∧ o.legalEntity = true
+def IsParentCompany (o : Org) : Prop := o.holdsVentures = true ∧ o.operatesItself = true ∧ o.legalEntity = true
+
+theorem holding_is_venture {o : Org} (h : IsHolding o) : IsVenture o := h.1
+theorem holding_is_group {o : Org} (h : IsHolding o) : IsGroup o := h.2.1
+theorem holding_not_vam_venture {o : Org} (h : IsHolding o) : ¬ IsVentureVam o := by
+  intro v; have h1 := h.2.2.2.1; have h2 := v.2; rw [h1] at h2; cases h2
+theorem holding_company_not_parent {o : Org} (h : IsHoldingCompany o) : ¬ IsParentCompany o := by
+  intro p; have h1 := h.2.1; have h2 := p.2.1; rw [h1] at h2; cases h2
+
+/-- The finding: "holding" is not the industry's "holding company". SpaceX operates itself, so it is a holding and a
+    parent company but not a holding company; a founder with several ventures and no legal entity is a holding and
+    neither. The standard umbrella word is "group" (IFRS 10). -/
+def spaceX : Org := ⟨true, false, true, true, true, true, true⟩
+def founderOfSeveral : Org := ⟨true, false, true, true, false, false, true⟩
+theorem spacex_holding_parent_not_holding_company :
+    IsHolding spaceX ∧ IsParentCompany spaceX ∧ ¬ IsHoldingCompany spaceX ∧ IsGroup spaceX :=
+  by simp [IsHolding, IsVenture, IsParentCompany, IsHoldingCompany, IsGroup, spaceX]
+theorem founder_holding_no_company :
+    IsHolding founderOfSeveral ∧ ¬ IsHoldingCompany founderOfSeveral ∧ ¬ IsParentCompany founderOfSeveral :=
+  by simp [IsHolding, IsVenture, IsParentCompany, IsHoldingCompany, founderOfSeveral]
+
+end Naive.Anatomy
