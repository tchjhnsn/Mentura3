@@ -0,0 +1,37 @@
+/- How Naive's records system acts (2026-11-01). Mirrors mechanism-vocab.ts. Core Lean only; built by the phases thread. -/
+namespace Naive.Mechanism
+
+structure Sys where
+  physical : Bool
+  deterministic : Bool
+  statedRules : Bool
+  traceable : Bool
+  learned : Bool
+  stateful : Bool
+  definedTransitions : Bool
+  typedSymbols : Bool
+
+def StateMachine (s : Sys) : Prop := s.stateful = true ∧ s.definedTransitions = true
+def LearnedModel (s : Sys) : Prop := s.learned = true
+def MechanicalSystem (s : Sys) : Prop := s.physical = true
+def RecordsMechanism (s : Sys) : Prop :=
+  s.physical = false ∧ s.deterministic = true ∧ s.statedRules = true ∧ s.traceable = true ∧
+  s.stateful = true ∧ s.definedTransitions = true ∧ s.typedSymbols = true ∧ s.learned = false
+
+theorem records_mechanism_is_state_machine {s : Sys} (h : RecordsMechanism s) : StateMachine s :=
+  ⟨h.2.2.2.2.1, h.2.2.2.2.2.1⟩
+
+/-- Nothing learned decides inside the records mechanism: models propose from outside it. -/
+theorem records_mechanism_not_learned {s : Sys} (h : RecordsMechanism s) (l : LearnedModel s) : False := by
+  have x := h.2.2.2.2.2.2.2
+  have y : s.learned = true := l
+  rw [x] at y
+  exact Bool.noConfusion y
+
+theorem records_mechanism_not_mechanical {s : Sys} (h : RecordsMechanism s) (m : MechanicalSystem s) : False := by
+  have x := h.1
+  have y : s.physical = true := m
+  rw [x] at y
+  exact Bool.noConfusion y
+
+end Naive.Mechanism
diff --git a/project-files/naive-design/prototypes/architecture/Model.lean b/project-files/naive-design/prototypes/architecture/Model.lean
new file mode 100644
