+++ b/project-files/naive-design/prototypes/architecture/lineage.py
@@ -0,0 +1,38 @@
+# Genealogy of the import graph. Orientation: if A imports B, B is A's parent (A is built on B).
+# degree = direct children; reach = all descendants; height = generations below; depth = generations above.
+import json, re, sys, functools
+sys.setrecursionlimit(10000)
+d = json.load(open('as-built.json'))
+F = {f['path']: f for f in d['files'] if not re.search(r'(-test|/test)\.(mjs|ts)$', f['path'])}
+children = {p: set() for p in F}; parents = {p: set() for p in F}
+for p, f in F.items():
+    for i in f['imports']:
+        if i in F: children[i].add(p); parents[p].add(i)
+cyc = set(x for c in d['cycles'] for x in c)
+def desc(p):
+    seen, st = set(), [p]
+    while st:
+        v = st.pop()
+        for c in children[v]:
+            if c not in seen: seen.add(c); st.append(c)
+    seen.discard(p); return seen
+@functools.lru_cache(None)
+def height(p, stack=frozenset()):
+    if p in stack: return 0
+    hs = [height(c, stack | {p}) for c in children[p]]
+    return 1 + max(hs) if hs else 0
+rows = []
+for p in F:
+    ds = desc(p); deg = len(children[p])
+    rows.append((p, deg, len(ds), height(p), len(parents[p]), p in cyc))
+sources = [r for r in rows if r[4] == 0]
+leaves = [r for r in rows if r[1] == 0]
+print("files", len(rows), "sources(no parent)", len(sources), "leaves(no children)", len(leaves), "both (isolated)", len([r for r in rows if r[1]==0 and r[4]==0]))
+print("\nbroadest (most direct children):")
+for r in sorted(rows, key=lambda r: -r[1])[:6]: print(f"  {r[0]:45} children {r[1]:4} descendants {r[2]:4} generations {r[3]}{' (cycle)' if r[5] else ''}")
+print("\ndeepest-reaching relative to direct children (descendants/children):")
+for r in sorted([r for r in rows if r[1] >= 1], key=lambda r: -(r[2] / r[1]))[:6]: print(f"  {r[0]:45} children {r[1]:4} descendants {r[2]:4} generations {r[3]}{' (cycle)' if r[5] else ''}")
+print("\nkernels:")
+for k in ["schema/terms/engine.ts", "schema/redact.mjs", "schema/verify.mjs", "knowledge/connectors/resolve.mjs"]:
+    r = next(x for x in rows if x[0] == k); print(f"  {k:45} parents {r[4]} children {r[1]} descendants {r[2]} generations {r[3]}")
+json.dump([dict(zip(["path","children","descendants","generations","parents","in_cycle"], r)) for r in rows], open('lineage.json','w'))
