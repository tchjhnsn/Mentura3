+// Relationships between two ventures, us (A) and them (B) (Torian, 2026-11-01 04:45Z: what is it when you use
+// another company for your company's purposes; prove, do not assume, that a venture is not a competitor).
+// Value net: Brandenburger and Nalebuff, Co-opetition (1996). One level: an ordered pair of ventures. Exhaustive.
+//
+//   node relation-vocab.ts
+
+import { freeze, passSet, relation, run, validTest, type Base, type Relation, type Term } from "/home/user/ee-build/schema/terms/engine.ts";
+
+type P<F> = [string, string, (f: F) => boolean][];
+const mk = <F extends Base>(level: string) => (id: string, label: string, meaning: string, sources: string[], props: P<F>, predicts?: Record<string, Relation>): Term<F> =>
+  ({ id, label, level, kind: "role", form: "word", meaning, sources, predicts, props: props.map(([pid, says, check]) => ({ id: pid, says, check })) });
+
+export type Pair = Base & {
+  aBuysFromB: boolean;        // A pays B for a product or service it uses to make its own
+  bBuysFromA: boolean;        // B pays A
+  sameJobSameCustomers: boolean; // a customer could use B's product instead of A's for the same job
+  raisesValue: boolean;       // a customer values A's product more when they also have B's
+  sameScarceInput: boolean;   // a supplier finds it less attractive to supply A when it also supplies B
+  processesAData: boolean;    // B processes personal data on A's behalf
+};
+const R = mk<Pair>("venture pair");
+export const REL_VOCAB: Term<Pair>[] = [
+  R("supplier", "supplier (vendor)", "B provides A something A uses to make its own products (value-net sense, which includes employees). 'Vendor' is narrower: a supplier under a commercial contract, never an employee (verbs-vocab.ts). Anthropic, SpaceXAI (Cursor, Grokbot), TypeSafe and LangChain are ours.",
+    ["Brandenburger and Nalebuff, Co-opetition (1996): suppliers in the value net"],
+    [["SU1", "A buys from B", (f) => f.aBuysFromB]],
+    { "sub-processor": "has_a_kind", "demand-competitor": "overlap", "not-a-competitor": "overlap", customer: "overlap" }),
+  R("customer", "customer", "B pays A for A's product.",
+    ["Co-opetition (1996)"],
+    [["CU1", "B buys from A", (f) => f.bBuysFromA]],
+    { supplier: "overlap" }),
+  R("sub-processor", "sub-processor", "A supplier that processes personal data on A's behalf (GDPR Art. 28). ElevenLabs is Anthropic's for text-to-speech.",
+    ["GDPR Article 28 (processors and sub-processors)"],
+    [["SU1", "A buys from B", (f) => f.aBuysFromB], ["SP1", "B processes personal data for A", (f) => f.processesAData]],
+    { supplier: "is_a" }),
+  R("complementor", "complementor", "Customers value A's product more when they also have B's.",
+    ["Co-opetition (1996)"],
+    [["CO1", "raises A's value to customers", (f) => f.raisesValue]],
+    { supplier: "overlap", "demand-competitor": "overlap" }),
+  R("demand-competitor", "competitor (for customers)", "A customer could use B's product instead of A's for the same job.",
+    ["Co-opetition (1996)"],
+    [["DC1", "same job, same customers", (f) => f.sameJobSameCustomers]],
+    { "not-a-competitor": "disjoint", supplier: "overlap" }),
+  R("supply-competitor", "competitor (for suppliers)", "A supplier finds it less attractive to supply A when it also supplies B (scarce compute, talent, data).",
+    ["Co-opetition (1996)"],
+    [["SC1", "same scarce input", (f) => f.sameScarceInput]],
+    { "not-a-competitor": "disjoint" }),
+  R("not-a-competitor", "not a competitor", "Proven only when BOTH hold: no product of B serves the same job for the same customers as a product of A, and the two do not draw on the same scarce input.",
+    ["Co-opetition (1996), both sides of the value net"],
+    [["NC1", "no same job for same customers", (f) => !f.sameJobSameCustomers], ["NC2", "no same scarce input", (f) => !f.sameScarceInput]],
+    { "demand-competitor": "disjoint", "supply-competitor": "disjoint", supplier: "overlap" }),
+];
+
+export function pairCases(): Pair[] {
+  const keys = ["aBuysFromB", "bBuysFromA", "sameJobSameCustomers", "raisesValue", "sameScarceInput", "processesAData"] as const;
+  const out: Pair[] = [];
+  for (let m = 0; m < 2 ** (keys.length + 1); m++) {
+    const f = { confirmed: Boolean(m & 1), label: ["pair", undefined][m % 2] } as Pair;
+    keys.forEach((k, i) => { (f as Record<string, unknown>)[k] = Boolean(m & (2 << i)); });
+    out.push(f);
+  }
+  return out;
+}
+
+if (import.meta.url === `file://${process.argv[1]}`) {
+  const cs = pairCases();
+  const sets = new Map(REL_VOCAB.map((t) => [t.id, passSet(t, cs)])); let ok = 0, n = 0;
+  console.log(`== pair: ${cs.length} cases`);
+  for (const t of REL_VOCAB) { const v = validTest(t, cs); console.log(`${t.id.padEnd(20)} ${freeze(t)} ${v.length ? v.join("; ") : "valid"}`); }
+  for (const a of REL_VOCAB) for (const [o, w] of Object.entries(a.predicts ?? {})) {
+    n++; const g = relation(sets.get(a.id)!, sets.get(o)!); if (g === w) ok++;
+    console.log(`${a.id} ~ ${o}: predicted ${w}, got ${g} -> ${g === w ? "confirmed" : "REFUTED"}`);
+  }
+  console.log(`\n${ok}/${n} predictions confirmed`);
+}
