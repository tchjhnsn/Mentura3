+    [["VF1", "checked against a specification", (f) => f.againstSpec]], { validate: "overlap" }),
+  W("validate", "validate", "IEEE 1012 validation: check that the specification meets the real need (built the right thing).",
+    ["IEEE 1012-2016", "ISO/IEC/IEEE 12207:2017 §6.4.11"],
+    [["VL1", "checked against the real need", (f) => f.againstNeed]]),
