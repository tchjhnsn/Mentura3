+# Architecture record v2: top-down (C4 levels), every element typed by a vocabulary term. Agent draft, unconfirmed.
+import json, re, collections, hashlib
+d = json.load(open('as-built.json'))
+F = {f['path']: f for f in d['files']}
+isTest = lambda p: bool(re.search(r'(-test|/test)\.(mjs|ts)$', p))
+
+# --- level 3: components of the Naive core library, by what the code does (rules over paths) ---
+COMP = [
+ ("router", "Route table and actions: every read and write goes through it", r"^interface/(router|package-routes|reads|context|adapters|acting)\.mjs$|^schema/(feedback-route|record-types)\."),
+ ("write-gate", "The write path: containment, access, ownership gates, drafts a person accepts", r"^interface/(writes|boundaries|gate-hooks|kit-boundary)\.mjs$|^schema/(gate|gate-drafts|access|naive-config|visibility|model-steps|use-model)\.mjs$"),
+ ("provenance", "Append-only log of who changed what and why", r"^interface/provenance\.mjs$|^schema/reasons\.mjs$"),
+ ("records-and-paths", "Where each record lives in a venture, the workspace and its ventures", r"^schema/(venture-paths|workspace|workspace-init|venture-core|venture-type|foundation|structure|canonical|setup|departments|add-department|clock)\.mjs$"),
+ ("decisions", "Decisions, the docket, frames and impact", r"^schema/(decisions|docket|docket-eval|decision-analytics|decision-index|frames|impact|roadmaps|triggers|run-handoff)\.mjs$"),
+ ("lifecycle", "Phases, gates, exit criteria, freshness and what's stale", r"^schema/(lifecycle|freshness|stale|need-now|time-to-ready|calendar|caching|activity|telemetry|beta-gate|assess-problem)\.mjs$|^interface/(vitals|instrumentation)\.mjs$"),
+ ("packages-and-kits", "Packages, kits and the frameworks a venture adopts", r"^schema/(packages|kits|load-packages|user-frameworks|bdd)\.mjs$|^purpose/|^frameworks/|^operations/|^governance/|^evidence/"),
+ ("checks", "Checks the repo and ventures must pass", r"^schema/check-|^schema/(verify|test)\.mjs$|^schema/validate\.py$"),
+ ("lints", "Lints that question a venture's records", r"^schema/(lint-|premise-lint|publish-lint|brand-lint)"),
+ ("term-engine", "Glossary terms: tests, cross-run, admission", r"^schema/terms/"),
+ ("upgrades", "Migrations, upgrades and porting", r"^schema/(migrations/|upgrades|upgrade-venture|migrate-venture|port-venture)"),
+ ("releases-and-publishing", "Frozen releases, publishing, redaction, artifacts", r"^schema/(releases|build-release|start-release|release-read|publish|redact)\.mjs$|^interface/release-card\.mjs$"),
+ ("brand", "Brand tokens, voice, design system, assets", r"^schema/(brand|design-system|assets)\.mjs$|^interface/brand\.mjs$"),
+ ("money-and-team", "Payouts, bugs and other operational records", r"^schema/(payouts|bugs)\.mjs$"),
+ ("founders", "Founder folders above ventures", r"^schema/founders\.ts$"),
+ ("connector-contract", "The contract every source-of-truth connector meets, plus the offline file-system connector", r"^knowledge/connectors/"),
+ ("generator", "Creates a venture from conventions", r"^schema/(init-venture)\.mjs$|^schema/scaffold"),
+]
+# --- level 2: containers ---
+CONT = [
+ # id, kind, says, file rule, system, runtime?
+ ("naive-cli", "container", "The naive and mentura commands, one process per command", r"^interface/cli/", "naive"),
+ ("mcp-server", "container", "MCP server over stdio: agents call the router's actions as tools", r"^interface/mcp/", "naive"),
+ ("local-api", "container", "HTTP API on 127.0.0.1, for one builder's machine", r"^interface/api/", "naive"),
+ ("dev-server", "container", "naive dev: the setup page and the live board", r"^interface/dev/|^interface/demo/", "naive"),
+ ("agent-harness", "container", "Runs an agent through Discovery on a founder's idea dump, then scores the run", r"^interface/harness/", "naive"),
+ ("generator-cli", "container", "create-venture: makes a new venture folder", r"^interface/create-venture/", "naive"),
+ ("venture-workspace", "data store", "The venture's records on disk: JSON files checked by schemas, plus the provenance log", None, "naive"),
+ ("naive-core", "container (library)", "The in-process code every Naive container loads: the router, the gate and the rest. Not run on its own; shown as one box because five containers share it", None, "naive"),
+ ("test-suite", "container (development)", "node test.mjs: every check and test", r"^test\.mjs$|^eslint\.config\.mjs$", "naive"),
+ ("lean-proofs", "container (development)", "Lean 4 library: theorems about terms and the founder definition", None, "naive"),
+ ("tla-models", "container (development)", "TLA+ models checked by TLC through the pstack statechart skill", r"^verification/", "naive"),
+ ("dev-scripts", "container (development)", "PR review and other repo scripts", r"^scripts/", "naive"),
+ ("console-app", "container", "Next.js web app: the operator console", r"^console/", "mentura"),
+ ("webhooks-server", "container", "Receives signed change notices from systems of record", r"^platform/webhooks/", "mentura"),
+ ("research-mcp", "container", "MCP server for market research through Firecrawl", r"^platform/mcp/", "mentura"),
+ ("integrations", "container", "Vendor syncs and connectors: Rho, GitHub", r"^platform/(integrations|connectors)/", "mentura"),
+ ("hosted-kits", "container", "Kits served by the platform", r"^platform/kits/", "mentura"),
+]
+fileComp, fileCont = {}, {}
+for p in F:
+    for cid, _, rx, sysid in [(c[0], c[2], c[3], c[4]) for c in CONT if c[3]]:
+        if re.search(rx, p): fileCont[p] = cid; break
+    else:
+        for cid, _, rx in COMP:
+            if re.search(rx, p): fileComp[p] = cid; fileCont[p] = "naive-core"; break
+unplaced = sorted(p for p in F if p not in fileCont and not isTest(p))
+kern = {"knowledge/connectors/resolve.mjs": "kernel", "schema/redact.mjs": "kernel", "schema/terms/engine.ts": "kernel and engine", "schema/verify.mjs": "kernel"}
+
+def facts(paths):
+    ps = [p for p in paths if p in F]
+    return {"modules": len([p for p in ps if not isTest(p)]), "tests": len([p for p in ps if isTest(p)]), "lines": sum(F[p]['lines'] for p in ps),
+            "packages": sorted({e for p in ps for e in F[p]['external']})}
+def deps(key, mapping):
+    out = collections.Counter()
+    for p, c in mapping.items():
+        if c != key: continue
+        for i in F[p]['imports']:
+            t = mapping.get(i)
+            if t and t != key: out[t] += 1
+    return dict(sorted(out.items()))
+elements = []
+elements.append({"id": "founder", "term": "person", "level": "context", "says": "Owns every record and decision. Uses Naive directly or through a harness."})
+for h, says in [("claude-code", "AI harness: runs an agent for a person; shows artifacts"), ("cursor", "AI harness; shows canvases"), ("grokbot", "AI harness; shows pages (unverified)"), ("terminal", "shell; shows text")]:
+    elements.append({"id": h, "term": "software system", "external": True, "level": "context", "says": says, "plays": "agent (a role, not a person)"})
+for x, says in [("github", "code hosting"), ("vercel", "web hosting"), ("rho", "banking"), ("firecrawl", "web scraping for research"), ("jev", "typed judgments (TypeSafe)"), ("npm-registry", "package registry")]:
+    elements.append({"id": x, "term": "software system", "external": True, "level": "context", "says": says})
+elements.append({"id": "naive", "term": "software system", "also": ["framework"], "root": True, "level": "context", "says": "The venture development framework: conventions, records, routes and checks. The root of this record."})
+elements.append({"id": "mentura", "term": "software system", "also": ["platform"], "level": "context", "says": "The platform: hosted, with accounts and named vendors (EE-041). Gets its own architecture record; shown here collapsed."})
+for cid, kind, says, rx, sysid in CONT:
+    paths = [p for p, c in fileCont.items() if c == cid]
+    if cid == "lean-proofs": paths = []
+    e = {"id": cid, "term": "data store" if kind == "data store" else "container", "note": kind if "(" in kind else None, "level": "container", "part_of": sysid, "says": says,
+         "derived": facts(paths) if paths else None, "depends_on": deps(cid, fileCont)}
+    elements.append(e)
+for cid, says, _ in COMP:
+    paths = [p for p, c in fileComp.items() if c == cid]
+    elements.append({"id": cid, "term": "component", "level": "component", "part_of": "naive-core", "says": says, "derived": facts(paths), "depends_on": deps(cid, fileComp),
+                     "kernels": [{"id": k, "term": "module", "role": v, "lines": F[k]['lines']} for k, v in kern.items() if fileComp.get(k) == cid]})
+uses = [("founder", "naive-cli", "runs commands"), ("founder", "dev-server", "sets up a venture"), ("founder", "claude-code", "works with an agent"),
+        ("claude-code", "mcp-server", "calls tools"), ("cursor", "naive-cli", "runs commands"), ("grokbot", "mcp-server", "calls tools (if configured)"), ("terminal", "naive-cli", "runs commands"),
+        ("naive-cli", "naive-core", "loads"), ("mcp-server", "naive-core", "loads"), ("local-api", "naive-core", "loads"), ("dev-server", "naive-core", "loads"), ("agent-harness", "naive-core", "loads"),
+        ("naive-core", "venture-workspace", "reads and writes records"), ("generator-cli", "venture-workspace", "creates"),
+        ("agent-harness", "jev", "scores site pages (through Mentura scripts)"), ("console-app", "vercel", "deployed on"), ("integrations", "rho", "syncs"), ("integrations", "github", "reads records"),
+        ("research-mcp", "firecrawl", "searches"), ("test-suite", "naive-core", "checks"), ("tla-models", "naive-core", "models"), ("lean-proofs", "naive-core", "proves claims about")]
+rec = {"id": "naive", "record": "architecture record", "standard": "ISO/IEC/IEEE 42010; levels from the C4 model", "status": "draft", "confirmed": False, "drafted_by": "agent",
+       "root": "naive", "derived_at": {"commit": d['head']},
+       "elements": elements, "relations": [{"from": a, "to": b, "says": s} for a, b, s in uses],
+       "unplaced": unplaced,
+       "views": [{"id": "architecture-map", "url": "https://claude.ai/artifact/PpxtxLtjCkomM8NSN6woVj"}, {"id": "dependency-map", "url": "https://claude.ai/artifact/NNcyZWNPS4dDiuA3akVQZ6"}],
+       "vocabulary": "prototypes/architecture/vocabulary.ts"}
+# A8: derived facts never overwrite declared content. Keep declared sections, and declared (non-derived) elements and relations.
+import os
+P = '/mnt/project-files/naive-design/architecture/naive.architecture.json'
+if os.path.exists(P):
+    old = json.load(open(P))
+    for k in ("needs", "requirements", "constraints", "behaviours", "change_rules", "amendment_log", "checks"):
+        if k in old: rec[k] = old[k]
+    ids = {e["id"] for e in rec["elements"]}
+    oldE = {e["id"]: e for e in old.get("elements", [])}
+    for e in rec["elements"]:
+        if e["id"] in oldE and "status" in oldE[e["id"]]: e["status"] = oldE[e["id"]]["status"]
+    rec["elements"] += [e for e in old.get("elements", []) if e.get("declared") and e["id"] not in ids]
+    rec["relations"] += [r for r in old.get("relations", []) if r.get("declared")]
+s = json.dumps(rec, indent=1)
+open(P, 'w').write(s)
+print(len(elements), "elements;", len(unplaced), "unplaced:", unplaced[:40])
+print({c[0]: facts([p for p, x in fileComp.items() if x == c[0]])['modules'] for c in COMP})
