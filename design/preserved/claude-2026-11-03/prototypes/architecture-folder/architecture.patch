+// Our verbs, and supplier as a class (Torian, 2026-11-01 06:13Z: "a drawing of a building is not a blueprint";
+// "the person I'm hiring is the supplier of those skills"; verbs need fixed meanings so commands are understood).
+//   node verbs-vocab.ts
+import { freeze, passSet, relation, run, validTest, type Base, type Relation, type Term } from "/home/user/ee-build/schema/terms/engine.ts";
+type P<F> = [string, string, (f: F) => boolean][];
+const mk = <F extends Base>(level: string, kind: string, form: string) => (id: string, label: string, meaning: string, sources: string[], props: P<F>, predicts?: Record<string, Relation>): Term<F> =>
+  ({ id, label, level, kind, form, meaning, sources, predicts, props: props.map(([pid, says, check]) => ({ id: pid, says, check })) } as Term<F>);
+
+// ---------- level 1: one act of work on a system ----------
+export type Act = Base & {
+  showsIntent: boolean;     // produces a picture or prose of what is wanted
+  decidesStructure: boolean;// decides elements and how they relate
+  writesRecord: boolean;    // the output is written into a record (not only prose)
+  checkable: boolean;       // the output can be checked by a test that can fail
+  buildable: boolean;       // detailed enough to implement one part without further structural decisions
+  runsCode: boolean;        // produces running code
+  inProduct: boolean;       // that code ships in the product (not a sandbox)
+  checksAgainst: boolean;   // compares something with a record and reports pass/fail
+  machineProof: boolean;    // a proof checker accepts it
+  personConfirms: boolean;  // a person confirms it meets the need
+  changesExisting: boolean; // alters or removes something already in a record
+  addsNew: boolean;         // adds something new to a record
+};
+const V = mk<Act>("act", "act", "verb");
+export const VERBS: Term<Act>[] = [
+  V("sketch", "sketch (draw)", "Show what is wanted, in pictures or prose, without fixing anything that a test could check. A drawing of a building.",
+    ["Torian 06:13Z; AIA schematic design (not opened)"],
+    [["SK1", "shows intent", (f) => f.showsIntent], ["SK2", "not checkable", (f) => !f.checkable]],
+    { architect: "disjoint", design: "overlap" }),
+  V("design", "design (systems design)", "Decide a system's structure: which elements, and how they relate. The umbrella activity; it may stay in prose.",
+    ["DECIDED 2026-10-31 22:07Z: 'systems design' = the activity and its docs"],
+    [["DE1", "decides structure", (f) => f.decidesStructure]],
+    { architect: "has_a_kind", "detail-design": "has_a_kind", sketch: "overlap" }),
+  V("architect", "architect (blueprint)", "Write the structure into the architecture record, in a form checks can run against. A blueprint of a building.",
+    ["ISO/IEC/IEEE 42010 architecture description; ISO/IEC/IEEE 12207 architecture definition (not opened)"],
+    [["DE1", "decides structure", (f) => f.decidesStructure], ["AR1", "writes the record", (f) => f.writesRecord], ["AR2", "checkable", (f) => f.checkable]],
+    { design: "is_a", sketch: "disjoint", "detail-design": "overlap" }),
+  V("detail-design", "design a part (detailed design)", "Detail one part until it can be built without further structural decisions. ISO 12207's design definition, which comes after architecture definition.",
+    ["ISO/IEC/IEEE 12207 design definition process (not opened)"],
+    [["DE1", "decides structure", (f) => f.decidesStructure], ["DD1", "buildable", (f) => f.buildable]],
+    { design: "is_a", architect: "overlap" }),
+  V("prototype", "prototype", "Run code to learn, outside the product.",
+    ["general usage"],
+    [["PR1", "runs code", (f) => f.runsCode], ["PR2", "not in the product", (f) => !f.inProduct]],
+    { build: "disjoint" }),
+  V("build", "build (implement)", "Write code that ships in the product.",
+    ["ISO/IEC/IEEE 12207 implementation process (not opened)"],
+    [["PR1", "runs code", (f) => f.runsCode], ["BU1", "in the product", (f) => f.inProduct]],
+    { prototype: "disjoint" }),
+  V("verify", "verify", "Check something against its record and report pass or fail.",
+    ["ISO/IEC/IEEE 12207 verification: built right (not opened)"],
+    [["VE1", "checks against a record", (f) => f.checksAgainst]],
+    { prove: "overlap", validate: "overlap" }),
+  V("prove", "prove", "Give a proof a machine checker accepts (Lean).",
+    ["ours: Lean, core only"],
+    [["PV1", "machine-checked proof", (f) => f.machineProof]],
+    { verify: "overlap" }),
+  V("validate", "validate", "A person confirms it meets the need: the right thing was built.",
+    ["ISO/IEC/IEEE 12207 validation (not opened); ours: validation = person"],
+    [["VA1", "a person confirms", (f) => f.personConfirms]],
+    { verify: "overlap" }),
+  V("amend", "amend", "Change or remove something already in a record. Needs a decision, keeps the old version, re-runs the checks.",
+    ["ours; cf. constitutional amendment"],
+    [["AM1", "writes the record", (f) => f.writesRecord], ["AM2", "changes what exists", (f) => f.changesExisting]],
+    { append: "disjoint" }),
+  V("append", "append", "Add to a record without changing anything already in it. Needs only the checks to pass.",
+    ["ours; cf. append-only log"],
+    [["AM1", "writes the record", (f) => f.writesRecord], ["AP1", "adds new", (f) => f.addsNew], ["AP2", "changes nothing existing", (f) => !f.changesExisting]],
+    { amend: "disjoint", architect: "overlap" }),
+];
+
+// ---------- level 2: a party in relation to one of our needs ----------
+export type Party = Base & {
+  providesInput: boolean;   // supplies something we use to make our products (goods, services, skills, labour)
+  engaged: boolean;         // is supplying it now
+  commercial: boolean;      // under a commercial contract (sale, licence, services)
+  employment: boolean;      // under employment
+  assessed: boolean;        // has been assessed against the identity of the need
+  matches: boolean;         // the assessment found a match
+};
+const S = mk<Party>("party to a need", "role", "noun");
+export const SUPPLY: Term<Party>[] = [
+  S("supplier", "supplier (value net)", "Anyone who provides an input we use, now: vendors, contractors and employees alike. Supplier is a class; the input decides its kind.",
+    ["Brandenburger and Nalebuff, Co-opetition (1996): suppliers include employees (from memory, not opened)"],
+    [["SU1", "provides an input", (f) => f.providesInput], ["SU2", "engaged now", (f) => f.engaged]],
+    { vendor: "has_a_kind", employee: "has_a_kind", "prospect-supplier": "disjoint" }),
+  S("vendor", "vendor (procurement)", "A supplier under a commercial contract. Procurement's and legal's sense; it excludes employees.",
+    ["procurement usage; roles prototype (employee vs contractor tests)"],
+    [["SU1", "provides an input", (f) => f.providesInput], ["SU2", "engaged", (f) => f.engaged], ["VN1", "commercial contract", (f) => f.commercial], ["VN2", "not employment", (f) => !f.employment]],
+    { supplier: "is_a", employee: "disjoint" }),
+  S("employee", "employee", "A supplier of skills and labour under employment.",
+    ["IRS common-law test / ABC test (roles prototype)"],
+    [["SU1", "provides an input", (f) => f.providesInput], ["SU2", "engaged", (f) => f.engaged], ["EM1", "employment", (f) => f.employment]],
+    { supplier: "is_a", vendor: "disjoint" }),
+  S("lead", "lead", "A party that might meet a need, not yet assessed against its identity.",
+    ["sales usage: unqualified prospect"],
+    [["LD1", "not engaged", (f) => !f.engaged], ["LD2", "not assessed", (f) => !f.assessed]],
+    { "prospect-supplier": "disjoint" }),
+  S("prospect-supplier", "prospective supplier", "Assessed against the identity of a need and found to match; not yet engaged.",
+    ["procurement usage: shortlisted supplier"],
+    [["PS1", "provides the input (could)", (f) => f.providesInput], ["PS2", "not engaged", (f) => !f.engaged], ["PS3", "assessed", (f) => f.assessed], ["PS4", "matches", (f) => f.matches]],
+    { candidate: "has_a_kind", lead: "disjoint", supplier: "disjoint" }),
+  S("candidate", "candidate", "A prospective supplier of skills who would be engaged by employment.",
+    ["hiring usage"],
+    [["PS1", "provides the input (could)", (f) => f.providesInput], ["PS2", "not engaged", (f) => !f.engaged], ["PS3", "assessed", (f) => f.assessed], ["PS4", "matches", (f) => f.matches], ["EM1", "would be employment", (f) => f.employment]],
+    { "prospect-supplier": "is_a" }),
+];
+
+function cases<F extends Base>(keys: readonly string[], label: string): F[] {
+  const out: F[] = [];
+  for (let m = 0; m < 2 ** (keys.length + 1); m++) { const f = { confirmed: Boolean(m & 1), label: [label, undefined][m % 2] } as F; keys.forEach((k, i) => { (f as Record<string, unknown>)[k] = Boolean(m & (2 << i)); }); out.push(f); }
+  return out;
+}
+function level<F extends Base>(name: string, vocab: Term<F>[], cs: F[]) {
+  const sets = new Map(vocab.map((t) => [t.id, passSet(t, cs)])); let ok = 0, n = 0;
+  console.log(`== ${name}: ${cs.length} cases`);
+  for (const t of vocab) { const v = validTest(t, cs); console.log(`${t.id.padEnd(18)} ${freeze(t)} ${v.length ? v.join("; ") : "valid"}`); }
+  for (const a of vocab) for (const [o, w] of Object.entries(a.predicts ?? {})) { n++; const g = relation(sets.get(a.id)!, sets.get(o)!); if (g === w) ok++; console.log(`${a.id} ~ ${o}: predicted ${w}, got ${g} -> ${g === w ? "confirmed" : "REFUTED"}`); }
+  console.log(`${ok}/${n} predictions confirmed\n`);
+}
+if (import.meta.url === `file://${process.argv[1]}`) {
+  level("act", VERBS, cases<Act>(["showsIntent", "decidesStructure", "writesRecord", "checkable", "buildable", "runsCode", "inProduct", "checksAgainst", "machineProof", "personConfirms", "changesExisting", "addsNew"], "design"));
+  level("party to a need", SUPPLY, cases<Party>(["providesInput", "engaged", "commercial", "employment", "assessed", "matches"], "supplier"));
+  const b = Object.fromEntries(["showsIntent", "decidesStructure", "writesRecord", "checkable", "buildable", "runsCode", "inProduct", "checksAgainst", "machineProof", "personConfirms", "changesExisting", "addsNew"].map((k) => [k, false]));
+  const ex: [string, Record<string, boolean>][] = [
+    ["Today's docs (precog, identity): proposed prose with diagrams", { showsIntent: true, decidesStructure: true }],
+    ["Today's prototypes (vocab runs, gate.ts)", { runsCode: true, checksAgainst: true }],
+    ["Adding the library to naive.architecture.json, with checks", { decidesStructure: true, writesRecord: true, checkable: true, addsNew: true }],
+    ["Changing 'identity' from ambitions to purpose in the record", { decidesStructure: true, writesRecord: true, checkable: true, changesExisting: true }],
+  ];
+  console.log("== examples (act)");
+  for (const [nm, fx] of ex) console.log(`${nm.padEnd(62)} ${VERBS.filter((t) => run(t, { confirmed: true, ...b, ...fx } as Act).pass).map((t) => t.id).join(", ")}`);
+}
