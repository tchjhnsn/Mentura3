@@ -0,0 +1,37 @@
+/- Venture relationships on the value net (2026-11-01). Mirrors relation-vocab.ts. Core Lean only.
+   Written in the AI-labs thread; built by the phases thread. -/
+namespace Naive.Relation
+
+structure Pair where
+  aBuysFromB : Bool
+  bBuysFromA : Bool
+  sameJobSameCustomers : Bool
+  raisesValue : Bool
+  sameScarceInput : Bool
+  processesAData : Bool
+
+def Supplier (p : Pair) : Prop := p.aBuysFromB = true
+def SubProcessor (p : Pair) : Prop := Supplier p ∧ p.processesAData = true
+def DemandCompetitor (p : Pair) : Prop := p.sameJobSameCustomers = true
+def SupplyCompetitor (p : Pair) : Prop := p.sameScarceInput = true
+def NotACompetitor (p : Pair) : Prop := p.sameJobSameCustomers = false ∧ p.sameScarceInput = false
+
+theorem sub_processor_is_supplier {p : Pair} (h : SubProcessor p) : Supplier p := h.1
+
+theorem not_competitor_excludes_demand {p : Pair} (hn : NotACompetitor p) (hd : DemandCompetitor p) : False := by
+  have a := hn.1
+  have b : p.sameJobSameCustomers = true := hd
+  rw [a] at b
+  exact Bool.noConfusion b
+
+theorem not_competitor_excludes_supply {p : Pair} (hn : NotACompetitor p) (hs : SupplyCompetitor p) : False := by
+  have a := hn.2
+  have b : p.sameScarceInput = true := hs
+  rw [a] at b
+  exact Bool.noConfusion b
+
+/-- Being a supplier proves nothing about competing: a supplier can also be a competitor (co-opetition). -/
+theorem supplier_can_compete : ∃ p : Pair, Supplier p ∧ DemandCompetitor p :=
+  ⟨⟨true, false, true, false, false, false⟩, rfl, rfl⟩
+
+end Naive.Relation
diff --git a/project-files/naive-design/prototypes/architecture/Representation.lean b/project-files/naive-design/prototypes/architecture/Representation.lean
new file mode 100644
index 0000000..1abf5a6
--- /dev/null
+++ b/project-files/naive-design/prototypes/architecture/Representation.lean
@@ -0,0 +1,40 @@
+/- Knowledge-representation terms and Naive's homonyms (2026-11-01). Mirrors representation-vocab.ts. Core Lean only. -/
+namespace Naive.Representation
+
+structure Rep where
+  worldKnowledge : Bool
+  slots : Bool
+  defaults : Bool
+  stereotyped : Bool
+  eventSequence : Bool
+  nodesEdges : Bool
+  primitives : Bool
+  conditionAction : Bool
+  constrains : Bool
+  executable : Bool
+
+def Knowledge (r : Rep) : Prop := r.worldKnowledge = true ∧ r.executable = false
+def DataSchema (r : Rep) : Prop := r.constrains = true ∧ r.slots = true ∧ r.executable = false
+def CognitiveSchema (r : Rep) : Prop := Knowledge r ∧ r.slots = true ∧ r.defaults = true
+def Frame (r : Rep) : Prop := CognitiveSchema r ∧ r.stereotyped = true
+def Script (r : Rep) : Prop := Frame r ∧ r.eventSequence = true
+def ProgramScript (r : Rep) : Prop := r.executable = true
+def ProductionSystem (r : Rep) : Prop := r.conditionAction = true ∧ r.executable = true
+
+theorem frame_is_cognitive_schema {r : Rep} (h : Frame r) : CognitiveSchema r := h.1
+theorem script_is_frame {r : Rep} (h : Script r) : Frame r := h.1
+theorem production_is_program {r : Rep} (h : ProductionSystem r) : ProgramScript r := h.2
+/-- "script" is a homonym: the knowledge script never runs, the program script always does. -/
+theorem scripts_disjoint {r : Rep} (s : Script r) (p : ProgramScript r) : False := by
+  unfold Script Frame CognitiveSchema Knowledge at s; unfold ProgramScript at p; simp_all
+/-- "schema" is a homonym only partly: a data schema is never a program. -/
+theorem data_schema_not_program {r : Rep} (d : DataSchema r) (p : ProgramScript r) : False := by
+  unfold DataSchema at d; unfold ProgramScript at p; simp_all
+/-- ... but a data schema and a cognitive schema overlap (a frame record can be both). -/
+def frameRecord : Rep := ⟨true, true, true, true, false, false, false, false, true, false⟩
+def plainSchema : Rep := ⟨false, true, false, false, false, false, false, false, true, false⟩
+theorem schemas_overlap :
+    (DataSchema frameRecord ∧ CognitiveSchema frameRecord) ∧ (DataSchema plainSchema ∧ ¬ CognitiveSchema plainSchema) := by
+  simp [DataSchema, CognitiveSchema, Knowledge, frameRecord, plainSchema]
+
+end Naive.Representation
diff --git a/project-files/naive-design/prototypes/architecture/Research.lean b/project-files/naive-design/prototypes/architecture/Research.lean
new file mode 100644
index 0000000..d1ee812
--- /dev/null
+++ b/project-files/naive-design/prototypes/architecture/Research.lean
@@ -0,0 +1,71 @@
+/- Research terms (2026-11-01): researches vs capabilities, AI lab vs applied AI company, Kautz neuro-symbolic types.
+   Mirrors research-vocab.ts. Core Lean only. Written in the AI-labs thread; built by the phases thread. -/
+namespace Naive.Research
+
+structure Link where
+  doesResearch : Bool
+  productOffers : Bool
+  viaSupplier : Bool
+  usesPlatform : Bool
+
+def Researches (l : Link) : Prop := l.doesResearch = true
+def Offers (l : Link) : Prop := l.productOffers = true
+def Own (l : Link) : Prop := Offers l ∧ l.viaSupplier = false ∧ Researches l
+def Supplied (l : Link) : Prop := Offers l ∧ l.viaSupplier = true
+def DependsOnPlatform (l : Link) : Prop := l.usesPlatform = true ∧ l.doesResearch = false
+
+theorem own_is_research {l : Link} (h : Own l) : Researches l := h.2.2
+theorem supplied_is_offer {l : Link} (h : Supplied l) : Offers l := h.1
+theorem own_not_supplied {l : Link} (ho : Own l) (hs : Supplied l) : False := by
+  have a := ho.2.1
+  have b := hs.2
+  rw [a] at b
+  exact Bool.noConfusion b
+/-- Using a platform for an area is not researching it. -/
+theorem platform_not_research {l : Link} (hd : DependsOnPlatform l) (hr : Researches l) : False := by
+  have a := hd.2
+  have b : l.doesResearch = true := hr
+  rw [a] at b
+  exact Bool.noConfusion b
+/-- A product can offer a capability the venture does not research (Claude's voice mode). -/
+theorem offer_without_research : ∃ l : Link, Supplied l ∧ ¬ Researches l :=
+  ⟨⟨false, true, true, false⟩, ⟨rfl, rfl⟩, fun h => Bool.noConfusion h⟩
+
+structure Org where
+  researchIsMain : Bool
+  publishes : Bool
+  trainsModels : Bool
+  frontierScale : Bool
+  sellsProducts : Bool
+
+def AILab (o : Org) : Prop := o.researchIsMain = true ∧ o.publishes = true
+def FrontierLab (o : Org) : Prop := AILab o ∧ o.trainsModels = true ∧ o.frontierScale = true
+def AppliedAI (o : Org) : Prop := o.sellsProducts = true ∧ o.researchIsMain = false
+
+theorem frontier_is_lab {o : Org} (h : FrontierLab o) : AILab o := h.1
+theorem lab_not_applied {o : Org} (hl : AILab o) (ha : AppliedAI o) : False := by
+  have a := hl.1
+  have b := ha.2
+  rw [a] at b
+  exact Bool.noConfusion b
+
+structure NS where
+  neuralPart : Bool
+  symbolicPart : Bool
+  symbolicCallsNeural : Bool
+  neuralCallsSymbolic : Bool
+  pipeline : Bool
+
+def Both (s : NS) : Prop := s.neuralPart = true ∧ s.symbolicPart = true
+def Type2 (s : NS) : Prop := Both s ∧ s.symbolicCallsNeural = true ∧ s.neuralCallsSymbolic = false
+def Type3 (s : NS) : Prop := Both s ∧ s.pipeline = true
+def Type6 (s : NS) : Prop := Both s ∧ s.neuralCallsSymbolic = true ∧ s.symbolicCallsNeural = false
+
+/-- Who is in charge separates Type 2 (symbolic calls the model) from Type 6 (the model calls symbols). -/
+theorem type2_not_type6 {s : NS} (h2 : Type2 s) (h6 : Type6 s) : False := by
+  have a := h2.2.1
+  have b := h6.2.2
+  rw [a] at b
+  exact Bool.noConfusion b
+
+end Naive.Research
diff --git a/project-files/naive-design/prototypes/architecture/S1.lean b/project-files/naive-design/prototypes/architecture/S1.lean
new file mode 100644
index 0000000..19c10ad
--- /dev/null
+++ b/project-files/naive-design/prototypes/architecture/S1.lean
@@ -0,0 +1,52 @@
+/- Terms from Anthropic's S-1 (2026-10-26) against ours (proposed, 2026-11-01). Mirrors s1-vocab.ts: the same
+   facts, so a theorem here and a cross-run there say the same thing. -/
+namespace Naive.Stack
+
+structure Stack where
+  isModel : Bool
+  wrapsModel : Bool
+  runsAgentLoop : Bool
+  personWorksThrough : Bool
+  reachesMostLayers : Bool
+  offersPrimitives : Bool
+  othersBuildOn : Bool
+  endUserProduct : Bool
+
+def IsModel (s : Stack) : Prop := s.isModel = true ∧ s.wrapsModel = false
+/-- Ours (EE-093). -/
+def IsHarness (s : Stack) : Prop := s.personWorksThrough = true ∧ s.reachesMostLayers = true
+/-- The S-1's. -/
+def IsHarnessS1 (s : Stack) : Prop := s.wrapsModel = true
+def IsAgentHarness (s : Stack) : Prop := IsHarnessS1 s ∧ s.runsAgentLoop = true ∧ s.personWorksThrough = true
+def IsPlatform (s : Stack) : Prop := s.othersBuildOn = true
+def IsPlatformS1 (s : Stack) : Prop := s.offersPrimitives = true ∧ IsPlatform s ∧ s.isModel = false
+def IsApplication (s : Stack) : Prop := s.endUserProduct = true ∧ s.personWorksThrough = true ∧ s.isModel = false
+
+theorem agent_harness_is_s1_harness {s : Stack} (h : IsAgentHarness s) : IsHarnessS1 s := h.1
+theorem s1_platform_is_platform {s : Stack} (h : IsPlatformS1 s) : IsPlatform s := h.2.1
+theorem model_not_s1_harness {s : Stack} (m : IsModel s) : ¬ IsHarnessS1 s := by
+  intro h; have h1 := m.2; unfold IsHarnessS1 at h; rw [h1] at h; cases h
+theorem model_not_application {s : Stack} (m : IsModel s) : ¬ IsApplication s := by
+  intro a; have h1 := m.1; have h2 := a.2.2; rw [h1] at h2; cases h2
+
+/-- The finding: an agent harness is not always a harness in our sense. A coding agent used only on code is an
+    agent harness but reaches fewer than four layers, so the ontology's "the default kind of harness" is false. -/
+def codingAgentOnly : Stack := ⟨false, true, true, true, false, false, false, true⟩
+theorem agent_harness_not_always_ours : IsAgentHarness codingAgentOnly ∧ ¬ IsHarness codingAgentOnly :=
+  ⟨⟨rfl, rfl, rfl⟩, fun h => by cases h.2⟩
+
+/-- The S-1's harness and ours overlap: the Agent SDK is theirs and not ours (no person works through it). -/
+def agentSdk : Stack := ⟨false, true, true, false, false, true, true, false⟩
+def claudeCode : Stack := ⟨false, true, true, true, true, false, false, true⟩
+theorem harness_senses_overlap :
+    (IsHarnessS1 agentSdk ∧ ¬ IsHarness agentSdk) ∧ (IsHarnessS1 claudeCode ∧ IsHarness claudeCode) :=
+  ⟨⟨rfl, fun h => by cases h.1⟩, rfl, ⟨rfl, rfl⟩⟩
+
+/-- Decided 2026-11-01 (card): our sense is renamed workbench, a kind of the industry workbench; harness takes the S-1's sense. -/
+def IsWorkbench (s : Stack) : Prop := IsHarness s
+def IsWorkbenchIndustry (s : Stack) : Prop := s.personWorksThrough = true
+theorem workbench_is_industry_workbench {s : Stack} (h : IsWorkbench s) : IsWorkbenchIndustry s := h.1
+theorem workbench_and_harness_overlap :
+    (IsHarnessS1 agentSdk ∧ ¬ IsWorkbench agentSdk) ∧ (IsHarnessS1 claudeCode ∧ IsWorkbench claudeCode) := harness_senses_overlap
+
+end Naive.Stack
diff --git a/project-files/naive-design/prototypes/architecture/Stage.lean b/project-files/naive-design/prototypes/architecture/Stage.lean
new file mode 100644
index 0000000..5562a36
--- /dev/null
+++ b/project-files/naive-design/prototypes/architecture/Stage.lean
@@ -0,0 +1,72 @@
+/- The idea pipeline (2026-11-01, Torian 07:35Z). Mirrors stage.ts. Core Lean only; built by the phases thread. -/
+namespace Naive.Stage
+
+inductive Stage where
+  | captured | sketched | designed | architected | implemented | verified | proved | retired
+  deriving DecidableEq, Repr
+
+open Stage
+
+/-- The allowed moves: forward one gate at a time, a regression from verified to implemented, or retire. -/
+inductive Step : Stage → Stage → Prop where
+  | capture_sketch   : Step captured sketched
+  | sketch_design    : Step sketched designed
+  | design_architect : Step designed architected
+  | architect_build  : Step architected implemented
+  | build_verify     : Step implemented verified
+  | verify_prove     : Step verified proved
+  | regress          : Step verified implemented
+  | retire (s : Stage) : s ≠ retired → Step s retired
+
+/-- No skipping: nothing goes from an idea or a sketch straight to code. -/
+theorem no_sketch_to_code : ¬ Step sketched implemented := by intro h; cases h
+theorem no_idea_to_code : ¬ Step captured implemented := by intro h; cases h
+theorem no_design_to_code : ¬ Step designed implemented := by intro h; cases h
+/-- Code is only ever reached from the architecture record (or by a regression from verified). -/
+theorem code_only_from_record (s : Stage) : Step s implemented → s = architected ∨ s = verified := by
+  intro h; cases h
+  · exact Or.inl rfl
+  · exact Or.inr rfl
+/-- Retired is final. -/
+theorem retired_final (t : Stage) : ¬ Step retired t := by
+  intro h; cases h with
+  | retire _ hne => exact hne rfl
+
+structure Ev where
+  captured : Bool
+  drawn : Bool
+  termsAdmitted : Bool
+  traced : Bool
+  inRecord : Bool
+  recordChecks : Bool
+  codeExists : Bool
+  conforms : Bool
+  tested : Bool
+  proved : Bool
+  retired : Bool
+
+def IsSketched (e : Ev) : Prop := e.retired = false ∧ e.drawn = true ∧ (e.termsAdmitted && e.traced) = false ∧ e.inRecord = false ∧ e.codeExists = false
+def IsDesigned (e : Ev) : Prop := e.retired = false ∧ e.drawn = true ∧ e.termsAdmitted = true ∧ e.traced = true ∧ e.inRecord = false ∧ e.codeExists = false
+def IsArchitected (e : Ev) : Prop := e.retired = false ∧ e.inRecord = true ∧ e.recordChecks = true ∧ e.termsAdmitted = true ∧ e.traced = true ∧ e.codeExists = false
+def IsImplemented (e : Ev) : Prop := e.retired = false ∧ e.inRecord = true ∧ e.recordChecks = true ∧ e.codeExists = true ∧ (e.conforms && e.tested) = false
+def IsVerified (e : Ev) : Prop := e.retired = false ∧ e.inRecord = true ∧ e.recordChecks = true ∧ e.codeExists = true ∧ e.conforms = true ∧ e.tested = true ∧ e.proved = false
+
+theorem sketched_not_designed (e : Ev) : IsSketched e → ¬ IsDesigned e := by
+  intro ⟨_, _, h, _, _⟩ ⟨_, _, ht, htr, _, _⟩
+  rw [ht, htr] at h; simp at h
+theorem designed_not_architected (e : Ev) : IsDesigned e → ¬ IsArchitected e := by
+  intro ⟨_, _, _, _, hr, _⟩ ⟨_, hr', _⟩
+  rw [hr] at hr'; exact Bool.noConfusion hr'
+theorem architected_not_implemented (e : Ev) : IsArchitected e → ¬ IsImplemented e := by
+  intro ⟨_, _, _, _, _, hc⟩ ⟨_, _, _, hc', _⟩
+  rw [hc] at hc'; exact Bool.noConfusion hc'
+theorem implemented_not_verified (e : Ev) : IsImplemented e → ¬ IsVerified e := by
+  intro ⟨_, _, _, _, h⟩ ⟨_, _, _, _, hc, ht, _⟩
+  rw [hc, ht] at h; simp at h
+/-- SB1: anything below architected has no element in the record and no code: it is in the sandbox. -/
+theorem below_architected_is_sandboxed (e : Ev) : IsSketched e ∨ IsDesigned e → e.inRecord = false ∧ e.codeExists = false := by
+  intro h; cases h with
+  | inl h => exact ⟨h.2.2.2.1, h.2.2.2.2⟩
+  | inr h => exact ⟨h.2.2.2.2.1, h.2.2.2.2.2⟩
+
+end Naive.Stage
diff --git a/project-files/naive-design/prototypes/architecture/Structure.lean b/project-files/naive-design/prototypes/architecture/Structure.lean
new file mode 100644
index 0000000..d8889e7
--- /dev/null
+++ b/project-files/naive-design/prototypes/architecture/Structure.lean
@@ -0,0 +1,50 @@
+/-
+  The containment tree of an architecture record (proposed, 2026-10-31). `parent x = some p` means x is
+  directly part of p. Core Lean only.
+-/
+namespace Naive.Structure
+
+/-- `PartOf parent x y`: x is y, or x is part of y through a chain of parents (reflexive). -/
+inductive PartOf {α : Type} (parent : α → Option α) : α → α → Prop
+  | refl (x) : PartOf parent x x
+  | up {x p y} : parent x = some p → PartOf parent p y → PartOf parent x y
+
+/-- A root: no parent, and every element is part of it. -/
+def IsRoot {α : Type} (parent : α → Option α) (r : α) : Prop :=
+  parent r = none ∧ ∀ x, PartOf parent x r
+
+/-- If x has no parent, the only thing x is part of is x itself. -/
+theorem partOf_of_no_parent {α : Type} {parent : α → Option α} {x y : α}
+    (h : parent x = none) (hp : PartOf parent x y) : x = y := by
+  cases hp with
+  | refl => rfl
+  | up e _ => rw [h] at e; cases e
+
+/-- A hierarchy has at most one root. So "the root of the architecture record" names exactly one element,
+    the software system, and two records claiming different roots for one hierarchy can't both be right. -/
+theorem root_unique {α : Type} {parent : α → Option α} {r₁ r₂ : α}
+    (h₁ : IsRoot parent r₁) (h₂ : IsRoot parent r₂) : r₁ = r₂ :=
+  partOf_of_no_parent h₁.1 (h₂.2 r₁)
+
+/-- The C4 levels as properties: a container runs or stores separately, a component does not. -/
+structure LevelFacts where
+  runsOrStoresSeparately : Bool
+  groupsBehindContract   : Bool
+  singleSourceUnit       : Bool
+
+def isContainer (f : LevelFacts) : Prop := f.runsOrStoresSeparately = true ∧ f.singleSourceUnit = false
+def isComponent (f : LevelFacts) : Prop :=
+  f.runsOrStoresSeparately = false ∧ f.groupsBehindContract = true ∧ f.singleSourceUnit = false
+def isModule (f : LevelFacts) : Prop := f.singleSourceUnit = true
+
+/-- No element is both a container and a component, or a component and a module: levels never blur. -/
+theorem container_not_component (f : LevelFacts) : ¬ (isContainer f ∧ isComponent f) := by
+  intro ⟨⟨h1, _⟩, ⟨h2, _⟩⟩; rw [h1] at h2; cases h2
+
+theorem component_not_module (f : LevelFacts) : ¬ (isComponent f ∧ isModule f) := by
+  intro ⟨⟨_, _, h1⟩, h2⟩; unfold isModule at h2; rw [h1] at h2; cases h2
+
+theorem container_not_module (f : LevelFacts) : ¬ (isContainer f ∧ isModule f) := by
+  intro ⟨⟨_, h1⟩, h2⟩; unfold isModule at h2; rw [h1] at h2; cases h2
+
+end Naive.Structure
diff --git a/project-files/naive-design/prototypes/architecture/Trace.lean b/project-files/naive-design/prototypes/architecture/Trace.lean
new file mode 100644
index 0000000..3caf40d
--- /dev/null
+++ b/project-files/naive-design/prototypes/architecture/Trace.lean
@@ -0,0 +1,24 @@
+/-
+  Traceability (proposed, 2026-10-31). Elements satisfy requirements; requirements derive from goals.
+  If both links are total, every element traces to a goal. Non-goals are never traced to.
+-/
+namespace Naive.Trace
+
+variable {Elem Req Goal : Type}
+
+/-- Every element satisfies some requirement and every requirement derives from some goal: then every
+    element serves some goal. This is what check A1-plus-traceability buys. -/
+theorem element_traces_to_goal (satisfies : Elem → Req → Prop) (derives : Req → Goal → Prop)
+    (h1 : ∀ e, ∃ r, satisfies e r) (h2 : ∀ r, ∃ g, derives r g) (e : Elem) :
+    ∃ r g, satisfies e r ∧ derives r g := by
+  obtain ⟨r, hr⟩ := h1 e
+  obtain ⟨g, hg⟩ := h2 r
+  exact ⟨r, g, hr, hg⟩
+
+/-- If requirements only derive from committed goals, nothing built can trace to a non-goal. -/
+theorem nothing_serves_a_nongoal (satisfies : Elem → Req → Prop) (derives : Req → Goal → Prop)
+    (committed : Goal → Prop) (h : ∀ r g, derives r g → committed g)
+    (e : Elem) (r : Req) (g : Goal) (hs : satisfies e r) (hd : derives r g) : committed g :=
+  let _ := hs; h r g hd
+
+end Naive.Trace
diff --git a/project-files/naive-design/prototypes/architecture/Verbs.lean b/project-files/naive-design/prototypes/architecture/Verbs.lean
new file mode 100644
index 0000000..7c35909
--- /dev/null
+++ b/project-files/naive-design/prototypes/architecture/Verbs.lean
@@ -0,0 +1,64 @@
+/- Our verbs and supplier as a class (2026-11-01). Mirrors verbs-vocab.ts. Core Lean only; built by the phases thread. -/
+namespace Naive.Verbs
+
+structure Act where
+  showsIntent : Bool
+  decidesStructure : Bool
+  writesRecord : Bool
+  checkable : Bool
+  changesExisting : Bool
+  addsNew : Bool
+
+def Sketch (a : Act) : Prop := a.showsIntent = true ∧ a.checkable = false
+def Design (a : Act) : Prop := a.decidesStructure = true
+def Architect (a : Act) : Prop := a.decidesStructure = true ∧ a.writesRecord = true ∧ a.checkable = true
+def Amend (a : Act) : Prop := a.writesRecord = true ∧ a.changesExisting = true
+def Append (a : Act) : Prop := a.writesRecord = true ∧ a.addsNew = true ∧ a.changesExisting = false
+
+theorem architect_is_design {a : Act} (h : Architect a) : Design a := h.1
+/-- A drawing is not a blueprint. -/
+theorem sketch_not_architect {a : Act} (s : Sketch a) (h : Architect a) : False := by
+  have x := s.2
+  have y := h.2.2
+  rw [x] at y
+  exact Bool.noConfusion y
+theorem append_not_amend {a : Act} (p : Append a) (m : Amend a) : False := by
+  have x := p.2.2
+  have y := m.2
+  rw [x] at y
+  exact Bool.noConfusion y
+/-- Architecting can be an append (adding new elements with checks). -/
+theorem architect_by_append : ∃ a : Act, Architect a ∧ Append a :=
+  ⟨⟨false, true, true, true, false, true⟩, ⟨rfl, rfl, rfl⟩, ⟨rfl, rfl, rfl⟩⟩
+
+structure Party where
+  providesInput : Bool
+  engaged : Bool
+  commercial : Bool
+  employment : Bool
+  assessed : Bool
+  matchesNeed : Bool  -- `matches` is a Lean keyword
+
+def Supplier (p : Party) : Prop := p.providesInput = true ∧ p.engaged = true
+def Vendor (p : Party) : Prop := Supplier p ∧ p.commercial = true ∧ p.employment = false
+def Employee (p : Party) : Prop := Supplier p ∧ p.employment = true
+def Lead (p : Party) : Prop := p.engaged = false ∧ p.assessed = false
+def Prospect (p : Party) : Prop := p.providesInput = true ∧ p.engaged = false ∧ p.assessed = true ∧ p.matchesNeed = true
+def Candidate (p : Party) : Prop := Prospect p ∧ p.employment = true
+
+/-- In the value-net sense an employee is a supplier. -/
+theorem employee_is_supplier {p : Party} (h : Employee p) : Supplier p := h.1
+/-- In procurement's sense an employee is never a vendor. -/
+theorem vendor_not_employee {p : Party} (v : Vendor p) (e : Employee p) : False := by
+  have x := v.2.2
+  have y := e.2
+  rw [x] at y
+  exact Bool.noConfusion y
+theorem candidate_is_prospect {p : Party} (h : Candidate p) : Prospect p := h.1
+theorem lead_not_prospect {p : Party} (l : Lead p) (q : Prospect p) : False := by
+  have x := l.2
+  have y := q.2.2.1
+  rw [x] at y
+  exact Bool.noConfusion y
+
+end Naive.Verbs
