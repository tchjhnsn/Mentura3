+      if (s.startsWith(".")) { const r = resolve(p, s, files); if (r) imports.push(r); }
+      else if (s.startsWith("node:")) builtins.push(s);
+      else if (!s.startsWith("@/")) external.push(s.startsWith("@") ? s.split("/").slice(0, 2).join("/") : s.split("/")[0]);
+    }
+    const effects = new Set(specs.map((s) => EFFECT_MODULES[s]).filter(Boolean));
+    if (/\bfetch\(/.test(t)) effects.add("network");
+    if (/process\.(env|argv|exit|cwd)/.test(t)) effects.add("process");
+    if (/Date\.now\(|new Date\(\)/.test(t)) effects.add("clock");
+    if (/Math\.random\(/.test(t)) effects.add("randomness");
+    const base = p.replace(SRC, "");
+    const short = base.split("/").pop()!;
+    facts.push({
+      path: p, component: component(p), lines: t.split("\n").length,
+      imports: [...new Set(imports)], external: [...new Set(external)], builtins: [...new Set(builtins)], effects: [...effects].sort(),
+      rulesAsInput: /export (?:async )?function \w+\s*(?:<[^>]*>)?\s*\([^)]*\b(rules?|terms?|props|checks?|pool)\b/.test(t) || /export (?:async )?function \w+<F[^>]*>\(\s*t: Term/.test(t),
+      verdictWithReasons: /\b(failed|reasons|breaks|why)\b/.test(t),
+      domainRefs: (t.match(/\.schema\.json|routes\(\)|venture\.json|foundation\//g) ?? []).length,
+      tested: [...text.entries()].some(([q, u]) => q !== p && /(-test\.|\/test\.|\.test\.)/.test(q) && (u.includes(`${short}.`) || u.includes(`/${short}"`))) || testMjs.includes(p),
+      modeled: tla.filter(([, u]) => u.includes(short)).map(([q]) => q),
+      proved: lean.filter(([, u]) => u.includes(p) || u.includes(`${short}.ts`) || u.includes(`${short}.mjs`)).map(([q]) => q),
+    });
+  }
+  // dependents and cycles
+  const fanIn = new Map<string, number>(src.map((p) => [p, 0]));
+  for (const f of facts) for (const i of f.imports) fanIn.set(i, (fanIn.get(i) ?? 0) + 1);
+  const cycles = scc(facts).filter((c) => c.length > 1);
+  return { files: facts.map((f) => ({ ...f, fanIn: fanIn.get(f.path) ?? 0 })), cycles };
+}
+
+/** Tarjan's strongly connected components over the import graph. */
+function scc(facts: FileFacts[]): string[][] {
+  const adj = new Map(facts.map((f) => [f.path, f.imports]));
+  let i = 0; const idx = new Map<string, number>(), low = new Map<string, number>(), on = new Set<string>(), st: string[] = [], out: string[][] = [];
+  const go = (v: string) => {
+    idx.set(v, i); low.set(v, i); i++; st.push(v); on.add(v);
+    for (const w of adj.get(v) ?? []) {
+      if (!idx.has(w)) { go(w); low.set(v, Math.min(low.get(v)!, low.get(w)!)); }
+      else if (on.has(w)) low.set(v, Math.min(low.get(v)!, idx.get(w)!));
+    }
+    if (low.get(v) === idx.get(v)) { const c: string[] = []; let w; do { w = st.pop()!; on.delete(w); c.push(w); } while (w !== v); out.push(c); }
+  };
+  for (const v of adj.keys()) if (!idx.has(v)) go(v);
+  return out;
+}
+
+/** What the layer manifests declare versus what the code has. */
+export function drift(repo: string, files: { path: string }[]) {
+  const paths = new Set(files.map((f) => f.path));
+  const declared: { layer: string; path: string; as: string }[] = [];
+  for (const m of execFileSync("git", ["-C", repo, "ls-files", "*/layer.json"], { encoding: "utf8" }).split("\n").filter(Boolean)) {
+    const d = JSON.parse(readFileSync(join(repo, m), "utf8"));
+    for (const c of d.checks ?? []) declared.push({ layer: d.layer, path: typeof c === "string" ? c : c.path, as: "check" });
+    for (const s of d.skills ?? []) declared.push({ layer: d.layer, path: typeof s === "string" ? s : s.path, as: "skill" });
+  }
+  const declaredPaths = new Set(declared.map((d) => d.path.split(" ")[0]));
+  return {
+    declaredButMissing: declared.filter((d) => !existsSync(join(repo, d.path.split(" ")[0]))),
+    builtButUndeclared: [...paths].filter((p) => !declaredPaths.has(p) && !/(-test|\/test)\.(mjs|ts)$/.test(p)).length,
+    declaredCount: declared.length,
+  };
+}
+
+if (import.meta.url === `file://${process.argv[1]}`) {
+  const repo = process.argv[2];
+  const oi = process.argv.indexOf("--out");
+  const out = oi > 0 ? process.argv[oi + 1] : dirname(new URL(import.meta.url).pathname);
+  mkdirSync(out, { recursive: true });
+  const built = derive(repo);
+  const head = execFileSync("git", ["-C", repo, "rev-parse", "--short", "HEAD"], { encoding: "utf8" }).trim();
+  writeFileSync(join(out, "as-built.json"), JSON.stringify({ repo: relative("/", repo), head, ...built }, null, 1));
+  writeFileSync(join(out, "drift.json"), JSON.stringify(drift(repo, built.files), null, 1));
+  console.log(`${built.files.length} files, ${built.files.reduce((n, f) => n + f.imports.length, 0)} internal edges, ${built.cycles.length} cycles, head ${head}`);
+}
