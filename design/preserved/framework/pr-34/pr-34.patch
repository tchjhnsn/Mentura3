+++ b/platform/agents/outreach/test.mjs
@@ -0,0 +1,37 @@
+#!/usr/bin/env node
+// Outreach agents, offline: stand-in agent and Jev, a temporary output folder, the code checks.
+import { mkdtempSync, readFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+
+const here = new URL(".", import.meta.url).pathname;
+process.env.FRAMES_AGENT_CMD = `node ${join(here, "fixtures/agent.mjs")}`;
+process.env.FRAMES_JEV_CMD = `node ${join(here, "fixtures/jev.mjs")}`;
+const { runOutreach, isProfile, NOTE_MAX } = await import("./run.mjs");
+
+let failed = 0;
+const expect = (what, ok) => { console.log(`${ok ? "pass" : "FAIL"}  ${what}`); if (!ok) failed++; };
+const facts = JSON.parse(readFileSync(join(here, "../frames/fixtures/facts.json"), "utf8"));
+const out = mkdtempSync(join(tmpdir(), "outreach-"));
+const { rows, feedback, trace } = await runOutreach({ facts, need: "whether they would fund growth while the founder keeps the final say over the product", out });
+const fb = Object.fromEntries(feedback.map((f) => [f.key, f.score]));
+
+expect("only linkedin.com/in/ profile URLs count as profiles", isProfile("https://www.linkedin.com/in/ada-example") && !isProfile("https://linkedin.com/company/bo") && !isProfile("https://example.com/in/x"));
+expect("an investor without evidence is dropped before Jev", !rows.some((r) => r.id === "no-evidence"));
+expect("an investor Jev judges not a fit is dropped", rows.length === 1 && rows[0].id === "ada-fund" && rows[0].fit === "fits");
+expect("the draft cites the investor's evidence and fits a LinkedIn note", fb.draft_cites_evidence === 1 && rows[0].draft.note.length <= NOTE_MAX && fb.note_fits_linkedin === 1);
+expect("nothing is sent", fb.founder_sends === 1 && rows.every((r) => r.status === "draft"));
+expect("the markdown says how to send and that nothing was sent", readFileSync(join(out, "outreach.md"), "utf8").includes("Nothing has been sent") && readFileSync(join(out, "outreach.md"), "utf8").includes("Add a note"));
+expect("the trace has research, fit and draft", trace.children.map((c) => c.name).join() === "outreach.research,outreach.fit,outreach.draft");
+
+const named = await runOutreach({ facts, need: "x", investor: "Bo Example", out: mkdtempSync(join(tmpdir(), "outreach-named-")) });
+expect("a named target is kept even when the evidence fits poorly", named.rows.some((r) => r.id === "bo-capital"));
+expect("a company page is not kept as a profile link", named.rows.find((r) => r.id === "bo-capital").linkedin_url === null);
+
+const { queue, target } = await import("./send.mjs");
+const rs = [{ id: "a", fit: "fits", draft: {}, linkedin_url: "https://www.linkedin.com/in/a" }, { id: "b", fit: "does not fit", draft: {} }, { id: "c", fit: "maybe", draft: {}, status: "sent" }, { id: "d", name: "Dee Example", firm: "Dee Fund", fit: "maybe", draft: {}, linkedin_url: null }];
+expect("prepare-to-send skips poor fits and anything already sent", queue(rs).map((r) => r.id).join() === "a,d" && queue(rs, { all: true }).map((r) => r.id).join() === "a,b,d" && queue(rs, { only: "b" }).map((r) => r.id).join() === "b");
+expect("without a profile link it opens a LinkedIn people search, never a guessed profile", target(rs[0]) === rs[0].linkedin_url && target(rs[3]).startsWith("https://www.linkedin.com/search/results/people/?keywords=Dee%20Example"));
+
+if (failed) { console.error(`${failed} failed`); process.exit(1); }
+console.log("all passing");
