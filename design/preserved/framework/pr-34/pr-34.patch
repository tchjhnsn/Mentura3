diff --git a/schema/migrations/kit-to-package.mjs b/schema/migrations/kit-to-package.mjs
new file mode 100644
index 0000000..b658c39
--- /dev/null
+++ b/schema/migrations/kit-to-package.mjs
@@ -0,0 +1,94 @@
+// Migration kit-to-package (framework 0.3.0, EE-071): packages are Naive's, kits are Mentura's. The
+// first record migration, like a Next.js codemod that rewrites code for a renamed API:
+//
+//   1. naive.config.json: before 0.3.0, `kits` listed the venture's Naive packages. A name that is a
+//      Naive package moves into `packages` (pinned by the upgrader); a Mentura kit stays in `kits`; any
+//      other name is escalated, never guessed.
+//   2. Routes inside records: decision unlocks, the team plan's route globs (who may read and write
+//      what) and the where-used list's parent routes still name layer and kit routes
+//      (purpose/validation/solution). Each is rewritten to its package route through the route aliases
+//      (validation/solution), so access and locks keep meaning what they meant. A glob that spans
+//      routes now in several packages (purpose/**) cannot be rewritten safely and is escalated.
+//
+// Every change goes through ctx (schema/upgrades.mjs).
+
+import { existsSync, readdirSync, readFileSync } from "node:fs";
+import { join } from "node:path";
+
+export const id = "kit-to-package";
+export const describe = "Moves Naive packages out of naive.config.json kits into packages, and rewrites layer and kit routes inside records (decision unlocks, team-plan access, where-used parents) to package routes";
+
+const repo = new URL("../..", import.meta.url).pathname;
+
+function aliases() {
+  const f = process.env.MENTURA_ROUTE_ALIASES ?? join(repo, "interface/route-aliases.json");
+  // Longest first, so purpose/validation/problem wins over a shorter alias it starts with.
+  return existsSync(f) ? JSON.parse(readFileSync(f, "utf8")).aliases.slice().sort((a, b) => b.from.length - a.from.length) : [];
+}
+
+/** A route or route glob rewritten through the aliases: { to } when it moved, { escalate } when it spans moved routes, else null. */
+export function rewriteRoute(route, list = aliases()) {
+  if (typeof route !== "string") return null;
+  const hit = list.find((a) => route === a.from || route.startsWith(`${a.from}/`));
+  if (hit) return { to: hit.to + route.slice(hit.from.length), alias: hit };
+  const star = route.indexOf("*");
+  if (star >= 0) {
+    const head = route.slice(0, star).replace(/\/$/, "");
+    // A glob from the root (**) still covers every route after the move.
+    const spans = head === "" ? [] : list.filter((a) => a.from === head || a.from.startsWith(`${head}/`));
+    if (spans.length) return { escalate: `${route} spans routes that moved to ${[...new Set(spans.map((a) => a.to.split("/")[0]))].join(", ")}` };
+  }
+  return null;
+}
+
+export function apply(dir, ctx) {
+  const list = aliases();
+
+  // 1. kits that are Naive packages become packages.
+  const cfg = ctx.config;
+  if (Array.isArray(cfg.kits) && cfg.kits.length) {
+    const keep = [];
+    for (const name of cfg.kits) {
+      if (existsSync(join(repo, "packages", name, "package.json"))) {
+        cfg.packages = { ...(cfg.packages ?? {}), [name]: cfg.packages?.[name] ?? {} };
+        ctx.note(`naive.config.json: ${name} is a Naive package, so it moved from kits to packages`);
+      } else if (existsSync(join(repo, "platform/kits", name, "kit.json"))) keep.push(name);
+      else { keep.push(name); ctx.escalate(`naive.config.json: kits names ${name}, which is neither a Naive package nor a Mentura kit; left as it is`); }
+    }
+    if (keep.length !== cfg.kits.length) ctx.configChanged();
+    if (keep.length) cfg.kits = keep; else delete cfg.kits;
+  }
+
+  // 2. Routes inside records.
+  const rewrite = (file, value, where) => {
+    const r = rewriteRoute(value, list);
+    if (!r) return value;
+    if (r.escalate) { ctx.escalate(`${file}: ${where} ${r.escalate}; rewrite it yourself`); return value; }
+    return r.to;
+  };
+  const rewriteFile = (file, fn) => {
+    if (!existsSync(join(dir, file))) return;
+    const before = readFileSync(join(dir, file), "utf8");
+    const rec = JSON.parse(before);
+    fn(rec);
+    const after = JSON.stringify(rec, null, 2) + "\n";
+    if (after.trim() !== before.trim()) ctx.write(file, after, { note: "routes renamed from layer and kit routes to package routes (EE-071)" });
+  };
+
+  const decisionFiles = (sub = "") => readdirSync(join(dir, sub), { withFileTypes: true }).flatMap((e) => {
+    const rel = sub ? `${sub}/${e.name}` : e.name;
+    if (e.isDirectory()) return e.name.startsWith(".") || e.name.startsWith("_") || existsSync(join(dir, rel, "venture.json")) ? [] : decisionFiles(rel);
+    return e.name.endsWith(".decision.json") ? [rel] : [];
+  });
+  for (const f of decisionFiles()) rewriteFile(f, (d) => {
+    for (const u of d.unlocks ?? []) if (Array.isArray(u.routes)) u.routes = u.routes.map((g) => rewrite(f, g, "unlocks route"));
+  });
+
+  for (const f of ["people/team-plan.json", "operations/team-plan.json"]) rewriteFile(f, (p) => {
+    for (const role of p.roles ?? []) for (const k of ["read", "write"]) if (Array.isArray(role.routes?.[k])) role.routes[k] = role.routes[k].map((g) => rewrite(f, g, `role ${role.id} ${k}`));
+  });
+
+  rewriteFile("knowledge/where-used.json", (w) => {
+    for (const fact of w.facts ?? []) if (fact.parent?.route) fact.parent.route = rewrite("knowledge/where-used.json", fact.parent.route, `fact ${fact.id} parent`);
+  });
+}
diff --git a/schema/migrations/package-layout.mjs b/schema/migrations/package-layout.mjs
new file mode 100644
index 0000000..77b8287
--- /dev/null
+++ b/schema/migrations/package-layout.mjs
@@ -0,0 +1,86 @@
+// Migration package-layout (framework 0.2.0, EE-070): moves a venture from the layer layout onto
+// the package folder layout, like a Next.js codemod. Files move with git mv when git tracks them and
+// with a plain rename otherwise. A file with no clear new home is archived under _private/ and
+// escalated for a person, never guessed. Old routes keep resolving through interface/route-aliases.json.
+//
+// Every change goes through ctx (schema/upgrades.mjs), so a dry run (--check) reports the same moves
+// without touching anything, and the upgrader records each one in provenance.
+
+import { existsSync, readdirSync, readFileSync } from "node:fs";
+import { join } from "node:path";
+
+export const id = "package-layout";
+export const describe = "Moves records from the layer folders (purpose/, pillars/, products/, knowledge/) into package folders (foundation/, validation/, product/, marketing/, people/, decisions/)";
+
+export function apply(dir, ctx) {
+  const load = (p) => JSON.parse(readFileSync(p, "utf8"));
+  // A decision file infers its target from the folder it sits in. Stamp that path before the file
+  // moves, so the decision still points at the same record.
+  const stampDecisions = (folder) => {
+    const d = join(dir, folder);
+    if (!existsSync(d)) return;
+    for (const f of readdirSync(d).filter((x) => x.endsWith(".decision.json"))) {
+      const rec = load(join(d, f));
+      if (rec.decides?.path) continue;
+      const at = folder.split("/").slice(0, -1).join("/");
+      const base = f.split(".")[0];
+      rec.decides = { ...(rec.decides ?? {}), path: at ? `${at}/${base}.json` : `${base}.json` };
+      ctx.write(`${folder}/${f}`, JSON.stringify(rec, null, 2) + "\n", { note: "stamped the record it decides before the move (EE-070)", log: false });
+    }
+  };
+
+  const pairs = [
+    ["purpose/validation/problem.json", "foundation/problem.json"],
+    ["purpose/icp.json", "foundation/icp.json"],
+    ["purpose/alignment.json", "foundation/alignment.json"],
+    ["purpose/telos.draft.md", "foundation/telos.draft.md"],
+    ["purpose/validation/solution.json", "validation/solution.json"],
+    ["purpose/validation/go-to-market.json", "validation/go-to-market.json"],
+    ["operations/team-plan.json", "people/team-plan.json"],
+    ["pillars/brand.md", "marketing/brand.md"],
+    // A venture made since init writes a root AGENTS.md keeps it; the old README becomes the knowledge layout.
+    ["knowledge/README.md", existsSync(join(dir, "AGENTS.md")) ? "knowledge/AGENTS.md" : "AGENTS.md"],
+    ["purpose/anatomy.answers.reasoned.json", "product/anatomy.answers.reasoned.json"],
+    ["purpose/anatomy.matrix.md", "product/anatomy.matrix.md"],
+  ];
+  for (const [a, b] of pairs) ctx.mv(a, b);
+
+  const list = (rel, ext) => existsSync(join(dir, rel)) ? readdirSync(join(dir, rel)).filter((f) => f.endsWith(ext)) : [];
+  for (const f of list("products", ".json")) ctx.mv(`products/${f}`, `product/${f}`);
+  for (const f of list("purpose/anatomy", ".json")) ctx.mv(`purpose/anatomy/${f}`, `product/anatomy/${f}`);
+
+  for (const folder of ["purpose/decisions", "purpose/anatomy/decisions", "operations/decisions"]) {
+    stampDecisions(folder);
+    for (const f of list(folder, ".decision.json")) ctx.mv(`${folder}/${f}`, `decisions/${f}`);
+  }
+
+  for (const f of ["product.md", "business.md"]) {
+    if (existsSync(join(dir, "pillars", f))) {
+      ctx.mv(`pillars/${f}`, `_private/pillars/${f}`);
+      ctx.escalate(`${f.replace(".md", "")} pillar: the brief names a home only for brand (marketing/). Archived at _private/pillars/${f} rather than guessed.`);
+    }
+  }
+  for (const f of list("purpose/research", "")) {
+    ctx.mv(`purpose/research/${f}`, `_private/research/${f}`);
+    ctx.escalate(`purpose/research/${f}: no package home in the route table. Archived at _private/research/${f}.`);
+  }
+
+  for (const gone of ["purpose", "pillars", "knowledge", "products"]) ctx.removeEmpty(gone);
+
+  const policy = "governance/publication-policy.json";
+  if (existsSync(join(dir, policy))) {
+    const text = readFileSync(join(dir, policy), "utf8");
+    if (text.includes("pillars/brand.md")) ctx.write(policy, text.replaceAll("pillars/brand.md", "marketing/brand.md"), { note: "the brand pillar moved to marketing/brand.md (EE-070)" });
+  }
+
+  for (const sub of ["raw/dump", "raw/sources", "ideas", "finance", "customers", "investors", "money", "public"]) ctx.keep(sub);
+
+  // The layout release, as before: the moves this migration made and what it escalated.
+  if (ctx.moved.length || ctx.escalated.length) ctx.write(".release/layout.json", JSON.stringify({
+    version: 1,
+    at: ctx.at,
+    note: "Moved onto the package folder layout (EE-070). Old routes stay as aliases for one release.",
+    moves: ctx.moved.map(([from, to]) => ({ from, to })),
+    escalated: ctx.escalated,
+  }, null, 2) + "\n", { activity: "release", note: "package folder layout", derived_from: ctx.moved.map(([, to]) => to) });
+}
