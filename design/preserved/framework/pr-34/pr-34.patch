new file mode 100644
index 0000000..5de9c41
--- /dev/null
+++ b/platform/agents/outreach/run.mjs
@@ -0,0 +1,127 @@
+#!/usr/bin/env node
+// Investor outreach agents (platform, Mentura, confidential): the "find out" step after a frame run.
+// Desk research cannot show whether a provider will fund this founder on these terms; asking can.
+// research (agent, web search) -> fit (Jev, per investor, on public evidence) -> draft (agent) -> checks.
+// Writes <out>/outreach.json and <out>/outreach.md: each investor with a public source, the LinkedIn
+// profile link when a search result shows one (never guessed, never scraped), a connection note and a
+// longer message. Nothing is sent: the founder opens the profile and sends, or approves an agent that
+// does. Design: platform/design/adr-viability-and-real-world-research-2026-10-29.md.
+//
+//   node platform/agents/outreach/run.mjs --facts <facts.json> --need "<what the founder asks for>"
+//     [--investor "<a name or profile URL to target>"] [--count 5] [--out <dir>] [--upload] [--project naive-frames]
+//
+// FRAMES_AGENT_CMD and FRAMES_JEV_CMD swap in stand-ins (fixtures/) for tests, as in ../frames.
+
+import { spawnSync } from "node:child_process";
+import { mkdirSync, readFileSync, writeFileSync } from "node:fs";
+import { join, resolve } from "node:path";
+
+const repo = new URL("../../../", import.meta.url).pathname;
+const { agent } = await import(join(repo, "platform/agents/frames/run.mjs"));
+const arg = (name, dflt = null) => { const i = process.argv.indexOf(`--${name}`); return i >= 0 ? process.argv[i + 1] : dflt; };
+const load = (p) => JSON.parse(readFileSync(p, "utf8"));
+const now = () => new Date().toISOString();
+const YES = 0.7, NO = 0.3;
+// LinkedIn caps a connection note at 300 characters, and at 200 on free accounts.
+/** A LinkedIn people search for the investor: a search, not a guessed profile. */
+export const linkedinSearch = (r) => `https://www.linkedin.com/search/results/people/?keywords=${encodeURIComponent([r.name, r.firm].filter(Boolean).join(" "))}`;
+
+export const NOTE_MAX = 200, MESSAGE_MAX = 900;
+
+export function researchPrompt(facts, need, count, investor) {
+  const target = investor ? `Find this one investor: ${investor}. Confirm who they are and what they publicly back.` : `Find ${count} investors (angels, funds, lenders) who publicly back ventures like this one: the same industry, this phase, and near the founder where possible. Keep searching until you have ${count} or have run every search below.
+Search widely, one query per angle: funds and angels in this industry (and the industry it sells to); funds whose thesis names the venture's kind of product; angel groups and seed funds in the founder's city and state; revenue-based and non-dilutive lenders that fund this size of revenue; accelerators that invest in this industry; recent funding news for similar companies, and who led those rounds.
+Name a person, not only a firm: the partner or angel who leads such deals, since a message goes to a person.`;
+  return `You are the investor research agent. Search the web now. ${target}
+For each investor give public evidence: the URL of a page (their site, a portfolio page, a news story, an interview) and what it says that shows the fit, in a short quote or close paraphrase.
+For their LinkedIn profile, search "<their name> <firm> LinkedIn". Give the URL ONLY if it appears in your search results exactly; never construct or guess one. Never read LinkedIn pages themselves.
+
+The venture: ${JSON.stringify(facts)}
+What the founder needs to find out: ${need}
+
+Answer with JSON only: {"investors": [{"id": "kebab-id", "name": "...", "firm": "... or null", "role": "...", "location": "... or null", "linkedin_url": "https://www.linkedin.com/in/... or null", "evidence": [{"url": "https://...", "says": "..."}]}]}`;
+}
+
+export function fitRequest(facts, investors) {
+  const questions = Object.fromEntries(investors.map((x) => [`fit:${x.id}`, { type: "noul", instructions: `Going only by \`investors.${x.id}.evidence\`, does this investor back ventures like the one in \`venture\` (its industry and its phase)?`, criteria: { true: "Yes: the evidence shows such investments or a stated thesis that includes them", false: "No: the evidence shows a different focus, or shows nothing about it" } }]));
+  return { state: { guidelines: "Judge only by the public evidence given. Do not use what you may know about the person.", venture: facts, investors: Object.fromEntries(investors.map((x) => [x.id, { name: x.name, firm: x.firm, evidence: x.evidence }])) }, model: "jev-latest", questions };
+}
+
+export function draftPrompt(facts, need, investors) {
+  return `You are the outreach drafter. Write, for each investor, a LinkedIn connection note (at most ${NOTE_MAX} characters) and a longer message (at most ${MESSAGE_MAX} characters) from the founder.
+Each one: names one specific thing from that investor's evidence; says in one line what the venture is, using only the facts given; asks one clear question that finds out whether they would consider what the founder needs. No flattery, no invented numbers, no urgency that is not real, no promises.
+
+The venture: ${JSON.stringify(facts)}
+What the founder needs to find out: ${need}
+Investors: ${JSON.stringify(investors.map((x) => ({ id: x.id, name: x.name, firm: x.firm, evidence: x.evidence })))}
+
+Answer with JSON only: {"drafts": [{"id": "<investor id>", "note": "...", "message": "...", "cites": "<the evidence URL it refers to>"}]}`;
+}
+
+function jev(request) {
+  const c = process.env.FRAMES_JEV_CMD ? process.env.FRAMES_JEV_CMD.split(" ") : ["node", join(repo, "platform/integrations/jev.mjs")];
+  const t0 = now();
+  const p = spawnSync(c[0], c.slice(1), { input: JSON.stringify(request), encoding: "utf8", maxBuffer: 1 << 26 });
+  const span = { name: "outreach.fit", run_type: "tool", start: t0, end: now(), inputs: request };
+  if (p.status !== 0) return { answers: {}, span: { ...span, error: (p.stderr || "").trim().slice(0, 300) || `status ${p.status}` } };
+  const out = JSON.parse(p.stdout);
+  return { answers: out.answers ?? {}, model: out.model, span: { ...span, outputs: out, metadata: { model: out.model } } };
+}
+
+export const isProfile = (u) => typeof u === "string" && /^https:\/\/([a-z]{2,3}\.)?linkedin\.com\/in\/[^/?#\s]+\/?$/i.test(u);
+
+/** Code checks on the drafts, sent to LangSmith as feedback. */
+export function checks(rows) {
+  const n = rows.length || 1;
+  const share = (ok) => Math.round((rows.filter(ok).length / n) * 1e4) / 1e4;
+  return [
+    { key: "investors_found", score: rows.length ? 1 : 0, comment: `${rows.length} investors judged a fit or a maybe` },
+    { key: "evidence_cited", score: share((r) => r.evidence.some((e) => /^https?:\/\//.test(e.url))) },
+    { key: "draft_cites_evidence", score: share((r) => r.draft && r.evidence.some((e) => e.url === r.draft.cites)) },
+    { key: "note_fits_linkedin", score: share((r) => r.draft && r.draft.note.length <= NOTE_MAX), comment: `connection notes at most ${NOTE_MAX} characters` },
+    { key: "message_length", score: share((r) => r.draft && r.draft.message.length <= MESSAGE_MAX) },
+    { key: "profile_links_valid", score: share((r) => r.linkedin_url == null || isProfile(r.linkedin_url)), comment: "a profile link is a linkedin.com/in/ URL from a search result, or none" },
+    { key: "founder_sends", score: rows.every((r) => r.status === "draft") ? 1 : 0, comment: "nothing is sent by the agents" },
+  ];
+}
+
+export function markdown(facts, need, rows, at) {
+  const lines = [`# Investor outreach (drafts)`, ``, `For: ${facts.venture ?? facts.what ?? "the venture"}. Finding out: ${need}`, `Researched ${at.slice(0, 10)}. Nothing has been sent.`, ``, `To send on LinkedIn: run node platform/agents/outreach/send.mjs --from outreach.json on your computer. It opens each profile and puts the note on your clipboard; choose Connect, then Add a note, paste and send. Once connected, send the longer message.`, ``];
+  for (const r of rows) {
+    lines.push(`## ${r.name}${r.firm ? `, ${r.firm}` : ""}`, ``, `- Fit: ${r.fit} (${r.p_fit ?? "-"})`, `- Profile: ${r.linkedin_url ?? `no profile link in the search results; search LinkedIn for them: ${linkedinSearch(r)}`}`, `- Evidence: ${r.evidence.map((e) => `${e.says} (${e.url})`).join("; ")}`, ``, `**Connection note** (${r.draft?.note.length ?? 0} characters)`, ``, `> ${r.draft?.note ?? ""}`, ``, `**Message**`, ``, `> ${(r.draft?.message ?? "").replace(/\n/g, "\n> ")}`, ``);
+  }
+  return lines.join("\n");
+}
+
+export async function runOutreach({ facts, need, investor = null, count = 5, out }) {
+  const at = now(), spans = [];
+  const research = agent("research", researchPrompt(facts, need, count, investor), { web: true }); spans.push({ ...research.span, name: "outreach.research" });
+  const found = (research.out.investors ?? []).filter((x) => x.id && x.name && (x.evidence ?? []).length).map((x) => ({ ...x, linkedin_url: isProfile(x.linkedin_url) ? x.linkedin_url : null }));
+  const j = jev(fitRequest(facts, found)); spans.push(j.span);
+  const judged = found.map((x) => { const p = typeof j.answers[`fit:${x.id}`]?.noul === "number" ? j.answers[`fit:${x.id}`].noul : null; return { ...x, p_fit: p, fit: p == null ? "unknown" : p >= YES ? "fits" : p <= NO ? "does not fit" : "maybe" }; });
+  // A named target is drafted for even when the evidence is thin; a search keeps only fits and maybes.
+  const kept = investor ? judged : judged.filter((x) => x.fit !== "does not fit");
+  const drafted = kept.length ? agent("draft", draftPrompt(facts, need, kept)) : { out: { drafts: [] }, span: { name: "draft", start: now(), end: now(), outputs: { skipped: "no investors" } } };
+  spans.push({ ...drafted.span, name: "outreach.draft" });
+  const rows = kept.map((x) => ({ ...x, draft: (drafted.out.drafts ?? []).find((d) => d.id === x.id) ?? null, status: "draft" }));
+  const feedback = checks(rows);
+  const trace = { name: `outreach${investor ? `:${investor}` : ""}`, run_type: "chain", start: at, end: now(), inputs: { facts, need, investor, count }, outputs: { investors: rows.map((r) => ({ name: r.name, fit: r.fit, linkedin_url: r.linkedin_url })) }, children: spans, feedback, tags: ["outreach", "investors"], metadata: { harness: "mentura-outreach" } };
+  mkdirSync(out, { recursive: true });
+  writeFileSync(join(out, "outreach.json"), JSON.stringify({ at, facts, need, investor, rows, feedback }, null, 2) + "\n");
+  writeFileSync(join(out, "outreach.md"), markdown(facts, need, rows, at) + "\n");
+  writeFileSync(join(out, "outreach-trace.json"), JSON.stringify(trace, null, 2) + "\n");
+  return { rows, feedback, trace, tracePath: join(out, "outreach-trace.json") };
+}
+
+if (process.argv[1] && resolve(process.argv[1]) === new URL(import.meta.url).pathname) {
+  const need = arg("need");
+  if (!arg("facts") || !need) { console.error('usage: node platform/agents/outreach/run.mjs --facts <facts.json> --need "<what to find out>" [--investor "<name or URL>"] [--count 5] [--out dir] [--upload]'); process.exit(2); }
+  const out = arg("out") ? resolve(arg("out")) : join(process.cwd(), ".outreach", String(Date.now()));
+  const r = await runOutreach({ facts: load(arg("facts")), need, investor: arg("investor"), count: Number(arg("count", 5)), out });
+  let uploaded = null;
+  if (process.argv.includes("--upload")) {
+    const p = spawnSync("node", [join(repo, "platform/integrations/langsmith.mjs"), r.tracePath, "--project", arg("project", "naive-frames")], { encoding: "utf8" });
+    uploaded = p.status === 0 ? JSON.parse(p.stdout) : { error: (p.stderr || "").trim() };
+  }
+  console.log(JSON.stringify({ out, investors: r.rows.map((x) => `${x.fit} ${x.p_fit ?? "-"} ${x.name}${x.firm ? ` (${x.firm})` : ""} ${x.linkedin_url ?? "no profile link"}`), feedback: Object.fromEntries(r.feedback.map((f) => [f.key, f.score])), uploaded }, null, 2));
+}
diff --git a/platform/agents/outreach/send.mjs b/platform/agents/outreach/send.mjs
new file mode 100644
index 0000000..3f9a0f3
--- /dev/null
+++ b/platform/agents/outreach/send.mjs
@@ -0,0 +1,64 @@
+#!/usr/bin/env node
+// Prepare to send (platform, Mentura, confidential): the agent gets each message ready, the founder sends.
+// Run on the founder's own computer after run.mjs. For each investor it opens the LinkedIn profile (or a
+// LinkedIn people search when no profile link was found) and puts the connection note on the clipboard.
+// The founder clicks Connect, Add a note, pastes and sends. Nothing here logs in to LinkedIn or clicks
+// anything there (Torian's choice, 2026-10-29: "You send, the agent prepares").
+// After each one it asks whether the founder sent it and records the answer in outreach.json.
+//
+//   node platform/agents/outreach/send.mjs --from <out>/outreach.json [--only id,id] [--all] [--dry-run]
+//
+// Investors judged "does not fit" are skipped unless --all. --dry-run prints the plan and changes nothing.
+
+import { spawnSync } from "node:child_process";
+import { readFileSync, writeFileSync } from "node:fs";
+import { createInterface } from "node:readline/promises";
+import { linkedinSearch } from "./run.mjs";
+
+const arg = (name, dflt = null) => { const i = process.argv.indexOf(`--${name}`); return i >= 0 ? process.argv[i + 1] : dflt; };
+const flag = (name) => process.argv.includes(`--${name}`);
+
+/** Which investors to prepare, in order: approved by --only, or every one that is not "does not fit". */
+export function queue(rows, { only = null, all = false } = {}) {
+  const ids = only ? only.split(",").map((s) => s.trim()) : null;
+  return rows.filter((r) => r.draft && r.status !== "sent" && (ids ? ids.includes(r.id) : all || r.fit !== "does not fit"));
+}
+
+export const target = (r) => r.linkedin_url ?? linkedinSearch(r);
+
+function open(url) {
+  const c = process.platform === "darwin" ? ["open", url] : process.platform === "win32" ? ["cmd", "/c", "start", "", url] : ["xdg-open", url];
+  spawnSync(c[0], c.slice(1), { stdio: "ignore" });
+}
+
+function copy(text) {
+  const c = process.platform === "darwin" ? ["pbcopy"] : process.platform === "win32" ? ["clip"] : ["xclip", "-selection", "clipboard"];
+  return spawnSync(c[0], c.slice(1), { input: text }).status === 0;
+}
+
+async function main() {
+  const from = arg("from");
+  if (!from) { console.error("usage: node platform/agents/outreach/send.mjs --from <outreach.json> [--only id,id] [--all] [--dry-run]"); process.exit(2); }
+  const doc = JSON.parse(readFileSync(from, "utf8"));
+  const todo = queue(doc.rows, { only: arg("only"), all: flag("all") });
+  if (flag("dry-run")) {
+    for (const r of todo) console.log(`${r.id}: ${r.name}${r.firm ? `, ${r.firm}` : ""} (${r.fit})\n  open ${target(r)}\n  note (${r.draft.note.length} chars): ${r.draft.note}\n`);
+    console.log(`${todo.length} to prepare. Nothing opened, copied or changed.`);
+    return;
+  }
+  const rl = createInterface({ input: process.stdin, output: process.stdout });
+  for (const r of todo) {
+    console.log(`\n${r.name}${r.firm ? `, ${r.firm}` : ""} (${r.fit})`);
+    open(target(r));
+    const copied = copy(r.draft.note);
+    console.log(r.linkedin_url ? "Opened the profile." : "No profile link was found, so a LinkedIn people search is open. Pick the right person.");
+    console.log(copied ? "The connection note is on the clipboard. Choose Connect, then Add a note, paste and send." : `Copy this note:\n${r.draft.note}`);
+    let a = (await rl.question("Sent? [y]es, [m] copy the longer message, [s]kip, [q]uit: ")).trim().toLowerCase();
+    if (a === "m") { copy(r.draft.message) || console.log(r.draft.message); console.log("The longer message is on the clipboard, for after they accept."); a = (await rl.question("Sent the note? [y/n]: ")).trim().toLowerCase(); }
+    if (a === "q") break;
+    if (a === "y") { r.status = "sent"; r.sent_at = new Date().toISOString(); r.sent_by = "founder"; writeFileSync(from, JSON.stringify(doc, null, 2) + "\n"); console.log("Recorded as sent by you."); }
+  }
+  rl.close();
+}
+
+if (process.argv[1] && import.meta.url.endsWith(process.argv[1].split("/").pop())) await main();
