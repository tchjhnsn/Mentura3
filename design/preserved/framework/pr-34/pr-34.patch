+++ b/platform/agents/cases/reconstruct.mjs
@@ -0,0 +1,88 @@
+#!/usr/bin/env node
+// Case reconstruction (platform, Mentura, confidential): turns a real, public deal into a test case for a
+// Naive frame. Torian's idea (2026-10-29): Shark Tank episodes, podcasts such as David Senra's Founders, and
+// other public material record decisions and deals made over time; recreating their frames gives the agents
+// training and evaluation data. Because the outcome is known, the case's expected verdicts come from what
+// actually happened, not from a model's opinion.
+//
+//   node platform/agents/cases/reconstruct.mjs --frame <id> --deal "<a public deal, e.g. a company on Shark Tank>" [--out <dir>]
+//   node platform/agents/cases/reconstruct.mjs --frame <id> --find 5 [--source "Shark Tank"] [--out <dir>]
+//   then: node platform/agents/frames/run.mjs --frame <id> --case-file <out>/<case>.case.json
+//
+// Rules the code enforces, because the legal position is not settled (see the pipeline doc, "Case sources"):
+// facts and deal terms only, each with the public page it came from; a short paraphrase per source, never a
+// transcript, lyrics-length quote or downloaded media; every case is "reconstructed" and "draft" until a
+// person reviews it. Cases are written outside git by default (.cases/). Never use Torian's own ventures.
+
+import { mkdirSync, writeFileSync } from "node:fs";
+import { join, resolve } from "node:path";
+
+const repo = new URL("../../../", import.meta.url).pathname;
+const F = await import(join(repo, "schema/frames.mjs"));
+const { agent } = await import(join(repo, "platform/agents/frames/run.mjs"));
+const arg = (name, dflt = null) => { const i = process.argv.indexOf(`--${name}`); return i >= 0 ? process.argv[i + 1] : dflt; };
+
+export const SAYS_MAX = 300;
+export const LABELS = ["yes", "no", "unknown"];
+export const READINGS = ["false", "trade-off", "sequence"];
+
+export function reconstructPrompt(f, { deal = null, find = 1, source = null } = {}) {
+  const ask = deal
+    ? `Reconstruct this one public deal: ${deal}.`
+    : `Find ${find} public deals${source ? ` from ${source}` : ""} where a founder faced this frame's trade, with outcomes on public record. Mix outcomes: some where the trade turned out false, some real trade-offs, some sequences.`;
+  return `You are the case reconstructor. Search the web now. ${ask}
+The frame: "${f.title}" (${f.id}). The trade the founder's sentence forces: ${f.dichotomy}
+Its premises: ${f.premises.map((p) => `${p.id}: ${p.claim}`).join(" | ")}
+Its facts (props): ${JSON.stringify(f.props)}
+
+For each deal:
+- facts: each prop as it stood WHEN THE DECISION WAS MADE, from public sources; "not on record" when no source states it. Never use what happened afterwards here.
+- what_happened: the deal or decision actually taken and its terms, in one or two plain sentences.
+- expect: for each premise id, "yes", "no" or "unknown" judged by what happened; and "dichotomy": "false" (they got the goal without the trade), "trade-off" (they had to give one up) or "sequence" (one first, then the other). Give a one-line reason for each.
+- sources: the public pages (show recaps, press, the company's own statements, podcast episode pages). For each, what it says in your own short paraphrase, at most ${SAYS_MAX} characters. No transcripts, no long quotes.
+Skip any deal you cannot source. Use only public figures' public deals.
+
+Answer with JSON only: {"cases": [{"id": "kebab-id", "title": "...", "source_kind": "tv|podcast|press|book|other", "when": "YYYY or YYYY-MM", "facts": {...}, "what_happened": "...", "expect": {"<premise id>": "yes|no|unknown", "dichotomy": "false|trade-off|sequence"}, "reasons": {"<key>": "..."}, "sources": [{"url": "https://...", "says": "..."}]}]}`;
+}
+
+/** Code's checks on one reconstructed case: every problem found, or none. */
+export function check(f, c) {
+  const p = [];
+  if (!c.id || !/^[a-z0-9-]+$/.test(c.id)) p.push("id is not kebab-case");
+  const extra = Object.keys(c.facts ?? {}).filter((k) => !f.props.includes(k));
+  if (extra.length) p.push(`facts the frame does not have: ${extra.join(", ")}`);
+  if (!f.props.some((k) => c.facts?.[k] && c.facts[k] !== "not on record")) p.push("no fact is on record");
+  for (const pr of f.premises) if (!LABELS.includes(c.expect?.[pr.id])) p.push(`expect.${pr.id} is not yes, no or unknown`);
+  if (!READINGS.includes(c.expect?.dichotomy)) p.push("expect.dichotomy is not false, trade-off or sequence");
+  const src = (c.sources ?? []).filter((s) => /^https:\/\/\S+$/.test(s.url ?? "") && s.says);
+  if (!src.length) p.push("no source with a URL");
+  if ((c.sources ?? []).some((s) => (s.says ?? "").length > SAYS_MAX)) p.push(`a source note is longer than ${SAYS_MAX} characters`);
+  if (!c.what_happened) p.push("what happened is missing");
+  return p;
+}
+
+/** Reconstruct cases for a frame; keeps the ones that pass every check and reports the rest. */
+export function reconstruct({ frameId, deal = null, find = 1, source = null, out }) {
+  const f = F.frameOf(frameId);
+  if (!f) throw new Error(`no frame ${frameId}; node schema/frames.mjs list shows them`);
+  const a = agent("reconstruct", reconstructPrompt(f, { deal, find, source }), { web: true });
+  const kept = [], dropped = [];
+  for (const c of a.out.cases ?? []) {
+    const problems = check(f, c);
+    if (problems.length) { dropped.push({ id: c.id ?? null, problems }); continue; }
+    const facts = Object.fromEntries(f.props.map((k) => [k, c.facts[k] ?? "not on record"]));
+    const expect = { ...Object.fromEntries(f.premises.map((p) => [p.id, c.expect[p.id]])), dichotomy: c.expect.dichotomy };
+    kept.push({ id: c.id, frame: f.id, title: c.title, provenance: "reconstructed", status: "draft", source_kind: c.source_kind ?? "other", when: c.when ?? null, facts, what_happened: c.what_happened, expect, reasons: c.reasons ?? {}, sources: c.sources.map((s) => ({ url: s.url, says: s.says })), reconstructed_at: new Date().toISOString() });
+  }
+  mkdirSync(out, { recursive: true });
+  for (const c of kept) writeFileSync(join(out, `${c.id}.case.json`), JSON.stringify(c, null, 2) + "\n");
+  return { kept, dropped, span: { ...a.span, name: "cases.reconstruct" } };
+}
+
+if (process.argv[1] && resolve(process.argv[1]) === new URL(import.meta.url).pathname) {
+  const frameId = arg("frame");
+  if (!frameId || !(arg("deal") || arg("find"))) { console.error('usage: node platform/agents/cases/reconstruct.mjs --frame <id> (--deal "<public deal>" | --find <n> [--source "<show or podcast>"]) [--out dir]'); process.exit(2); }
+  const out = resolve(arg("out", join(process.cwd(), ".cases", frameId)));
+  const r = reconstruct({ frameId, deal: arg("deal"), find: Number(arg("find", 1)), source: arg("source"), out });
+  console.log(JSON.stringify({ out, kept: r.kept.map((c) => `${c.id}: ${c.expect.dichotomy} (${c.sources.length} sources) ${c.what_happened}`), dropped: r.dropped }, null, 2));
+}
