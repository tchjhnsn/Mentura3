+#!/usr/bin/env node
+// Frame agents, offline: stand-in agent and Jev over Naive's own frame and runtime (schema/frames.mjs).
+import { existsSync, mkdtempSync, readFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+
+const here = new URL(".", import.meta.url).pathname;
+process.env.FRAMES_AGENT_CMD = `node ${join(here, "fixtures/agent.mjs")}`;
+process.env.FRAMES_JEV_CMD = `node ${join(here, "fixtures/jev.mjs")}`;
+const { runFrame, judgeRequest, ladder, viabilityRequest } = await import("./run.mjs");
+const F = await import(join(here, "../../../schema/frames.mjs"));
+
+let failed = 0;
+const expect = (what, ok) => { console.log(`${ok ? "pass" : "FAIL"}  ${what}`); if (!ok) failed++; };
+const f = F.frameOf("fund-without-ceding-control");
+const facts = JSON.parse(readFileSync(join(here, "fixtures/facts.json"), "utf8"));
+
+const req = judgeRequest(f, facts, [{ id: "x", question: "Is it?" }]);
+expect("the Jev request carries exactly state, model and questions", Object.keys(req).sort().join() === "model,questions,state");
+expect("the frame's own questions come from frames.request", Object.keys(F.request(f, facts).questions).every((k) => k in req.questions) && "attack:x" in req.questions);
+
+const out = mkdtempSync(join(tmpdir(), "frames-"));
+const { run, feedback, trace } = await runFrame({ frameId: f.id, facts, problem: "I need investors to scale but I don't want to give up control.", out });
+const fb = Object.fromEntries(feedback.map((x) => [x.key, x.score]));
+expect("the framer fills only facts the frame reads and the records lack", run.filled.cap_table && run.filled.control_rights && run.filled.runway === undefined);
+expect("premise verdicts are settled by frames.verdicts", run.got["money-means-ownership"] === "no" && run.got["control-is-one-thing"] === "yes" && run.got.dichotomy === "false");
+expect("the attacker's propositions are judged too", run.judged["attack:growth-reaches-goal"].verdict === "no");
+expect("an option without a source is dropped by frames.fresh", run.fresh.kept.length === 3 && run.fresh.dropped === 1);
+expect("lookup options reach the decision that takes them", run.proposed.find((x) => x.id === "fund-growth-how").options.length === 3);
+expect("records are open, agent-drafted, in decisions/", existsSync(join(out, "decisions/fund-growth-how.decision.json")) && run.records.every((r) => r.status === "open" && r.provenance.drafted_by.kind === "agent"));
+expect("every check passes on a clean run", fb.frame_has_no_answer === 1 && fb.options_cited === 1 && fb.founder_decides === 1 && fb.premises_judged === 1);
+expect("the trace has one span per step", trace.children.map((c) => c.name).join() === "frames.framer,frames.attacker,frames.jev,frames.scout,frames.viability,frames.records");
+const lad = Object.fromEntries(run.viability.options.map((o) => [o.option.slice(0, 6), o]));
+expect("an option whose source excludes the venture stops at possible", lad["Repay "].available === "no" && lad["Repay "].reached === "possible");
+expect("an option available and acceptable reaches acceptable, never confirmed", lad["Issue "].reached === "acceptable" && lad["Issue "].confirmed === "not yet");
+expect("a source that does not say who qualifies leaves availability unknown, unasked", lad["A loan"].available === "unknown" && !Object.keys(run.viability.options).includes("x") && run.viability.summary.includes("unknown for 1"));
+expect("an option already acceptable means no find-out decision", !run.records.some((r) => r.id.endsWith("find-out-availability")));
+expect("the lookup decision's note carries the viability", run.records.find((r) => r.id === "fund-growth-how").note.includes("confirmed for 0"));
+expect("a trade-off is not possible, so no option reaches a stage", ladder({ reading: "trade-off" }, viabilityRequest({ control_rights: "votes" }, [{ option: "x", source: "https://a" }]), { "available:o1": { noul: 1 }, "acceptable:o1": { noul: 1 } }).options[0].reached === "none");
+const none = ladder({ reading: "false" }, viabilityRequest({}, [{ option: "x", source: "https://a" }]), {});
+expect("with nothing shown available, the next steps say how to find out", none.options[0].available === "unknown" && none.next_steps.length === 4);
+expect("without named control rights, acceptability is not asked", !("acceptable:o1" in viabilityRequest({}, [{ option: "x", source: "https://a" }]).questions));
+
+const caseRun = await runFrame({ frameId: f.id, caseId: "services-firm-profitable", out: mkdtempSync(join(tmpdir(), "frames-case-")) });
+const acc = caseRun.feedback.find((x) => x.key === "case_accuracy");
+expect("a case is scored against what it expects", acc && acc.score > 0 && acc.score <= 1 && caseRun.run.expect.dichotomy === "false");
+expect("a case with facts runs without the framer", !caseRun.trace.children.some((c) => c.name === "frames.framer"));
+
+if (failed) { console.error(`${failed} failed`); process.exit(1); }
+console.log("all passing");
