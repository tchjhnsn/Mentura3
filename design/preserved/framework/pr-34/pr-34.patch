+        "command": { "type": "string", "description": "The framework command it extends, such as \"upgrade --agent\"" }
+      }
+    },
+    "entry": { "type": "string", "description": "The kit's program, relative to its folder, run as node <entry> <venture dir>" },
+    "agent": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": ["command"],
+      "properties": {
+        "command": { "type": "array", "items": { "type": "string" }, "description": "The agent it runs by default; MENTURA_AGENT_CMD replaces it" },
+        "env": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" }, "description": "Environment variables it reads, by name" }
+      }
+    },
+    "automations": {
+      "type": "array",
+      "items": { "$ref": "trigger.schema.json" },
+      "description": "Triggers the kit brings; each names the package it needs (needs)"
