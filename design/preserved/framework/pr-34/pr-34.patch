+++ b/platform/agents/frames/run.mjs
@@ -0,0 +1,286 @@
+#!/usr/bin/env node
+// Frame agents (platform, Mentura, confidential): the kit that runs Naive's decision frames
+// (schema/frames.mjs) with agents around them. Naive judges a frame's own premises in code; the agents
+// add what code cannot: facts from the founder's words, premise attacks specific to this founder, and
+// the dated, cited lookup a frame's options come from. Jev (System 1) judges every proposition in one
+// request; the founder decides. Design: platform/design/agent-training-pipeline.md.
+//
+//   node platform/agents/frames/run.mjs --frame <id> --venture <dir> [--problem "<words>"]   records go into the venture
+//   node platform/agents/frames/run.mjs --frame <id> --case <case id> [--out <dir>]          one of the frame's fictional cases
+//   node platform/agents/frames/run.mjs --frame <id> --cases [--out <dir>]                   every case, scored against expect
+//   node platform/agents/frames/run.mjs --frame <id> --case-file <file> [--case-file ...]      reconstructed cases (../cases), scored against expect
+//   node platform/agents/frames/run.mjs --frame <id> --facts <file> --problem "<words>" [--out <dir>]
+//     add --upload [--project naive-frames] to send each trace to LangSmith
+//
+// Steps, one trace span each: framer (agent; only when the founder's words must fill facts the records
+// lack) -> attacker (agent) -> jev (frames.request plus the attacker's propositions) -> scout (Firecrawl,
+// or the agent's web search without a key) -> viability (Jev on each option's source: available,
+// acceptable) -> records (frames.run into a venture, else frames' emits proposed into <out>). FRAMES_AGENT_CMD and FRAMES_JEV_CMD swap in stand-ins (fixtures/) for tests.
+
+import { spawnSync } from "node:child_process";
+import { mkdirSync, readFileSync, writeFileSync } from "node:fs";
+import { join, resolve } from "node:path";
+
+const repo = new URL("../../../", import.meta.url).pathname;
+const F = await import(join(repo, "schema/frames.mjs"));
+const { propose } = await import(join(repo, "schema/decisions.mjs"));
+const arg = (name, dflt = null) => { const i = process.argv.indexOf(`--${name}`); return i >= 0 ? process.argv[i + 1] : dflt; };
+const load = (p) => JSON.parse(readFileSync(p, "utf8"));
+const now = () => new Date().toISOString();
+const NONE = "not on record";
+const missing = (v) => v == null || v === "" || v === NONE;
+
+function cmd(envName, dflt) {
+  const v = process.env[envName];
+  return v ? v.split(" ").filter(Boolean) : dflt;
+}
+
+/** One agent step: the prompt on stdin, the answer in claude -p --output-format json's shape. */
+export function agent(step, prompt, { web = false } = {}) {
+  const base = cmd("FRAMES_AGENT_CMD", ["claude", "-p", "--output-format", "json", ...(web ? ["--tools", "WebSearch", "--allowedTools", "WebSearch"] : ["--tools", ""])]);
+  const t0 = now();
+  const p = spawnSync(base[0], base.slice(1), { input: `STEP: ${step}\n\n${prompt}`, encoding: "utf8", maxBuffer: 1 << 26, timeout: web ? 600000 : 300000 });
+  if (p.status !== 0) throw new Error(`${step}: the agent stopped with status ${p.status}: ${(p.stderr || p.stdout || "").slice(0, 300)}`);
+  const env = JSON.parse(p.stdout);
+  if (env.is_error) throw new Error(`${step}: ${env.result}`);
+  const text = String(env.result ?? "");
+  const out = JSON.parse(text.slice(text.indexOf("{"), text.lastIndexOf("}") + 1));
+  return { out, span: { name: `frames.${step}`, run_type: "llm", start: t0, end: now(), inputs: { prompt }, outputs: { result: text }, metadata: { usage: env.usage ?? null, cost_usd: env.total_cost_usd ?? null } } };
+}
+
+const about = (f) => `Frame "${f.title}" (${f.id}). The trade the founder's sentence forces: ${f.dichotomy}
+Premises the frame tests: ${f.premises.map((p) => `${p.id}: ${p.claim}`).join(" | ")}`;
+
+export function framerPrompt(f, problem, facts) {
+  const gaps = f.props.filter((k) => missing(facts[k]));
+  return `You are the framer. Read the founder's words and fill ONLY the facts below that the words actually state. Leave out anything they do not state; never guess.
+${about(f)}
+
+The founder's words: ${JSON.stringify(problem)}
+Facts already known: ${JSON.stringify(facts)}
+Facts to fill if the words state them: ${JSON.stringify(gaps)}
+
+Answer with JSON only: {"facts": {"<fact>": "<as the founder put it>"}}`;
+}
+
+export function attackerPrompt(f, facts) {
+  return `You are the premise attacker. The frame's own premises are judged already. Write up to three MORE yes/no propositions that attack the premises of THIS founder's situation, using the frame's attacks (${f.attacks.map((a) => `${a}: ${F.ATTACKS[a]}`).join(" ")}).
+Each proposition is answerable from the facts alone, names one thing and has no "and"; "true" must mean the founder's premise holds. Never name a financial instrument or any other answer.
+${about(f)}
+Facts: ${JSON.stringify(facts)}
+
+Answer with JSON only: {"propositions": [{"id": "kebab-id", "attack": "<attack>", "question": "Is ...?"}]}`;
+}
+
+export function scoutPrompt(f, queries) {
+  return `You are the freshness scout. Search the web now and list options that fit what the frame looks for. Do not judge which is best, and do not answer from memory: every option needs the URL you found it at.
+Prefer sources from the last ${f.freshness.max_age_days} days.
+Queries: ${JSON.stringify(queries)}
+
+For each option, copy what the source says about who qualifies (revenue, months of history, stage, location) and what the provider gets in return (a share of revenue, shares, votes, seats, vetoes). Write "not stated" when the source does not say.
+
+Answer with JSON only: {"options": [{"option": "<a way to do it, in plain words>", "source": "https://...", "published": "YYYY-MM-DD or null", "who_qualifies": "...", "provider_gets": "..."}]}`;
+}
+
+/** Jev's request: the frame's own (frames.request) plus the attacker's propositions, as attack:<id>. */
+export function judgeRequest(f, facts, propositions) {
+  const req = F.request(f, facts);
+  for (const p of propositions) req.questions[`attack:${p.id}`] = { type: "noul", instructions: `Given only the facts in \`venture\`, is this true: ${p.question}`, criteria: { true: "Yes: the facts show it", false: "No: the facts show it is not" } };
+  return req;
+}
+
+function jev(request) {
+  const c = cmd("FRAMES_JEV_CMD", ["node", join(repo, "platform/integrations/jev.mjs")]);
+  const t0 = now();
+  const p = spawnSync(c[0], c.slice(1), { input: JSON.stringify(request), encoding: "utf8", maxBuffer: 1 << 26 });
+  const span = { name: "frames.jev", run_type: "tool", start: t0, end: now(), inputs: request };
+  if (p.status !== 0) return { answers: {}, model: null, span: { ...span, error: (p.stderr || "").trim().slice(0, 300) || `status ${p.status}` } };
+  const out = JSON.parse(p.stdout);
+  return { answers: out.answers ?? {}, model: out.model, span: { ...span, outputs: out, metadata: { model: out.model, usage: out.usage } } };
+}
+
+const verdictOf = (prob) => (prob == null ? "unknown" : prob >= F.YES ? "yes" : prob <= F.NO ? "no" : "unknown");
+
+/** The lookup a frame's options come from, in frames.fresh's shape: {options: [{option, source, as_of}]}. */
+async function scout(f, facts) {
+  const filters = f.freshness.filter_by.map((k) => facts[k]).filter((v) => !missing(v)).join(", ");
+  const queries = f.freshness.look_for.map((q) => (filters ? `${q} (${filters})` : q)).slice(0, 5);
+  const t0 = now(), asOf = t0.slice(0, 10);
+  if (process.env.FIRECRAWL_API_KEY && !process.env.FRAMES_AGENT_CMD) {
+    const { search } = await import(join(repo, "platform/mcp/research.mjs"));
+    const results = await search({ queries, results: 4 });
+    const options = results.map((r) => ({ option: r.title ?? r.snippet, source: r.url, as_of: asOf, note: r.snippet }));
+    return { lookup: { looked_up: t0, queries, options }, span: { name: "frames.scout", run_type: "tool", start: t0, end: now(), inputs: { queries, via: "firecrawl" }, outputs: { options } } };
+  }
+  const { out, span } = agent("scout", scoutPrompt(f, queries), { web: true });
+  const options = (out.options ?? []).map((o) => ({ option: o.option, source: o.source, as_of: asOf, ...(o.published ? { published: o.published } : {}), who_qualifies: o.who_qualifies ?? "not stated", provider_gets: o.provider_gets ?? "not stated" }));
+  return { lookup: { looked_up: t0, queries, options }, span: { ...span, name: "frames.scout", run_type: "tool", inputs: { queries, via: "agent web search" } } };
+}
+
+// ---- viability: possible, available, acceptable, confirmed ----
+// "Possible" is the frame's own verdict: the trade is false or a sequence. It says nothing about whether
+// anyone will fund this founder on those terms. "Available" and "acceptable" are judged per option against
+// what its source says (desk research, a probability, never a confirmation). "Confirmed" needs a real
+// provider's answer (a conversation, the forum) and no model can reach it.
+// See platform/design/adr-viability-and-real-world-research-2026-10-29.md.
+export const STAGES = ["possible", "available", "acceptable", "confirmed"];
+
+// A source that does not say is no evidence either way: that stage is unknown and is not asked of Jev.
+const unstated = (x) => !x || /^\s*not stated/i.test(x);
+
+export function viabilityRequest(facts, kept) {
+  const options = Object.fromEntries(kept.map((o, i) => [`o${i + 1}`, { option: o.option, who_qualifies: o.who_qualifies ?? "not stated", provider_gets: o.provider_gets ?? "not stated", source: o.source, as_of: o.as_of }]));
+  const questions = {};
+  for (const [id, o] of Object.entries(options)) {
+    if (!unstated(o.who_qualifies)) questions[`available:${id}`] = { type: "noul", instructions: `Going only by what \`options.${id}.who_qualifies\` says (its source's own words), does a venture with the facts in \`venture\` qualify for this today?`, criteria: { true: "Yes: the stated criteria include this venture", false: "No: the stated criteria exclude this venture" } };
+    if (!missing(facts.control_rights) && !unstated(o.provider_gets)) questions[`acceptable:${id}`] = { type: "noul", instructions: `Going only by \`options.${id}.provider_gets\`, does the founder keep every right named in \`venture.control_rights\`?`, criteria: { true: "Yes: what the provider gets leaves those rights with the founder", false: "No: the provider gets one of them" } };
+  }
+  return { state: { guidelines: "Judge each question only by what the option's source says and the venture's facts. This is desk research: do not assume a provider will say yes.", venture: facts, options }, model: "jev-latest", questions };
+}
+
+/** The highest stage each option reaches; a stage counts only when every stage before it is yes. */
+export function ladder(dichotomy, request, answers) {
+  const possible = dichotomy && ["false", "sequence"].includes(dichotomy.reading) ? "yes" : dichotomy?.reading === "trade-off" ? "no" : "unknown";
+  const p = (a) => (typeof a?.noul === "number" ? a.noul : null);
+  const options = Object.entries(request.state.options).map(([id, o]) => {
+    const available = verdictOf(p(answers[`available:${id}`]));
+    const acceptable = `acceptable:${id}` in request.questions ? verdictOf(p(answers[`acceptable:${id}`])) : "unknown";
+    const stages = { possible, available, acceptable, confirmed: "not yet" };
+    const reached = STAGES.filter((_, i) => STAGES.slice(0, i + 1).every((st) => stages[st] === "yes")).pop() ?? "none";
+    return { id, option: o.option, source: o.source, p_available: p(answers[`available:${id}`]), p_acceptable: p(answers[`acceptable:${id}`]), ...stages, reached };
+  });
+  const count = (v) => options.filter((o) => o.available === v).length;
+  const summary = `possible: ${possible}; available on desk research for ${count("yes")} of ${options.length}, ruled out by the source's own criteria for ${count("no")}, unknown for ${count("unknown")} (the source does not say who qualifies, so there is no evidence either way); acceptable for ${options.filter((o) => o.available === "yes" && o.acceptable === "yes").length}; confirmed for 0 (only a provider's answer confirms one)`;
+  return { possible, options, summary, next_steps: possible === "yes" && !options.some((o) => o.reached === "acceptable") ? NEXT_STEPS : [] };
+}
+
+/** How a founder finds out what desk research cannot show: who will actually provide it. */
+export const NEXT_STEPS = [
+  "Have the research agent find investors and lenders who back ventures like this one, at this phase and near the founder, each with a public source",
+  "Start from an investor list the founder already has",
+  "Ask providers directly: an agent drafts each message, and the founder sends it or approves the agent sending it",
+  "Post the need, anonymously, where investors can answer (Mentura's investor index and forum, not built yet)",
+];
+
+/** The frame's emits proposed as open decisions in a folder that is not a venture (cases, constructed founders). */
+function proposeEmits(f, out, facts, v, kept, problem) {
+  const said = problem ? `The founder said: "${problem}". ` : "";
+  const summary = Object.entries(v.premises).map(([k, x]) => `${k} ${x.verdict}`).join("; ");
+  return f.emits.map((e) => {
+    const fromLookup = (e.options_from ?? "frame") === "lookup";
+    const options = fromLookup ? kept.map((o) => `${o.option} (${o.source}, ${o.as_of})`) : e.options;
+    const note = `${said}From the frame ${f.id}. Premises: ${summary}${v.dichotomy ? `; the trade reads as ${v.dichotomy.reading}` : ""}.`;
+    const r = propose(out, { id: e.id, question: e.question, ...(options?.length ? { options } : {}), ...(e.layer ? { layer: e.layer } : {}), ...(e.needed_in ? { needed_in: e.needed_in } : {}), note }, { agentId: "frames/runner", via: "mcp", harness: "mentura-frames" });
+    if (!r.ok) throw new Error(r.error);
+    return { id: e.id, question: e.question, options: options ?? [], from_lookup: fromLookup };
+  });
+}
+
+/** Code checks on one run, sent to LangSmith as feedback. */
+export function evals(f, run) {
+  const judged = Object.values(run.judged);
+  const known = judged.filter((j) => j.p != null);
+  const lookupOptions = run.proposed.filter((p) => p.from_lookup).flatMap((p) => p.options);
+  const fb = [
+    { key: "frame_has_no_answer", score: F.check(f).length ? 0 : 1 },
+    { key: "premises_judged", score: judged.length ? known.length / judged.length : 0, comment: `${known.length} of ${judged.length} propositions judged by Jev` },
+    { key: "jev_decisive", score: known.length ? known.filter((j) => j.p >= F.YES || j.p <= F.NO).length / known.length : 0, comment: "share judged at or above 0.7 or at or below 0.3" },
+    { key: "options_cited", score: lookupOptions.length && run.fresh.kept.every((o) => /^https?:\/\//.test(o.source)) ? 1 : 0, comment: `${run.fresh.kept.length} lookup options kept, ${run.fresh.dropped} dropped as uncited or stale` },
+    { key: "viability_judged", score: run.viability.options.length ? run.viability.options.filter((o) => o.available !== "unknown").length / run.viability.options.length : 0, comment: run.viability.summary },
+    { key: "founder_decides", score: run.records.every((r) => r.status === "open" && !r.answer) ? 1 : 0, comment: "no record is decided by an agent" },
+  ];
+  if (run.expect) {
+    const keys = Object.keys(run.expect);
+    const right = keys.filter((k) => run.got[k] === run.expect[k]).length;
+    fb.push({ key: "case_accuracy", score: keys.length ? right / keys.length : 0, comment: keys.map((k) => `${k}: expected ${run.expect[k]}, got ${run.got[k]}`).join("; ") });
+  }
+  // LangSmith takes scores to four decimal places at most.
+  return fb.map((x) => ({ ...x, score: Math.round(x.score * 1e4) / 1e4 }));
+}
+
+/** One frame against one founder: a venture, a case or a facts file. */
+export async function runFrame({ frameId, venture, caseId, caseObj = null, facts: given, problem, out }) {
+  const f = F.frameOf(frameId);
+  if (!f) throw new Error(`no frame ${frameId}; node schema/frames.mjs list shows them`);
+  const at = now(), spans = [];
+  const c = caseObj ?? (caseId ? (f.cases ?? []).find((x) => x.id === caseId) : null);
+  if (caseId && !c) throw new Error(`frame ${f.id} has no case ${caseId}`);
+  let facts = venture ? (await F.props(venture)).facts : c ? { ...c.facts } : { ...(given ?? {}) };
+  let filled = {};
+  if (problem && f.props.some((k) => missing(facts[k]))) {
+    const fr = agent("framer", framerPrompt(f, problem, facts)); spans.push(fr.span);
+    filled = Object.fromEntries(Object.entries(fr.out.facts ?? {}).filter(([k, x]) => f.props.includes(k) && missing(facts[k]) && !missing(x)));
+    facts = { ...facts, ...filled };
+  }
+  const at2 = agent("attacker", attackerPrompt(f, facts)); spans.push(at2.span);
+  const propositions = (at2.out.propositions ?? []).slice(0, 3).filter((p) => p.id && p.question);
+  const req = judgeRequest(f, facts, propositions);
+  const j = jev(req); spans.push(j.span);
+  const v = F.verdicts(f, j.answers, facts);
+  const p = (a) => (typeof a?.noul === "number" ? a.noul : null);
+  const judged = {
+    ...Object.fromEntries(Object.entries(v.premises).map(([k, x]) => [`premise:${k}`, { question: x.claim, attack: x.attack, p: x.p, verdict: x.verdict }])),
+    ...Object.fromEntries(propositions.map((x) => [`attack:${x.id}`, { question: x.question, attack: x.attack, p: p(j.answers[`attack:${x.id}`]), verdict: verdictOf(p(j.answers[`attack:${x.id}`])) }])),
+  };
+  const s = await scout(f, facts); spans.push(s.span);
+  const fresh = F.fresh(f, s.lookup);
+  const vreq = viabilityRequest(facts, fresh.kept);
+  const vj = Object.keys(vreq.questions).length ? jev(vreq) : { answers: {}, span: { name: "frames.jev", start: now(), end: now(), inputs: vreq, outputs: { skipped: "no options to judge" } } };
+  spans.push({ ...vj.span, name: "frames.viability" });
+  const viability = ladder(v.dichotomy, vreq, vj.answers);
+  const t0 = now();
+  let proposed, records;
+  if (venture) {
+    const r = await F.run(venture, { id: f.id, text: problem ?? undefined, lookup: s.lookup, agentId: "frames/runner", harness: "mentura-frames" });
+    if (!r.ok) throw new Error(r.error);
+    proposed = r.result.proposed.map((x) => ({ ...x, from_lookup: (f.emits.find((e) => e.id === x.id)?.options_from ?? "frame") === "lookup" }));
+    records = proposed.map((x) => load(join(venture, "decisions", `${x.id}.decision.json`)));
+  } else {
+    mkdirSync(out, { recursive: true });
+    proposed = proposeEmits(f, out, facts, v, fresh.kept, problem);
+    records = proposed.map((x) => load(join(out, "decisions", `${x.id}.decision.json`)));
+  }
+  const home = venture ?? out;
+  for (const x of proposed.filter((x) => x.from_lookup)) {
+    const rec = records.find((r) => r.id === x.id);
+    if (!rec) continue;
+    const per = viability.options.map((o) => `${o.option}: ${o.available === "unknown" ? "availability unknown" : o.available === "no" ? "ruled out by its source" : `reaches ${o.reached}`}`).join("; ");
+    const r = propose(home, { id: rec.id, question: rec.question, ...(rec.options ? { options: rec.options } : {}), note: `${rec.note} Viability: ${viability.summary}. ${per}.` }, { agentId: "frames/runner", via: "mcp", harness: "mentura-frames" });
+    if (r.ok) Object.assign(rec, load(join(home, "decisions", `${rec.id}.decision.json`)));
+  }
+  if (viability.next_steps.length) {
+    const r = propose(home, { id: `${f.id}-find-out-availability`, question: "How will the founder find out which of these options a provider will actually offer this venture?", options: viability.next_steps, note: `Desk research cannot show this. ${viability.summary}.` }, { agentId: "frames/runner", via: "mcp", harness: "mentura-frames" });
+    if (r.ok) { const rec = load(join(home, "decisions", `${f.id}-find-out-availability.decision.json`)); records.push(rec); proposed.push({ id: rec.id, question: rec.question, options: rec.options, from_lookup: false }); }
+  }
+  spans.push({ name: "frames.records", run_type: "chain", start: t0, end: now(), inputs: { via: venture ? "frames.run" : "decisions.propose" }, outputs: { proposed } });
+  const got = { ...Object.fromEntries(Object.entries(v.premises).map(([k, x]) => [k, x.verdict])), ...(v.dichotomy ? { dichotomy: v.dichotomy.reading } : {}) };
+  const run = { viability, frame: f.id, at, problem: problem ?? null, case: c?.id ?? null, facts, filled, judged, dichotomy: v.dichotomy, reframe: F.request(f, facts).state.frame, lookup: s.lookup, fresh, proposed, records, got, expect: c?.expect ?? null, jev_model: j.model };
+  const feedback = evals(f, run);
+  const trace = { name: `frames:${f.id}${c ? `:${c.id}` : ""}`, run_type: "chain", start: at, end: now(), inputs: { frame: f.id, case: c?.id ?? null, problem: problem ?? null, facts }, outputs: { dichotomy: v.dichotomy, verdicts: got, proposed: proposed.map((x) => x.id) }, children: spans, feedback, tags: ["frames", ...f.functions, ...(c ? ["case"] : []), ...(c?.provenance ? [c.provenance] : [])], metadata: { harness: "mentura-frames", jev_model: j.model } };
+  const where = out ?? venture;
+  mkdirSync(where, { recursive: true });
+  writeFileSync(join(where, `frames-run${c ? `.${c.id}` : ""}.json`), JSON.stringify({ ...run, feedback }, null, 2) + "\n");
+  writeFileSync(join(where, `frames-trace${c ? `.${c.id}` : ""}.json`), JSON.stringify(trace, null, 2) + "\n");
+  return { run, feedback, trace, tracePath: join(where, `frames-trace${c ? `.${c.id}` : ""}.json`) };
+}
+
+if (process.argv[1] && resolve(process.argv[1]) === new URL(import.meta.url).pathname) {
+  const frameId = arg("frame");
+  if (!frameId) { console.error("usage: node platform/agents/frames/run.mjs --frame <id> (--venture <dir> | --case <id> | --cases | --case-file <file> | --facts <file>) [--problem \"<words>\"] [--out <dir>] [--upload] [--project naive-frames]"); process.exit(2); }
+  const f = F.frameOf(frameId);
+  const out = arg("out") ? resolve(arg("out")) : join(process.cwd(), ".frames", `${frameId}-${Date.now()}`);
+  const venture = arg("venture") ? resolve(arg("venture")) : null;
+  const caseFiles = process.argv.flatMap((x, i) => (process.argv[i - 1] === "--case-file" ? [load(resolve(x))] : []));
+  const cases = caseFiles.length ? caseFiles.map((c) => c.id) : process.argv.includes("--cases") ? (f?.cases ?? []).map((c) => c.id) : arg("case") ? [arg("case")] : [null];
+  const results = [];
+  for (const caseId of cases) {
+    const r = await runFrame({ frameId, venture, caseId, caseObj: caseFiles.find((c) => c.id === caseId) ?? null, facts: arg("facts") ? load(arg("facts")) : null, problem: arg("problem"), out: venture ? null : (caseId ? join(out, caseId) : out) });
+    let uploaded = null;
+    if (process.argv.includes("--upload")) {
+      const p = spawnSync("node", [join(repo, "platform/integrations/langsmith.mjs"), r.tracePath, "--project", arg("project", "naive-frames")], { encoding: "utf8" });
+      uploaded = p.status === 0 ? JSON.parse(p.stdout) : { error: (p.stderr || "").trim() };
+    }
+    results.push({ case: caseId, dichotomy: r.run.dichotomy?.reading, verdicts: r.run.got, expect: r.run.expect, attacks: Object.entries(r.run.judged).filter(([k]) => k.startsWith("attack:")).map(([, x]) => `${x.verdict} ${x.p ?? "-"} ${x.question}`), lookup: `${r.run.fresh.kept.length} kept, ${r.run.fresh.dropped} dropped`, viability: r.run.viability.summary, proposed: r.run.proposed.map((x) => `${x.id} (${x.options.length} options)`), feedback: Object.fromEntries(r.feedback.map((x) => [x.key, Math.round(x.score * 100) / 100])), uploaded });
+  }
+  console.log(JSON.stringify({ frame: frameId, out: venture ?? out, results }, null, 2));
+}
