+#!/usr/bin/env node
+// A stand-in for the case reconstructor in tests (FRAMES_AGENT_CMD): answers like claude -p --output-format json.
+// The deals are invented; they only exercise the code's checks.
+let prompt = "";
+for await (const c of process.stdin) prompt += c;
+const good = { id: "pickle-co-royalty", title: "An invented pickle company takes a royalty deal", source_kind: "tv", when: "2015", facts: { phase: "beachhead", revenue: "400,000 USD a year", control_rights: "the recipe and the brand", extra_fact: "not a prop" }, what_happened: "An investor paid for a royalty on each jar instead of equity.", expect: { "needs-outside-money": "yes", "money-means-ownership": "no", "ownership-means-control": "unknown", "control-is-one-thing": "yes", dichotomy: "false" }, reasons: { dichotomy: "the money came without shares" }, sources: [{ url: "https://example.com/recap", says: "Recap: a royalty of one dollar per jar until repaid twice over." }] };
+const unsourced = { ...good, id: "no-source", sources: [] };
+const longQuote = { ...good, id: "long-quote", sources: [{ url: "https://example.com/t", says: "x".repeat(400) }] };
+const badLabel = { ...good, id: "bad-label", expect: { ...good.expect, dichotomy: "maybe" } };
+const cases = [good, unsourced, longQuote, badLabel].map((c) => ({ ...c, facts: Object.fromEntries(Object.entries(c.facts).filter(([k]) => k !== "extra_fact" || c.id !== "pickle-co-royalty")) }));
+console.log(JSON.stringify({ type: "result", is_error: false, result: JSON.stringify({ cases }) }));
