+#!/usr/bin/env node
+// Case reconstruction, offline: a stand-in agent, a temporary output folder, the code's checks.
+import { mkdtempSync, readdirSync, readFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+
+const here = new URL(".", import.meta.url).pathname;
+process.env.FRAMES_AGENT_CMD = `node ${join(here, "fixtures/agent.mjs")}`;
+const { reconstruct, reconstructPrompt, check, SAYS_MAX } = await import("./reconstruct.mjs");
+const F = await import(join(here, "../../../schema/frames.mjs"));
+
+let failed = 0;
+const expect = (what, ok) => { console.log(`${ok ? "pass" : "FAIL"}  ${what}`); if (!ok) failed++; };
+const frame = "fund-without-ceding-control", f = F.frameOf(frame);
+const out = mkdtempSync(join(tmpdir(), "cases-"));
+const { kept, dropped } = reconstruct({ frameId: frame, find: 4, out });
+
+expect("the prompt asks for facts as they stood at the decision and paraphrase only", reconstructPrompt(f, { find: 2 }).includes("WHEN THE DECISION WAS MADE") && reconstructPrompt(f, { find: 2 }).includes("No transcripts"));
+expect("a sourced case with known labels is kept", kept.length === 1 && kept[0].id === "pickle-co-royalty");
+expect("a case is reconstructed and draft until a person reviews it", kept[0].provenance === "reconstructed" && kept[0].status === "draft");
+expect("missing props read 'not on record'", f.props.every((k) => k in kept[0].facts) && kept[0].facts.runway === "not on record");
+expect("a case without a source is dropped", dropped.some((d) => d.id === "no-source"));
+expect(`a source note over ${SAYS_MAX} characters is dropped`, dropped.some((d) => d.id === "long-quote"));
+expect("an unknown dichotomy label is dropped", dropped.some((d) => d.id === "bad-label"));
+expect("facts the frame does not have are a problem", check(f, { ...kept[0], facts: { ...kept[0].facts, extra: "x" } }).some((p) => p.includes("extra")));
+expect("the kept case is written as a case file", readdirSync(out).join() === "pickle-co-royalty.case.json" && JSON.parse(readFileSync(join(out, "pickle-co-royalty.case.json"), "utf8")).expect.dichotomy === "false");
+
+if (failed) { console.error(`${failed} failed`); process.exit(1); }
+console.log("all passing");
