new file mode 100644
index 0000000..74d6b8b
--- /dev/null
+++ b/schema/examples/frames/judge.mjs
@@ -0,0 +1,10 @@
+#!/usr/bin/env node
+// A stand-in judge for the frames test (the Jev protocol): reads one request on stdin and answers every
+// noul question from the facts it was given, without a model. A premise is unknown (0.5) when a fact it
+// could rest on says "not on record", else no (0.1); the trade reads as a sequence.
+let input = "";
+for await (const c of process.stdin) input += c;
+const req = JSON.parse(input);
+const unknown = Object.values(req.state.venture ?? {}).some((v) => v === "not on record");
+const answers = Object.fromEntries(Object.keys(req.questions).map((k) => [k, { noul: k.startsWith("dichotomy:") ? (k === "dichotomy:sequence" ? 0.9 : 0.1) : k === "premise:needs-outside-money" && unknown ? 0.5 : 0.1 }]));
+console.log(JSON.stringify({ model: "stand-in", answers }));
diff --git a/schema/examples/venture-type/jev.mjs b/schema/examples/venture-type/jev.mjs
new file mode 100644
index 0000000..5c18c02
--- /dev/null
+++ b/schema/examples/venture-type/jev.mjs
@@ -0,0 +1,12 @@
+#!/usr/bin/env node
+// A stand-in for Jev in tests (MENTURA_TYPE_CMD="node schema/examples/venture-type/jev.mjs"): reads the
+// typed request on stdin and answers each type:<id> question yes when the description uses one of that
+// type's examples, so the classifier's ranking and its uncertain path can be tested offline.
+import { readFileSync } from "node:fs";
+let input = "";
+for await (const c of process.stdin) input += c;
+const req = JSON.parse(input);
+const words = req.state.venture.description.toLowerCase();
+const types = JSON.parse(readFileSync(new URL("../../venture-types.json", import.meta.url), "utf8")).types;
+const answers = Object.fromEntries(types.map((t) => [`type:${t.id}`, { noul: t.examples.some((e) => words.includes(e.toLowerCase())) ? 0.92 : 0.04 }]));
+console.log(JSON.stringify({ model: "stand-in", answers }));
