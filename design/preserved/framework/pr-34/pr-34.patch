+  let root;
+  try { root = new URL(base); } catch { throw new Error(`${base} is not a URL`); }
+  if (!/^https?:$/.test(root.protocol)) throw new Error(`${base} is not an http or https URL`);
+  const origin = base.replace(/\/+$/, "");
+  const lastmod = /^\d{4}-\d{2}-\d{2}/.test(record.planned_at ?? "") ? record.planned_at.slice(0, 10) : null;
+  const pages = [...record.pages].sort((a, b) => (a.level === "home" ? -1 : b.level === "home" ? 1 : 0));
+  const urls = pages.map((p) => {
+    const path = p.path.startsWith("/") ? p.path : `/${p.path}`;
+    return `  <url>\n    <loc>${xmlEscape(origin + (path === "/" ? "/" : path))}</loc>${lastmod ? `\n    <lastmod>${lastmod}</lastmod>` : ""}\n  </url>`;
+  });
+  return `<?xml version="1.0" encoding="UTF-8"?>\n<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">\n${urls.join("\n")}\n</urlset>\n`;
+}
+
+// ---------------------------------------------------------------------------------------------
+
+if (import.meta.url === `file://${process.argv[1]}`) {
+  const argv = process.argv.slice(2);
+  const opt = (n) => { const i = argv.indexOf(`--${n}`); return i >= 0 ? argv[i + 1] : undefined; };
+  const json = argv.includes("--json");
+  const dir = argv[0];
+  const mode = argv[1] && !argv[1].startsWith("--") ? argv[1] : null;
+  if (!dir || !existsSync(join(dir, "venture.json"))) { console.error("usage: node schema/brand.mjs <venture dir> tokens|voice|check | --for <route> | --package <id> | --base <url> [--json]"); process.exit(2); }
+  const print = (x, text) => console.log(json ? JSON.stringify(x, null, 2) : text ?? JSON.stringify(x, null, 2));
+  if (opt("for") !== undefined) {
+    const brand = brandOf(dir);
+    if (!brand) { console.error(`no brand yet: write ${BRAND} (mentura marketing/brand template)`); process.exit(1); }
+    print(resolveBrand(brand, opt("for")));
+  } else if (opt("package") !== undefined) {
+    const t = termsFor(dir, opt("package"));
+    print(t, t.terms.map((x) => `${x.term.padEnd(24)} ${x.from.padEnd(12)} ${x.meaning}`).join("\n") || `no terms reach ${opt("package")}`);
+  } else if (opt("base") !== undefined) {
+    const s = sitemapOf(dir);
+    if (!s) { console.error("no marketing sitemap yet: plan it (mentura operations/marketing/sitemap run) and write marketing/sitemap.json"); process.exit(1); }
+    let xml;
+    try { xml = sitemapXml(s.record, opt("base")); } catch (e) { console.error(e.message); process.exit(1); }
+    print({ from: s.file, pages: s.record.pages.length, xml }, xml);
+  } else if (mode === "tokens") {
+    const t = tokens(dir);
+    if (!t) { console.error(`no brand yet: write ${BRAND}`); process.exit(1); }
+    print(t, t.css);
+  } else if (mode === "voice") {
+    const v = voice(dir);
+    print(v, v.violations.map((x) => `${x.file}:${x.line}  "${x.found}" (${x.rule})${x.use ? ` -> ${x.use}` : ""}`).join("\n") || `voice: ${v.files} files keep to the voice rules`);
+  } else {
+    const r = checkBrand(dir);
+    if (json) console.log(JSON.stringify(r, null, 2));
+    else {
+      for (const e of r.errors) console.log(`error  ${e}`);
+      for (const w of r.warnings) console.log(`warn   ${w}`);
+      console.log(r.ok ? `brand: ${r.brand ? "tokens, typefaces, marks, design systems and voice check out" : "no brand record yet; glossaries check out"}` : `brand: ${r.errors.length} errors`);
+    }
+    process.exit(r.ok ? 0 : 1);
+  }
+}
diff --git a/schema/build-release.mjs b/schema/build-release.mjs
new file mode 100644
index 0000000..495a3f9
--- /dev/null
+++ b/schema/build-release.mjs
@@ -0,0 +1,61 @@
+#!/usr/bin/env node
+// naive build (I-17, C-13): checks every open package can be released, then writes the release to
+// <venture>/.release/: release.json (the manifest: confirmed records frozen in, named live holes, the
+// route table as the release holds it), records/ (the frozen copies) and card.json (the release card).
+// It refuses, exit 1, when a record in an open package is unconfirmed or a check fails, and names each
+// one with the command that settles it. The rules are in schema/releases.mjs.
+//
+//   node schema/build-release.mjs <venture dir> [--now <iso time>] [--json] [--dry-run]
+//   node schema/build-release.mjs <venture dir> --add <route>       add one new item without rebuilding (C-18)
+//   node schema/build-release.mjs <venture dir> --export <out dir>  the release as plain files, no holes (Z-3)
+//
+// --port is accepted and ignored, so naive build and naive start can pass the same arguments.
+
+import { existsSync } from "node:fs";
+import { join } from "node:path";
+import { add, build, exportRelease } from "./releases.mjs";
+
+const args = process.argv.slice(2);
+const opt = (n) => { const i = args.indexOf(`--${n}`); return i >= 0 ? args[i + 1] : undefined; };
+const has = (n) => args.includes(`--${n}`);
+const values = new Set(["now", "add", "export", "port"].flatMap((n) => (opt(n) !== undefined ? [opt(n)] : [])));
+const dir = args.find((a) => !a.startsWith("--") && !values.has(a));
+if (!dir || !existsSync(join(dir, "venture.json"))) {
+  console.error("usage: node schema/build-release.mjs <venture dir> [--now <iso>] [--json] [--dry-run] | --add <route> | --export <out dir>");
+  process.exit(2);
+}
+const actor = process.env.MENTURA_ACTOR === "agent" ? "agent" : "person";
+const now = opt("now") ?? new Date().toISOString();
+if (opt("now") && Number.isNaN(Date.parse(opt("now")))) { console.error(`--now ${opt("now")} is not a time`); process.exit(2); }
+
+if (opt("export")) {
+  const r = exportRelease(dir, opt("export"));
+  if (!r.ok) { console.error(r.error); process.exit(1); }
+  console.log(has("json") ? JSON.stringify(r, null, 2) : `exported ${r.records} records to ${r.out}; ${r.left_out_live} live items left out`);
+  process.exit(0);
+}
+
+if (opt("add")) {
+  const r = await add(dir, opt("add"), { now, actor });
+  if (!r.ok) { console.error(r.error + (r.fix ? `\n  fix: ${r.fix}` : "")); process.exit(1); }
+  console.log(has("json") ? JSON.stringify(r.manifest, null, 2) : `added ${r.added.route} to release ${r.added.from}: now release ${r.manifest.release}; nothing else was rebuilt`);
+  process.exit(0);
+}
+
+const r = await build(dir, { now, actor, dryRun: has("dry-run") });
+if (!r.ok) {
+  if (r.error) { console.error(r.error); process.exit(1); }
+  if (has("json")) console.log(JSON.stringify(r, null, 2));
+  console.error("naive build: no release written.");
+  for (const p of r.packages.filter((x) => !x.releasable)) console.error(`  package ${p.id} cannot be released:`);
+  for (const b of r.blockers) console.error(`    ${b.file}: ${b.why}\n      fix: ${b.fix}`);
+  for (const c of r.failed_checks) console.error(`  check ${c.check} failed:\n    ${c.output.replace(/\n/g, "\n    ")}`);
+  process.exit(1);
+}
+const m = r.manifest;
+if (has("json")) { console.log(JSON.stringify(m, null, 2)); process.exit(0); }
+console.log(`${r.dry_run ? "would write" : "wrote"} release ${m.release} for ${m.venture} (${m.phase}) as of ${m.now}`);
+console.log(`  ${m.records.length} records frozen, ${m.holes.length} live holes, ${m.left_out.length} files left out`);
+for (const p of m.packages) console.log(`  package ${p.id.padEnd(12)} ${p.releasable ? "released" : "blocked"}  shell ${p.shell ?? "empty"}${p.gaps.length ? `  not written yet: ${p.gaps.join(", ")}` : ""}`);
+for (const h of m.holes) console.log(`  hole ${h.kind.padEnd(9)} ${h.name}: ${h.why}`);
+console.log(`  cache: ${m.cache.hits} hits, ${m.cache.misses} misses${m.cache.fresh ? " (started fresh: new framework, packages or model)" : ""}`);
