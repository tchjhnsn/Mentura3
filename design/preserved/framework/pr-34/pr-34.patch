+const fixed = { "premise:needs-outside-money": 0.55, "premise:money-means-ownership": 0.12, "premise:ownership-means-control": 0.2, "premise:control-is-one-thing": 0.9, "dichotomy:false": 0.85, "dichotomy:trade-off": 0.2, "dichotomy:sequence": 0.4, "attack:growth-reaches-goal": 0.05, "available:o1": 0.1, "acceptable:o1": 0.95, "available:o2": 0.9, "acceptable:o2": 0.8 };
