+  /** The person who made this lead a prospect; required from prospect on. An agent ranks leads (fit) but never qualifies one */
+  qualified_by?: string;
+  /** How good a lead this is. A draft until a person confirms it; an agent may rank, never confirm its own rank */
+  fit?: {
