+++ b/schema/discovery-meeting.schema.json
@@ -0,0 +1,47 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "discovery-meeting.schema.json",
+  "title": "Discovery meeting",
+  "description": "One discovery conversation, planned and then held, at <venture>/validation/discovery/meetings/<id>.json: when, the script (questions tagged to the hypotheses they test), what the interviewer predicts they will hear, and afterwards the recording's raw source, the validation interview filed from it, and the introduction asked for. No pitch: the playbook keeps Naive, Mentura and the puzzle out of these meetings.",
+  "type": "object",
+  "required": ["id", "person", "at", "status", "script"],
+  "additionalProperties": false,
+  "properties": {
+    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "Equal to the file name" },
+    "person": { "type": "string", "pattern": "^p-[a-z0-9-]+$" },
+    "at": { "type": "string", "format": "date-time" },
+    "minutes": { "type": "integer", "minimum": 5 },
+    "medium": { "enum": ["in-person", "video", "phone"] },
+    "status": { "enum": ["planned", "held", "cancelled", "no-show"] },
+    "script": {
+      "type": "array",
+      "minItems": 1,
+      "items": {
+        "type": "object",
+        "required": ["ask", "tests"],
+        "additionalProperties": false,
+        "properties": {
+          "ask": { "type": "string", "minLength": 1 },
+          "tests": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Hypothesis ids the answer bears on (H1, H2, price-anchor) or problem-interview for the template's questions" }
+        }
+      }
+    },
+    "prediction": { "type": "string", "description": "What the interviewer expects to hear, written before the meeting, so the answers can surprise" },
+    "recording": {
+      "type": "object",
+      "required": ["source"],
+      "additionalProperties": false,
+      "properties": { "source": { "type": "string", "description": "The raw source id (raw/sources/<id>); the recording and notes are cited, never copied" } }
+    },
+    "interview": { "type": "string", "description": "The validation interview id (validation/interviews/<id>.json) filed from this meeting" },
+    "introduction": {
+      "type": "object",
+      "required": ["asked"],
+      "additionalProperties": false,
+      "properties": {
+        "asked": { "type": "boolean" },
+        "given": { "type": "string", "pattern": "^p-[a-z0-9-]+$", "description": "The lead they introduced" }
+      }
+    }
+  }
+}
diff --git a/schema/discovery-test.ts b/schema/discovery-test.ts
new file mode 100644
index 00000000..78e653b1
--- /dev/null
+++ b/schema/discovery-test.ts
@@ -0,0 +1,170 @@
+// Tests the Discovery workflow (schema/discovery.ts): the LinkedIn export import keeps names in _private/,
+// the checks fail what they must, and the packet keeps checked facts apart from agent drafts.
+//
+//   node schema/discovery-test.ts
+
+import { spawnSync } from "node:child_process";
+import { mkdirSync, mkdtempSync, readFileSync, readdirSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { dirname, join } from "node:path";
+import { routes } from "../interface/router.mjs";
+import { check, exportDate, funnel, importConnections, packet, parseConnections, planMeeting } from "./discovery.ts";
+
+const repo = new URL("..", import.meta.url).pathname;
+let failed = 0;
+const expect = (name: string, ok: boolean, detail = ""): void => { console.log(`${ok ? "pass" : "FAIL"}  ${name}${ok ? "" : `  ${detail}`}`); if (!ok) failed++; };
+const put = (f: string, o: unknown): void => { mkdirSync(dirname(f), { recursive: true }); writeFileSync(f, JSON.stringify(o, null, 2) + "\n"); };
+const read = (f: string): Record<string, unknown> => JSON.parse(readFileSync(f, "utf8")) as Record<string, unknown>;
+const valid = (schema: string, f: string): boolean => spawnSync("python3", ["-I", join(repo, "schema/validate.py"), "--schema", schema, "--file", f], { encoding: "utf8" }).status === 0;
+
+const dir = mkdtempSync(join(tmpdir(), "discovery-test-"));
+put(join(dir, "venture.json"), { id: "dv", name: "Discovery test" });
+put(join(dir, "foundation/icp/early-founders.json"), { id: "early-founders" });
+
+// The export as LinkedIn describes it: notes above the header, quoted fields, "31 Oct 2026" dates.
+const csv = [
+  "Notes:",
+  "\"When exporting your connection data, you may notice that some of the email addresses are missing.\"",
+  "",
+  "First Name,Last Name,URL,Email Address,Company,Position,Connected On",
+  "Ada,Quill,https://www.linkedin.com/in/ada-quill,,Quill Labs,Founder & CEO,12 Mar 2025",
+  "Ben,Ortiz,https://www.linkedin.com/in/ben-ortiz,ben@example.com,\"Ortiz, Ltd\",Software Engineer,01 Jan 2024",
+  "Cam,Rhee,https://www.linkedin.com/in/cam-rhee,,Rhee Co,Co-founder,5 Oct 2026",
+].join("\n");
+
+{
+  const rows = parseConnections(csv);
+  expect("the export's notes are skipped and every row is read", rows.length === 3, JSON.stringify(rows));
+  expect("a quoted company with a comma stays one field", rows[1]?.company === "Ortiz, Ltd", String(rows[1]?.company));
+  expect("export dates become ISO dates", rows[0]?.connected_on === "2025-03-12" && exportDate("5 Oct 2026") === "2026-10-05");
+  expect("an unknown date form is left out, not guessed", exportDate("03/12/25") === undefined);
+  let threw = false;
+  try { parseConnections("a,b\n1,2"); } catch { threw = true; }
+  expect("a file that is not the export is refused", threw);
+}
+
+// A connections list the founder compiled (for example with an agent): other columns, "October 31, 2026" dates.
+{
+  const list = ["name,headline,profile_url,connected_on", "\"Dee Park\",\"Founder | Building with agents\",\"https://www.linkedin.com/in/dee-park\",\"October 31, 2026\""].join("\n");
+  const rows = parseConnections(list);
+  expect("a founder's own connections list is read too", rows.length === 1 && rows[0]?.name === "Dee Park" && rows[0]?.position === "Founder | Building with agents" && rows[0]?.connected_on === "2026-10-31", JSON.stringify(rows));
+  const other = mkdtempSync(join(tmpdir(), "discovery-list-"));
+  const r = importConnections(other, list, { icp: "early-founders" });
+  expect("its contacts say where they came from", read(join(other, `_private/people/${r.created[0]}.json`)).imported !== undefined && (read(join(other, `_private/people/${r.created[0]}.json`)).imported as { from: string }).from === "connections-list");
+  expect("its contact validates against its schema", valid("discovery-contact.schema.json", join(other, `_private/people/${r.created[0]}.json`)));
+  rmSync(other, { recursive: true, force: true });
+}
+
+const imported = importConnections(dir, csv, { icp: "early-founders", match: /founder/i, now: new Date("2026-10-31T12:00:00Z") });
+const [ada, cam] = imported.created;
+{
+  expect("only founders are imported when --match founder", imported.created.length === 2, JSON.stringify(imported));
+  const lead = readFileSync(join(dir, `validation/discovery/leads/${ada}.json`), "utf8");
+  expect("the lead record holds an opaque id and no name or link", /^p-[0-9a-f]{8}$/.test(ada ?? "") && !/Ada|Quill|linkedin/i.test(lead.replace("linkedin-connections-export", "")), lead);
+  const contact = read(join(dir, `_private/people/${ada}.json`));
+  expect("the name sits in _private/people/, marked private", contact.private === true && contact.name === "Ada Quill");
+  expect("the lead validates against its schema", valid("discovery-lead.schema.json", join(dir, `validation/discovery/leads/${ada}.json`)));
+  expect("the contact validates against its schema", valid("discovery-contact.schema.json", join(dir, `_private/people/${ada}.json`)));
+  const again = importConnections(dir, csv, { icp: "early-founders", match: /founder/i });
+  expect("a second import of the same export adds no one", again.created.length === 0 && again.skipped === 2, JSON.stringify(again));
+  expect("a clean import passes the checks", check(dir).length === 0, check(dir).join("; "));
+}
+
+// A dossier an agent compiled, one fact checked by a person.
+const dossierFile = join(dir, `validation/discovery/dossiers/${ada}.json`);
+const dossier = {
+  id: ada, person: ada,
+  compiled: { at: "2026-10-31T13:00:00Z", by: { kind: "agent", id: "research-agent" } },
+  facts: [
+    { about: "venture", claim: "Raised a pre-seed round in 2025", source: { url: "https://example.com/news/quill-labs-pre-seed", retrieved: "2026-10-31T13:00:00Z" }, status: "confirmed", confirmed_by: "torian" },
+    { about: "team", claim: "Two engineers on the team", source: { url: "https://example.com/quill-labs/about", retrieved: "2026-10-31T13:00:00Z" }, status: "draft" },
+  ],
+  something_special: "Has sold to hospital procurement before",
+  questions: ["How was the pre-seed paid back in time spent raising?"],
+};
+put(dossierFile, dossier);
+expect("the dossier validates against its schema", valid("discovery-dossier.schema.json", dossierFile));
+expect("a sourced dossier with a person's check passes", check(dir).length === 0, check(dir).join("; "));
+
+const failsWith = (name: string, mutate: () => void, pattern: RegExp): void => {
+  const saved = readdirSync(dir, { recursive: true, withFileTypes: true }).filter((e) => e.isFile()).map((e) => { const f = join(e.parentPath, e.name); return [f, readFileSync(f, "utf8")] as const; });
+  mutate();
+  const problems = check(dir);
+  expect(name, problems.some((p) => pattern.test(p)), problems.join("; ") || "no problems found");
+  rmSync(dir, { recursive: true, force: true });
+  for (const [f, text] of saved) { mkdirSync(dirname(f), { recursive: true }); writeFileSync(f, text); }
+};
+
+failsWith("a fact confirmed by the agent that compiled it fails", () => put(dossierFile, { ...dossier, facts: [{ ...dossier.facts[0], confirmed_by: "research-agent" }] }), /confirmed by the agent/);
+failsWith("a fact an agent sourced from a linkedin.com page fails (no LinkedIn scraping)", () => put(dossierFile, { ...dossier, facts: [{ ...dossier.facts[1], source: { url: "https://www.linkedin.com/in/ada-quill", retrieved: "2026-10-31T13:00:00Z" } }] }), /linkedin\.com/);
