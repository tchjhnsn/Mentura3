diff --git a/schema/discovery-contact.schema.json b/schema/discovery-contact.schema.json
new file mode 100644
index 00000000..0e108558
--- /dev/null
+++ b/schema/discovery-contact.schema.json
@@ -0,0 +1,28 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "discovery-contact.schema.json",
+  "title": "Discovery contact (private)",
+  "description": "The real person behind a lead's opaque id, at <venture>/_private/people/<person>.json. private is always true, so the record never reaches a model and never ships in a release (EE-073). Filled from the founder's own LinkedIn data export, from a connections list the founder compiled, or typed by a person. Naive itself never fetches LinkedIn.",
+  "type": "object",
+  "required": ["id", "private", "name"],
+  "additionalProperties": false,
+  "properties": {
+    "id": { "type": "string", "pattern": "^p-[a-z0-9-]+$" },
+    "private": { "const": true },
+    "name": { "type": "string", "minLength": 1 },
+    "profile_url": { "type": "string" },
+    "email": { "type": "string" },
+    "company": { "type": "string" },
+    "position": { "type": "string" },
+    "connected_on": { "type": "string", "format": "date" },
+    "imported": {
+      "type": "object",
+      "required": ["from", "at"],
+      "additionalProperties": false,
+      "properties": {
+        "from": { "enum": ["linkedin-connections-export", "connections-list", "typed"], "description": "LinkedIn's own export, a connections list the founder compiled (for example with an agent), or typed by a person" },
+        "at": { "type": "string", "format": "date-time" }
+      }
+    }
+  }
+}
diff --git a/schema/discovery-dossier.schema.json b/schema/discovery-dossier.schema.json
new file mode 100644
index 00000000..ee0f14b2
--- /dev/null
+++ b/schema/discovery-dossier.schema.json
@@ -0,0 +1,57 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "discovery-dossier.schema.json",
+  "title": "Discovery dossier",
+  "description": "What is known about a lead and their venture before a discovery meeting, at <venture>/validation/discovery/dossiers/<person>.json. Every fact cites a public source and stays a draft until a person confirms it, so agent research is never read as the founder's own claim. Posture: they have something special, and we look for where we fit into their puzzle, not where they fit into ours.",
+  "type": "object",
+  "required": ["id", "person", "compiled", "facts"],
+  "additionalProperties": false,
+  "properties": {
+    "id": { "type": "string", "pattern": "^p-[a-z0-9-]+$", "description": "Equal to the person id and the file name" },
+    "person": { "type": "string", "pattern": "^p-[a-z0-9-]+$" },
+    "compiled": {
+      "type": "object",
+      "required": ["at", "by"],
+      "additionalProperties": false,
+      "properties": {
+        "at": { "type": "string", "format": "date-time" },
+        "by": {
+          "type": "object",
+          "required": ["kind", "id"],
+          "additionalProperties": false,
+          "properties": { "kind": { "enum": ["person", "agent"] }, "id": { "type": "string" } }
+        }
+      }
+    },
+    "facts": {
+      "type": "array",
+      "items": {
+        "type": "object",
+        "required": ["about", "claim", "source", "status"],
+        "additionalProperties": false,
+        "properties": {
+          "about": { "enum": ["founder", "team", "venture", "market", "money", "other"] },
+          "claim": { "type": "string", "minLength": 1 },
+          "source": {
+            "type": "object",
+            "required": ["url", "retrieved"],
+            "additionalProperties": false,
+            "properties": {
+              "url": { "type": "string", "minLength": 1, "description": "A public page, a reference id (ref:<id>), or the founder's own export (export:linkedin)" },
+              "retrieved": { "type": "string", "format": "date-time" },
+              "quote": { "type": "string", "description": "The exact words the claim rests on" }
+            }
+          },
+          "status": { "enum": ["draft", "confirmed", "rejected"] },
+          "confirmed_by": { "type": "string", "description": "The person who checked it; required when confirmed" }
+        }
+      }
+    },
+    "something_special": { "type": "string", "description": "A draft guess at what this founder has that others do not; the meeting tests it, it is never told to them" },
+    "questions": {
+      "type": "array",
+      "items": { "type": "string", "minLength": 1 },
+      "description": "Gaps the meeting could close, phrased as past facts to ask about"
+    }
+  }
+}
diff --git a/schema/discovery-lead.schema.json b/schema/discovery-lead.schema.json
new file mode 100644
index 00000000..5982aa61
--- /dev/null
+++ b/schema/discovery-lead.schema.json
@@ -0,0 +1,190 @@
+{
+  "$schema": "https://json-schema.org/draft/2020-12/schema",
+  "$id": "discovery-lead.schema.json",
+  "title": "Discovery lead or prospect",
+  "description": "One person the venture may talk to in Discovery, at <venture>/validation/discovery/leads/<person>.json. Everyone imported starts as a lead (status new); when a person qualifies one it becomes a prospect, as in common CRM usage. Agents may rank leads, never qualify them. It holds only an opaque person id: the name, profile link, email and company sit in _private/people/<person>.json, which never reaches a model or a release. The outreach log is evidence too: who was asked, through which channel, and who said yes (Mentura discovery playbook, 2026-10-31).",
+  "type": "object",
+  "required": [
+    "id",
+    "icp",
+    "group",
+    "status"
+  ],
+  "additionalProperties": false,
+  "properties": {
+    "id": {
+      "type": "string",
+      "pattern": "^p-[a-z0-9-]+$",
+      "description": "The opaque person id, equal to the file name; never a name or contact detail"
+    },
+    "icp": {
+      "type": "string",
+      "description": "The ideal customer profile id (foundation/icp/<id>.json) this person is recruited against"
+    },
+    "group": {
+      "enum": [
+        "own-network",
+        "community",
+        "cold"
+      ],
+      "description": "How the founder was found, so the answers are not all from people who like the interviewer: your own network, a community (Capital Factory, Antler, a meetup), or someone who owes you nothing"
+    },
+    "role": {
+      "enum": [
+        "founder",
+        "builder",
+        "partner",
+        "connector",
+        "investor",
+        "other"
+      ],
+      "description": "Why they matter: a founder to interview, a builder in the ICP who is not yet a founder, a partner the venture works with, a connector who leads to more founders, an investor"
+    },
+    "community": {
+      "type": "string",
+      "description": "Which community, when group is community"
+    },
+    "money": {
+      "enum": [
+        "raising",
+        "bootstrapping",
+        "stopped",
+        "unknown"
+      ],
+      "description": "What the founder is doing about money now; interviewing only survivors biases the answers"
+    },
+    "status": {
+      "enum": [
+        "new",
+        "prospect",
+        "asked",
+        "accepted",
+        "declined",
+        "no-reply",
+        "interviewed",
+        "dropped"
+      ],
+      "description": "new: a lead, imported and not yet qualified; prospect: a person qualified them for outreach (qualified_by); the rest follow outreach; dropped: not a fit, say why in the note"
+    },
+    "qualified_by": {
+      "type": "string",
+      "description": "The person who made this lead a prospect; required from prospect on. An agent ranks leads (fit) but never qualifies one"
+    },
+    "fit": {
+      "type": "object",
+      "required": [
+        "rank",
+        "reasons",
+        "by"
+      ],
+      "additionalProperties": false,
+      "description": "How good a lead this is. A draft until a person confirms it; an agent may rank, never confirm its own rank",
+      "properties": {
+        "rank": {
+          "enum": [
+            "high",
+            "medium",
+            "low"
+          ]
+        },
+        "reasons": {
+          "type": "array",
+          "minItems": 1,
+          "items": {
+            "type": "string",
+            "minLength": 1
+          }
+        },
+        "signals": {
+          "type": "array",
+          "items": {
+            "type": "string"
+          },
+          "description": "Evidence the lead already sees what we see (the economics of intelligence), with where it was seen; stays a draft like the rest"
+        },
+        "by": {
+          "type": "object",
+          "required": [
+            "kind",
+            "id"
+          ],
+          "additionalProperties": false,
+          "properties": {
+            "kind": {
+              "enum": [
+                "person",
+                "agent"
+              ]
+            },
+            "id": {
+              "type": "string"
+            }
+          }
+        },
+        "confirmed_by": {
+          "type": "string",
+          "description": "The person who agreed with the rank"
+        }
+      }
+    },
+    "source": {
+      "type": "string",
+      "description": "Where the lead came from: linkedin-connections-export, an introduction, an event, a person's own note"
+    },
+    "intro_from": {
+      "type": "string",
+      "pattern": "^p-[a-z0-9-]+$",
+      "description": "The person who introduced them; a given introduction is a commitment"
+    },
+    "outreach": {
+      "type": "array",
+      "items": {
+        "type": "object",
+        "required": [
+          "at",
+          "channel",
+          "outcome"
+        ],
+        "additionalProperties": false,
+        "properties": {
+          "at": {
+            "type": "string",
+            "format": "date"
+          },
+          "channel": {
+            "enum": [
+              "linkedin-message",
+              "email",
+              "introduction",
+              "in-person",
+              "event",
+              "other"
+            ]
+          },
+          "outcome": {
+            "enum": [
+              "pending",
+              "no-reply",
+              "declined",
+              "accepted"
+            ]
+          },
+          "sent_by": {
+            "type": "string",
+            "description": "The person who sent it; an agent may draft outreach, a person sends it"
+          }
+        }
+      }
+    },
+    "meetings": {
+      "type": "array",
+      "items": {
+        "type": "string"
+      },
+      "description": "Discovery meeting ids (validation/discovery/meetings/<id>.json)"
+    },
+    "note": {
+      "type": "string"
+    }
+  }
+}
diff --git a/schema/discovery-meeting.schema.json b/schema/discovery-meeting.schema.json
new file mode 100644
