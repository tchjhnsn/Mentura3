+     */
+    at: string;
+  };
+};
+
+/** What is known about a lead and their venture before a discovery meeting, at <venture>/validation/discovery/dossiers/<person>.json. Every fact cites a public source and stays a draft until a person confirms it, so agent research is never read as the founder's own claim. Posture: they have something special, and we look for where we fit into their puzzle, not where they fit into ours. */
+export type DiscoveryDossier = {
+  /** Equal to the person id and the file name */
+  id: string;
+  person: string;
+  compiled: {
+    /**
+     * @format date-time
+     */
+    at: string;
+    by: {
+      kind: "person" | "agent";
+      id: string;
+    };
+  };
+  facts: {
+    about: "founder" | "team" | "venture" | "market" | "money" | "other";
+    claim: string;
+    source: {
+      /** A public page, a reference id (ref:<id>), or the founder's own export (export:linkedin) */
+      url: string;
+      /**
+       * @format date-time
+       */
+      retrieved: string;
+      /** The exact words the claim rests on */
+      quote?: string;
+    };
+    status: "draft" | "confirmed" | "rejected";
