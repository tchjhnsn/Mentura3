+  status: "planned" | "held" | "cancelled" | "no-show";
+  script: {
+    ask: string;
+    /** Hypothesis ids the answer bears on (H1, H2, price-anchor) or problem-interview for the template's questions */
+    tests: string[];
+  }[];
+  /** What the interviewer expects to hear, written before the meeting, so the answers can surprise */
+  prediction?: string;
+  recording?: {
+    /** The raw source id (raw/sources/<id>); the recording and notes are cited, never copied */
+    source: string;
+  };
+  /** The validation interview id (validation/interviews/<id>.json) filed from this meeting */
+  interview?: string;
+  introduction?: {
+    asked: boolean;
+    /** The lead they introduced */
+    given?: string;
+  };
+};
