+/** The real person behind a lead's opaque id, at <venture>/_private/people/<person>.json. private is always true, so the record never reaches a model and never ships in a release (EE-073). Filled from the founder's own LinkedIn data export, from a connections list the founder compiled, or typed by a person. Naive itself never fetches LinkedIn. */
+export type DiscoveryContact = {
+  id: string;
+  private: true;
+  name: string;
+  profile_url?: string;
+  email?: string;
+  company?: string;
+  position?: string;
+  /**
+   * @format date
+   */
