+// The Discovery workflow for interviewing founders (Mentura discovery playbook, 2026-10-31): leads,
+// dossiers, meetings and the packet read before a meeting. A lead is an opaque person id (p-xxxx);
+// the real name and profile sit in _private/people/<id>.json, which never reaches a model or a release.
+//
+//   node schema/discovery.ts check <dir>                                   a venture or a folder of ventures
+//   node schema/discovery.ts import <venture> <Connections.csv> --icp <id> [--match <regex>] [--group own-network]
+//   node schema/discovery.ts plan <venture> --person <p-id> --at <date-time> [--medium video] [--minutes 25] [--prediction <text>]
+//   node schema/discovery.ts packet <venture> <meeting id> [--names]
+//   node schema/discovery.ts funnel <venture>
+//
+// import reads the founder's own LinkedIn data export (Settings, Data privacy, Get a copy of your data,
+// Connections), or a connections list the founder compiled (name, headline, profile_url, connected_on). Nothing here fetches LinkedIn, and check fails a dossier fact an agent sourced from a
+// linkedin.com page (standing rule: no LinkedIn scraping). The export's columns are inferred from public
+// descriptions of it (First Name, Last Name, URL, Email Address, Company, Position, Connected On, after a few
+// lines of notes); check them against a real export before relying on the import.
+//
+// The packet is a view, not a record: it is rebuilt from the records each time. Without --names it holds
+// person ids only. With --names it reads _private/, so keep that copy for the person and off any model.
+
+import { randomBytes } from "node:crypto";
+import { existsSync, mkdirSync, readdirSync, readFileSync, writeFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { ventureFile } from "./venture-paths.mjs";
+import type { DiscoveryContact, DiscoveryDossier, DiscoveryMeeting, DiscoveryLead, ValidationInterview } from "./types/records.d.ts";
+
+type Script = DiscoveryMeeting["script"];
+type Listed<T> = { file: string; record: T };
+
+const LEADS = "validation/discovery/leads";
+const DOSSIERS = "validation/discovery/dossiers";
+const MEETINGS = "validation/discovery/meetings";
+const CONTACTS = "_private/people";
+
+/** The playbook's questions, tagged to what they test. The template's five problem questions come first. */
+export const DEFAULT_SCRIPT: Script = [
+  { ask: "Walk me through the last time you were stuck on a decision about your venture. When was it?", tests: ["problem-interview"] },
+  { ask: "What did you do about it? What did that cost you, in time or money?", tests: ["problem-interview"] },
+  { ask: "How did you pay for getting from idea to your first paying customer? Walk me through it.", tests: ["H2", "price-anchor"] },
+  { ask: "Did you try to raise money, or get into an accelerator, before you had customers? What happened?", tests: ["H1"] },
+  { ask: "If you paid for it yourself: was that the plan from the start, or what you did when the other route didn't work?", tests: ["H2"] },
+  { ask: "What have you given up to get help, in money, equity or time? Who did you get it from? Was it worth it?", tests: ["price-anchor"] },
+  { ask: "Who do you go to when you're stuck on a decision? How often?", tests: ["problem-interview"] },
+  { ask: "What decision do you most wish you'd made differently in the first year? What did it cost?", tests: ["problem-interview"] },
+  { ask: "Who is another founder I should talk to about this?", tests: ["commitment"] },
+];
+
+// The playbook's "Do not": no pitch, no hypothetical prices, no waitlist as a reward.
+const PITCH = [
+  { re: /\b(naive|mentura|puzzle|waitlist)\b/i, why: "names Naive, Mentura, the puzzle or the waitlist (no pitch in discovery)" },
+  { re: /\bwould you (pay|use|buy)\b|\bhow much would\b|\bworth to you\b/i, why: "asks a hypothetical price or use; ask what they already pay instead" },
+];
+
+const readJson = <T>(f: string): T => JSON.parse(readFileSync(f, "utf8")) as T;
+const writeJson = (f: string, o: unknown): void => { mkdirSync(dirname(f), { recursive: true }); writeFileSync(f, JSON.stringify(o, null, 2) + "\n"); };
+function list<T>(dir: string, rel: string): Listed<T>[] {
+  const d: string = ventureFile(dir, rel);
+  return existsSync(d) ? readdirSync(d).filter((f) => f.endsWith(".json")).sort().map((f) => ({ file: f, record: readJson<T>(join(d, f)) })) : [];
+}
+const one = <T>(dir: string, rel: string, id: string): T | null => {
+  const f: string = ventureFile(dir, `${rel}/${id}.json`);
+  return existsSync(f) ? readJson<T>(f) : null;
+};
+
+/** One CSV line into fields, with double-quoted fields and "" for a quote inside one. */
+function csvFields(line: string): string[] {
+  const out: string[] = [];
+  let cur = "", quoted = false;
+  for (let i = 0; i < line.length; i++) {
+    const c = line[i];
+    if (quoted) {
+      if (c === '"' && line[i + 1] === '"') { cur += '"'; i++; }
+      else if (c === '"') quoted = false;
+      else cur += c;
+    } else if (c === '"') quoted = true;
+    else if (c === ",") { out.push(cur); cur = ""; }
+    else cur += c;
+  }
+  out.push(cur);
+  return out.map((s) => s.trim());
+}
+
+const MONTHS = ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"];
+/** "31 Oct 2026", "October 31, 2026" or an ISO date into YYYY-MM-DD; anything else is left out rather than guessed. */
+export function exportDate(s: string): string | undefined {
+  if (/^\d{4}-\d{2}-\d{2}$/.test(s)) return s;
+  const dm = /^(\d{1,2}) ([A-Za-z]{3})\w* (\d{4})$/.exec(s), md = /^([A-Za-z]{3})\w* (\d{1,2}), (\d{4})$/.exec(s);
+  const [mon, day, year] = dm ? [dm[2], dm[1], dm[3]] : md ? [md[1], md[2], md[3]] : [];
+  const month = mon ? MONTHS.indexOf(mon.toLowerCase()) : -1;
+  return day && year && month >= 0 ? `${year}-${String(month + 1).padStart(2, "0")}-${day.padStart(2, "0")}` : undefined;
+}
+
+export type Connection = { name: string; profile_url?: string; email?: string; company?: string; position?: string; connected_on?: string };
+
+/** Which file this is: LinkedIn's own Connections.csv export (First Name, Last Name, URL, Email Address,
+ *  Company, Position, Connected On, after a few lines of notes), or a connections list the founder compiled
+ *  themselves, for example with an agent (name, headline, profile_url, connected_on). */
+export type ConnectionsFormat = "linkedin-connections-export" | "connections-list";
+export function connectionsFormat(csv: string): { format: ConnectionsFormat; at: number; lines: string[] } {
+  const lines = csv.replace(/^\uFEFF/, "").split(/\r?\n/);
+  const exp = lines.findIndex((l) => /^"?First Name"?,/.test(l));
+  if (exp >= 0) return { format: "linkedin-connections-export", at: exp, lines };
+  const own = lines.findIndex((l) => /^"?name"?,/i.test(l) && /profile_url/i.test(l));
+  if (own >= 0) return { format: "connections-list", at: own, lines };
+  throw new Error("no header row: expected LinkedIn's Connections.csv (First Name, Last Name, URL, ...) or a list with name, headline, profile_url, connected_on");
+}
+
+/** The rows of either connections file. The notes above the header row are skipped. */
+export function parseConnections(csv: string): Connection[] {
+  const { format, at, lines } = connectionsFormat(csv);
+  const head = csvFields(lines[at]).map((h) => format === "connections-list" ? h.toLowerCase() : h);
+  // The same fields under each file's column names.
+  const names = format === "linkedin-connections-export"
+    ? { url: "URL", email: "Email Address", company: "Company", position: "Position", on: "Connected On" }
+    : { url: "profile_url", email: "email", company: "company", position: "headline", on: "connected_on" };
+  const col = (row: string[], name: string): string | undefined => { const i = head.indexOf(name); const v = i >= 0 ? row[i] : undefined; return v ? v : undefined; };
+  return lines.slice(at + 1).filter((l) => l.trim()).map(csvFields).flatMap((row) => {
+    const name = format === "linkedin-connections-export" ? [col(row, "First Name"), col(row, "Last Name")].filter(Boolean).join(" ") : col(row, "name") ?? "";
+    if (!name) return [];
+    const on = col(row, names.on);
+    const c: Connection = { name };
+    const url = col(row, names.url), email = col(row, names.email), company = col(row, names.company), position = col(row, names.position);
+    if (url) c.profile_url = url;
+    if (email) c.email = email;
+    if (company) c.company = company;
+    if (position) c.position = position;
+    const iso = on ? exportDate(on) : undefined;
+    if (iso) c.connected_on = iso;
+    return [c];
+  });
+}
+
+export type ImportOptions = { icp: string; match?: RegExp; group?: DiscoveryLead["group"]; now?: Date };
+
+/** Files each matching connection as a lead (person id only) and a private contact. A connection whose
+ *  profile link, or else name and company, is already a contact is skipped, so a later export only adds. */
+export function importConnections(dir: string, csv: string, o: ImportOptions): { created: string[]; skipped: number } {
+  const now = (o.now ?? new Date()).toISOString().replace(/\.\d{3}Z$/, "Z");
+  const known = new Set(list<DiscoveryContact>(dir, CONTACTS).flatMap(({ record: c }) => [c.profile_url, `${c.name}|${c.company ?? ""}`].filter((k): k is string => !!k)));
+  const created: string[] = [];
+  let skipped = 0;
+  const from = connectionsFormat(csv).format;
+  for (const c of parseConnections(csv)) {
+    if (o.match && !o.match.test(`${c.position ?? ""} ${c.company ?? ""}`)) continue;
+    if ((c.profile_url && known.has(c.profile_url)) || known.has(`${c.name}|${c.company ?? ""}`)) { skipped++; continue; }
+    let id = `p-${randomBytes(4).toString("hex")}`;
+    while (existsSync(ventureFile(dir, `${CONTACTS}/${id}.json`))) id = `p-${randomBytes(4).toString("hex")}`;
+    const contact: DiscoveryContact = { id, private: true, ...c, imported: { from, at: now } };
+    const lead: DiscoveryLead = { id, icp: o.icp, group: o.group ?? "own-network", money: "unknown", status: "new", source: from };
+    writeJson(ventureFile(dir, `${CONTACTS}/${id}.json`), contact);
+    writeJson(ventureFile(dir, `${LEADS}/${id}.json`), lead);
+    if (c.profile_url) known.add(c.profile_url);
+    known.add(`${c.name}|${c.company ?? ""}`);
+    created.push(id);
+  }
+  return { created, skipped };
+}
+
+export type PlanOptions = { person: string; at: string; medium?: DiscoveryMeeting["medium"]; minutes?: number; prediction?: string; script?: Script };
+
+/** Writes a planned meeting with the playbook's script and links it from the lead. */
+export function planMeeting(dir: string, o: PlanOptions): DiscoveryMeeting {
+  const lead = one<DiscoveryLead>(dir, LEADS, o.person);
+  if (!lead) throw new Error(`no lead ${o.person} (${LEADS}/${o.person}.json)`);
+  const base = `${o.at.slice(0, 10)}-${o.person}`;
+  let id = base;
+  for (let n = 2; existsSync(ventureFile(dir, `${MEETINGS}/${id}.json`)); n++) id = `${base}-${n}`;
+  const meeting: DiscoveryMeeting = { id, person: o.person, at: o.at, medium: o.medium ?? "video", minutes: o.minutes ?? 25, status: "planned", script: o.script ?? DEFAULT_SCRIPT };
+  if (o.prediction) meeting.prediction = o.prediction;
+  writeJson(ventureFile(dir, `${MEETINGS}/${id}.json`), meeting);
+  writeJson(ventureFile(dir, `${LEADS}/${o.person}.json`), { ...lead, meetings: [...(lead.meetings ?? []), id] });
+  return meeting;
+}
+
+/** Every problem across the discovery records of one venture. */
+export function check(dir: string): string[] {
+  const problems: string[] = [];
+  const contacts = new Map(list<DiscoveryContact>(dir, CONTACTS).map(({ record }) => [record.id, record]));
+  const leads = new Map(list<DiscoveryLead>(dir, LEADS).map(({ record }) => [record.id, record]));
+  const meetings = list<DiscoveryMeeting>(dir, MEETINGS);
+  const held = new Set(meetings.filter(({ record: m }) => m.status === "held").map(({ record: m }) => m.person));
+  const identifying = (id: string): string[] => { const c = contacts.get(id); return c ? [c.name, c.email, c.profile_url].filter((s): s is string => !!s && s.length > 3) : []; };
+  const names = (text: string, id: string, where: string): void => {
+    for (const s of identifying(id)) if (text.toLowerCase().includes(s.toLowerCase())) problems.push(`${where}: names the person behind ${id}; names stay in ${CONTACTS}/`);
+  };
+
+  for (const { file, record: c } of list<DiscoveryContact>(dir, CONTACTS))
+    if (c.id !== file.replace(/\.json$/, "")) problems.push(`${CONTACTS}/${file}: id ${c.id} is not the file name`);
+  for (const { file, record: p } of list<DiscoveryLead>(dir, LEADS)) {
+    const at = `${LEADS}/${file}`;
+    if (p.id !== file.replace(/\.json$/, "")) problems.push(`${at}: id ${p.id} is not the file name`);
+    if (!contacts.has(p.id)) problems.push(`${at}: no private contact ${CONTACTS}/${p.id}.json`);
+    if (!existsSync(ventureFile(dir, `foundation/icp/${p.icp}.json`))) problems.push(`${at}: no ICP profile ${p.icp} (foundation/icp/${p.icp}.json)`);
+    if (p.group === "community" && !p.community) problems.push(`${at}: group community, but which community is missing`);
+    if (p.intro_from && !leads.has(p.intro_from)) problems.push(`${at}: introduced by ${p.intro_from}, who is not a lead`);
+    for (const m of p.meetings ?? []) if (!meetings.some(({ record }) => record.id === m)) problems.push(`${at}: no meeting ${m}`);
+    if (p.status === "interviewed" && !held.has(p.id)) problems.push(`${at}: interviewed, but no held meeting names ${p.id}`);
+    if (p.fit?.confirmed_by && p.fit.by.kind === "agent" && p.fit.confirmed_by === p.fit.by.id) problems.push(`${at}: its fit is confirmed by the agent that ranked it; a person confirms it`);
+    if (!["new", "dropped"].includes(p.status) && !p.qualified_by) problems.push(`${at}: ${p.status}, but no person qualified it (qualified_by); a lead becomes a prospect only when a person says so`);
+    if (p.qualified_by && p.fit?.by.kind === "agent" && p.qualified_by === p.fit.by.id) problems.push(`${at}: qualified by the agent that ranked it; a person qualifies a lead`);
+    if (p.status === "dropped" && !p.note) problems.push(`${at}: dropped with no note saying why`);
+    if (p.status === "asked" && !(p.outreach ?? []).length) problems.push(`${at}: asked, but the outreach log is empty`);
+    names(JSON.stringify(p), p.id, at);
+  }
+  for (const { file, record: d } of list<DiscoveryDossier>(dir, DOSSIERS)) {
+    const at = `${DOSSIERS}/${file}`;
+    if (d.id !== file.replace(/\.json$/, "") || d.person !== d.id) problems.push(`${at}: id and person must both be the file name`);
+    if (!leads.has(d.person)) problems.push(`${at}: no lead ${d.person}`);
+    d.facts.forEach((f, i) => {
+      if (f.status === "confirmed" && !f.confirmed_by) problems.push(`${at}: fact ${i + 1} is confirmed, but by no one`);
+      if (f.status === "confirmed" && d.compiled.by.kind === "agent" && f.confirmed_by === d.compiled.by.id) problems.push(`${at}: fact ${i + 1} is confirmed by the agent that compiled it; a person checks it`);
+      if (d.compiled.by.kind === "agent" && /(^|\/\/|\.)linkedin\.com\b/i.test(f.source.url)) problems.push(`${at}: fact ${i + 1} cites a linkedin.com page an agent read; use the founder's export (export:linkedin) or a public page`);
+    });
+    names(JSON.stringify(d), d.person, at);
+  }
+  for (const { file, record: m } of meetings) {
+    const at = `${MEETINGS}/${file}`;
+    if (m.id !== file.replace(/\.json$/, "")) problems.push(`${at}: id ${m.id} is not the file name`);
+    if (!leads.has(m.person)) problems.push(`${at}: no lead ${m.person}`);
+    m.script.forEach((q, i) => { for (const p of PITCH) if (p.re.test(q.ask)) problems.push(`${at}: question ${i + 1} ${p.why}`); });
+    if (m.status === "held" && !m.prediction) problems.push(`${at}: held with no prediction written before it`);
+    if (m.recording && !existsSync(ventureFile(dir, `raw/sources/${m.recording.source.replace(/^raw\/sources\//, "")}/source.json`))) problems.push(`${at}: no raw source ${m.recording.source}`);
+    if (m.interview) {
+      const iv = one<ValidationInterview>(dir, "validation/interviews", m.interview);
+      if (!iv) problems.push(`${at}: no validation interview ${m.interview}`);
+      else if (iv.person !== m.person) problems.push(`${at}: interview ${m.interview} is about ${iv.person}, not ${m.person}`);
+    }
+    if (m.introduction?.given && !leads.has(m.introduction.given)) problems.push(`${at}: introduction to ${m.introduction.given}, who is not a lead yet`);
+    names(JSON.stringify(m), m.person, at);
+  }
+  return problems;
+}
+
+/** Who was asked, who said yes, who was interviewed, by group: the response rate is evidence too. */
+export function funnel(dir: string): Record<string, Record<string, number>> {
+  const out: Record<string, Record<string, number>> = {};
+  for (const { record: p } of list<DiscoveryLead>(dir, LEADS)) {
+    const g = (out[p.group] ??= { leads: 0, asked: 0, accepted: 0, interviewed: 0 });
+    const asked = (p.outreach ?? []).length > 0;
+    g.leads++;
+    if (asked) g.asked++;
+    if ((p.outreach ?? []).some((o) => o.outcome === "accepted") || p.status === "accepted" || p.status === "interviewed") g.accepted++;
+    if (p.status === "interviewed") g.interviewed++;
+  }
+  return out;
+}
+
+/** The meeting packet: what to read before the meeting, built from the records. Confirmed facts and agent
+ *  drafts are kept apart, and every fact shows its source. */
+export function packet(dir: string, meetingId: string, o: { names?: boolean } = {}): string {
+  const m = one<DiscoveryMeeting>(dir, MEETINGS, meetingId);
+  if (!m) throw new Error(`no meeting ${meetingId} (${MEETINGS}/${meetingId}.json)`);
+  const p = one<DiscoveryLead>(dir, LEADS, m.person);
+  const d = one<DiscoveryDossier>(dir, DOSSIERS, m.person);
+  const c = o.names ? one<DiscoveryContact>(dir, CONTACTS, m.person) : null;
+  const who = c ? `${c.name}${c.position || c.company ? ` (${[c.position, c.company].filter(Boolean).join(", ")})` : ""}` : m.person;
+  const facts = (status: string) => (d?.facts ?? []).filter((f) => f.status === status)
+    .map((f) => `- ${f.claim} [${f.about}] (source: ${f.source.url}, retrieved ${f.source.retrieved.slice(0, 10)}${f.confirmed_by ? `, checked by ${f.confirmed_by}` : ""})`);
+  const confirmed = facts("confirmed"), drafts = facts("draft");
+  const lines = [
+    `# Meeting packet: ${who}`,
+    "",
+    `${m.at} · ${m.medium ?? "video"} · ${m.minutes ?? 25} minutes · ${m.status}`,
+    "",
+    "## Who",
+    p ? `- Found through ${p.group}${p.community ? ` (${p.community})` : ""}; money now: ${p.money ?? "unknown"}; ICP ${p.icp}` : `- No lead record for ${m.person}`,
+    ...(p?.intro_from ? [`- Introduced by ${p.intro_from}`] : []),
+    ...(p?.outreach ?? []).map((x) => `- ${x.at}: ${x.channel}, ${x.outcome}`),
+    "",
+    "## Checked facts",
+    ...(confirmed.length ? confirmed : ["- None yet."]),
+    "",
+    "## Drafts, not yet checked by a person",
+    ...(drafts.length ? drafts : ["- None."]),
+    ...(d?.something_special ? ["", "## What they may have that others don't (a draft guess, never said to them)", d.something_special] : []),
+    ...(d?.questions?.length ? ["", "## Gaps to close", ...d.questions.map((q) => `- ${q}`)] : []),
+    "",
+    "## Prediction, written before the meeting",
+    m.prediction ?? "None written yet. Write one before the meeting, so the answers can surprise you.",
+    "",
+    "## Script (past facts, not opinions)",
+    ...m.script.map((q, i) => `${i + 1}. ${q.ask} (${q.tests.join(", ")})`),
+    "",
+    "## Do not",
+    "- Pitch Naive, Mentura or the puzzle, or show them anything.",
+    "- Ask \"would you pay for...?\" or \"how much would this be worth?\"",
+    "- Mention the waitlist as a reward for the interview.",
+    "",
+    "## After",
+    "- Recording and notes go in raw/; cite them, never copy them into records.",
+    "- File the interview in validation/interviews/ and link it from this meeting.",
+    "- File each finding as an evidence item, tagged H1, H2 or price-anchor.",
+    "- Ask for one introduction to another founder.",
+    "",
+    `_A view built from ${MEETINGS}/${m.id}.json${p ? `, ${LEADS}/${p.id}.json` : ""}${d ? `, ${DOSSIERS}/${d.id}.json` : ""}${c ? ` and ${CONTACTS}/${c.id}.json (private: keep this copy off any model)` : ""}._`,
+  ];
+  return lines.join("\n") + "\n";
+}
+
+const ventures = (d: string): string[] => readdirSync(d, { withFileTypes: true }).flatMap((e) =>
+  e.name === "node_modules" || e.name.startsWith(".") || !e.isDirectory() ? [] : existsSync(join(d, e.name, "venture.json")) ? [join(d, e.name), ...ventures(join(d, e.name))] : ventures(join(d, e.name)));
+
+if (import.meta.url === `file://${process.argv[1]}`) {
+  const [cmd, a, b] = process.argv.slice(2);
+  const flag = (n: string): string | undefined => { const i = process.argv.indexOf(`--${n}`); return i > 0 ? process.argv[i + 1] : undefined; };
+  const usage = () => { console.error("usage: node schema/discovery.ts check <dir> | import <venture> <Connections.csv> --icp <id> [--match <regex>] | plan <venture> --person <id> --at <date-time> | packet <venture> <meeting> [--names] | funnel <venture>"); process.exit(2); };
+  try {
+    if (cmd === "check" && a) {
+      const dirs = existsSync(join(a, "venture.json")) ? [a] : ventures(a);
+      const problems = dirs.flatMap((d) => check(d).map((p) => `${d}: ${p}`));
+      console.log(problems.length ? problems.map((p) => `FAIL  ${p}`).join("\n") : `discovery records: ${dirs.length} venture(s) checked`);
+      process.exit(problems.length ? 1 : 0);
+    } else if (cmd === "import" && a && b) {
+      const icp = flag("icp");
+      if (!icp) usage();
+      const match = flag("match");
+      const group = flag("group") as DiscoveryLead["group"] | undefined;
+      const r = importConnections(a, readFileSync(b, "utf8"), { icp: icp as string, ...(match ? { match: new RegExp(match, "i") } : {}), ...(group ? { group } : {}) });
+      console.log(`${r.created.length} lead(s) added, ${r.skipped} already known. Names are in ${CONTACTS}/ only.`);
+    } else if (cmd === "plan" && a) {
+      const person = flag("person"), at = flag("at");
+      if (!person || !at) usage();
+      const minutes = flag("minutes"), medium = flag("medium") as DiscoveryMeeting["medium"] | undefined, prediction = flag("prediction");
+      const m = planMeeting(a, { person: person as string, at: at as string, ...(medium ? { medium } : {}), ...(minutes ? { minutes: Number(minutes) } : {}), ...(prediction ? { prediction } : {}) });
+      console.log(`planned ${MEETINGS}/${m.id}.json`);
+    } else if (cmd === "packet" && a && b) {
+      process.stdout.write(packet(a, b, { names: process.argv.includes("--names") }));
+    } else if (cmd === "funnel" && a) {
+      console.log(JSON.stringify(funnel(a), null, 2));
+    } else usage();
+  } catch (e) {
+    console.error(e instanceof Error ? e.message : String(e));
+    process.exit(1);
+  }
+}
