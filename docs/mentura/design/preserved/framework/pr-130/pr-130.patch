+  questions?: string[];
+};
+
+/** One person the venture may talk to in Discovery, at <venture>/validation/discovery/leads/<person>.json. Everyone imported starts as a lead (status new); when a person qualifies one it becomes a prospect, as in common CRM usage. Agents may rank leads, never qualify them. It holds only an opaque person id: the name, profile link, email and company sit in _private/people/<person>.json, which never reaches a model or a release. The outreach log is evidence too: who was asked, through which channel, and who said yes (Mentura discovery playbook, 2026-10-31). */
+export type DiscoveryLead = {
+  /** The opaque person id, equal to the file name; never a name or contact detail */
+  id: string;
+  /** The ideal customer profile id (foundation/icp/<id>.json) this person is recruited against */
+  icp: string;
+  /** How the founder was found, so the answers are not all from people who like the interviewer: your own network, a community (Capital Factory, Antler, a meetup), or someone who owes you nothing */
+  group: "own-network" | "community" | "cold";
+  /** Why they matter: a founder to interview, a builder in the ICP who is not yet a founder, a partner the venture works with, a connector who leads to more founders, an investor */
+  role?: "founder" | "builder" | "partner" | "connector" | "investor" | "other";
+  /** Which community, when group is community */
+  community?: string;
+  /** What the founder is doing about money now; interviewing only survivors biases the answers */
+  money?: "raising" | "bootstrapping" | "stopped" | "unknown";
+  /** new: a lead, imported and not yet qualified; prospect: a person qualified them for outreach (qualified_by); the rest follow outreach; dropped: not a fit, say why in the note */
