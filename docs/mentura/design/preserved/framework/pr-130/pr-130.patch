+    reasons: string[];
+    /** Evidence the lead already sees what we see (the economics of intelligence), with where it was seen; stays a draft like the rest */
+    signals?: string[];
+    by: {
+      kind: "person" | "agent";
+      id: string;
+    };
+    /** The person who agreed with the rank */
+    confirmed_by?: string;
+  };
+  /** Where the lead came from: linkedin-connections-export, an introduction, an event, a person's own note */
+  source?: string;
+  /** The person who introduced them; a given introduction is a commitment */
+  intro_from?: string;
+  outreach?: {
+    /**
+     * @format date
+     */
+    at: string;
+    channel: "linkedin-message" | "email" | "introduction" | "in-person" | "event" | "other";
+    outcome: "pending" | "no-reply" | "declined" | "accepted";
+    /** The person who sent it; an agent may draft outreach, a person sends it */
+    sent_by?: string;
+  }[];
+  /** Discovery meeting ids (validation/discovery/meetings/<id>.json) */
+  meetings?: string[];
+  note?: string;
+};
+
+/** One discovery conversation, planned and then held, at <venture>/validation/discovery/meetings/<id>.json: when, the script (questions tagged to the hypotheses they test), what the interviewer predicts they will hear, and afterwards the recording's raw source, the validation interview filed from it, and the introduction asked for. No pitch: the playbook keeps Naive, Mentura and the puzzle out of these meetings. */
+export type DiscoveryMeeting = {
+  /** Equal to the file name */
+  id: string;
+  person: string;
+  /**
+   * @format date-time
+   */
+  at: string;
