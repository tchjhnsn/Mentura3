diff --git a/schema/noun-relations.ts b/schema/noun-relations.ts
new file mode 100644
index 00000000..684f80da
--- /dev/null
+++ b/schema/noun-relations.ts
@@ -0,0 +1,302 @@
+// Typed relations between nouns (EE-103). The closed set is SKOS broader, narrower and
+// related, plus part-of and derived-from. broader and narrower are inverses, and related
+// is symmetric: stating one side is enough, and a stated pair must agree with its inverse.
+// part-of and derived-from have no inverse in the set. broader and part-of may not cycle.
+// A noun does not relate to itself. The graph draws each fact once.
+
+export const RELATION_TYPES = ["broader", "narrower", "related", "part-of", "derived-from"] as const;
+export type RelationType = (typeof RELATION_TYPES)[number];
+
+const RELATION_SET = new Set<string>(RELATION_TYPES);
+const FILL: Record<string, string> = {
+  shared: "#f5f5f4",
+  strategy: "#ede9fe",
+  products: "#dbeafe",
+  "marketing-and-sales": "#fce7f3",
+  finance: "#dcfce7",
+  "supply-chain": "#ffedd5",
+  "service-delivery": "#e0f2fe",
+  "customer-service": "#cffafe",
+  "human-capital": "#fef9c3",
+  it: "#e2e8f0",
+  assets: "#f3e8ff",
+  "risk-and-compliance": "#fee2e2",
+  "external-relationships": "#ccfbf1",
+  capabilities: "#fef3c7",
+};
+const STROKE: Record<string, string> = {
+  shared: "#57534e",
+  strategy: "#6d28d9",
+  products: "#1d4ed8",
+  "marketing-and-sales": "#be185d",
+  finance: "#15803d",
+  "supply-chain": "#c2410c",
+  "service-delivery": "#0369a1",
+  "customer-service": "#0e7490",
+  "human-capital": "#a16207",
+  it: "#334155",
+  assets: "#7e22ce",
+  "risk-and-compliance": "#b91c1c",
+  "external-relationships": "#0f766e",
+  capabilities: "#b45309",
+};
+
+type RelationInput = {
+  noun: string;
+  status?: string;
+  function?: string | null;
+  relations?: unknown;
+};
+
+type Stated = { from: string; type: RelationType; target: string };
+type Edge = { from: string; to: string; type: "broader" | "related" | "part-of" | "derived-from"; arrow: boolean };
+
+const isRecord = (value: unknown): value is Record<string, unknown> => !!value && typeof value === "object" && !Array.isArray(value);
+const isRelationType = (value: string): value is RelationType => RELATION_SET.has(value);
+
+function nounsOf(input: readonly unknown[]): RelationInput[] {
+  const out: RelationInput[] = [];
+  for (const item of input) {
+    if (!isRecord(item) || typeof item.noun !== "string" || item.noun === "") continue;
+    const named = item.function;
+    const owner: string | null | undefined = named === null ? null : typeof named === "string" ? named : undefined;
+    out.push({
+      noun: item.noun,
+      status: typeof item.status === "string" ? item.status : undefined,
+      function: owner,
+      relations: item.relations,
+    });
+  }
+  return out;
+}
+
+function readRelations(noun: RelationInput, errors: string[]): { type: string; target: string }[] {
+  if (noun.relations === undefined) return [];
+  if (!Array.isArray(noun.relations)) {
+    errors.push(`docs/ontology.json: ${noun.noun}: relations is not a list`);
+    return [];
+  }
+  const out: { type: string; target: string }[] = [];
+  for (const item of noun.relations) {
+    if (!isRecord(item) || typeof item.type !== "string" || typeof item.target !== "string" || item.type === "" || item.target === "") {
+      errors.push(`docs/ontology.json: ${noun.noun}: a relation needs a type and a target`);
+      continue;
+    }
+    out.push({ type: item.type, target: item.target });
+  }
+  return out;
+}
+
+function pairOf(a: string, b: string): string {
+  return a < b ? `${a}\0${b}` : `${b}\0${a}`;
+}
+
+/** Directions that agree. A pair stated both ways is left out; the caller reports it. */
+function oneWay(facts: { from: string; to: string }[]): { edges: [string, string][]; conflicts: string[] } {
+  const dir = new Map<string, string>();
+  const bad = new Set<string>();
+  for (const fact of facts) {
+    const pair = pairOf(fact.from, fact.to);
+    const way = `${fact.from}\0${fact.to}`;
+    const prev = dir.get(pair);
+    if (prev && prev !== way) bad.add(pair);
+    else dir.set(pair, way);
+  }
+  const edges: [string, string][] = [];
+  const conflicts: string[] = [];
+  for (const [pair, way] of dir) {
+    if (bad.has(pair)) {
+      const [left, right] = pair.split("\0");
+      conflicts.push(`docs/ontology.json: ${left} and ${right}: broader and narrower point both ways`);
+      continue;
+    }
+    const [from, to] = way.split("\0");
+    if (from && to) edges.push([from, to]);
+  }
+  conflicts.sort();
+  return { edges, conflicts };
+}
+
+function cycleMessage(path: string[]): string {
+  const body = path.slice(0, -1);
+  let start = 0;
+  for (let i = 1; i < body.length; i++) if ((body[i] ?? "") < (body[start] ?? "")) start = i;
+  const rotated = body.slice(start).concat(body.slice(0, start));
+  return `${rotated.join(" -> ")} -> ${rotated[0]}`;
+}
+
+function cycles(label: string, edges: readonly [string, string][]): string[] {
+  const adj = new Map<string, string[]>();
+  for (const [from, to] of edges) {
+    const list = adj.get(from) ?? [];
+    if (!list.includes(to)) list.push(to);
+    adj.set(from, list);
+    if (!adj.has(to)) adj.set(to, []);
+  }
+  const found: string[] = [];
+  const color = new Map<string, number>();
+  const stack: string[] = [];
+  const visit = (node: string): void => {
+    color.set(node, 1);
+    stack.push(node);
+    for (const next of [...(adj.get(node) ?? [])].sort()) {
+      const state = color.get(next) ?? 0;
+      if (state === 0) visit(next);
+      else if (state === 1) {
+        const at = stack.indexOf(next);
+        found.push(`docs/ontology.json: ${label} cycle: ${cycleMessage(stack.slice(at).concat(next))}`);
+      }
+    }
+    stack.pop();
+    color.set(node, 2);
+  };
+  for (const node of [...adj.keys()].sort()) if ((color.get(node) ?? 0) === 0) visit(node);
+  return [...new Set(found)].sort();
+}
+
+type Resolved = { errors: string[]; stated: Stated[]; edges: Edge[]; owner: Map<string, string> };
+
+function resolve(input: readonly unknown[]): Resolved {
+  const nouns = nounsOf(input);
+  const errors: string[] = [];
+  const byName = new Map(nouns.map((noun) => [noun.noun, noun]));
+  const owner = new Map(nouns.map((noun) => [noun.noun, noun.function ? noun.function : "shared"]));
+  const stated: Stated[] = [];
+  const broaderFacts: { from: string; to: string }[] = [];
+  const partFacts: { from: string; to: string }[] = [];
+  const related = new Map<string, [string, string]>();
+  const derived: Edge[] = [];
+
+  for (const noun of nouns) {
+    const seen = new Set<string>();
+    for (const rel of readRelations(noun, errors)) {
+      if (!isRelationType(rel.type)) {
+        errors.push(`docs/ontology.json: ${noun.noun}: relation type ${rel.type} is not in the closed set`);
+        continue;
+      }
+      if (rel.target === noun.noun) {
+        errors.push(`docs/ontology.json: ${noun.noun}: ${rel.type} relates a noun to itself`);
+        continue;
+      }
+      const key = `${rel.type}\0${rel.target}`;
+      if (seen.has(key)) {
+        errors.push(`docs/ontology.json: ${noun.noun}: ${rel.type} ${rel.target} is stated twice`);
+        continue;
+      }
+      seen.add(key);
+      stated.push({ from: noun.noun, type: rel.type, target: rel.target });
+      const target = byName.get(rel.target);
+      if (!target) {
+        errors.push(`docs/ontology.json: ${noun.noun}: ${rel.type} ${rel.target} is not a noun`);
+        continue;
+      }
+      if (target.status === "retired" || noun.status === "retired") {
+        if (target.status === "retired") errors.push(`docs/ontology.json: ${noun.noun}: ${rel.type} ${rel.target} is retired`);
+        continue;
+      }
+      if (rel.type === "broader") broaderFacts.push({ from: noun.noun, to: rel.target });
+      if (rel.type === "narrower") broaderFacts.push({ from: rel.target, to: noun.noun });
+      if (rel.type === "part-of") partFacts.push({ from: noun.noun, to: rel.target });
+      if (rel.type === "related") related.set(pairOf(noun.noun, rel.target), noun.noun < rel.target ? [noun.noun, rel.target] : [rel.target, noun.noun]);
+      if (rel.type === "derived-from") derived.push({ from: noun.noun, to: rel.target, type: "derived-from", arrow: true });
+    }
+  }
+
+  const hierarchy = oneWay(broaderFacts);
+  errors.push(...hierarchy.conflicts);
+  errors.push(...cycles("broader", hierarchy.edges));
+  errors.push(...cycles("part-of", partFacts.map((fact) => [fact.from, fact.to])));
+
+  const edges: Edge[] = [
+    ...hierarchy.edges.map(([from, to]) => ({ from, to, type: "broader" as const, arrow: true })),
+    ...partFacts.map((fact) => ({ from: fact.from, to: fact.to, type: "part-of" as const, arrow: true })),
+    ...[...related.values()].map(([from, to]) => ({ from, to, type: "related" as const, arrow: false })),
+    ...derived,
+  ];
+  edges.sort((a, b) => a.type.localeCompare(b.type) || a.from.localeCompare(b.from) || a.to.localeCompare(b.to));
+  return { errors, stated, edges, owner };
+}
+
+/** Problems in noun-to-noun relations. Empty when the ontology agrees with EE-103. */
+export function relationErrors(input: readonly unknown[]): string[] {
+  return resolve(input).errors;
+}
+
+function slug(name: string): string {
+  return name.toLowerCase().replace(/[^a-z0-9]+/g, "_").replace(/^_+|_+$/g, "") || "noun";
+}
+
+function mermaidLabel(name: string): string {
+  return `"${name.replace(/"/g, "#quot;")}"`;
+}
+
+/** The whole of docs/noun-graph.md, generated from the ontology. */
+export function renderNounGraph(input: readonly unknown[]): string {
+  const { edges, owner } = resolve(input);
+  const names = [...new Set(edges.flatMap((edge) => [edge.from, edge.to]))].sort();
+  const ids = new Map<string, string>();
+  const used = new Set<string>();
+  for (const name of names) {
+    let id = `n_${slug(name)}`;
+    let n = 2;
+    while (used.has(id)) id = `n_${slug(name)}_${n++}`;
+    used.add(id);
+    ids.set(name, id);
+  }
+  const groups = new Map<string, string[]>();
+  for (const name of names) {
+    const group = owner.get(name) ?? "shared";
+    const list = groups.get(group) ?? [];
+    list.push(name);
+    groups.set(group, list);
+  }
+  const groupNames = [...groups.keys()].sort((a, b) => (a === "shared" ? -1 : b === "shared" ? 1 : a.localeCompare(b)));
+  const lines = ["flowchart LR"];
+  for (const group of groupNames) {
+    lines.push(`  subgraph g_${slug(group)}[${mermaidLabel(group)}]`);
+    for (const name of (groups.get(group) ?? []).sort()) lines.push(`    ${ids.get(name)}[${mermaidLabel(name)}]`);
+    lines.push("  end");
+  }
+  for (const edge of edges) {
+    const from = ids.get(edge.from);
+    const to = ids.get(edge.to);
+    const link = edge.arrow ? `-->|${edge.type}|` : `---|${edge.type}|`;
+    lines.push(`  ${from} ${link} ${to}`);
+  }
+  for (const group of groupNames) {
+    const fill = FILL[group] ?? "#f5f5f4";
+    const stroke = STROKE[group] ?? "#57534e";
+    lines.push(`  classDef c_${slug(group)} fill:${fill},stroke:${stroke},color:#1c1917`);
+  }
+  for (const name of names) lines.push(`  class ${ids.get(name)} c_${slug(owner.get(name) ?? "shared")}`);
+  return [
+    "# Noun graph",
+    "",
+    "Generated from `docs/ontology.json` by `node schema/check-nouns.mjs --graph` (EE-103). Do not edit this file by hand.",
+    "",
+    "Nouns are grouped and colored by the function that owns them. A noun with no function is shared. A noun that takes part in no relation is left off the graph.",
+    "",
+    "Each relation is drawn once. `broader` points from the narrower noun to the broader one, and a stated `narrower` is drawn as that same arrow. `related` is a line with no arrow, because it is symmetric. `part-of` points from the part to the whole. `derived-from` points from the derived noun to its source.",
+    "",
+    "```mermaid",
+    ...lines,
+    "```",
+    "",
+  ].join("\n");
+}
+
+/** The Relations section of docs/ontology.md. Stated rows only; inverses are derived, not repeated. */
+export function renderRelationSection(input: readonly unknown[]): string {
+  const { stated } = resolve(input);
+  const rows = [...stated].sort((a, b) => a.from.localeCompare(b.from) || a.type.localeCompare(b.type) || a.target.localeCompare(b.target));
+  return [
+    "",
+    "### Relations",
+    "",
+    "Each row is stated on the noun. `broader` and `narrower` are inverses, and `related` is symmetric, so the other side is derived and is not listed again. The graph is [docs/noun-graph.md](noun-graph.md).",
+    "",
+    "| From | Type | To |",
+    "| --- | --- | --- |",
+    ...rows.map((row) => `| ${row.from} | ${row.type} | ${row.target} |`),
+  ].join("\n");
+}
