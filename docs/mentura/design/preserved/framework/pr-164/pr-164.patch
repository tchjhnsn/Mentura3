+// vocabulary_parent: noun:schema
+// Nouns, verbs and kinds as vocabulary objects (EE-107). Other code imports this module.
+//
+// Nouns stay in docs/ontology.json, with every field they already have. Verbs, kinds,
+// tiers and shapes live in schema/vocabulary.json, and the verb set is checked against
+// design.diff.verbs in operations/operating-rules.json. Each object has a stable id and
+// a JSON Schema shape (draft 2020-12 keywords this module enforces). A noun with no
+// declared shape has an open object shape.
+//
+// A record type names its parent with vocabulary_parent in schema/data-model.json.
+// A record uses the same field. A code module puts `// vocabulary_parent: <id>` in its
+// first 40 lines. The shape check runs on instance records. A record type and a module
+// are checked for a parent that resolves to a live object.
+//
+// schema/vocabulary-baseline.json lists subjects that have no parent yet. The list may
+// only shrink: a subject that is not listed is a new gap, a listed subject that now has
+// a parent must be removed, and an entry added after the baseline is on framework needs
+// `approved`. Shape mismatches are never baselined.
+//
+//   node schema/check-vocabulary.mjs
+
+import { spawnSync } from "node:child_process";
+import { existsSync, readFileSync, readdirSync, statSync } from "node:fs";
+import { join, relative, resolve } from "node:path";
+
+export const PARENT_FIELD = "vocabulary_parent";
+export const HEADER_LINES = 40;
+export const VOCABULARY_FILE = "schema/vocabulary.json";
+export const BASELINE_FILE = "schema/vocabulary-baseline.json";
+export const ONTOLOGY_FILE = "docs/ontology.json";
+export const OPERATING_RULES_FILE = "operations/operating-rules.json";
+
+export const MODULE_ROOTS = [
+  "schema", "interface", "knowledge", "operations", "evidence",
+  "governance", "purpose", "platform", "packages", "frameworks",
+] as const;
+
+export const TIER_NAMES = ["low", "costly", "one_way_door"] as const;
+export const TIER_SCORES = ["severity", "reversibility", "time_to_detect", "blast_radius"] as const;
+
+export type TierName = typeof TIER_NAMES[number];
+export type TierScoreName = typeof TIER_SCORES[number];
+export type TierScores = Record<TierScoreName, number>;
+export type VocabularyClass = "noun" | "verb" | "kind";
+export type SubjectKind = "record-type" | "record" | "module";
+
+export type SchemaNode = {
+  type?: string | string[];
+  const?: unknown;
+  enum?: unknown[];
+  required?: string[];
+  properties?: Record<string, SchemaNode>;
+  additionalProperties?: boolean | SchemaNode;
+  minLength?: number;
+  maxLength?: number;
+  minimum?: number;
+  maximum?: number;
+  minItems?: number;
+  maxItems?: number;
+  pattern?: string;
+  items?: SchemaNode;
+  allOf?: SchemaNode[];
+  anyOf?: SchemaNode[];
+  oneOf?: SchemaNode[];
+  if?: SchemaNode;
+  then?: SchemaNode;
+  else?: SchemaNode;
+  not?: SchemaNode;
+  title?: string;
+  description?: string;
+  $schema?: string;
+  $id?: string;
+  $comment?: string;
+};
+
+/** A noun record from docs/ontology.json, kept whole. */
+export type NounRecord = { noun: string; status?: string } & Record<string, unknown>;
+
+export type VocabularyObject = {
+  id: string;
+  class: VocabularyClass;
+  shape: SchemaNode;
+  shapeDeclared: boolean;
+  noun?: NounRecord;
+  verb?: string;
+  kind?: string;
+  kinds?: string[];
+  /** The field a derive or merge line must name: source, or successor. */
+  names?: string;
+};
+
+export type TierRule = {
+  values: TierName[];
+  scores: TierScoreName[];
+  score_min: number;
+  score_max: number;
+  tier_of: "max";
+  rank: Record<string, TierName>;
+};
+
+export type Vocabulary = {
+  objects: VocabularyObject[];
+  byId: Map<string, VocabularyObject>;
+  tiers: TierRule;
+};
+
+export type Subject = {
+  kind: SubjectKind;
+  /** Baseline id: record-type:<id>, module:<path>, or record:<path>. */
+  id: string;
+  parent: string | null;
+  /** Set when the parent line or field is present and unusable. Not counted as a gap. */
+  parentError: string | null;
+  /** Instance records are shape-checked. Record types and modules are not. */
+  shapeCheck: boolean;
+  value?: unknown;
+};
+
+export type BaselineEntry = {
+  id: string;
+  approved?: string;
+};
+
+export class VocabularyError extends Error {
+  constructor(message: string) {
+    super(message);
+    this.name = "VocabularyError";
+  }
+}
+
+const PARENT_LINE = /^\/\/ vocabulary_parent:\s+(\S+)\s*$/;
+const ID_RE = /^(noun:[a-z0-9@][a-z0-9@-]*|verb:[a-z][a-z-]*|kind:[a-z][a-z-]*)$/;
+const BASELINE_ID_RE = /^(record-type:[a-z0-9-]+|module:\S+|record:\S+)$/;
+const OPEN_SHAPE: SchemaNode = { type: "object" };
+const SHAPE_KEYS = new Set([
+  "$schema", "$id", "$comment", "title", "description",
+  "type", "const", "enum", "required", "properties", "additionalProperties",
+  "minLength", "maxLength", "minimum", "maximum", "minItems", "maxItems", "pattern",
+  "items", "allOf", "anyOf", "oneOf", "if", "then", "else", "not",
+]);
+const TYPES = new Set(["object", "array", "string", "number", "integer", "boolean", "null"]);
+
+const isRecord = (x: unknown): x is Record<string, unknown> => !!x && typeof x === "object" && !Array.isArray(x);
+
+function relPath(root: string, file: string): string {
+  return relative(resolve(root), resolve(file)).split("\\").join("/");
+}
+
+/** Stable id for a noun string. Spaces become hyphens. A scoped noun keeps its @. */
+export function nounId(noun: string): string {
+  const slug = noun.trim().toLowerCase().replace(/[^a-z0-9@]+/g, "-").replace(/^-+|-+$/g, "");
+  return `noun:${slug}`;
+}
+
+function same(a: unknown, b: unknown): boolean {
+  if (a === b) return true;
+  if (typeof a !== "object" || typeof b !== "object" || !a || !b) return false;
+  if (Array.isArray(a) || Array.isArray(b)) {
+    return Array.isArray(a) && Array.isArray(b) && a.length === b.length && a.every((v, i) => same(v, b[i]));
+  }
+  const aKeys = Object.keys(a);
+  const bKeys = Object.keys(b as object);
+  if (aKeys.length !== bKeys.length) return false;
+  return aKeys.every((k) => same((a as Record<string, unknown>)[k], (b as Record<string, unknown>)[k]));
+}
+
+function readJson(root: string, rel: string): unknown {
+  return JSON.parse(readFileSync(join(root, rel), "utf8")) as unknown;
+}
+
+function strings(value: unknown, path: string, errors: string[]): string[] | null {
+  if (!Array.isArray(value) || !value.every((v) => typeof v === "string")) {
+    errors.push(`${path} must be an array of strings`);
+    return null;
+  }
+  return value;
+}
+
+function parseShape(value: unknown, path: string): { shape: SchemaNode | null; errors: string[] } {
+  const errors: string[] = [];
+  if (!isRecord(value)) return { shape: null, errors: [`${path} must be a JSON Schema object`] };
+  for (const key of Object.keys(value)) {
+    if (!SHAPE_KEYS.has(key)) errors.push(`${path}: unsupported keyword ${key}`);
+  }
+  if (errors.length) return { shape: null, errors };
+  const shape: SchemaNode = {};
+  if (value.type !== undefined) {
+    const type = value.type;
+    const list = Array.isArray(type) ? type : [type];
+    if (!list.every((t) => typeof t === "string" && TYPES.has(t))) errors.push(`${path}.type is not a JSON Schema type`);
+    else shape.type = Array.isArray(type) ? list.filter((t): t is string => typeof t === "string") : list[0];
+  }
+  if (value.const !== undefined) shape.const = value.const;
+  if (value.enum !== undefined) {
+    if (!Array.isArray(value.enum)) errors.push(`${path}.enum must be an array`);
+    else shape.enum = value.enum;
+  }
+  const required = value.required === undefined ? null : strings(value.required, `${path}.required`, errors);
+  if (required) shape.required = required;
+  if (value.properties !== undefined) {
+    if (!isRecord(value.properties)) errors.push(`${path}.properties must be an object`);
+    else {
+      shape.properties = {};
+      for (const [name, child] of Object.entries(value.properties)) {
+        const parsed = parseShape(child, `${path}.properties.${name}`);
+        errors.push(...parsed.errors);
+        if (parsed.shape) shape.properties[name] = parsed.shape;
+      }
+    }
+  }
+  if (value.additionalProperties !== undefined) {
+    if (typeof value.additionalProperties === "boolean") shape.additionalProperties = value.additionalProperties;
+    else {
+      const parsed = parseShape(value.additionalProperties, `${path}.additionalProperties`);
+      errors.push(...parsed.errors);
+      if (parsed.shape) shape.additionalProperties = parsed.shape;
+    }
+  }
+  for (const key of ["minLength", "maxLength", "minimum", "maximum", "minItems", "maxItems"] as const) {
+    if (value[key] === undefined) continue;
+    if (typeof value[key] !== "number" || !Number.isFinite(value[key])) errors.push(`${path}.${key} must be a number`);
+    else shape[key] = value[key] as number;
+  }
+  if (value.pattern !== undefined) {
+    if (typeof value.pattern !== "string") errors.push(`${path}.pattern must be a string`);
+    else {
+      try { new RegExp(value.pattern); shape.pattern = value.pattern; }
+      catch { errors.push(`${path}.pattern is not a regular expression`); }
+    }
+  }
+  if (value.items !== undefined) {
+    const parsed = parseShape(value.items, `${path}.items`);
+    errors.push(...parsed.errors);
+    if (parsed.shape) shape.items = parsed.shape;
+  }
+  for (const key of ["allOf", "anyOf", "oneOf"] as const) {
+    if (value[key] === undefined) continue;
+    if (!Array.isArray(value[key])) errors.push(`${path}.${key} must be an array`);
+    else {
+      shape[key] = [];
+      value[key].forEach((child, i) => {
+        const parsed = parseShape(child, `${path}.${key}[${i}]`);
+        errors.push(...parsed.errors);
+        if (parsed.shape) shape[key]?.push(parsed.shape);
+      });
+    }
+  }
+  for (const key of ["if", "then", "else", "not"] as const) {
+    if (value[key] === undefined) continue;
+    const parsed = parseShape(value[key], `${path}.${key}`);
+    errors.push(...parsed.errors);
+    if (parsed.shape) shape[key] = parsed.shape;
+  }
+  for (const key of ["title", "description", "$schema", "$id", "$comment"] as const) {
+    if (value[key] === undefined) continue;
+    if (typeof value[key] !== "string") errors.push(`${path}.${key} must be a string`);
+    else shape[key] = value[key] as string;
+  }
+  return { shape: errors.length ? null : shape, errors };
+}
+
+function jsonType(value: unknown): string | null {
+  if (value === null) return "null";
+  if (Array.isArray(value)) return "array";
+  if (typeof value === "number") return Number.isFinite(value) ? (Number.isInteger(value) ? "integer" : "number") : null;
+  if (typeof value === "string" || typeof value === "boolean") return typeof value;
+  if (isRecord(value)) return "object";
+  return null;
+}
+
+function typeMatches(value: unknown, type: string): boolean {
+  const got = jsonType(value);
+  if (type === "number") return got === "number" || got === "integer";
+  if (type === "integer") return got === "integer";
+  return got === type;
+}
+
+/** Problems that keep value from matching the shape. Empty when it matches. */
+export function shapeProblems(shape: SchemaNode, value: unknown, at = ""): string[] {
+  const where = at || "(root)";
+  const errors: string[] = [];
+  if (shape.type !== undefined) {
+    const accepted = Array.isArray(shape.type) ? shape.type : [shape.type];
+    if (!accepted.some((type) => typeMatches(value, type))) errors.push(`${where}: expected ${accepted.join(" or ")}`);
+  }
+  if (shape.const !== undefined && !same(value, shape.const)) errors.push(`${where}: expected ${JSON.stringify(shape.const)}`);
+  if (shape.enum && !shape.enum.some((item) => same(value, item))) errors.push(`${where}: expected one of ${shape.enum.map((item) => JSON.stringify(item)).join(", ")}`);
+  if (shape.not && shapeProblems(shape.not, value, at).length === 0) errors.push(`${where}: should not match the not schema`);
+  if (isRecord(value)) {
+    if (shape.required) for (const key of shape.required) if (!(key in value)) errors.push(`${at}/${key}: required`);
+    if (shape.properties) {
+      for (const [key, child] of Object.entries(shape.properties)) {
+        if (key in value) errors.push(...shapeProblems(child, value[key], `${at}/${key}`));
+      }
+    }
+    if (shape.additionalProperties !== undefined && shape.additionalProperties !== true) {
+      const known = new Set(Object.keys(shape.properties ?? {}));
+      for (const [key, child] of Object.entries(value)) {
+        if (known.has(key)) continue;
+        if (shape.additionalProperties === false) errors.push(`${at}/${key}: additional property`);
+        else errors.push(...shapeProblems(shape.additionalProperties, child, `${at}/${key}`));
+      }
+    }
+  }
+  if (typeof value === "string") {
+    if (shape.minLength !== undefined && value.length < shape.minLength) errors.push(`${where}: shorter than ${shape.minLength}`);
+    if (shape.maxLength !== undefined && value.length > shape.maxLength) errors.push(`${where}: longer than ${shape.maxLength}`);
+    if (shape.pattern !== undefined && !new RegExp(shape.pattern).test(value)) errors.push(`${where}: does not match ${shape.pattern}`);
+  }
+  if (typeof value === "number" && Number.isFinite(value)) {
+    if (shape.minimum !== undefined && value < shape.minimum) errors.push(`${where}: below ${shape.minimum}`);
+    if (shape.maximum !== undefined && value > shape.maximum) errors.push(`${where}: above ${shape.maximum}`);
+  }
+  if (Array.isArray(value)) {
+    if (shape.minItems !== undefined && value.length < shape.minItems) errors.push(`${where}: fewer than ${shape.minItems} items`);
+    if (shape.maxItems !== undefined && value.length > shape.maxItems) errors.push(`${where}: more than ${shape.maxItems} items`);
+    if (shape.items) value.forEach((item, i) => errors.push(...shapeProblems(shape.items as SchemaNode, item, `${at}/${i}`)));
+  }
+  for (const child of shape.allOf ?? []) errors.push(...shapeProblems(child, value, at));
+  if (shape.anyOf) {
+    const branches = shape.anyOf.map((child) => shapeProblems(child, value, at));
+    if (!branches.some((branch) => branch.length === 0)) errors.push(...(branches[0] ?? [`${where}: matched no anyOf branch`]));
+  }
+  if (shape.oneOf) {
+    const matched = shape.oneOf.filter((child) => shapeProblems(child, value, at).length === 0).length;
+    if (matched !== 1) errors.push(`${where}: expected one oneOf branch, matched ${matched}`);
+  }
+  if (shape.if) {
+    const condition = shapeProblems(shape.if, value, at).length === 0;
+    if (condition && shape.then) errors.push(...shapeProblems(shape.then, value, at));
+    if (!condition && shape.else) errors.push(...shapeProblems(shape.else, value, at));
+  }
+  return errors;
+}
+
+/** The tier is the maximum of the four scores. Score 1, 2 and 3 select low, costly and one_way_door. */
+export function tierOf(scores: TierScores, tiers: TierRule): TierName {
+  const values = tiers.scores.map((name) => scores[name]);
+  if (values.some((n) => typeof n !== "number" || !Number.isInteger(n) || n < tiers.score_min || n > tiers.score_max)) {
+    throw new VocabularyError(`tier scores must be integers from ${tiers.score_min} to ${tiers.score_max}`);
+  }
+  const tier = tiers.rank[String(Math.max(...values))];
+  if (!tier) throw new VocabularyError("the tier rank has no name for that score");
+  return tier;
+}
+
+function pushShape(errors: string[], parsed: { shape: SchemaNode | null; errors: string[] }): SchemaNode | null {
+  errors.push(...parsed.errors);
+  return parsed.shape;
+}
+
+function loadTiers(raw: unknown, impact: unknown, errors: string[]): TierRule | null {
+  if (!isRecord(raw)) { errors.push("schema/vocabulary.json: tiers must be an object"); return null; }
+  const values = strings(raw.values, "tiers.values", errors);
+  const scores = strings(raw.scores, "tiers.scores", errors);
+  if (!values || !scores) return null;
+  if (!same(values, [...TIER_NAMES])) errors.push(`tiers.values must be ${TIER_NAMES.join(", ")}`);
+  if (!same(scores, [...TIER_SCORES])) errors.push(`tiers.scores must be ${TIER_SCORES.join(", ")}`);
+  if (raw.tier_of !== "max") errors.push("tiers.tier_of must be max");
+  if (raw.score_min !== 1 || raw.score_max !== 3) errors.push("tiers scores run from 1 to 3");
+  if (!isRecord(raw.rank)) errors.push("tiers.rank must map each score to a tier");
+  const rank: Record<string, TierName> = {};
+  if (isRecord(raw.rank)) {
+    for (let score = 1; score <= 3; score++) {
+      const name = raw.rank[String(score)];
+      const expected = TIER_NAMES[score - 1];
+      if (name !== expected) errors.push(`tiers.rank.${score} must be ${expected}`);
+      else rank[String(score)] = expected;
+    }
+  }
+  if (!isRecord(impact)) errors.push("operations/operating-rules.json: questions.impact is missing");
+  else {
+    if (!same(impact.tiers, [...TIER_NAMES])) errors.push("questions.impact.tiers does not match the vocabulary tiers");
+    if (!same(impact.scores, [...TIER_SCORES])) errors.push("questions.impact.scores does not match the vocabulary scores");
+    if (impact.tier_of !== "max") errors.push("questions.impact.tier_of must be max");
+    if (impact.score_min !== 1 || impact.score_max !== 3) errors.push("questions.impact scores must run from 1 to 3");
+  }
+  if (errors.length) return null;
+  return { values: [...TIER_NAMES], scores: [...TIER_SCORES], score_min: 1, score_max: 3, tier_of: "max", rank };
+}
+
+function verbNames(raw: Record<string, unknown>): string | undefined {
+  if (typeof raw.derive_names === "string") return raw.derive_names;
+  if (typeof raw.merge_names === "string") return raw.merge_names;
+  return undefined;
+}
+
+/** Loads the vocabulary. errors is empty when the catalog, the ontology and the operating rules agree. */
+export function loadVocabulary(root: string): { vocabulary: Vocabulary | null; errors: string[] } {
+  const errors: string[] = [];
+  let catalog: unknown;
+  let ontology: unknown;
+  let rules: unknown;
+  try {
+    catalog = readJson(root, VOCABULARY_FILE);
+    ontology = readJson(root, ONTOLOGY_FILE);
+    rules = readJson(root, OPERATING_RULES_FILE);
+  } catch (e) {
+    return { vocabulary: null, errors: [e instanceof Error ? e.message : String(e)] };
+  }
+  if (!isRecord(catalog) || catalog.version !== "1" || !Array.isArray(catalog.verbs) || !Array.isArray(catalog.kinds) || !isRecord(catalog.shapes)) {
+    return { vocabulary: null, errors: ["schema/vocabulary.json: version 1, with verbs, kinds and shapes"] };
+  }
+  if (!isRecord(ontology) || !Array.isArray(ontology.nouns)) return { vocabulary: null, errors: ["docs/ontology.json has no nouns"] };
+  const design = isRecord(rules) && isRecord(rules.design) && isRecord(rules.design.diff) ? rules.design.diff : null;
+  const ruleVerbs = design && isRecord(design.verbs) ? design.verbs : null;
+  const impact = isRecord(rules) && isRecord(rules.questions) ? rules.questions.impact : null;
+  if (!ruleVerbs) errors.push("operations/operating-rules.json: design.diff.verbs is missing");
+  const tiers = loadTiers(catalog.tiers, impact, errors);
+
+  const objects: VocabularyObject[] = [];
+  const seen = new Set<string>();
+  const take = (object: VocabularyObject) => {
+    if (seen.has(object.id)) errors.push(`duplicate vocabulary id ${object.id}`);
+    seen.add(object.id);
+    objects.push(object);
+  };
+
+  for (const noun of ontology.nouns) {
+    if (!isRecord(noun) || typeof noun.noun !== "string") { errors.push("docs/ontology.json has a noun that is not an object"); continue; }
+    const id = nounId(noun.noun);
+    if (!ID_RE.test(id)) errors.push(`docs/ontology.json: ${noun.noun} has no stable id`);
+    take({ id, class: "noun", shape: OPEN_SHAPE, shapeDeclared: false, noun: noun as NounRecord });
+  }
+
+  const byId = new Map(objects.map((object) => [object.id, object]));
+  for (const [id, raw] of Object.entries(catalog.shapes)) {
+    const object = byId.get(id);
+    if (!object || object.class !== "noun") { errors.push(`shapes.${id} is not a noun id`); continue; }
+    const shape = pushShape(errors, parseShape(raw, `shapes.${id}`));
+    if (shape) { object.shape = shape; object.shapeDeclared = true; }
+  }
+
+  const ruleEntries = ruleVerbs ? Object.entries(ruleVerbs) : [];
+  if (catalog.verbs.length !== ruleEntries.length) errors.push("vocabulary verbs do not match design.diff.verbs");
+  catalog.verbs.forEach((raw, index) => {
+    if (!isRecord(raw) || typeof raw.verb !== "string" || raw.class !== "verb" || raw.id !== `verb:${raw.verb}`) {
+      errors.push(`verbs[${index}] needs class verb and id verb:<name>`);
+      return;
+    }
+    const kinds = strings(raw.kinds, `${raw.id}.kinds`, errors);
+    const shape = pushShape(errors, parseShape(raw.shape, `${raw.id}.shape`));
+    const rule = ruleVerbs && isRecord(ruleVerbs[raw.verb]) ? ruleVerbs[raw.verb] as Record<string, unknown> : null;
+    if (!rule) errors.push(`${raw.id} is not in design.diff.verbs`);
+    else if (kinds && !same(kinds, rule.kinds)) errors.push(`${raw.id}.kinds does not match design.diff.verbs`);
+    const names = verbNames(raw);
+    if (rule) {
+      const ruleNames = verbNames(rule);
+      if (names !== ruleNames) errors.push(`${raw.id} names ${names ?? "nothing"}, design.diff.verbs names ${ruleNames ?? "nothing"}`);
+    }
+    if (shape && kinds) take({ id: raw.id, class: "verb", shape, shapeDeclared: true, verb: raw.verb, kinds, names });
+  });
+  for (const [name] of ruleEntries) if (!catalog.verbs.some((raw) => isRecord(raw) && raw.verb === name)) errors.push(`design.diff.verbs.${name} has no vocabulary object`);
+
+  const kindOwners = new Map<string, string>();
+  for (const object of objects) if (object.class === "verb" && object.kinds && object.verb) for (const kind of object.kinds) kindOwners.set(kind, object.verb);
+
+  catalog.kinds.forEach((raw, index) => {
+    if (!isRecord(raw) || typeof raw.kind !== "string" || typeof raw.verb !== "string" || raw.class !== "kind" || raw.id !== `kind:${raw.kind}`) {
+      errors.push(`kinds[${index}] needs class kind and id kind:<name>`);
+      return;
+    }
+    const shape = pushShape(errors, parseShape(raw.shape, `${raw.id}.shape`));
+    if (kindOwners.get(raw.kind) !== raw.verb) errors.push(`${raw.id} is not a kind of verb:${raw.verb}`);
+    const names = typeof raw.names === "string" ? raw.names : undefined;
+    const owner = objects.find((object) => object.id === `verb:${raw.verb}`);
+    const expect = owner?.kinds?.includes(raw.kind) && owner.names && (raw.kind === "derive" || raw.kind === "merge") ? owner.names : undefined;
+    if (names !== expect) errors.push(`${raw.id} names ${names ?? "nothing"} and verb:${raw.verb} names ${expect ?? "nothing"}`);
+    if (shape) take({ id: raw.id, class: "kind", shape, shapeDeclared: true, verb: raw.verb, kind: raw.kind, names });
+  });
+  for (const [kind, verb] of kindOwners) if (!objects.some((object) => object.id === `kind:${kind}`)) errors.push(`kind:${kind} of verb:${verb} has no vocabulary object`);
+
+  if (errors.length || !tiers) return { vocabulary: null, errors };
+  return { vocabulary: { objects, byId: new Map(objects.map((object) => [object.id, object])), tiers }, errors: [] };
+}
+
+/** Reads a module's parent from the first 40 lines. No line means no parent. */
+export function parentFromModuleSource(source: string): { parent: string | null; error: string | null } {
+  const found: string[] = [];
+  const bad: string[] = [];
+  source.split("\n").slice(0, HEADER_LINES).forEach((line) => {
+    const match = PARENT_LINE.exec(line);
+    if (!match?.[1]) return;
+    if (!ID_RE.test(match[1])) bad.push(match[1]);
+    else found.push(match[1]);
+  });
+  if (bad.length) return { parent: null, error: `${PARENT_FIELD} is not a vocabulary id` };
+  if (found.length > 1) return { parent: null, error: `${PARENT_FIELD} is declared more than once` };
+  return { parent: found[0] ?? null, error: null };
+}
+
+function parentFromValue(value: unknown): { parent: string | null; error: string | null } {
+  if (!isRecord(value) || !Object.prototype.hasOwnProperty.call(value, PARENT_FIELD)) return { parent: null, error: null };
+  const raw = value[PARENT_FIELD];
+  if (typeof raw !== "string" || !ID_RE.test(raw)) return { parent: null, error: `${PARENT_FIELD} must be a vocabulary id` };
+  return { parent: raw, error: null };
+}
+
+function walk(dir: string): string[] {
+  if (!existsSync(dir)) return [];
+  return readdirSync(dir).flatMap((name) => {
+    if (name === "node_modules" || name === ".git") return [];
+    const path = join(dir, name);
+    return statSync(path).isDirectory() ? walk(path) : [path];
+  });
+}
+
+function isTestModule(rel: string): boolean {
+  const base = rel.split("/").pop() ?? "";
+  return base.startsWith("test.") || base.includes(".test.") || /-test\.[^.]+$/.test(base);
+}
+
+/** Record types, core modules and instance JSON records, each with the parent it names. */
+export function collectSubjects(root: string): { subjects: Subject[]; errors: string[] } {
+  const subjects: Subject[] = [];
+  const errors: string[] = [];
+  const seen = new Set<string>();
+  const add = (subject: Subject) => {
+    if (seen.has(subject.id)) errors.push(`duplicate subject ${subject.id}`);
+    seen.add(subject.id);
+    subjects.push(subject);
+  };
+  let model: unknown;
+  try { model = readJson(root, "schema/data-model.json"); }
+  catch (e) { return { subjects, errors: [e instanceof Error ? e.message : String(e)] }; }
+  const records = isRecord(model) && Array.isArray(model.records) ? model.records : null;
+  if (!records) errors.push("schema/data-model.json has no records");
+  for (const record of records ?? []) {
+    if (!isRecord(record) || typeof record.id !== "string") { errors.push("a record type has no id"); continue; }
+    const named = parentFromValue(record);
+    add({ kind: "record-type", id: `record-type:${record.id}`, parent: named.parent, parentError: named.error, shapeCheck: false, value: record });
+  }
+  for (const dir of MODULE_ROOTS) {
+    for (const file of walk(join(root, dir))) {
+      const rel = relPath(root, file);
+      if (!/\.(mjs|ts|js|cjs|mts)$/.test(rel) || rel.startsWith("schema/types/") || isTestModule(rel)) continue;
+      const named = parentFromModuleSource(readFileSync(file, "utf8"));
+      add({ kind: "module", id: `module:${rel}`, parent: named.parent, parentError: named.error, shapeCheck: false });
+    }
+  }
+  for (const file of walk(join(root, "instance")).filter((path) => path.endsWith(".json"))) {
+    const rel = relPath(root, file);
+    let value: unknown;
+    try { value = JSON.parse(readFileSync(file, "utf8")) as unknown; }
+    catch { add({ kind: "record", id: `record:${rel}`, parent: null, parentError: "invalid JSON", shapeCheck: true }); continue; }
+    const named = parentFromValue(value);
+    add({ kind: "record", id: `record:${rel}`, parent: named.parent, parentError: named.error, shapeCheck: true, value });
+  }
+  return { subjects, errors };
+}
+
+export function parseBaseline(text: string): { entries: BaselineEntry[]; errors: string[] } {
+  let value: unknown;
+  try { value = JSON.parse(text) as unknown; }
+  catch (e) { return { entries: [], errors: [e instanceof Error ? e.message : String(e)] }; }
+  return baselineEntries(value);
+}
+
+export function baselineEntries(value: unknown): { entries: BaselineEntry[]; errors: string[] } {
+  const errors: string[] = [];
+  if (!isRecord(value) || !Array.isArray(value.gaps)) return { entries: [], errors: [`${BASELINE_FILE}: gaps must be an array`] };
+  const entries: BaselineEntry[] = [];
+  const seen = new Set<string>();
+  for (const gap of value.gaps) {
+    let id = "";
+    let approved: string | undefined;
+    if (typeof gap === "string") id = gap;
+    else if (isRecord(gap) && typeof gap.id === "string") {
+      id = gap.id;
+      if (gap.approved !== undefined && typeof gap.approved !== "string") errors.push(`${id}: approved must be a string`);
+      if (typeof gap.approved === "string") approved = gap.approved;
+      for (const key of Object.keys(gap)) if (key !== "id" && key !== "approved") errors.push(`${id}: unknown baseline field ${key}`);
+    } else errors.push(`${BASELINE_FILE}: a gap must be an id or an object with an id`);
+    if (!id) continue;
+    if (!BASELINE_ID_RE.test(id)) errors.push(`${id}: not a subject id`);
+    if (seen.has(id)) errors.push(`${id}: duplicate baseline entry`);
+    seen.add(id);
+    entries.push(approved === undefined ? { id } : { id, approved });
+  }
+  return { entries, errors };
+}
+
+function readBaseline(root: string): { entries: BaselineEntry[]; errors: string[] } {
+  const path = join(root, BASELINE_FILE);
+  if (!existsSync(path)) return { entries: [], errors: [`${BASELINE_FILE} is missing`] };
+  return parseBaseline(readFileSync(path, "utf8"));
+}
+
+function ownRepository(root: string): boolean {
+  const ran = spawnSync("git", ["-C", root, "rev-parse", "--git-dir"], { encoding: "utf8" });
+  if (ran.status !== 0 || !ran.stdout.trim()) return false;
+  return resolve(root, ran.stdout.trim()) === resolve(root, ".git");
+}
+
+/** The baseline at the merge base with framework, or null when this file is not on that branch yet. */
+export function previousBaseline(root: string): { entries: BaselineEntry[] | null; errors: string[] } {
+  if (!ownRepository(root)) return { entries: null, errors: [] };
+  for (const ref of ["origin/framework", "framework"]) {
+    const base = spawnSync("git", ["-C", root, "merge-base", "HEAD", ref], { encoding: "utf8" });
+    if (base.status !== 0 || !base.stdout.trim()) continue;
+    const shown = spawnSync("git", ["-C", root, "show", `${base.stdout.trim()}:${BASELINE_FILE}`], { encoding: "utf8" });
+    if (shown.status !== 0) return { entries: null, errors: [] };
+    const parsed = parseBaseline(shown.stdout);
+    return { entries: parsed.errors.length ? null : parsed.entries, errors: parsed.errors };
+  }
+  return { entries: null, errors: [] };
+}
+
+/**
+ * Decides the check. previous null means there is no baseline on the base branch yet,
+ * so the committed list is the starting ratchet and additions are not judged here.
+ * A later list may drop an entry. An entry the previous list did not have fails unless
+ * that entry carries a non-empty approved string.
+ */
+export function evaluate(input: {
+  subjects: Subject[];
+  vocabulary: Vocabulary;
+  baseline: BaselineEntry[];
+  previous: BaselineEntry[] | null;
+}): string[] {
+  const errors: string[] = [];
+  const gaps: string[] = [];
+  for (const subject of input.subjects) {
+    if (subject.parentError) { errors.push(`${subject.id}: ${subject.parentError}`); continue; }
+    if (!subject.parent) { gaps.push(subject.id); continue; }
+    const object = input.vocabulary.byId.get(subject.parent);
+    if (!object) { errors.push(`${subject.id} claims ${subject.parent} and that vocabulary object does not exist`); continue; }
+    if (object.class === "noun" && object.noun?.status === "retired") errors.push(`${subject.id} claims ${subject.parent}, which is retired`);
+    if (!subject.shapeCheck) continue;
+    const problems = shapeProblems(object.shape, subject.value);
+    if (problems.length) errors.push(`${subject.id} claims ${subject.parent} and does not match its shape: ${problems.join("; ")}`);
+  }
+  const listed = new Set(input.baseline.map((entry) => entry.id));
+  const gapSet = new Set(gaps);
+  for (const gap of gaps) if (!listed.has(gap)) errors.push(`new gap ${gap}: no vocabulary parent`);
+  for (const entry of input.baseline) if (!gapSet.has(entry.id)) errors.push(`${entry.id}: baseline entry is no longer a gap; remove it`);
+  if (input.previous) {
+    const before = new Set(input.previous.map((entry) => entry.id));
+    for (const entry of input.baseline) {
+      if (before.has(entry.id)) continue;
+      if (!entry.approved?.trim()) errors.push(`baseline adds ${entry.id} without approval`);
+    }
+  }
+  return errors;
+}
+
+export type CheckCounts = {
+  objects: number;
+  nouns: number;
+  verbs: number;
+  kinds: number;
+  recordTypes: number;
+  modules: number;
+  records: number;
+  parents: number;
+  gaps: number;
+};
+
+export type CheckResult = {
+  errors: string[];
+  summary: string;
+  counts: CheckCounts;
+  subjects: Subject[];
+  baseline: BaselineEntry[];
+  vocabulary: Vocabulary | null;
+};
+
+/** The repository check: load, collect, read the baseline, compare with the base branch. */
+export function checkRepository(root: string): CheckResult {
+  const dir = root.replace(/\/$/, "");
+  const loaded = loadVocabulary(dir);
+  const collected = loaded.vocabulary ? collectSubjects(dir) : { subjects: [], errors: [] };
+  const baseline = readBaseline(dir);
+  const previous = previousBaseline(dir);
+  const errors = [...loaded.errors, ...collected.errors, ...baseline.errors, ...previous.errors];
+  if (loaded.vocabulary && baseline.errors.length === 0 && previous.errors.length === 0) {
+    errors.push(...evaluate({
+      subjects: collected.subjects,
+      vocabulary: loaded.vocabulary,
+      baseline: baseline.entries,
+      previous: previous.entries,
+    }));
+  }
+  const subjects = collected.subjects;
+  const counts: CheckCounts = {
+    objects: loaded.vocabulary?.objects.length ?? 0,
+    nouns: loaded.vocabulary?.objects.filter((object) => object.class === "noun").length ?? 0,
+    verbs: loaded.vocabulary?.objects.filter((object) => object.class === "verb").length ?? 0,
+    kinds: loaded.vocabulary?.objects.filter((object) => object.class === "kind").length ?? 0,
+    recordTypes: subjects.filter((subject) => subject.kind === "record-type").length,
+    modules: subjects.filter((subject) => subject.kind === "module").length,
+    records: subjects.filter((subject) => subject.kind === "record").length,
+    parents: subjects.filter((subject) => subject.parent).length,
+    gaps: baseline.entries.length,
+  };
