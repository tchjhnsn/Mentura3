+// vocabulary_parent: noun:schema
+// Fails when a record type, a core module or an instance record has no vocabulary
+// parent and is not in the baseline, when the baseline gains an entry or keeps a
+// closed one, or when a record claims a vocabulary object and does not match its
+// shape (EE-107). The same check runs from schema/check-nouns.mjs.
+//
+//   node schema/check-vocabulary.mjs
+
+import { fileURLToPath } from "node:url";
+import { checkRepository } from "./vocabulary.ts";
+
+const root = process.env.EE_ROOT?.replace(/\/$/, "") || fileURLToPath(new URL("..", import.meta.url));
+const result = checkRepository(root);
+if (result.errors.length) {
+  console.error(result.errors.join("\n"));
+  process.exit(1);
+}
+console.log(`${result.summary}.`);
