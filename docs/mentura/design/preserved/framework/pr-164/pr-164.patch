+// Behavior of the vocabulary check (EE-107). The repository case runs the real
+// catalog. The rest build a small vocabulary and assert the ratchet.
+//
+//   node schema/vocabulary-test.ts
+
+import { readFileSync } from "node:fs";
+import { spawnSync } from "node:child_process";
+import { join } from "node:path";
+import { fileURLToPath } from "node:url";
+import {
+  checkRepository, evaluate, loadVocabulary, nounId, parentFromModuleSource, shapeProblems, tierOf,
+  type BaselineEntry, type SchemaNode, type Subject, type Vocabulary, type VocabularyObject,
+} from "./vocabulary.ts";
+
+const root = fileURLToPath(new URL("..", import.meta.url));
+let failed = 0;
+const expect = (name: string, ok: boolean, detail?: unknown) => {
+  console.log(`${ok ? "ok  " : "FAIL"} ${name}`);
+  if (!ok) {
+    failed++;
+    if (detail !== undefined) console.log(typeof detail === "string" ? detail : JSON.stringify(detail, null, 2));
+  }
+};
+
+const ventureShape: SchemaNode = {
+  type: "object",
+  required: ["vocabulary_parent", "phase"],
+  properties: {
+    vocabulary_parent: { const: "noun:venture" },
+    phase: { enum: ["discovery", "validation"] },
+  },
+};
+
+function object(partial: Pick<VocabularyObject, "id" | "class"> & Partial<VocabularyObject>): VocabularyObject {
+  return { shape: { type: "object" }, shapeDeclared: false, ...partial };
+}
+
+function vocabulary(): Vocabulary {
+  const objects = [
+    object({ id: "noun:venture", class: "noun", shape: ventureShape, shapeDeclared: true, noun: { noun: "venture", status: "new" } }),
+    object({ id: "noun:guiding-statement", class: "noun", noun: { noun: "guiding statement", status: "retired" } }),
+    object({ id: "verb:create", class: "verb", verb: "create", shapeDeclared: true, shape: { type: "object", required: ["verb"], properties: { verb: { const: "create" } } } }),
+  ];
+  return {
+    objects,
+    byId: new Map(objects.map((item) => [item.id, item])),
+    tiers: { values: ["low", "costly", "one_way_door"], scores: ["severity", "reversibility", "time_to_detect", "blast_radius"], score_min: 1, score_max: 3, tier_of: "max", rank: { "1": "low", "2": "costly", "3": "one_way_door" } },
+  };
+}
+
+const subject = (id: string, parent: string | null, extra: Partial<Subject> = {}): Subject => ({
+  kind: id.startsWith("record:") ? "record" : id.startsWith("module:") ? "module" : "record-type",
+  id, parent, parentError: null, shapeCheck: id.startsWith("record:"), ...extra,
+});
+
+const entry = (id: string, approved?: string): BaselineEntry => approved === undefined ? { id } : { id, approved };
+const problems = (subjects: Subject[], baseline: BaselineEntry[], previous: BaselineEntry[] | null) =>
+  evaluate({ subjects, vocabulary: vocabulary(), baseline, previous });
+
+const missing = subject("record-type:workspace", null);
+expect("a missing parent fails", problems([missing], [], null).some((error) => error.includes("new gap record-type:workspace")));
+
+const mismatch = subject("record:instance/ventures/example/venture.json", "noun:venture", { value: { vocabulary_parent: "noun:venture", phase: "nope" } });
+expect("a shape mismatch fails", problems([mismatch], [], null).some((error) => error.includes("does not match its shape")));
+
+expect("a baselined gap passes", problems([missing], [entry(missing.id)], null).length === 0);
+
+const known = subject("record-type:workspace", null);
+const added = subject("module:schema/new-file.mjs", null);
+expect("a new gap fails", problems([known, added], [entry(known.id)], null).some((error) => error.includes("new gap module:schema/new-file.mjs")));
+
+const closed = subject("record-type:venture", "noun:venture");
+expect("removing an entry from the baseline is allowed", problems(
+  [known, closed],
+  [entry(known.id)],
+  [entry(known.id), entry(closed.id)],
+).length === 0);
+
+expect("adding one fails unless explicitly approved", problems(
+  [known, added],
+  [entry(known.id), entry(added.id)],
+  [entry(known.id)],
+).some((error) => error.includes("baseline adds module:schema/new-file.mjs without approval")));
+
+expect("a blank approval is not approval", problems(
+  [known, added],
+  [entry(known.id), entry(added.id, "   ")],
+  [entry(known.id)],
+).some((error) => error.includes("without approval")));
+
+expect("an approved addition passes", problems(
+  [known, added],
+  [entry(known.id), entry(added.id, "Torian, 2026-11-02: this module landed with no parent")],
+  [entry(known.id)],
+).length === 0);
+
+expect("a closed gap that stays in the baseline fails", problems(
+  [closed],
+  [entry(closed.id)],
+  null,
+).some((error) => error.includes("no longer a gap")));
+
+expect("an unknown parent fails", problems(
+  [subject("record:instance/x.json", "noun:missing", { value: {} })],
+  [],
+  null,
+).some((error) => error.includes("does not exist")));
+
+expect("a retired noun fails", problems(
+  [subject("record:instance/x.json", "noun:guiding-statement", { value: {} })],
+  [],
+  null,
+).some((error) => error.includes("retired")));
+
+expect("a module with a parent is not shape-checked", problems(
+  [subject("module:schema/vocabulary.ts", "noun:venture")],
+  [],
+  null,
+).length === 0);
+
+expect("a record that matches its shape passes", problems(
+  [subject("record:instance/ok.json", "noun:venture", { value: { vocabulary_parent: "noun:venture", phase: "discovery" } })],
+  [],
+  null,
+).length === 0);
+
+const header = parentFromModuleSource(`// vocabulary_parent: noun:schema\nexport const n = 1;\n`);
+expect("a module header names its parent", header.parent === "noun:schema" && header.error === null);
+const late = Array.from({ length: 41 }, (_, i) => i === 40 ? "// vocabulary_parent: noun:schema" : "// note").join("\n");
+expect("a parent after line 40 is not a parent", parentFromModuleSource(late).parent === null);
+expect("two parent lines fail", parentFromModuleSource("// vocabulary_parent: noun:schema\n// vocabulary_parent: noun:venture\n").error !== null);
+
+const loaded = loadVocabulary(root);
+expect("the repository vocabulary loads", loaded.errors.length === 0 && loaded.vocabulary !== null, loaded.errors.join("\n"));
+const vocab = loaded.vocabulary;
+if (vocab) {
+  const ontology = JSON.parse(readFileSync(join(root, "docs/ontology.json"), "utf8")) as { nouns: { noun: string }[] };
+  const preserved = ontology.nouns.every((noun) => {
+    const found = vocab.byId.get(nounId(noun.noun));
+    return !!found && JSON.stringify(found.noun) === JSON.stringify(noun);
+  });
+  expect("every ontology noun is preserved", ontology.nouns.length === 112 && preserved);
+  expect("ids do not collide", vocab.objects.length === vocab.byId.size);
+  expect("verbs and kinds are the three and the eight", vocab.byId.has("verb:create") && vocab.byId.has("verb:amend") && vocab.byId.has("verb:delete")
+    && ["originate", "derive", "append", "rename", "deprecate", "revise", "remove", "merge"].every((kind) => vocab.byId.has(`kind:${kind}`)));
+  const create = vocab.byId.get("verb:create");
+  const derive = vocab.byId.get("kind:derive");
+  const originate = vocab.byId.get("kind:originate");
+  const merge = vocab.byId.get("kind:merge");
+  expect("derive without a source fails the create shape", !!create && shapeProblems(create.shape, { verb: "create", kind: "derive", noun: "venture" }).length > 0);
+  expect("derive with a source passes", !!derive && shapeProblems(derive.shape, { verb: "create", kind: "derive", noun: "venture", source: "noun:phase" }).length === 0);
+  expect("originate needs no source", !!originate && shapeProblems(originate.shape, { verb: "create", kind: "originate", noun: "venture" }).length === 0);
+  expect("merge without a successor fails", !!merge && shapeProblems(merge.shape, { verb: "delete", kind: "merge", noun: "venture" }).length > 0);
+  const venture = vocab.byId.get("noun:venture");
+  const schema = vocab.byId.get("noun:schema");
+  expect("venture declares a shape and schema stays open", !!venture?.shapeDeclared && schema?.shapeDeclared === false);
+  expect("the max score selects the tier", tierOf({ severity: 1, reversibility: 1, time_to_detect: 1, blast_radius: 1 }, vocab.tiers) === "low"
+    && tierOf({ severity: 1, reversibility: 2, time_to_detect: 1, blast_radius: 1 }, vocab.tiers) === "costly"
+    && tierOf({ severity: 3, reversibility: 1, time_to_detect: 2, blast_radius: 1 }, vocab.tiers) === "one_way_door");
+  let threw = false;
+  try { tierOf({ severity: 4, reversibility: 1, time_to_detect: 1, blast_radius: 1 }, vocab.tiers); }
+  catch { threw = true; }
+  expect("a score outside 1 to 3 is refused", threw);
+}
+
+const repo = checkRepository(root);
+expect("the repository check passes", repo.errors.length === 0, repo.errors.join("\n"));
+expect("the wired examples name a parent", [
+  ["record-type:venture", "noun:venture"],
+  ["record:instance/ventures/everything-ecosystem/venture.json", "noun:venture"],
+  ["module:schema/vocabulary.ts", "noun:schema"],
+  ["module:schema/check-vocabulary.mjs", "noun:schema"],
+].every(([id, parent]) => repo.subjects.find((item) => item.id === id)?.parent === parent));
+expect("a test module is outside the check", repo.subjects.every((item) => item.id !== "module:schema/vocabulary-test.ts"));
+expect("the baseline matches the gaps", repo.errors.length === 0 && repo.counts.parents + repo.counts.gaps === repo.subjects.length);
+const ran = spawnSync(process.execPath, ["schema/check-vocabulary.mjs"], { cwd: root, encoding: "utf8" });
+expect("the vocabulary command passes", ran.status === 0, ran.stderr);
+console.log(repo.summary);
+
+if (failed) { console.log(`${failed} failed`); process.exit(1); }
+console.log("vocabulary: all passed");
