@@ -4,8 +4,14 @@
 import { existsSync } from "node:fs";
 import { basename, dirname, join, resolve } from "node:path";
 
+// NAIVE_CEILING_DIRECTORIES, like GIT_CEILING_DIRECTORIES: colon-separated folders the search never
+// enters, so a command run inside a checkout of Naive never finds the venture that holds the checkout.
+const ceilings = () => (process.env.NAIVE_CEILING_DIRECTORIES ?? "").split(":").filter(Boolean).map((c) => resolve(c));
+
 export function findVenture(from = process.cwd()) {
+  const stop = ceilings();
   for (let d = resolve(from); ; d = dirname(d)) {
+    if (stop.includes(d)) return null;
     if (existsSync(join(d, "venture.json"))) return d;
     if (dirname(d) === d) return null;
   }
