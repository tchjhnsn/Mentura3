diff --git a/schema/migrations/structured-layout.mjs b/schema/migrations/structured-layout.mjs
new file mode 100644
index 00000000..5d8897cf
--- /dev/null
+++ b/schema/migrations/structured-layout.mjs
@@ -0,0 +1,94 @@
+// Moves a venture onto the structured layout (EE-086), like a Next.js codemod. Only the files move: every
+// record keeps its logical path (foundation/problem.json stays foundation/problem.json to the router, the
+// provenance log and every citation), because schema/venture-paths.mjs resolves it into knowledge/ or meta/
+// once venture.json says the layout is structured. So no route changes and no alias is needed.
+//
+//   the knowledge base   every package folder and record file at the top moves into knowledge/
+//   meta/                provenance.jsonl, naive.config.json and knowledge/sources.json move into meta/,
+//                        and .release/ becomes meta/releases/
+//   README.md            profile.md becomes README.md
+//   the org chart        venture.json gains layout: structured and a flat org chart, one function per
+//                        package, owned by --owner, or by the solo founder when people/ names one
+//
+// Files git tracks move with git mv. The moves are reported as one note, not one provenance entry each:
+// no logical path changes, so there is nothing for an entry to record.
+
+import { spawnSync } from "node:child_process";
+import { existsSync, mkdirSync, readdirSync, readFileSync, renameSync, writeFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { layoutOf } from "../venture-paths.mjs";
+
+export const id = "structured-layout";
+export const describe = "Moves the venture onto the structured layout: the knowledge base into knowledge/, provenance, config, sources and releases into meta/, profile.md to README.md, and a flat org chart into venture.json (EE-086)";
+
+// What stays at the top: the venture's own files and what tools keep there.
+const TOP = new Set(["venture.json", "AGENTS.md", "README.md", "package.json", "package-lock.json", "pnpm-lock.yaml", "yarn.lock", "bun.lock", "bun.lockb", ".gitignore", ".git", ".vscode", ".naive", "node_modules", "knowledge", "meta", "repo"]);
+// Folders that hold venture-wide records, not one function's.
+const SHARED = new Set(["decisions", "evidence", "raw", "ideas", "_drafts", "_private", "public", "accounts", "products", "pillars", "purpose", "operations", "governance", "interface"]);
+
+export function apply(dir, ctx) {
+  if (layoutOf(dir) === "structured") return;
+  const repo = new URL("../..", import.meta.url).pathname;
+  const tracked = (p) => spawnSync("git", ["ls-files", "--error-unmatch", p], { cwd: dir, stdio: "pipe" }).status === 0;
+  const movedPaths = [], gone = new Set();
+  const move = (from, to) => {
+    if (!existsSync(join(dir, from))) return;
+    if (existsSync(join(dir, to))) { ctx.escalate(`${to} already exists, so ${from} stayed where it is; move it yourself`); return; }
+    if (!ctx.dry) {
+      mkdirSync(dirname(join(dir, to)), { recursive: true });
+      if (tracked(from)) spawnSync("git", ["mv", from, to], { cwd: dir, stdio: "pipe" });
+      else renameSync(join(dir, from), join(dir, to));
+    }
+    movedPaths.push(`${from} -> ${to}`);
+    gone.add(from);
+  };
+  // meta/ first, so knowledge/sources.json leaves the old layer folder before that folder is considered.
+  move("provenance.jsonl", "meta/provenance.jsonl");
+  move("naive.config.json", "meta/naive.config.json");
+  move("knowledge/sources.json", "meta/sources.json");
+  move(".release", "meta/releases");
+  if (!existsSync(join(dir, "README.md"))) move("profile.md", "README.md");
+  else ctx.escalate("README.md already exists, so profile.md moved into knowledge/; merge the two yourself");
+  // The old knowledge layer folder goes inside the new knowledge base, as knowledge/knowledge/.
+  if (existsSync(join(dir, "knowledge"))) {
+    if (!ctx.dry) {
+      renameSync(join(dir, "knowledge"), join(dir, ".knowledge-layer"));
+      mkdirSync(join(dir, "knowledge"), { recursive: true });
+      renameSync(join(dir, ".knowledge-layer"), join(dir, "knowledge/knowledge"));
+    }
+    movedPaths.push("knowledge -> knowledge/knowledge");
+  }
+  // The knowledge base: everything else at the top.
+  const packages = new Set(readdirSync(join(repo, "packages")).filter((n) => existsSync(join(repo, "packages", n, "package.json"))));
+  const moved = [];
+  for (const name of readdirSync(dir).sort()) {
+    // A --check run moves nothing, so skip what the steps above already said they would move.
+    if (TOP.has(name) || gone.has(name)) continue;
+    move(name, `knowledge/${name}`);
+    moved.push(name);
+  }
+  // The org chart: one function per package the venture has, flat, owned by the solo founder if there is one.
+  const vfile = join(dir, "venture.json");
+  const v = JSON.parse(readFileSync(vfile, "utf8"));
+  const rosterFile = join(dir, "knowledge/people/people.json");
+  const roster = !ctx.dry && existsSync(rosterFile) ? JSON.parse(readFileSync(rosterFile, "utf8")) : null;
+  const owner = ctx.owner ?? (roster?.mode === "solo" ? roster.people[0]?.id ?? null : null);
+  const functions = Object.fromEntries(moved.filter((n) => packages.has(n) && !SHARED.has(n)).map((n) => [n, { owner }]));
+  v.layout = "structured";
+  if (v.profile === "profile.md") v.profile = "README.md";
+  v.functions = { ...functions, ...(v.functions ?? {}) };
+  if (!ctx.dry) writeFileSync(vfile, JSON.stringify(v, null, 2) + "\n");
+  // Hats are read from the org chart now (EE-086), so people/ stops storing them.
+  if (!ctx.dry && roster) {
+    for (const p of roster.people) delete p.hats;
+    writeFileSync(rosterFile, JSON.stringify(roster, null, 2) + "\n");
+    const fdir = join(dir, "knowledge/people/founders");
+    if (existsSync(fdir)) for (const f of readdirSync(fdir).filter((n) => n.endsWith(".json"))) {
+      const rec = JSON.parse(readFileSync(join(fdir, f), "utf8"));
+      if ("hats" in rec) { delete rec.hats; writeFileSync(join(fdir, f), JSON.stringify(rec, null, 2) + "\n"); }
+    }
+  }
+  ctx.note(`moved ${movedPaths.length} entries into knowledge/ and meta/: ${movedPaths.join(", ")}`);
+  ctx.note(`venture.json: layout structured, ${Object.keys(v.functions).length} functions in a flat org chart${owner ? `, owned by ${owner}` : ", owners to name"}`);
+  if (roster && roster.mode !== "solo") ctx.escalate("a team venture: name each function's owner in venture.json functions; hats are read from there now");
+}
